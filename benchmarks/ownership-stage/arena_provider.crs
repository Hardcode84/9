// Handles contain live non-null arena addresses. Keep the context alive through
// the edit scope. Editing adds storage; only context destruction retires it.
domain CompilerArena(SuArena,SuDeclaration,SuLayoutHandle);
record SuArena{stage:*SuStage;} opaque;
record SuDeclaration{pointer:*CrustDecl;} opaque scoped;
record SuLayoutHandle{pointer:*SuLayout;} opaque scoped;
record SuLayoutData{size:u64;align:u32;state:u32;}

fn su_handle_publish(arena:read SuArena,decl:read SuDeclaration,layout:read SuLayoutHandle)->bool access(edit,CompilerArena){
    return crust_try_map_set(arena.stage->context,&arena.stage->layouts,decl.pointer as usize,layout.pointer as *u8);
}
fn su_handle_load(layout:read SuLayoutHandle)->SuLayoutData access(read,CompilerArena){
    return make SuLayoutData{size:layout.pointer->size,align:layout.pointer->align,state:layout.pointer->state};
}
fn su_handle_save(layout:read SuLayoutHandle,value:read SuLayoutData)->unit access(edit,CompilerArena){
    layout.pointer->size=value.size;layout.pointer->align=value.align;layout.pointer->state=value.state;
}
fn su_handle_fill(arena:read SuArena,decl:read SuDeclaration,layout:read SuLayoutHandle,depth:usize)->bool access(edit,CompilerArena){
    var sum:*SuType=crust_map_get(&arena.stage->types,decl.pointer->name as usize) as *SuType;
    if sum!=null(*SuType){return su_layout_variants(arena.stage,sum,layout.pointer,depth);}
    return su_layout_fields(arena.stage,layout.pointer,depth);
}
fn su_handle_round(arena:read SuArena,decl:read SuDeclaration,size:u64,align:u32)->u64 access(edit,CompilerArena){
    return su_round(arena.stage,size,align,&decl.pointer->loc);
}
fn su_handle_error(arena:read SuArena,decl:read SuDeclaration,cycle:bool)->unit access(edit,CompilerArena){
    if cycle{su_error(arena.stage,&decl.pointer->loc,"by-value cycle in union payload");}
    else{su_error(arena.stage,&decl.pointer->loc,"union layout depth exceeded");}
}
fn su_handle_failed(arena:read SuArena)->bool access(read,CompilerArena){return arena.stage->context->error_count!=0usize;}

fn su_layout_record(stage:*SuStage,decl:*CrustDecl,depth:usize)->*SuLayout {
    domain CompilerArena { edit CompilerArena {
        var arena:SuArena=make SuArena{stage:stage};
        var declaration:SuDeclaration=make SuDeclaration{pointer:decl};
        if !su_checked_layout_depth(read arena,read declaration,depth){return null(*SuLayout);}
        var pointer:*SuLayout=su_cache_get!(SuLayout)(&stage->layouts,decl as usize);
        if pointer==null(*SuLayout){
            pointer=su_alloc(stage,sizeof(SuLayout),alignof(SuLayout)) as *SuLayout;
            if pointer==null(*SuLayout){return pointer;}
            pointer->declaration=decl;
        }
        var layout:SuLayoutHandle=make SuLayoutHandle{pointer:pointer};
        if !su_checked_layout_record(read arena,read declaration,read layout,depth){return null(*SuLayout);}
        return pointer;
    } }
}

fn su_cache_get!(Value)(cache:*CrustMap,key:usize)->*Value {
    return crust_map_get(cache,key) as *Value;
}
