// SPDX-License-Identifier: Apache-2.0

host_source(run, "../../stages/build/load.crs");
if !application_setup(run, "../..") {
    return 1i32;
};
var stages: *StageSession = stage_open(run, "../..", "../../build/stage-cache");
if stages == null(*StageSession) {
    return 1i32;
};
var backend: ApplicationBackend = uninit;
if !application_backend(run, stages, &backend, c_backend_build) {
    return 1i32;
};

// Pass the root arguments to the C backend, for example: -o build/arguments.
return c_build(
    (*run).source,
    (*run).cursor,
    (*run).argc,
    (*run).argv,
    backend.emit
);

extern fn puts(text: *u8) -> i32 = "puts";

fn main(argc: i32, argv: **u8) -> i32 {
    if puts("Program arguments:") < 0i32 {
        return 1i32;
    }
    var index: i32 = 1i32;
    while index < argc {
        if puts(argv[index as usize]) < 0i32 {
            return 1i32;
        }
        index = index + 1i32;
    }
    return 0i32;
}
