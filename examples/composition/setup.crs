fn composition_stages(root:*CrustRun)->bool {
    return host_source(root,"../../api/crust0_stage.crs") &&
        host_source(root,"../../stages/c/model.crs") &&
        host_source(root,"../../stages/c/api.crs") &&
        host_source(root,"../../stages/c/extension.crs") &&
        host_source(root,"../../stages/reader/model.crs") &&
        host_source(root,"../../stages/reader/extension.crs") &&
        host_source(root,"../../stages/source/model.crs") &&
        host_source(root,"../../stages/resources/model.crs") &&
        host_source(root,"../../stages/resources/extension.crs") &&
        host_source(root,"../../stages/ownership/model.crs") &&
        host_source(root,"../../stages/ownership/extension.crs") &&
        host_source(root,"../../stages/overload/model.crs") &&
        host_source(root,"../../stages/overload/extension.crs") &&
        host_link(root,"../../build/crust-c-library.so") &&
        host_link(root,"../../build/crust-ownership-library.so") &&
        host_link(root,"../../build/crust-overload-library.so");
}
