fn composition_stages(
    root: *CrustRun,
    stages: *StageSession,
    backend: *ApplicationBackend
) -> bool {
    return host_source(root, "../../stages/c/model.crs") && host_source(
        root,
        "../../stages/c/extension.crs"
    ) && host_source(root, "../../stages/reader/model.crs") && host_source(
        root,
        "../../stages/reader/extension.crs"
    ) && host_source(root, "../../stages/source/model.crs") && host_source(
        root,
        "../../stages/resources/model.crs"
    ) && host_source(root, "../../stages/resources/extension.crs") && host_source(
        root,
        "../../stages/ownership/model.crs"
    ) && host_source(root, "../../stages/ownership/extension.crs") && host_source(
        root,
        "../../stages/overload/model.crs"
    ) && host_source(root, "../../stages/overload/extension.crs") && application_load(
        stages,
        backend,
        "stages/ownership/package.crs"
    ) && application_load(stages, backend, "stages/overload/package.crs");
}
