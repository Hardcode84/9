fn generic_equal(left: *u8, right: *u8) -> bool {
    var index: usize = 0usize;
    while left[index] == right[index] {
        if left[index] == 0u8 { return true; }
        index = index + 1usize;
    }
    return false;
}

fn generic_read(root: *CrustRun, program: *GsProgram, paths: **u8, count: usize) -> bool {
    var index: usize = 0usize;
    while index < count {
        var source: *CrustSource = host_input(root, paths[index], index as u64 + 1u64);
        if source == null(*CrustSource) || !gp_read(program, source) { return false; }
        index = index + 1usize;
    }
    return gp_check(program);
}

fn generic_emit(context: *CrustContext, entry: *CrustDecl, options: *CBackendOptions) -> i32 {
    return c_backend_build(context, entry, options);
}

fn generic_output(root: *CrustRun, program: *GsProgram) -> i32 {
    var options: CBackendOptions = make CBackendOptions {
        mode: 0u32, output: host_path(root, "../../build/generics"), symbols: null(*u8),
        cflags: null(**u8), cflag_count: 0usize, ldflags: null(**u8), ldflag_count: 0usize
    };
    if (*root).argc == 1i32 {
        options.mode = 2u32;
        options.output = host_path(root, "../../build/generics.c");
        options.symbols = host_path(root, "../../build/generics.rsp");
        if options.symbols == null(*u8) { return 1i32; }
    }
    if options.output == null(*u8) { return 1i32; }
    var entry: *CrustDecl = gp_find(program, "main");
    if entry == null(*CrustDecl) { return 1i32; }
    return generic_emit(&(*program).context, entry, &options);
}

// Read the selected inputs in one module and build its main function.
fn generic_build(root: *CrustRun, paths: **u8, count: usize) -> i32 {
    if (*root).argc > 1i32 || ((*root).argc == 1i32 && !generic_equal((*root).argv[0usize], "--emit-c")) {
        crust_set_error((*root).context, (*root).source, (*root).cursor, "expected no arguments or --emit-c");
        return 1i32;
    }
    var program: GsProgram = uninit;
    gp_init(&program, null(*CrustAllocator), 100u64);
    var status: i32 = 1i32;
    if generic_read(root, &program, paths, count) { status = generic_output(root, &program); }
    if program.syntax.error_count != 0usize { crust_run_diagnostic(&program.syntax); }
    if program.context.error_count != 0usize { crust_run_diagnostic(&program.context); }
    gp_destroy(&program);
    return status;
}
