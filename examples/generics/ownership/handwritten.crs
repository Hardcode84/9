extern fn emit(code: i32) -> i32 foreign(scalar) = "putchar";
extern fn acquire_fd(fd: i32) -> i32 foreign(acquire Ticket.handle) = "dup";
extern fn close_fd(fd: i32) -> i32 foreign(move fd: Ticket.handle) = "close";

record Plain { x: i32; y: i32; }
resource Ticket { handle: i32; } owns(handle = -1i32) drop ticket_drop;
resource Parcel { ticket: Ticket; code: i32; } drop parcel_drop;

fn ticket_drop(ticket: mut Ticket) -> unit {
    if ticket.handle != -1i32 {
        var status: i32 = close_fd(move ticket.handle);
        if status != 0i32 { trap; }
        emit(70i32);
    }
}

fn parcel_drop(parcel: mut Parcel) -> unit {
    emit(parcel.code);
}

fn parcel_new(code: i32) -> Parcel {
    var handle: i32 = acquire_fd(1i32);
    if handle == -1i32 { trap; }
    var ticket: Ticket = make Ticket { handle: move handle };
    return make Parcel { ticket: move ticket, code: code };
}

fn transfer_Plain(value: Plain) -> Plain { return value; }
fn discard_Plain(value: Plain) -> unit {}
fn transfer_Parcel(value: Parcel) -> Parcel { return move value; }
fn discard_Parcel(value: Parcel) -> unit { drop value; }

fn main(argc: i32, argv: **u8) -> i32 {
    var plain: Plain = make Plain { x: 10i32, y: 20i32 };
    var copied: Plain = transfer_Plain(plain);
    discard_Plain(copied);
    var parcel: Parcel = parcel_new(72i32);
    var forwarded: Parcel = transfer_Parcel(move parcel);
    discard_Parcel(move forwarded);
    if sizeof(Plain) != sizeof(Parcel) || alignof(Plain) != alignof(Parcel) { trap; }
    domain Graph {
        var first: Owner_Plain = owner_new_Plain(plain);
        var owned: Parcel = parcel_new(65i32);
        var second: Owner_Parcel = owner_new_Parcel(move owned);
        {
            var ready: Head = uninit;
            var active: Head = uninit;
            head_init(&ready);
            head_init(&active);
            ready_insert_Plain(mut ready, read first);
            ready_insert_Parcel(mut ready, read second);
            active_insert_Plain(mut active, read first);
            active_insert_Parcel(mut active, read second);
            if head_count(read ready) != 2usize || head_count(read active) != 2usize { trap; }
            read Graph {
                var value: read Plain = owner_value_Plain(read first);
                if value.x != 10i32 || value.y != 20i32 { trap; }
            }
            edit Graph {
                var value: mut Parcel = owner_mut_Parcel(mut second);
                value.code = 66i32;
            }
            drop first;
            if head_count(read ready) != 1usize || head_count(read active) != 1usize { trap; }
            {
                var replacement: Owner_Plain = owner_new_Plain(plain);
                ready_insert_Plain(mut ready, read replacement);
                active_insert_Plain(mut active, read replacement);
                if head_count(read ready) != 2usize || head_count(read active) != 2usize { trap; }
            }
            if head_count(read ready) != 1usize || head_count(read active) != 1usize { trap; }
        }
        read Graph {
            var value: read Parcel = owner_value_Parcel(read second);
            if value.code != 66i32 { trap; }
        }
    }
    emit(79i32); emit(75i32); emit(10i32);
    return 0i32;
}
