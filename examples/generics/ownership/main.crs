host_source(run, "../../../stages/build/load.crs");
if !application_setup(run, "../../..") {
    return 1i32;
};
var stages: *StageSession = stage_open(run, "../../..", "../../../build/stage-cache");
if stages == null(*StageSession) {
    return 1i32;
};
var backend: ApplicationBackend = uninit;
if !application_backend(run, stages, &backend, c_backend_build) {
    return 1i32;
};
host_source(run, "../../../stages/generics/ownership/api.crs");
host_source(run, "../../../stages/generics/ownership/build.crs");
if !application_load(stages, &backend, "stages/generics/ownership/package.crs") {
    return 1i32;
};

var provider: *CrustSource = host_input(run, "provider.crs", 100u64);
if provider == null(*CrustSource) {
    return 1i32;
};
if (*run).argc != 0i32 {
    return ownership_generics_build(
        null(*CrustSource),
        0usize,
        (*run).argc,
        (*run).argv,
        provider,
        1usize,
        backend.emit
    );
};
var arguments: [*u8; 5] = make [*u8; 5] {
    "-o",
    host_path(run, "../../../build/generics-ownership"),
    host_path(run, "payloads.crs"),
    host_path(run, "checked.crs"),
    host_path(run, "program.crs")
};
return ownership_generics_build(
    null(*CrustSource),
    0usize,
    5i32,
    &arguments[0usize],
    provider,
    1usize,
    backend.emit
);
