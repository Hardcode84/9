fn main(argc: i32, argv: **u8) -> i32 {
    var plain: Plain = make Plain { x: 10i32, y: 20i32 };
    var copied: Plain = transfer!(Plain)(plain);
    discard!(Plain)(copied);
    var parcel: Parcel = parcel_new(72i32);
    var forwarded: Parcel = transfer!(Parcel)(move parcel);
    discard!(Parcel)(move forwarded);
    if sizeof(Plain) != sizeof(Parcel) || alignof(Plain) != alignof(Parcel) { trap; }
    domain Graph {
        var first: Owner!(Plain) = owner_new!(Plain)(plain);
        var owned: Parcel = parcel_new(65i32);
        var second: Owner!(Parcel) = owner_new!(Parcel)(move owned);
        {
            var ready: Head = uninit;
            var active: Head = uninit;
            head_init(&ready);
            head_init(&active);
            ready_insert!(Plain)(mut ready, read first);
            ready_insert!(Parcel)(mut ready, read second);
            active_insert!(Plain)(mut active, read first);
            active_insert!(Parcel)(mut active, read second);
            if head_count(read ready) != 2usize || head_count(read active) != 2usize { trap; }
            read Graph {
                var value: read Plain = owner_value!(Plain)(read first);
                if value.x != 10i32 || value.y != 20i32 { trap; }
            }
            edit Graph {
                var value: mut Parcel = owner_mut!(Parcel)(mut second);
                value.code = 66i32;
            }
            drop first;
            if head_count(read ready) != 1usize || head_count(read active) != 1usize { trap; }
            {
                var replacement: Owner!(Plain) = owner_new!(Plain)(plain);
                ready_insert!(Plain)(mut ready, read replacement);
                active_insert!(Plain)(mut active, read replacement);
                if head_count(read ready) != 2usize || head_count(read active) != 2usize { trap; }
            }
            if head_count(read ready) != 1usize || head_count(read active) != 1usize { trap; }
        }
        read Graph {
            var value: read Parcel = owner_value!(Parcel)(read second);
            if value.code != 66i32 { trap; }
        }
    }
    emit(79i32); emit(75i32); emit(10i32);
    return 0i32;
}
