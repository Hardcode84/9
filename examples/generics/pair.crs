record Pair { first: T; second: T; }

fn pair_init(pair: *Pair, first: *T, second: *T) -> unit {
    (*pair).first = *first;
    (*pair).second = *second;
}

fn exchange(left: *T, right: *T) -> unit {
    var saved: T = *left;
    *left = *right;
    *right = saved;
}

fn pair_swap(pair: *Pair) -> unit {
    exchange(&(*pair).first, &(*pair).second);
}

fn pair_first(pair: *Pair) -> *T {
    return &(*pair).first;
}
