extern fn puts(text: *u8) -> i32 = "puts";

fn main(argc: i32, argv: **u8) -> i32 {
    var position_a: Position = make Position { x: 10i64, y: 20i64 };
    var position_b: Position = make Position { x: 30i64, y: 40i64 };
    var positions: PositionPair = uninit;
    position_pair_init(&positions, &position_a, &position_b);
    position_pair_swap(&positions);
    var first: *Position = position_pair_first(&positions);
    if (*first).x != 30i64 || (*first).y != 40i64 { trap; }
    if positions.second.x != 10i64 || positions.second.y != 20i64 { trap; }
    if sizeof(PositionPair) != 2usize * sizeof(Position) { trap; }
    if alignof(PositionPair) != alignof(Position) { trap; }
    if (&positions.second as usize) - (&positions.first as usize) != sizeof(Position) { trap; }

    var sample_a: Sample = make Sample { value: 5i32, tag: 65u8 };
    var sample_b: Sample = make Sample { value: 7i32, tag: 66u8 };
    var samples: SamplePair = uninit;
    sample_pair_init(&samples, &sample_a, &sample_b);
    sample_pair_swap(&samples);
    var sample: *Sample = sample_pair_first(&samples);
    if (*sample).value != 7i32 || (*sample).tag != 66u8 { trap; }
    if samples.second.value != 5i32 || samples.second.tag != 65u8 { trap; }
    if sizeof(SamplePair) != 2usize * sizeof(Sample) { trap; }
    if alignof(SamplePair) != alignof(Sample) { trap; }
    if (&samples.second as usize) - (&samples.first as usize) != sizeof(Sample) { trap; }
    if puts("generics: OK") < 0i32 { return 1i32; }
    return 0i32;
}
