host_source(run, "../../api/crust0_stage.crs");
host_source(run, "../../stages/memory/options.crs");
host_source(run, "contract-options.crs");
host_link(run, "../../build/crust-intrusive-contract-library.so");

extern fn intrusive_contract_program(request: *CrustBuild, options: *PmOptions,
                                     names: *UnlinkContractNames) -> i32 = "intrusive_contract_program";

var contracts: [PmForeignSpec; 3] = make [PmForeignSpec; 3] {
    make PmForeignSpec { name: "allocate", alignment: 16usize, kind: PM_ALLOCATE },
    make PmForeignSpec { name: "release", alignment: 1usize, kind: PM_RELEASE },
    make PmForeignSpec { name: "emit", alignment: 1usize, kind: PM_SCALAR }
};
var options: PmOptions = make PmOptions {
    summaries: null(**u8), summary_count: 0usize,
    foreign: &contracts[0usize], foreign_count: 3usize,
    max_depth: 128usize, max_paths: 256usize, max_iterations: 8usize,
    milliseconds: 10000u32
};
var names: UnlinkContractNames = make UnlinkContractNames {
    function_name: "unlink", previous: "prev", next: "next"
};
var arguments: [*u8; 4] = make [*u8; 4] {
    "-o", host_path(run, "../../build/intrusive-contract"),
    host_path(run, "../ownership/links.crs"), host_path(run, "program.crs")
};
var context: CrustContext = uninit;
crust_context_init(&context, null(*CrustAllocator));
var request: CrustBuild = make CrustBuild {
    context: &context, source: null(*CrustSource), target_begin: 0usize,
    argc: 4i32, argv: &arguments[0usize]
};
if (*run).argc != 0i32 { request.argc = (*run).argc; request.argv = (*run).argv; };
var result: i32 = intrusive_contract_program(&request, &options, &names);
if context.error_count != 0usize { crust_run_diagnostic(&context); };
crust_context_destroy(&context);
return result;
