record UnlinkContract { previous: *CrustField; next: *CrustField; }

fn unlink_contract_effect(contract: *PmContract, user: *u8) -> unit {
    var fields: *UnlinkContract = user as *UnlinkContract;
    var run: *PfRun = (*contract).run;
    var hook: *u8 = pf_parameter(run, 0usize);
    var type: *CrustType = (*(*(*(*run).declaration).params).type).base;
    var previous: *CrustField = (*fields).previous;
    var next: *CrustField = (*fields).next;
    var p: *u8 = pm_subobject(run, hook, (*previous).offset);
    var n: *u8 = pm_subobject(run, hook, (*next).offset);
    var before: *u8 = pm_contract_read(contract, p, (*previous).type);
    var after: *u8 = pm_contract_read(contract, n, (*next).type);
    pm_contract_access(contract, hook, type, false);
    pm_contract_access(contract, before, type, false);
    pm_contract_access(contract, after, type, false);
    pm_contract_write(contract, pm_subobject(run, before, (*next).offset), (*next).type, after);
    pm_contract_write(contract, pm_subobject(run, after, (*previous).offset), (*previous).type, before);
    pm_contract_write(contract, p, (*previous).type, hook);
    pm_contract_write(contract, n, (*next).type, hook);
}

fn unlink_contract_field(stage: *PfStage, record_value: *CrustDecl, name: *u8) -> *CrustField {
    var field: *CrustField = (*record_value).fields;
    while field != null(*CrustField) {
        if c_equal((*(*field).name).text, name) {
            var type: *CrustType = (*field).type;
            if (*type).kind == CRUST_T_POINTER && (*(*type).base).kind == CRUST_T_RECORD &&
               (*(*type).base).record_decl == record_value { return field; }
            break;
        }
        field = (*field).next;
    }
    pf_error(stage, &(*record_value).loc, "unlink contract requires a pointer field to its hook record");
    return null(*CrustField);
}

fn unlink_contract_prepare(stage: *PfStage, user: *u8) -> bool {
    var names: *UnlinkContractNames = user as *UnlinkContractNames;
    var declaration: *CrustDecl = pm_lookup((*stage).status.context, (*names).function_name);
    if declaration == null(*CrustDecl) { return false; }
    if (*declaration).kind != CRUST_D_FUNCTION || (*declaration).param_count != 1usize {
        pf_error(stage, &(*declaration).loc, "unlink contract requires one hook pointer parameter");
        return false;
    }
    var type: *CrustType = (*(*declaration).params).type;
    if (*type).kind != CRUST_T_POINTER || (*(*type).base).kind != CRUST_T_RECORD {
        pf_error(stage, &(*declaration).loc, "unlink contract requires a pointer to a hook record");
        return false;
    }
    var record_value: *CrustDecl = (*(*type).base).record_decl;
    var fields: UnlinkContract = make UnlinkContract {
        previous: unlink_contract_field(stage, record_value, (*names).previous),
        next: unlink_contract_field(stage, record_value, (*names).next)
    };
    if (*stage).status.failed { return false; }
    if fields.previous == fields.next {
        pf_error(stage, &(*declaration).loc, "unlink contract requires two different link fields");
        return false;
    }
    return pm_contract_register(stage, declaration, unlink_contract_effect, &fields as *u8);
}

// Check the selected unlink body, then its complete resource client, before output.
fn intrusive_contract_program(request: *CrustBuild, options: *PmOptions, names: *UnlinkContractNames) -> i32 {
    return resource_memory_program_with(request, options, unlink_contract_prepare, names as *u8);
}
