extern fn allocate(size: usize) -> *u8 foreign(allocate) = "malloc";
extern fn release(pointer: *u8) -> unit foreign(release) = "free";
extern fn emit(code: i32) -> i32 foreign(scalar) = "putchar";
domain Graph(Data, Payload, Node, Owner, ReadyHead);
record Data { value:i64; } domain(Graph);
resource Payload { data:*Data; } owns(data: storage) domain(Graph) drop payload_drop;
record Node { prev:*Node; next:*Node; active_prev:*Node; active_next:*Node; first:Payload; second:Payload; value:i64; }
    domain(Graph)
    references(prev, next, active_prev, active_next)
    invariant((*self).prev != null(*Node) && (*self).next != null(*Node) &&
              (*(*self).prev).next == self && (*(*self).next).prev == self)
    invariant((*self).active_prev != null(*Node) && (*self).active_next != null(*Node) &&
              (*(*self).active_prev).active_next == self && (*(*self).active_next).active_prev == self);
resource Owner { node:*Node; } owns(node: storage) domain(Graph) drop owner_drop;
resource ReadyHead { node:Node; } domain(Graph) drop ready_drop;
fn payload_new(value:i64)->Payload access(reclaim,Graph) {
    var data:*Data=allocate(sizeof(Data)) as *Data;
    if data!=null(*Data) {(*data).value=value;}
    return make Payload {data:move data};
}
fn payload_drop(payload:mut Payload)->unit access(reclaim,Graph) modifies(Payload.data) {
    var data:*Data=move payload.data;
    if data!=null(*Data) {emit((*data).value as i32); release(data as *u8);}
}
fn owner_new()->Owner access(reclaim,Graph) {
    var node:*Node=allocate(sizeof(Node)) as *Node;
    if node!=null(*Node) {
        (*node).first=payload_new(65i64);
        (*node).second=payload_new(66i64);
        (*node).value=7i64;
        (*node).prev=node; (*node).next=node;
        (*node).active_prev=node; (*node).active_next=node;
    }
    return make Owner {node:move node};
}
fn owner_drop(owner:mut Owner)->unit access(reclaim,Graph) {
    var node:*Node=move owner.node;
    if node!=null(*Node) {
        edit Graph {ready_unlink(node); active_unlink(node);}
        drop *node;
        release(node as *u8);
    }
}
fn ready_drop(head:mut ReadyHead)->unit access(reclaim,Graph) {
    edit Graph {while head.node.next!=&head.node {ready_unlink(head.node.next);}
        active_unlink(&head.node);}
}
fn main(argc:i32,argv:**u8)->i32 access(reclaim,Graph) {
    var head:ReadyHead=make ReadyHead {node:make Node {
        prev:null(*Node), next:null(*Node), active_prev:null(*Node), active_next:null(*Node),
        first:make Payload {data:null(*Data)}, second:make Payload {data:null(*Data)}, value:0i64
    }};
    head.node.prev=&head.node; head.node.next=&head.node;
    head.node.active_prev=&head.node; head.node.active_next=&head.node;
    {
        var owner:Owner=owner_new();
        if owner.node==null(*Node) {return 1i32;}
        if (*owner.node).first.data==null(*Data) || (*owner.node).second.data==null(*Data) {return 1i32;}
        edit Graph {ready_insert(&head.node,owner.node);}
        read Graph {
            var cursor:*Node=head.node.next;
            if cursor==&head.node {trap;}
            var node:*Node=cursor;
            if (*node).first.data!=null(*Data) {if (*(*node).first.data).value!=65i64 {trap;}}
        }
        drop owner;
    }
    {
        var replacement:Owner=owner_new();
        if replacement.node==null(*Node) {return 1i32;}
        if (*replacement.node).first.data==null(*Data) || (*replacement.node).second.data==null(*Data) {return 1i32;}
        edit Graph {ready_insert(&head.node,replacement.node);}
    }
    emit(79i32);emit(75i32);emit(10i32);
    return 0i32;
}
