fn ready_unlink(node: *Node) -> unit access(edit, Graph)
    modifies(Node.prev, Node.next)
    requires(node != null(*Node))
    ensures((*node).prev == node && (*node).next == node) {
    var before: *Node = (*node).prev;
    var after: *Node = (*node).next;
    (*before).next = after;
    (*after).prev = before;
    (*node).prev = node;
    (*node).next = node;
}

fn ready_insert(at: *Node, node: *Node) -> unit access(edit, Graph)
    modifies(Node.prev, Node.next)
    requires(at != null(*Node) && node != null(*Node))
    ensures(at == node || (*at).next == node) {
    if at == node { return; }
    ready_unlink(node);
    var after: *Node = (*at).next;
    (*node).prev = at;
    (*node).next = after;
    (*after).prev = node;
    (*at).next = node;
}

fn active_unlink(node: *Node) -> unit access(edit, Graph)
    modifies(Node.active_prev, Node.active_next)
    requires(node != null(*Node))
    ensures((*node).active_prev == node && (*node).active_next == node) {
    var before: *Node = (*node).active_prev;
    var after: *Node = (*node).active_next;
    (*before).active_next = after;
    (*after).active_prev = before;
    (*node).active_prev = node;
    (*node).active_next = node;
}

fn active_insert(at: *Node, node: *Node) -> unit access(edit, Graph)
    modifies(Node.active_prev, Node.active_next)
    requires(at != null(*Node) && node != null(*Node))
    ensures(at == node || (*at).active_next == node) {
    if at == node { return; }
    active_unlink(node);
    var after: *Node = (*at).active_next;
    (*node).active_prev = at;
    (*node).active_next = after;
    (*after).active_prev = node;
    (*at).active_next = node;
}
