extern fn alloc(size: usize, alignment: usize) -> *u8 = "crust0_host_alloc";
extern fn free(data: *u8) -> unit = "crust0_host_free";
extern fn write(stream: u32, data: *u8, size: usize) -> i32 = "crust0_host_write_stream";

record Hook {
    prev: *Hook;
    next: *Hook;
}

record Node {
    value: u64;
    hook: Hook;
}

fn init(h: *Hook) -> unit {
    (*h).prev = h;
    (*h).next = h;
}

fn insert_after(at: *Hook, h: *Hook) -> unit {
    var next: *Hook = (*at).next;
    (*h).prev = at;
    (*h).next = next;
    (*next).prev = h;
    (*at).next = h;
}

fn unlink(h: *Hook) -> unit {
    var before: *Hook = (*h).prev;
    var after: *Hook = (*h).next;
    (*before).next = after;
    (*after).prev = before;
    init(h);
}

fn node_of(h: *Hook) -> *Node {
    return (h as *u8 - (offsetof(Node, hook) as isize)) as *Node;
}

fn main(argc: i32, argv: **u8) -> i32 {
    var head: Hook = uninit;
    init(&head);
    var first: *Node = alloc(sizeof(Node), alignof(Node)) as *Node;
    if first == null(*Node) {
        return 1i32;
    }
    var second: *Node = alloc(sizeof(Node), alignof(Node)) as *Node;
    if second == null(*Node) {
        free(first as *u8);
        return 2i32;
    }
    (*first).value = 11u64;
    (*second).value = 22u64;
    init(&(*first).hook);
    init(&(*second).hook);
    insert_after(&head, &(*first).hook);
    insert_after(&(*first).hook, &(*second).hook);
    unlink(&(*first).hook);
    free(first as *u8);
    var found: *Node = node_of(head.next);
    if found != second || (*found).value != 22u64 {
        return 3i32;
    }
    if head.prev != &(*second).hook || (*second).hook.prev != &head {
        return 4i32;
    }
    first = alloc(sizeof(Node), alignof(Node)) as *Node;
    if first == null(*Node) {
        unlink(&(*second).hook);
        free(second as *u8);
        return 5i32;
    }
    (*first).value = 33u64;
    init(&(*first).hook);
    insert_after(&head, &(*first).hook);
    unlink(&(*second).hook);
    free(second as *u8);
    found = node_of(head.next);
    if found != first || (*found).value != 33u64 || head.prev != &(*first).hook {
        return 6i32;
    }
    unlink(&(*first).hook);
    free(first as *u8);
    if head.next != &head || head.prev != &head {
        return 7i32;
    }
    if write(1u32, "intrusive: ok\n", 14usize) != 0i32 {
        return 8i32;
    }
    return 0i32;
}
