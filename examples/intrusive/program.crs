fn main(argc: i32, argv: **u8) -> i32 {
    domain Graph {
        var first: Owner = owner_new(65i64);
        var second: Owner = owner_new(66i64);
        {
            var ready: ReadyHead = uninit;
            var active: ActiveHead = uninit;
            ready_init(&ready);
            active_init(&active);
            edit Graph {
                ready_insert(mut ready, read first);
                ready_insert(mut ready, read second);
                active_insert(mut active, read first);
                active_insert(mut active, read second);
            }
            var ready_total: usize = ready_count(read ready);
            var active_total: usize = active_count(read active);
            if ready_total != 2usize || active_total != 2usize { trap; }
            read Graph {
                var cursor: Cursor = ready_first(read ready);
                var end: Cursor = ready_end(read ready);
                var count: usize = 0usize;
                var done: bool = cursor_equal(read cursor, read end);
                while !done {
                    { var value: read i64 = cursor_value(read cursor);
                      if value < 65i64 || value > 66i64 { trap; } }
                    count = count + 1usize;
                    cursor_advance(mut cursor);
                    done = cursor_equal(read cursor, read end);
                }
                if count != 2usize { trap; }
            }
            drop first;
            ready_total = ready_count(read ready);
            active_total = active_count(read active);
            if ready_total != 1usize || active_total != 1usize { trap; }
            {
                var replacement: Owner = owner_new(67i64);
                edit Graph {
                    ready_insert(mut ready, read replacement);
                    active_insert(mut active, read replacement);
                }
            }
            ready_total = ready_count(read ready);
            if ready_total != 1usize { trap; }
            edit Graph {
                var cursor: Cursor = ready_first(read ready);
                var value: mut i64 = cursor_mut(mut cursor);
                value = 68i64;
            }
        }
        read Graph {
            var value: read i64 = owner_value(read second);
            if value != 68i64 { trap; }
        }
    }
    emit(79i32); emit(75i32); emit(10i32);
    return 0i32;
}
