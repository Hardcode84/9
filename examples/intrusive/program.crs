extern fn allocate(size: usize) -> *u8 foreign(allocate) = "malloc";
extern fn release(pointer: *u8) -> unit foreign(release) = "free";
extern fn emit(code: i32) -> i32 foreign(scalar) = "putchar";

record Node { ready: Hook; active: Hook; value: i64; }
    members(ready, active) domain(Graph);
resource Owner { node: *Node; } owns(node) domain(Graph) drop owner_drop;
resource ReadyHead { hook: Hook; } anchor(hook, Node.ready) domain(Graph) drop ready_drop;
resource ActiveHead { hook: Hook; } anchor(hook, Node.active) domain(Graph) drop active_drop;

fn owner_new(value: i64) -> Owner access(reclaim, Graph) {
    var node: *Node = allocate(sizeof(Node)) as *Node;
    if node != null(*Node) {
        (*node).value = value;
        hook_init(&(*node).ready);
        hook_init(&(*node).active);
    }
    return make Owner { node: move node };
}

fn owner_drop(owner: mut Owner) -> unit access(reclaim, Graph) {
    var node: *Node = move owner.node;
    if node != null(*Node) {
        edit Graph {
            unlink(&(*node).ready);
            unlink(&(*node).active);
        }
        release(node as *u8);
    }
}

fn ready_drop(head: mut ReadyHead) -> unit access(reclaim, Graph) {
    edit Graph {
        while head.hook.next != &head.hook { unlink(head.hook.next); }
    }
}

fn active_drop(head: mut ActiveHead) -> unit access(reclaim, Graph) {
    edit Graph {
        while head.hook.next != &head.hook { unlink(head.hook.next); }
    }
}

fn ready_count(head: read ReadyHead) -> usize access(read, Graph) {
    read Graph {
        var count: usize = 0usize;
        var cursor: *Hook = head.hook.next;
        while cursor != &head.hook {
            var node: *Node = parent(Node.ready, cursor);
            if (*node).value < 0i64 { trap; }
            count = count + 1usize;
            cursor = (*cursor).next;
        }
        return count;
    }
}

fn active_count(head: read ActiveHead) -> usize access(read, Graph) {
    read Graph {
        var count: usize = 0usize;
        var cursor: *Hook = head.hook.prev;
        while cursor != &head.hook {
            var node: *Node = parent(Node.active, cursor);
            if (*node).value < 0i64 { trap; }
            count = count + 1usize;
            cursor = (*cursor).prev;
        }
        return count;
    }
}

fn node_view(owner: read Owner) -> read Node access(read, Graph) from owner.node {
    if owner.node == null(*Node) { trap; }
    return read *owner.node;
}

fn value_view(node: read Node) -> read i64 access(read, Graph) from node.value {
    return read node.value;
}

fn value_mut(node: mut Node) -> mut i64 access(edit, Graph) from node.value {
    return mut node.value;
}

fn increment(node: mut Node) -> unit access(edit, Graph) {
    node.value = node.value + 1i64;
}

fn first_hook(head: read ReadyHead) -> read Hook access(read, Graph) from head.hook.next {
    return read *head.hook.next;
}

fn first_node(head: read ReadyHead) -> read Node access(read, Graph) from head.hook.next {
    var cursor: *Hook = head.hook.next;
    if cursor == &head.hook { trap; }
    return read *parent(Node.ready, cursor);
}

fn main(argc: i32, argv: **u8) -> i32 access(reclaim, Graph) {
    var first: Owner = owner_new(65i64);
    var second: Owner = owner_new(66i64);
    if first.node == null(*Node) || second.node == null(*Node) { return 1i32; }
    {
        var ready: ReadyHead = make ReadyHead { hook: make Hook { prev: null(*Hook), next: null(*Hook) } };
        var active: ActiveHead = make ActiveHead { hook: make Hook { prev: null(*Hook), next: null(*Hook) } };
        // Set self-links after each head reaches its final address.
        hook_init(&ready.hook);
        hook_init(&active.hook);
        var empty: usize = ready_count(read ready);
        if empty != 0usize { trap; }
        edit Graph {
            insert_after(&ready.hook, &(*first.node).ready);
            insert_after(&(*first.node).ready, &(*second.node).ready);
            insert_after(&active.hook, &(*first.node).active);
            insert_after(&(*first.node).active, &(*second.node).active);
        }
        var ready_total: usize = ready_count(read ready);
        var active_total: usize = active_count(read active);
        if ready_total != 2usize || active_total != 2usize { trap; }
        read Graph {
            var begin: read Hook = first_hook(read ready);
            var cursor: *Hook = &begin;
            if cursor == &ready.hook { trap; }
            var node: read Node = first_node(read ready);
            if node.value != 65i64 { trap; }
        }
        { var early: Owner = move first; }
        read Graph {
            if ready.hook.next != &(*second.node).ready || active.hook.next != &(*second.node).active { trap; }
            var ready_cursor: *Hook = ready.hook.next;
            var active_cursor: *Hook = active.hook.next;
            if ready_cursor == &ready.hook || active_cursor == &active.hook { trap; }
            var from_ready: *Node = parent(Node.ready, ready_cursor);
            var from_active: *Node = parent(Node.active, active_cursor);
            if (*from_ready).value != 66i64 || (*from_active).value != 66i64 { trap; }
        }
        ready_total = ready_count(read ready);
        active_total = active_count(read active);
        if ready_total != 1usize || active_total != 1usize { trap; }
        // Reuse allocation independently while the heads and second owner remain live.
        {
            var replacement: Owner = owner_new(67i64);
            if replacement.node == null(*Node) { return 1i32; }
            edit Graph {
                insert_after(&ready.hook, &(*replacement.node).ready);
                insert_after(&active.hook, &(*replacement.node).active);
            }
        }
    }
    read Graph {
        if (*second.node).ready.next != &(*second.node).ready || (*second.node).active.prev != &(*second.node).active { trap; }
        if (*second.node).value != 66i64 { trap; }
    }
    edit Graph {
        increment(mut *second.node);
        var value: mut i64 = value_mut(mut *second.node);
        value = 66i64;
    }
    read Graph {
        var node: read Node = node_view(read second);
        var value: read i64 = value_view(read node);
        if value != 66i64 { trap; }
    }
    emit(79i32);
    emit(75i32);
    emit(10i32);
    return 0i32;
}
