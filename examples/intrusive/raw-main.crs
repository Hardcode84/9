host_source(run, "../../stages/build/load.crs");
if !application_setup(run, "../..") {
    return 1i32;
};
var stages: *StageSession = stage_open(run, "../..", "../../build/stage-cache");
if stages == null(*StageSession) {
    return 1i32;
};
var backend: ApplicationBackend = uninit;
if !application_backend(run, stages, &backend, c_backend_build) {
    return 1i32;
};

var target: *CrustSource = host_input(run, "raw.crs", 1u64);
if (*run).argc != 0i32 {
    return c_build(target, 0usize, (*run).argc, (*run).argv, backend.emit);
};
var arguments: [*u8; 4] = uninit;
arguments[0usize] = "-o";
arguments[1usize] = host_path(run, "../../build/intrusive-raw");
arguments[2usize] = "--ldflag";
arguments[3usize] = host_path(run, "../../build/libcrust0_host.a");
return c_build(target, 0usize, 4i32, &arguments[0usize], backend.emit);
