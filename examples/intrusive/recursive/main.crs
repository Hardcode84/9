var arguments: [*u8; 4] = make [*u8; 4] {
    "-o", host_path(run, "../../../build/intrusive-recursive"),
    host_path(run, "../links.crs"), host_path(run, "program.crs")
};
return ownership_build((*run).source, (*run).cursor, 4i32, &arguments[0usize]);
