host_source(run, "../../api/crust0_stage.crs");
host_source(run, "../../stages/memory/options.crs");
host_source(run, "walk-options.crs");
host_link(run, "../../build/crust-intrusive-walk-library.so");

extern fn intrusive_walk_program(request: *CrustBuild, options: *PmOptions,
                                     names: *WalkNames) -> i32 = "intrusive_walk_program";

var contract: PmForeignSpec = make PmForeignSpec { name: "emit", alignment: 1usize, kind: PM_SCALAR };
var summarized: *u8 = "unlink";
var options: PmOptions = make PmOptions {
    summaries: &summarized, summary_count: 1usize,
    foreign: &contract, foreign_count: 1usize,
    max_depth: 128usize, max_paths: 256usize, max_iterations: 8usize,
    milliseconds: 10000u32
};
var names: WalkNames = make WalkNames {
    function_name: "walk", next: "next"
};
var arguments: [*u8; 4] = make [*u8; 4] {
    "-o", host_path(run, "../../build/intrusive-walk"),
    host_path(run, "../ownership/links.crs"), host_path(run, "walk.crs")
};
var context: CrustContext = uninit;
crust_context_init(&context, null(*CrustAllocator));
var request: CrustBuild = make CrustBuild {
    context: &context, source: null(*CrustSource), target_begin: 0usize,
    argc: 4i32, argv: &arguments[0usize]
};
if (*run).argc != 0i32 { request.argc = (*run).argc; request.argv = (*run).argv; };
var result: i32 = intrusive_walk_program(&request, &options, &names);
if context.error_count != 0usize { crust_run_diagnostic(&context); };
crust_context_destroy(&context);
return result;
