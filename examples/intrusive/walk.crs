extern fn emit(code: i32) -> i32 = "putchar";

resource Detach { hook: *Hook; } drop detach;

fn detach(value: mut Detach) -> unit {
    unlink(value.hook);
}

fn walk(cursor: *Hook, remaining: usize) -> *Hook {
    while remaining != 0usize {
        cursor = (*cursor).next;
        remaining = remaining - 1usize;
    }
    return cursor;
}

fn main(argc: i32, argv: **u8) -> i32 {
    var count: usize = 1000usize + argc as usize;
    var head: Hook = uninit;
    hook_init(&head);
    {
        var node: Hook = uninit;
        hook_init(&node);
        var cleanup: Detach = make Detach { hook: &node };
        insert_after(&head, &node);
        var reached: *Hook = walk(&head, count);
        if reached != &head && reached != &node { trap; }
        if head.next != &node || node.prev != &head { trap; }
    }
    var again: *Hook = walk(&head, count);
    if again != &head { trap; }
    // The resource detaches node before its storage expires.
    if head.next != &head || head.prev != &head { trap; }
    emit(79i32);
    emit(75i32);
    emit(10i32);
    return 0i32;
}
