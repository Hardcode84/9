// SPDX-License-Identifier: Apache-2.0

host_source(run, "../../stages/build/load.crs");
if !application_setup(run, "../..") {
    return 1i32;
};
var stages: *StageSession = stage_open(run, "../..", "../../build/stage-cache");
if stages == null(*StageSession) {
    return 1i32;
};
var backend: ApplicationBackend = uninit;
if !application_backend(run, stages, &backend, c_backend_build) {
    return 1i32;
};

var target: *CrustSource = host_input(run, "program.crs", 1u64);
var arguments: [*u8; 3] = make [*u8; 3] {
    "-o",
    host_path(run, "../../build/multiple-files"),
    host_path(run, "greeting.crs")
};
return c_build(target, 0usize, 3i32, &arguments[0usize], backend.emit);
