host_source(run, "../../../api/crust0_stage.crs");
host_source(run, "../../../stages/overload/api.crs");
host_link(run, "../../../build/crust-overload-library.so");

var arguments:[*u8;2] = make [*u8;2] {
    "-o", host_path(run, "../../../build/overload-hello")
};
return overload_build((*run).source, (*run).cursor, 2i32, &arguments[0usize]);

extern fn native_puts(text:*u8)->i32 = "puts";

fn hello(text:*u8)->i32 {
    if native_puts(text) < 0i32 { return 1i32; }
    return 0i32;
}

fn hello(count:u32)->i32 {
    var index:u32 = 0u32;
    while index < count {
        if hello("Hello, overloads!") != 0i32 { return 1i32; }
        index = index + 1u32;
    }
    return 0i32;
}

fn main(argc:i32, argv:**u8)->i32 {
    var say:fn(*u8)->i32 = hello;
    if say("A typed function value.") != 0i32 { return 1i32; }
    return hello(1u32);
}
