host_source(run, "../../../api/crust0_stage.crs");
host_source(run, "../../../stages/overload/resource_api.crs");
host_link(run, "../../../build/crust-overload-resource-library.so");

var arguments:[*u8;2] = make [*u8;2] {
    "-o", host_path(run, "../../../build/overload-resources")
};
return overload_resource_build((*run).source, (*run).cursor, 2i32, &arguments[0usize]);

extern fn native_dup(descriptor:i32)->i32 = "dup";
extern fn native_close(descriptor:i32)->i32 = "close";
extern fn native_strdup(text:*u8)->*u8 = "strdup";
extern fn native_free(bytes:*u8)->unit = "free";
extern fn native_write(descriptor:i32, bytes:*u8, size:usize)->isize = "write";
extern fn native_exit(status:i32)->unit = "exit";

resource Output { descriptor:i32; } drop release;
resource Text { bytes:*u8; } drop release;

fn open_output()->Output {
    unsafe {
        var descriptor:i32 = native_dup(1i32);
        if descriptor < 0i32 { native_exit(1i32); trap; }
        return make Output { descriptor:descriptor };
    }
}

fn make_text()->Text {
    unsafe {
        var bytes:*u8 = native_strdup("Owned overloads.\n");
        if bytes == null(*u8) { native_exit(1i32); trap; }
        return make Text { bytes:bytes };
    }
}

fn release(output:mut Output)->unit {
    unsafe {
        if native_close(output.descriptor) != 0i32 { native_exit(2i32); trap; }
    }
}

fn release(text:mut Text)->unit {
    unsafe { native_free(text.bytes); }
}

fn write(output:mut Output, text:*u8)->unit {
    unsafe {
        var size:usize = 0usize;
        while text[size] != 0u8 { size = size + 1usize; }
        var offset:usize = 0usize;
        while offset < size {
            var count:isize = native_write(output.descriptor, text + (offset as isize), size - offset);
            if count <= 0isize { native_exit(1i32); trap; }
            offset = offset + (count as usize);
        }
    }
}

fn write(output:mut Output, text:read Text)->unit {
    unsafe { write(mut output, text.bytes); }
}

fn main(argc:i32, argv:**u8)->i32 {
    var output:Output = open_output();
    var first:Text = make_text();
    var text:Text = move first;
    write(mut output, read text);
    defer write(mut output, "Deferred overload.\n");
    return 0i32;
}
