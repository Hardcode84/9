host_source(run, "../../../api/crust0_stage.crs");
host_source(run, "../../../stages/overload/api.crs");
host_link(run, "../../../build/crust-overload-library.so");

var provider:*CrustSource = host_input(run, "provider.crs", 1u64);
var object:*u8 = host_path(run, "../../../build/overload-format.o");
var interface:*u8 = host_path(run, "interface.crs");
var provider_arguments:[*u8;5] = make [*u8;5] {
    "--library", "--object", "-o", object, interface
};
var status:i32 = overload_build(provider, 0usize, 5i32, &provider_arguments[0usize]);
if status != 0i32 { return status; };

var arguments:[*u8;5] = make [*u8;5] {
    "-o", host_path(run, "../../../build/overload-separate"),
    interface, "--ldflag", object
};
return overload_build((*run).source, (*run).cursor, 5i32, &arguments[0usize]);

fn main(argc:i32, argv:**u8)->i32 {
    var output:Output = make Output { descriptor:1i32 };
    if format(&output, "types: ") != 0i32 { return 1i32; }
    if format(&output, 42u64) != 0i32 { return 1i32; }
    return format(&output, "\n");
}
