extern fn allocate(size: usize) -> *u8 foreign(allocate) = "malloc";
extern fn release(pointer: *u8) -> unit foreign(release) = "free";
extern fn emit(code: i32) -> i32 foreign(scalar) = "putchar";

record Cell { value: i64; }
resource CellOwner { cell: *Cell; } owns(cell: storage) drop cell_drop;

fn cell_new(value: i64) -> CellOwner {
    var cell: *Cell = allocate(sizeof(Cell)) as *Cell;
    if cell != null(*Cell) { (*cell).value = value; }
    return make CellOwner { cell: move cell };
}

fn cell_drop(owner: mut CellOwner) -> unit {
    var cell: *Cell = move owner.cell;
    if cell != null(*Cell) { release(cell as *u8); }
}

fn cell_view(owner: read CellOwner) -> read Cell from owner.cell {
    if owner.cell == null(*Cell) { trap; }
    return read *owner.cell;
}

fn main(argc: i32, argv: **u8) -> i32 {
    var owner: CellOwner = cell_new(65i64);
    if owner.cell == null(*Cell) { return 1i32; }
    var other: CellOwner = cell_new(67i64);
    if other.cell == null(*Cell) { return 1i32; }
    var first: read Cell = cell_view(read owner);
    drop other;
    var first_result: i32 = emit(first.value as i32);
    if first_result < 0i32 { return 1i32; }
    drop first;
    drop owner;
    var replacement: CellOwner = cell_new(66i64);
    if replacement.cell == null(*Cell) { return 1i32; }
    var second: read Cell = cell_view(read replacement);
    var second_result: i32 = emit(second.value as i32);
    if second_result < 0i32 { return 1i32; }
    drop second;
    var result: i32 = emit(10i32);
    if result < 0i32 { return 1i32; }
    return 0i32;
}
