// SPDX-License-Identifier: Apache-2.0

record Reading { value: read i64; tag: i32; }
record Editing { value: mut i64; }
record Wrapped { reading: Reading; }
record Meter { value: i64; }
record MeterView { meter: read Meter; }
record Comparison { actual: read i64; expected: read i64; }

extern fn emit(value: i32) -> i32 foreign(scalar) = "putchar";

fn reading_new(value: read i64) -> Reading from value {
    return make Reading { value: read value, tag: 7i32 };
}

fn reading_get(view: read Reading) -> i64 { return view.value; }

fn reading_value(view: read Reading) -> read i64 from view.value {
    return read view.value;
}

fn reading_again(view: read Reading) -> Reading from view.value {
    return make Reading { value: read view.value, tag: view.tag };
}

fn editing_new(value: mut i64) -> Editing from value {
    return make Editing { value: mut value };
}

fn editing_set(view: mut Editing, value: i64) -> unit { view.value = value; }

fn editing_consume(view: Editing) -> unit { view.value = 19i64; }

fn editing_read(view: read Editing) -> read i64 from view.value {
    return read view.value;
}

fn editing_mut(view: mut Editing) -> mut i64 from view.value {
    return mut view.value;
}

fn meter_view(meter: read Meter) -> MeterView from meter {
    return make MeterView { meter: read meter };
}

fn meter_get(view: read MeterView) -> i64 { return view.meter.value; }

fn comparison_equal(pair: read Comparison) -> bool { return pair.actual == pair.expected; }

fn main(argc: i32, argv: **u8) -> i32 {
    var count: i64 = 42i64;
    {
        var view: Reading = reading_new(read count);
        var answer: i64 = reading_get(read view);
        if answer != 42i64 || view.tag != 7i32 { trap; }
        var value: read i64 = reading_value(read view);
        if value != 42i64 { trap; }
        var again: Reading = reading_again(read view);
        if again.value != 42i64 { trap; }
    }
    {
        var view: Editing = editing_new(mut count);
        editing_set(mut view, 73i64);
        { var value: read i64 = editing_read(read view); if value != 73i64 { trap; } }
        { var value: mut i64 = editing_mut(mut view); value = 83i64; }
        var moved: Editing = move view;
        if moved.value != 83i64 { trap; }
        editing_consume(move moved);
        count = 7i64;
    }
    {
        var view: Editing = editing_new(mut count);
        view.value = 9i64;
        drop view;
        count = 11i64;
    }
    {
        var wrapped: Wrapped = make Wrapped {
            reading: make Reading { value: read count, tag: 3i32 }
        };
        if wrapped.reading.value != 11i64 { trap; }
    }
    var meter: Meter = make Meter { value: 5i64 };
    {
        var view: MeterView = meter_view(read meter);
        var value: i64 = meter_get(read view);
        if value != 5i64 { trap; }
    }
    meter.value = 6i64;
    {
        var view: MeterView = uninit;
        view = meter_view(read meter);
        if argc > 0i32 { drop view; } else { drop view; }
        meter.value = 7i64;
    }
    if sizeof(Editing) != sizeof(*i64) || sizeof(MeterView) != sizeof(*Meter) { trap; }
    var expected: i64 = 11i64;
    {
        // Independent results can be combined locally without a result-origin map.
        var actual: Reading = reading_new(read count);
        var reference: Reading = reading_new(read expected);
        var pair: Comparison = make Comparison { actual: read actual.value, expected: read reference.value };
        var equal: bool = comparison_equal(read pair);
        if !equal { trap; }
    }
    {
        var view: Reading = reading_new(read count);
        drop view;
        view = reading_new(read expected);
        count = 12i64;
        if view.value != 11i64 { trap; }
        drop view;
        expected = 13i64;
    }
    emit(79i32); emit(75i32); emit(10i32);
    return 0i32;
}
