// SPDX-License-Identifier: Apache-2.0

record Comparison { actual: read i64; expected: read i64; }

fn comparison_equal(pair: read Comparison) -> bool {
    return pair.actual == pair.expected;
}

fn expect_alias(index: read Index, key: i64, expected: read i64) -> unit access(read, Symbols) {
    var selection: Selection = index_select(read index, key);
    var present: bool = selection_present(read selection);
    if !present { trap; }
    var value: read i64 = selection_value(read selection);
    var pair: Comparison = make Comparison { actual: read value, expected: read expected };
    var equal: bool = comparison_equal(read pair);
    if !equal { trap; }
}

fn expect_unbound(index: read Index, key: i64) -> unit access(read, Symbols) {
    var selection: Selection = index_select(read index, key);
    var present: bool = selection_present(read selection);
    if present { trap; }
}

fn remove_required(index: mut Index, key: i64) -> unit access(reclaim, Symbols) {
    var removed: bool = index_remove(mut index, key);
    if !removed { trap; }
}

fn main(argc: i32, argv: **u8) -> i32 {
    domain Symbols {
        var index: Index = index_new();
        index_insert(mut index, 1i64, 41i64);
        index_insert(mut index, 2i64, 42i64);
        index_alias(mut index, 10i64, 1i64);
        index_alias(mut index, 11i64, 1i64);
        index_alias(mut index, 20i64, 2i64);
        var expected: i64 = 41i64;
        read Symbols {
            expect_alias(read index, 10i64, read expected);
            expect_alias(read index, 11i64, read expected);
        }
        remove_required(mut index, 1i64);
        expected = 42i64;
        read Symbols {
            expect_unbound(read index, 10i64);
            expect_unbound(read index, 11i64);
            expect_alias(read index, 20i64, read expected);
        }
        // Reuse of the key or allocation must not revive the old aliases.
        index_insert(mut index, 1i64, 43i64);
        read Symbols { expect_unbound(read index, 10i64); expect_unbound(read index, 11i64); }
        edit Symbols {
            // A selection keeps the old target while the alias changes.
            var old: Selection = index_select(read index, 20i64);
            var bound: bool = index_bind(mut index, 20i64, 1i64);
            if !bound { trap; }
            var value: read i64 = selection_value(read old);
            if value != 42i64 { trap; }
        }
        expected = 43i64;
        read Symbols { expect_alias(read index, 20i64, read expected); }
        remove_required(mut index, 2i64);
        read Symbols { expect_alias(read index, 20i64, read expected); }
        remove_required(mut index, 1i64);
        var removed: bool = index_remove(mut index, 1i64);
        if removed { trap; }
        read Symbols { expect_unbound(read index, 20i64); }
        // Leave live entries for automatic cleanup. The loop size is a runtime value.
        var key: i64 = 0i64;
        var count: i64 = argc as i64 + 16i64;
        while key < count {
            index_insert(mut index, key, key);
            index_alias(mut index, key + 100i64, key);
            key = key + 1i64;
        }
        expected = count - 1i64;
        read Symbols { expect_alias(read index, count + 99i64, read expected); }
    }
    emit(79i32); emit(75i32); emit(10i32);
    return 0i32;
}
