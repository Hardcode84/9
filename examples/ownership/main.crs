host_source(run, "../../api/crust0_stage.crs");
host_source(run, "../../stages/memory/options.crs");
host_source(run, "../../stages/memory/api.crs");
host_source(run, "../../stages/memory/build.crs");
host_link(run, "../../build/crust-memory-library.so");

var contracts: [PmForeignSpec; 3] = make [PmForeignSpec; 3] {
    make PmForeignSpec { name: "allocate", alignment: 16usize, kind: PM_ALLOCATE },
    make PmForeignSpec { name: "release", alignment: 1usize, kind: PM_RELEASE },
    make PmForeignSpec { name: "emit", alignment: 1usize, kind: PM_SCALAR }
};
var options: PmOptions = make PmOptions {
    summaries: null(**u8), summary_count: 0usize,
    foreign: &contracts[0usize], foreign_count: 3usize,
    max_depth: 128usize, max_paths: 256usize, max_iterations: 8usize,
    milliseconds: 10000u32
};
var arguments: [*u8; 4] = make [*u8; 4] {
    "-o", host_path(run, "../../build/ownership"),
    host_path(run, "links.crs"), host_path(run, "program.crs")
};
return memory_build((*run).source, (*run).cursor, 4i32, &arguments[0usize], &options);
