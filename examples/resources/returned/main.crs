host_source(run, "../../../api/crust0_stage.crs");
host_source(run, "../../../stages/resources/api.crs");
host_link(run, "../../../build/crust-resource-library.so");

var arguments:[*u8;2] = make [*u8;2] {
    "-o", host_path(run, "../../../build/resource-returned")
};
return resource_build((*run).source, (*run).cursor, 2i32, &arguments[0usize]);

// The resource stage reads the remainder of this file.
extern fn native_putchar(value:i32)->i32 = "putchar";

record Counter { value:i32; }

fn current(counter:read Counter)->read i32 from counter {
    return read counter.value;
}

fn update(counter:mut Counter)->mut i32 from counter {
    return mut counter.value;
}

fn print_number(value:read i32)->unit {
    unsafe {
        if native_putchar(value / 10i32 + 48i32) < 0i32 { trap; }
        if native_putchar(value % 10i32 + 48i32) < 0i32 { trap; }
        if native_putchar(10i32) < 0i32 { trap; }
    }
}

fn main(argc:i32, argv:**u8)->i32 {
    var counter:Counter = make Counter { value:41i32 };
    {
        var before:read i32 = current(read counter);
        if before != 41i32 { return 1i32; }
    }
    {
        var value:mut i32 = update(mut counter);
        value = 42i32;
    }
    print_number(current(read counter));
    return 0i32;
}
