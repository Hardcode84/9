var capacity:usize = ((*run).argc as usize) + 12usize;
var arguments:**u8 = crust_try_alloc((*run).context, capacity * sizeof(*u8), alignof(*u8)) as **u8;
if arguments == null(**u8) { return 1i32; };
arguments[0usize] = host_path(run, "library.crs");
