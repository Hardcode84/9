// SPDX-License-Identifier: Apache-2.0

host_source(run, "../../stages/build/load.crs");
if !application_setup(run, "../..") {
    return 1i32;
};
var stages: *StageSession = stage_open(run, "../..", "../../build/stage-cache");
if stages == null(*StageSession) {
    return 1i32;
};
var backend: ApplicationBackend = uninit;
if !application_backend(run, stages, &backend, c_backend_build) {
    return 1i32;
};
host_source(run, "../../stages/union/api.crs");
host_source(run, "../../stages/union/build.crs");
if !application_load(stages, &backend, "stages/union/package.crs") {
    return 1i32;
};

var arguments: [*u8; 3] = make [*u8; 3] {
    "-o",
    host_path(run, "../../build/union"),
    host_path(run, "program.crs")
};
return union_build(
    null(*CrustSource),
    0usize,
    3i32,
    &arguments[0usize],
    backend.emit
);
