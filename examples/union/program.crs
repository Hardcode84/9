// SPDX-License-Identifier: Apache-2.0

record Position { x: i64; y: i64; }

union Event {
    Move: Position;
    Key: u32;
    Quit: unit;
}

extern fn puts(text: *u8) -> i32 = "puts";

fn handle(event: *Event) -> i32 {
    match Event(*event) {
        Move(position) {
            if position.x != 10i64 || position.y != 20i64 { return 1i32; }
            return 0i32;
        }
        Key(code) {
            if code != 65u32 { return 2i32; }
            return 0i32;
        }
        Quit { return 0i32; }
    }
}

fn main(argc: i32, argv: **u8) -> i32 {
    var event: Event = uninit;
    construct Event.Move(event, make Position { x: 10i64, y: 20i64 });
    if handle(&event) != 0i32 { return 1i32; }
    construct Event.Key(event, 65u32);
    if handle(&event) != 0i32 { return 2i32; }
    construct Event.Quit(event);
    if handle(&event) != 0i32 { return 3i32; }
    if puts("union: OK") < 0i32 { return 4i32; }
    return 0i32;
}
