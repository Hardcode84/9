extern fn asm_close(stream: *u8) -> i32 = "fclose";

// Emit assembly and a symbol map for captured raw Crust sources.
fn asm_stage_compile(request: *StageCompile) -> bool {
    var context: *CrustContext = request -> context;
    if request -> options.count != 0usize {
        return native_error(context, "ASM package compiler accepts no source options");
    }
    if !stage_read_sources(context, &request -> sources) || !stage_names(
        request -> exports,
        context
    ) {
        return false;
    }
    var stream: *u8 = asm_open(context, request -> output);
    if stream == null(*u8) {
        return native_error(context, "cannot open package assembly output");
    }
    var success: bool = crust_x64_emit(context, stream, null(*CrustDecl));
    if asm_close(stream) != 0i32 {
        return native_error(context, "cannot close package assembly output");
    }
    return success && cache_save(context, request -> symbols, "", 0usize);
}
