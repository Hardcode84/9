fn crust_x64_try_emit_expression(emitter: *CrustX64Emitter, expression: *CrustExpr) -> bool {
    (*emitter).failed = false;
    x64_default_expression(emitter, expression);
    return !(*emitter).failed;
}
fn crust_x64_try_emit_place(emitter: *CrustX64Emitter, expression: *CrustExpr) -> bool {
    (*emitter).failed = false;
    x64_default_place(emitter, expression);
    return !(*emitter).failed;
}
fn crust_x64_try_emit_statement(emitter: *CrustX64Emitter, statement: *CrustStmt) -> bool {
    (*emitter).failed = false;
    x64_default_statement(emitter, statement);
    return !(*emitter).failed;
}
fn crust_x64_try_emit_constant(emitter: *CrustX64Emitter, declaration: *CrustDecl) -> bool {
    (*emitter).failed = false;
    x64_default_constant(emitter, declaration);
    return !(*emitter).failed;
}
fn crust_x64_try_emit_constant_value(emitter: *CrustX64Emitter, expression: *CrustExpr) -> bool {
    (*emitter).failed = false;
    x64_default_constant_value(emitter, expression);
    return !(*emitter).failed;
}
fn crust_x64_try_emit_function(emitter: *CrustX64Emitter, function: *CrustX64Function) -> bool {
    (*emitter).failed = false;
    x64_default_function(emitter, function);
    return !(*emitter).failed;
}

const crust_x64_default_ops: CrustX64Ops = make CrustX64Ops {
    expression: crust_x64_try_emit_expression, place: crust_x64_try_emit_place,
    statement: crust_x64_try_emit_statement
};

fn x64_emit_string(emitter: *CrustX64Emitter, expression: *CrustExpr) -> unit {
    var index: usize = 0usize;
    while index < (*expression).byte_count && !(*emitter).failed {
        var byte: u8 = (*expression).bytes[index];
        if index % 128usize == 0usize { x64_output_text(emitter, "\t.ascii \""); }
        if byte >= 32u8 && byte <= 126u8 && byte != 34u8 && byte != 92u8 {
            x64_output_byte(emitter, byte);
        } else {
            x64_output_byte(emitter, 92u8);
            x64_output_number(emitter, byte as u64, 8u64, 3usize);
        }
        if index % 128usize == 127usize || index + 1usize == (*expression).byte_count { x64_output_text(emitter, "\"\n"); }
        index = index + 1usize;
    }
}

fn x64_emit_aliases(emitter: *CrustX64Emitter) -> unit {
    var program: *CrustX64Program = (*emitter).program;
    var alias: *CrustX64Alias = (*program).aliases;
    while alias != null(*CrustX64Alias) && !(*emitter).failed {
        var name: *u8 = (*(*alias).declaration).link_name;
        if name[0usize] != 0u8 {
            x64_output_text(emitter, "\t.globl ");
            x64_symbol_name(emitter, name);
            x64_output_text(emitter, "\n\t.weakref ");
            x64_output_text(emitter, &(*program).label_prefix[0usize]);
            x64_output_text(emitter, "alias_");
            x64_output_number(emitter, (*alias).identity, 10u64, 0usize);
            x64_output_text(emitter, ", ");
            x64_symbol_name(emitter, name);
            x64_output_text(emitter, "\n");
        }
        alias = (*alias).next;
    }
}

fn x64_emit_constants(emitter: *CrustX64Emitter) -> unit {
    var unit_value: *CrustUnit = (*x64_context(emitter)).units;
    while unit_value != null(*CrustUnit) && !(*emitter).failed {
        var declaration: *CrustDecl = (*unit_value).declarations;
        while declaration != null(*CrustDecl) && !(*emitter).failed {
            if (*declaration).kind == CRUST_D_CONST { x64_default_constant(emitter, declaration); }
            declaration = (*declaration).next;
        }
        unit_value = (*unit_value).next;
    }
}

fn crust_x64_emit_program_with_ops(program: *CrustX64Program, output: *u8, operations: *CrustX64Ops) -> bool {
    var emitter: CrustX64Emitter = make CrustX64Emitter {
        program: program, function: null(*CrustX64Function), output: output, operations: operations,
        loop: null(*CrustX64Loop), next_label: 1u64, return_label: 0u64, failed: false
    };
    x64_emit_aliases(&emitter);
    x64_emit_constants(&emitter);
    x64_output_text(&emitter, "\t.section .rodata\n");
    var string: *CrustX64String = (*program).strings;
    while string != null(*CrustX64String) && !emitter.failed {
        x64_output_text(&emitter, &(*program).label_prefix[0usize]);
        x64_output_text(&emitter, "string_");
        x64_output_number(&emitter, (*string).identity, 10u64, 0usize);
        x64_output_text(&emitter, ":\n");
        x64_emit_string(&emitter, (*string).expression);
        string = (*string).next;
    }
    var function: *CrustX64Function = (*program).functions;
    while function != null(*CrustX64Function) && !emitter.failed {
        x64_default_function(&emitter, function);
        function = (*function).next;
    }
    if (*program).entry != null(*CrustDecl) {
        x64_output_text(&emitter, "\t.text\n\t.globl main\n\t.type main, @function\nmain:\n");
        x64_symbol_address(&emitter, (*program).entry);
        x64_output_text(&emitter, "\tjmp *%rax\n\t.size main, .-main\n");
    }
    x64_output_text(&emitter, "\t.section .note.GNU-stack,\"\",@progbits\n");
    if emitter.failed { return false; }
    if x64_fflush(output) != 0i32 {
        x64_io_error((*program).context, "assembly output flush failed: ");
        return false;
    }
    return true;
}

fn crust_x64_emit_program(program: *CrustX64Program, output: *u8) -> bool {
    return crust_x64_emit_program_with_ops(program, output, null(*CrustX64Ops));
}

fn crust_x64_emit(ctx: *CrustContext, output: *u8, entry: *CrustDecl) -> bool {
    var program: *CrustX64Program = null(*CrustX64Program);
    if !crust_x64_prepare(ctx, &program, entry) { return false; }
    return crust_x64_emit_program(program, output);
}
