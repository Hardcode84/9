// Capture the Linux x86-64 assembler and its loaded libraries.
fn asm_stage_toolchain(toolchain: *StageToolchain) -> bool {
    toolchain -> object = asm_stage_object;
    var paths: [*u8; 1] = make [*u8; 1] {
        "/usr/bin/as"
    };
    return cache_tools(
        toolchain -> context,
        &toolchain -> inputs,
        &paths[0usize],
        1usize,
        toolchain -> directory
    );
}

fn asm_stage_object(request: *StageObject) -> bool {
    var arguments: [*u8; 6] = make [*u8; 6] {
        "/usr/bin/as",
        "--64",
        request -> source,
        "-o",
        request -> output,
        null(*u8)
    };
    return cache_tool(request -> context, &arguments[0usize], null(*u8));
}

fn asm_open(context: *CrustContext, path: *u8) -> *u8 {
    return native_fopen(path, "wb");
}
