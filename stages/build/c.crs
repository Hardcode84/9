fn stage_emit(build: *StageBuild, context: *CrustContext, source: *u8, symbols: *u8) -> bool {
    var options: BackendOptions = make BackendOptions {
        mode: 2u32,
        output: source,
        symbols: symbols,
        cflags: null(**u8),
        cflag_count: 0usize,
        ldflags: null(**u8),
        ldflag_count: 0usize
    };
    var entry: *CrustDecl = null(*CrustDecl);
    if build -> interpreter == null(*CrustRun) {
        return c_backend_build(context, entry, &options) == 0i32;
    }
    var pointer: *BackendOptions = &options;
    var arguments: [*u8; 3] = make [*u8; 3] {
        &context as *u8,
        &entry as *u8,
        &pointer as *u8
    };
    var status: i32 = 1i32;
    return crust_eval_call(
        build -> interpreter -> eval,
        build -> emitter,
        &arguments[0usize],
        3usize,
        &status as *u8
    ) && status == 0i32;
}

fn stage_build_emit(
    build: *StageBuild,
    target: *CrustContext,
    source: *u8,
    symbols: *u8
) -> bool {
    if !build -> interpreted {
        return stage_emit(build, target, source, symbols);
    }
    var compiler: CrustContext = uninit;
    crust_context_init(&compiler, null(*CrustAllocator));
    var interpreter: CrustRun = uninit;
    var initialized: bool = false;
    var success: bool = stage_read_sources(&compiler, &build -> package -> sources);
    if success {
        initialized = true;
        success = crust_run_init(
            &interpreter,
            &compiler,
            build -> package -> sources.items[0usize],
            0i32,
            null(**u8)
        );
        var name: *CrustName = crust_try_intern(&compiler, "c_backend_build", 15usize);
        if success && name != null(*CrustName) {
            var symbol: *CrustSymbol = crust_map_get(&compiler.globals, name as usize) as *CrustSymbol;
            if symbol == null(*CrustSymbol) {
                success = native_error(target, "bootstrap package lacks c_backend_build");
            } else {
                build -> interpreter = &interpreter;
                build -> emitter = symbol -> decl;
                success = stage_emit(build, target, source, symbols);
            }
        } else {
            success = false;
        }
    }
    if initialized && !crust_run_destroy(&interpreter) {
        success = false;
    }
    stage_diagnostic(target, &compiler);
    crust_context_destroy(&compiler);
    return success;
}

fn stage_object_compile(
    toolchain: *StageToolchain,
    context: *CrustContext,
    source: *u8,
    output: *u8
) -> bool {
    var request: StageObject = make StageObject {
        context: context,
        source: source,
        output: output,
        user: toolchain -> user
    };
    var success: bool = toolchain -> object(&request);
    if !success && context -> error_count == 0usize {
        return native_error(context, "selected object compiler failed without a diagnostic");
    }
    return success && context -> error_count == 0usize;
}
