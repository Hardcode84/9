fn stage_read(package: *StagePackage, context: *CrustContext) -> bool {
    var index: usize = 0usize;
    while index < package->sources.count {
        var parsed: *CrustUnit = null(*CrustUnit);
        if !crust_read(context, package->sources.items[index], &parsed) { return false; }
        index = index + 1usize;
    }
    return crust_collect(context) && crust_resolve(context) && crust_check(context);
}

fn stage_emit(build: *StageBuild, context: *CrustContext, source: *u8, symbols: *u8) -> bool {
    var options: CBackendOptions = make CBackendOptions {
        mode: 2u32, output: source, symbols: symbols,
        cflags: null(**u8), cflag_count: 0usize, ldflags: null(**u8), ldflag_count: 0usize
    };
    var entry: *CrustDecl = null(*CrustDecl);
    if build->interpreter == null(*CrustRun) { return c_backend_build(context, entry, &options) == 0i32; }
    var pointer: *CBackendOptions = &options;
    var arguments: [*u8; 3] = make [*u8; 3] { &context as *u8, &entry as *u8, &pointer as *u8 };
    var status: i32 = 1i32;
    return crust_eval_call(build->interpreter->eval, build->emitter, &arguments[0usize], 3usize, &status as *u8) && status == 0i32;
}


fn stage_tools(context: *CrustContext, inputs: *CacheInputs, output: *u8) -> bool {
    var source: *u8 = native_join(context, output, ".c");
    var response: *u8 = native_join(context, output, ".symbols");
    if response == null(*u8) { return false; }
    var symbols: *u8 = native_join(context, "@", response);
    var object: *u8 = native_join(context, output, ".o");
    var renamed: *u8 = native_join(context, output, ".renamed");
    var libc: *u8 = cache_libc(context, inputs);
    if source == null(*u8) || symbols == null(*u8) || object == null(*u8) || renamed == null(*u8) || libc == null(*u8) { return false; }
    var rename: [*u8; 5] = make [*u8; 5] { "/usr/bin/objcopy", symbols, object, renamed, null(*u8) };
    var link: [*u8; 14] = make [*u8; 14] {
        "/usr/bin/ld", "-shared", "-Bsymbolic", "-z", "text", "-z", "relro", "-z", "now", renamed, libc, "-o", output, null(*u8)
    };
    return stage_gcc(context, source, object, false) &&
        cache_tool(context, &rename[0usize], null(*u8)) && cache_tool(context, &link[0usize], null(*u8));
}

fn stage_build(context: *CrustContext, request: *CacheBuild, output: *u8) -> bool {
    var build: *StageBuild = request->user as *StageBuild;
    var inputs: CacheInputs = make CacheInputs { items: request->inputs, count: request->count, capacity: request->count };
    var target: CrustContext = uninit;
    crust_context_init(&target, null(*CrustAllocator));
    var source: *u8 = native_join(context, output, ".c");
    var symbols: *u8 = native_join(context, output, ".symbols");
    var success: bool = source != null(*u8) && symbols != null(*u8) &&
        stage_compile_emit(build, &target, source, symbols) && stage_tools(context, &inputs, output);
    stage_diagnostic(context, &target);
    crust_context_destroy(&target);
    var suffixes: [*u8; 4] = make [*u8; 4] { ".c", ".symbols", ".o", ".renamed" };
    var index: usize = 0usize;
    while index < 4usize {
        var path: *u8 = native_join(context, output, suffixes[index]);
        if path == null(*u8) || !cache_remove(context, path) { success = false; }
        index = index + 1usize;
    }
    return success;
}

fn stage_build_emit(build: *StageBuild, target: *CrustContext, source: *u8, symbols: *u8) -> bool {
    if !build->interpreted { return stage_emit(build, target, source, symbols); }
    var compiler: CrustContext = uninit;
    crust_context_init(&compiler, null(*CrustAllocator));
    var interpreter: CrustRun = uninit;
    var initialized: bool = false;
    var success: bool = stage_read(build->package, &compiler);
    if success {
        initialized = true;
        success = crust_run_init(&interpreter, &compiler, build->package->sources.items[0usize], 0i32, null(**u8));
        var name: *CrustName = crust_try_intern(&compiler, "c_backend_build", 15usize);
        if success && name != null(*CrustName) {
            var symbol: *CrustSymbol = crust_map_get(&compiler.globals, name as usize) as *CrustSymbol;
            if symbol == null(*CrustSymbol) { success = native_error(target, "bootstrap package lacks c_backend_build"); }
            else { build->interpreter = &interpreter; build->emitter = symbol->decl; success = stage_emit(build, target, source, symbols); }
        } else { success = false; }
    }
    if initialized && !crust_run_destroy(&interpreter) { success = false; }
    stage_diagnostic(target, &compiler);
    crust_context_destroy(&compiler);
    return success;
}

fn stage_gcc(context: *CrustContext, source: *u8, output: *u8, preprocess: bool) -> bool {
    var arguments: [*u8; 17] = make [*u8; 17] {
        "/usr/bin/gcc", "-std=c99", "-pedantic-errors", "-O2", "-fPIC",
        "-fno-semantic-interposition", "-fstack-clash-protection", "-Wno-overlength-strings",
        "-x", "c", source, "-o", output, "-c", null(*u8), null(*u8), null(*u8)
    };
    if preprocess {
        arguments[13usize] = "-E";
        arguments[14usize] = "-P";
        arguments[15usize] = "-dD";
    }
    return cache_tool(context, &arguments[0usize], null(*u8));
}

fn stage_compile_emit(build:*StageBuild,target:*CrustContext,source:*u8,symbols:*u8)->bool {
    if build->compile!=null(fn(*StageCompile)->bool){return stage_compile_custom(build,target,source,symbols);}
    return stage_read(build->package,target) && stage_names(build->package->exports,target) &&
        stage_build_emit(build,target,source,symbols);
}

fn stage_compile_custom(build:*StageBuild,context:*CrustContext,source:*u8,symbols:*u8)->bool {
    var package:*StagePackage=build->package;
    var request:StageCompile=make StageCompile{
        sources:package->sources,options:package->options,exports:package->exports,
        context:context,output:source,symbols:symbols
    };
    var success:bool=build->compile(&request);
    if !success && context->error_count==0usize{return native_error(context,"selected stage compiler failed without a diagnostic");}
    return success && context->error_count==0usize;
}
