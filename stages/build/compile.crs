fn stage_build(context: *CrustContext, request: *CacheBuild, output: *u8) -> bool {
    var build: *StageBuild = request -> user as *StageBuild;
    var inputs: CacheInputs = make CacheInputs {
        items: request -> inputs,
        count: request -> count,
        capacity: request -> count
    };
    var target: CrustContext = uninit;
    crust_context_init(&target, null(*CrustAllocator));
    var source: *u8 = native_join(context, output, ".input");
    var symbols: *u8 = native_join(context, output, ".symbols");
    var success: bool = source != null(*u8) && symbols != null(*u8) && stage_compile_emit(
        build,
        &target,
        source,
        symbols
    ) && stage_tools(context, &inputs, build -> toolchain, output);
    stage_diagnostic(context, &target);
    crust_context_destroy(&target);
    var suffixes: [*u8; 4] = make [*u8; 4] {
        ".input",
        ".symbols",
        ".o",
        ".renamed"
    };
    var index: usize = 0usize;
    while index < 4usize {
        var path: *u8 = native_join(context, output, suffixes[index]);
        if path == null(*u8) || !cache_remove(context, path) {
            success = false;
        }
        index = index + 1usize;
    }
    return success;
}

fn stage_compile_emit(
    build: *StageBuild,
    target: *CrustContext,
    source: *u8,
    symbols: *u8
) -> bool {
    if build -> compile != null(fn(*StageCompile) -> bool) {
        return stage_compile_custom(build, target, source, symbols);
    }
    return stage_read_sources(target, &build -> package -> sources) && stage_names(
        build -> package -> exports,
        target
    ) && stage_build_emit(build, target, source, symbols);
}

fn stage_compile_custom(
    build: *StageBuild,
    context: *CrustContext,
    source: *u8,
    symbols: *u8
) -> bool {
    var package: *StagePackage = build -> package;
    var request: StageCompile = make StageCompile {
        sources: package -> sources,
        options: package -> options,
        exports: package -> exports,
        context: context,
        output: source,
        symbols: symbols
    };
    var success: bool = build -> compile(&request);
    if !success && context -> error_count == 0usize {
        return native_error(context, "selected stage compiler failed without a diagnostic");
    }
    return success && context -> error_count == 0usize;
}
