host_source(run,"load.crs");
if !stage_setup(run,"../..") {return 1i32;};
if run->argc!=3i32 {
    crust_set_error(run->context,run->source,run->cursor,"expected PACKAGE C-OUTPUT SYMBOLS-OUTPUT");return 1i32;
};
var stages:*StageSession=stage_open(run,"../..","../../build/stage-cache");
if stages==null(*StageSession){return 1i32;};
var package:StagePackage=uninit;
stage_init(&package,run,"../..");
if !stage_include(&package,run->argv[0usize]){return 1i32;};
var build:StageBuild=make StageBuild{package:&package,interpreter:null(*CrustRun),emitter:null(*CrustDecl),compile:null(fn(*StageCompile)->bool),interpreted:false};
var inputs:CacheInputs=make CacheInputs{items:null(**CrustSource),count:0usize,capacity:0usize};
if !stage_compiler_load(stages,&package,&inputs,&build){return 1i32;};
var output:*u8=host_path(run,run->argv[1usize]);
var symbols:*u8=host_path(run,run->argv[2usize]);
if output==null(*u8) || symbols==null(*u8){return 1i32;};
var target:CrustContext=uninit;
crust_context_init(&target,null(*CrustAllocator));
var success:bool=stage_compile_emit(&build,&target,output,symbols);
stage_diagnostic(run->context,&target);
crust_context_destroy(&target);
if success{return 0i32;};
return 1i32;
