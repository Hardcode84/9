fn stage_artifact(
    session: *StageSession,
    package: *StagePackage,
    interpreted: bool,
    result: *CacheArtifact
) -> bool {
    var context: *CrustContext = session -> root -> context;
    var inputs: CacheInputs = make CacheInputs {
        items: null(**CrustSource),
        count: 0usize,
        capacity: 0usize
    };
    var build: StageBuild = make StageBuild {
        package: package,
        toolchain: &session -> toolchain,
        interpreter: null(*CrustRun),
        emitter: null(*CrustDecl),
        compile: null(fn(*StageCompile) -> bool),
        interpreted: interpreted
    };
    var selected: StageToolchain = make StageToolchain {
        inputs: inputs,
        context: context,
        directory: session -> directory,
        object: null(fn(*StageObject) -> bool),
        user: null(*u8)
    };
    if !stage_compiler_load(session, package, &inputs, &build, &selected) {
        return false;
    }
    var counts: [usize; 6] = make [usize; 6] {
        package -> inputs.count,
        package -> sources.count,
        session -> inputs.count,
        interpreted as usize,
        package -> options.count,
        build.toolchain -> inputs.count
    };
    var recipe: CrustSource = make CrustSource {
        path: "crust-stage-build-v3",
        bytes: &counts[0usize] as *u8,
        size: sizeof([usize; 6]),
        identity: 0u64
    };
    if !cache_add(context, &inputs, &recipe) {
        return false;
    }
    var groups: [*CacheInputs; 5] = make [*CacheInputs; 5] {
        &package -> inputs,
        &package -> sources,
        &session -> inputs,
        &package -> options,
        &build.toolchain -> inputs
    };
    var group: usize = 0usize;
    while group < 5usize {
        var index: usize = 0usize;
        while index < groups[group] -> count {
            if !cache_add(context, &inputs, groups[group] -> items[index]) {
                return false;
            }
            index = index + 1usize;
        }
        group = group + 1usize;
    }
    if !stage_export_inputs(context, package, &inputs) {
        return false;
    }
    if !interpreted && !cache_input(context, &inputs, session -> backend) {
        return false;
    }
    var request: CacheBuild = make CacheBuild {
        inputs: inputs.items,
        count: inputs.count,
        build: stage_build,
        user: &build as *u8
    };
    return cache_artifact(context, session -> directory, &request, result);
}

// Capture the toolchain once and bootstrap the C provider. Keep the root and
// caller-owned cache directory live through all uses of this session.
fn stage_open(root: *CrustRun, base: *u8, directory: *u8) -> *StageSession {
    var context: *CrustContext = root -> context;
    var session: *StageSession = crust_try_alloc(
        context,
        sizeof(StageSession),
        alignof(StageSession)
    ) as *StageSession;
    if session == null(*StageSession) {
        return session;
    }
    session -> root = root;
    session -> depth = 0usize;
    session -> base = base;
    session -> directory = host_path(root, directory);
    session -> inputs = make CacheInputs {
        items: null(**CrustSource),
        count: 0usize,
        capacity: 0usize
    };
    if session -> directory == null(*u8) || !cache_directory(context, session -> directory) || !cache_loaded_sources(
        root,
        &session -> inputs
    ) || !cache_loaded_inputs(context, &session -> inputs) || !stage_link_inputs(
        context,
        &session -> inputs,
        session -> directory
    ) {
        return null(*StageSession);
    }
    session -> toolchain = make StageToolchain {
        inputs: make CacheInputs {
            items: null(**CrustSource),
            count: 0usize,
            capacity: 0usize
        },
        context: context,
        directory: session -> directory,
        object: null(fn(*StageObject) -> bool),
        user: null(*u8)
    };
    if !stage_c_toolchain(&session -> toolchain) {
        return null(*StageSession);
    }
    var package: StagePackage = uninit;
    stage_init(&package, root, base);
    if !stage_include(&package, "stages/c/package.crs") {
        return null(*StageSession);
    }
    var artifact: CacheArtifact = uninit;
    if !stage_artifact(session, &package, true, &artifact) {
        return null(*StageSession);
    }
    var library: *u8 = crust_run_open(root, artifact.path);
    if library == null(*u8) || !stage_bind_exports(root, library, package.exports) {
        return null(*StageSession);
    }
    session -> backend = artifact.path;
    return session;
}

// Return a validated library from captured package sources. Loading is explicit.
fn stage_library(session: *StageSession, manifest: *u8) -> *u8 {
    var package: StagePackage = uninit;
    stage_init(&package, session -> root, session -> base);
    if !stage_include(&package, manifest) {
        return null(*u8);
    }
    return stage_package_library(session, &package);
}

// Build a captured package. Keep its inputs and configuration live through return.
fn stage_package_library(session: *StageSession, package: *StagePackage) -> *u8 {
    var artifact: CacheArtifact = uninit;
    if session -> depth == 64usize {
        native_error(session -> root -> context, "stage compiler dependency depth exceeds 64");
        return null(*u8);
    }
    session -> depth = session -> depth + 1usize;
    var success: bool = stage_artifact(session, package, false, &artifact);
    session -> depth = session -> depth - 1usize;
    if !success {
        return null(*u8);
    }
    return artifact.path;
}

// Bind the package's exported interface to declarations already loaded by the root.
fn stage_import(session: *StageSession, manifest: *u8) -> bool {
    var package: StagePackage = uninit;
    stage_init(&package, session -> root, session -> base);
    if !stage_include(&package, manifest) {
        return false;
    }
    return stage_import_package(session, &package);
}

fn stage_import_package(session: *StageSession, package: *StagePackage) -> bool {
    var path: *u8 = stage_package_library(session, package);
    if path == null(*u8) {
        return false;
    }
    var library: *u8 = crust_run_open(session -> root, path);
    return library != null(*u8) && stage_bind_exports(
        session -> root,
        library,
        package -> exports
    );
}

// Bind the root's declared subset of this package interface to one provider.
fn stage_bind_exports(root: *CrustRun, library: *u8, exports: *StageName) -> bool {
    var names: CrustMap = make CrustMap {
        entries: null(*CrustMapEntry),
        count: 0usize,
        capacity: 0usize
    };
    var item: *StageName = exports;
    while item != null(*StageName) {
        var name: *CrustName = crust_try_intern(
            root -> context,
            item -> link,
            native_strlen(item -> link)
        );
        if name == null(*CrustName) || !crust_try_map_set(
            root -> context,
            &names,
            name as usize,
            item as *u8
        ) {
            return false;
        }
        item = item -> next;
    }
    var unit_value: *CrustUnit = root -> context -> units;
    while unit_value != null(*CrustUnit) {
        if !stage_bind_unit(root, library, unit_value, &names) {
            return false;
        }
        unit_value = unit_value -> next;
    }
    return true;
}

fn stage_bind_unit(
    root: *CrustRun,
    library: *u8,
    unit_value: *CrustUnit,
    names: *CrustMap
) -> bool {
    var declaration: *CrustDecl = unit_value -> declarations;
    while declaration != null(*CrustDecl) {
        if declaration -> kind == CRUST_D_EXTERN {
            var name: *CrustName = crust_try_intern(
                root -> context,
                declaration -> link_name,
                native_strlen(declaration -> link_name)
            );
            if name == null(*CrustName) {
                return false;
            }
            if crust_map_get(names, name as usize) != null(*u8) && !crust_run_import(
                root,
                library,
                declaration
            ) {
                return false;
            }
        }
        declaration = declaration -> next;
    }
    return true;
}

fn stage_export_inputs(
    context: *CrustContext,
    package: *StagePackage,
    inputs: *CacheInputs
) -> bool {
    var item: *StageName = package -> exports;
    while item != null(*StageName) {
        var captured: *CrustSource = crust_try_alloc(
            context,
            sizeof(CrustSource),
            alignof(CrustSource)
        ) as *CrustSource;
        if captured == null(*CrustSource) {
            return false;
        }
        * captured = make CrustSource {
            path: item -> text,
            bytes: item -> link,
            size: native_strlen(item -> link),
            identity: 0u64
        };
        if !cache_add(context, inputs, captured) {
            return false;
        }
        item = item -> next;
    }
    return true;
}

fn stage_compiler_load(
    session: *StageSession,
    package: *StagePackage,
    inputs: *CacheInputs,
    build: *StageBuild,
    toolchain: *StageToolchain
) -> bool {
    if package -> compiler == null(*u8) {
        if package -> options.count != 0usize {
            return native_error(
                session -> root -> context,
                "source options require a selected compiler"
            );
        }
        return true;
    }
    var path: *u8 = stage_library(session, package -> compiler);
    var root: *CrustRun = session -> root;
    var context: *CrustContext = root -> context;
    if path == null(*u8) || !cache_input(context, inputs, path) {
        return false;
    }
    var library: *u8 = crust_run_open(root, path);
    if library == null(*u8) {
        return false;
    }
    if !stage_selection_input(context, inputs, "stage-compiler-entry", package -> entry) {
        return false;
    }
    if !stage_native_callback(
        root,
        library,
        "stage_compiler_abi",
        package -> entry,
        &build -> compile as *u8
    ) {
        return false;
    }
    return stage_toolchain_load(root, library, package, inputs, build, toolchain);
}

fn stage_toolchain_load(
    root: *CrustRun,
    library: *u8,
    package: *StagePackage,
    inputs: *CacheInputs,
    build: *StageBuild,
    toolchain: *StageToolchain
) -> bool {
    if package -> toolchain == null(*u8) {
        return true;
    }
    var context: *CrustContext = root -> context;
    if !stage_selection_input(context, inputs, "stage-toolchain-entry", package -> toolchain) {
        return false;
    }
    var prepare: fn(*StageToolchain) -> bool = null(fn(*StageToolchain) -> bool);
    if !stage_native_callback(
        root,
        library,
        "stage_toolchain_abi",
        package -> toolchain,
        &prepare as *u8
    ) {
        return false;
    }
    var success: bool = prepare(toolchain);
    if !success && context -> error_count == 0usize {
        return native_error(context, "selected toolchain failed without a diagnostic");
    }
    if !success || context -> error_count != 0usize {
        return false;
    }
    if toolchain -> object == null(fn(*StageObject) -> bool) {
        return native_error(context, "selected toolchain has no object compiler");
    }
    build -> toolchain = toolchain;
    return true;
}

fn stage_native_callback(
    root: *CrustRun,
    library: *u8,
    prototype_name: *u8,
    entry: *u8,
    output: *u8
) -> bool {
    var context: *CrustContext = root -> context;
    var name: *CrustName = crust_try_intern(
        context,
        prototype_name,
        native_strlen(prototype_name)
    );
    if name == null(*CrustName) {
        return false;
    }
    var prototype: *CrustSymbol = crust_map_get(&context -> globals, name as usize) as *CrustSymbol;
    var declaration: *CrustDecl = crust_try_alloc(
        context,
        sizeof(CrustDecl),
        alignof(CrustDecl)
    ) as *CrustDecl;
    if declaration == null(*CrustDecl) {
        return false;
    }
    * declaration = *prototype -> decl;
    declaration -> next = null(*CrustDecl);
    declaration -> identity = 0u64;
    declaration -> unit_identity = 0u64;
    declaration -> link_name = entry;
    return crust_run_import(root, library, declaration) && crust_eval_function(
        root -> eval,
        declaration,
        output
    );
}

fn stage_link_inputs(context: *CrustContext, inputs: *CacheInputs, directory: *u8) -> bool {
    var paths: [*u8; 2] = make [*u8; 2] {
        "/usr/bin/objcopy",
        "/usr/bin/ld"
    };
    return cache_tools(context, inputs, &paths[0usize], 2usize, directory);
}

fn stage_selection_input(
    context: *CrustContext,
    inputs: *CacheInputs,
    key: *u8,
    value: *u8
) -> bool {
    var selection: *CrustSource = crust_try_alloc(
        context,
        sizeof(CrustSource),
        alignof(CrustSource)
    ) as *CrustSource;
    if selection == null(*CrustSource) {
        return false;
    }
    * selection = make CrustSource {
        path: key,
        bytes: value,
        size: native_strlen(value),
        identity: 0u64
    };
    return cache_add(context, inputs, selection);
}
