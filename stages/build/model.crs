record StageName { text: *u8; link: *u8; next: *StageName; }
record StagePackage {
    sources: CacheInputs;
    inputs: CacheInputs;
    exports: *StageName;
    root: *CrustRun;
    base: *u8;
    depth: usize;
}
record StageBuild {
    package: *StagePackage;
    interpreter: *CrustRun;
    emitter: *CrustDecl;
    interpreted: bool;
}
extern fn stage_realpath(path: *u8, result: *u8) -> *u8 = "realpath";

record StageSession {
    inputs: CacheInputs;
    root: *CrustRun;
    base: *u8;
    directory: *u8;
    backend: *u8;
}
