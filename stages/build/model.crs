record StagePackage {
    sources: CacheInputs;
    inputs: CacheInputs;
    options: CacheInputs;
    exports: *StageName;
    root: *CrustRun;
    base: *u8;
    compiler: *u8;
    entry: *u8;
    toolchain: *u8;
    depth: usize;
}
record StageBuild {
    package: *StagePackage;
    toolchain: *StageToolchain;
    interpreter: *CrustRun;
    emitter: *CrustDecl;
    compile: fn(*StageCompile) -> bool;
    interpreted: bool;
}

record StageSession {
    toolchain: StageToolchain;
    inputs: CacheInputs;
    root: *CrustRun;
    base: *u8;
    directory: *u8;
    backend: *u8;
    depth: usize;
}
