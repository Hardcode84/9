fn stage_init(package: *StagePackage, root: *CrustRun, base: *u8) -> unit {
    package->root = root;
    package->base = base;
    package->sources = make CacheInputs { items: null(**CrustSource), count: 0usize, capacity: 0usize };
    package->inputs = package->sources;
    package->options = package->sources;
    package->exports = null(*StageName);
    package->depth = 0usize;
    package->compiler = null(*u8);
    package->entry = null(*u8);
}

fn stage_capture(package: *StagePackage, path: *u8, inputs: *CacheInputs) -> bool {
    var context: *CrustContext = package->root->context;
    var selected: *u8 = stage_path(package->root, package->base, path);
    if selected == null(*u8) { return false; }
    var resolved: *u8 = stage_realpath(selected, null(*u8));
    if resolved == null(*u8) { return native_error(context, "cannot resolve stage source path"); }
    var owned: *u8 = crust_try_copy_string(context, resolved, native_strlen(resolved));
    crust0_host_free(resolved);
    if owned == null(*u8) { return false; }
    var index: usize = 0usize;
    while index < inputs->count {
        if cache_strcmp(inputs->items[index]->path, owned) == 0i32 { return true; }
        index = index + 1usize;
    }
    return cache_input(context, inputs, owned);
}

// Add one declaration source. Repeated paths contribute one captured unit.
fn stage_source(stage: *StagePackage, path: *u8) -> bool {
    return stage_capture(stage, path, &stage->sources);
}

fn stage_export_as(stage: *StagePackage, name: *u8, link: *u8) -> bool {
    if link[0usize] == 0u8 { return native_error(stage->root->context, "native stage export name is empty"); }
    var item: *StageName = stage->exports;
    while item != null(*StageName) {
        if cache_strcmp(item->text, name) == 0i32 {
            if cache_strcmp(item->link, link) == 0i32 { return true; }
            return native_error(stage->root->context, "conflicting native stage export names");
        }
        item = item->next;
    }
    item = crust_try_alloc(stage->root->context, sizeof(StageName), alignof(StageName)) as *StageName;
    if item == null(*StageName) { return false; }
    item->text = name;
    item->link = link;
    item->next = stage->exports;
    stage->exports = item;
    return true;
}

// Export the native function names declared by a consumer interface.
fn stage_interface(stage: *StagePackage, path: *u8) -> bool {
    var before: usize = stage->inputs.count;
    if !stage_capture(stage, path, &stage->inputs) { return false; }
    if stage->inputs.count == before { return true; }
    var source: *CrustSource = stage->inputs.items[stage->inputs.count - 1usize];
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var parsed: *CrustUnit = null(*CrustUnit);
    var success: bool = crust_read(&context, source, &parsed);
    if success {
        var declaration: *CrustDecl = parsed->declarations;
        while declaration != null(*CrustDecl) && success {
            if declaration->kind == CRUST_D_EXTERN {
                var name: *u8 = declaration->link_name;
                var copy: *u8 = crust_try_copy_string(stage->root->context, name, native_strlen(name));
                success = copy != null(*u8) && stage_export(stage, copy);
            }
            declaration = declaration->next;
        }
    }
    if context.error_count != 0usize {
        crust_set_error(stage->root->context, source, context.error_loc.offset, &context.error[0usize]);
    }
    crust_context_destroy(&context);
    return success;
}

fn stage_bind(run: *CrustRun, package: **StagePackage) -> bool {
    var context: *CrustContext = run->context;
    var name: *CrustName = crust_try_intern(context, "StagePackage", 12usize);
    if name == null(*CrustName) { return false; }
    var type_symbol: *CrustSymbol = crust_map_get(&context->globals, name as usize) as *CrustSymbol;
    var symbol: *CrustSymbol = crust_try_alloc(context, sizeof(CrustSymbol), alignof(CrustSymbol)) as *CrustSymbol;
    if symbol == null(*CrustSymbol) { return false; }
    symbol->kind = CRUST_SYM_PARAM;
    symbol->name = crust_try_intern(context, "stage", 5usize);
    symbol->type = crust_try_pointer_type(context, type_symbol->type);
    symbol->loc.source = run->source;
    if symbol->name == null(*CrustName) || symbol->type == null(*CrustType) ||
       !crust_try_map_set(context, &run->scope.locals, symbol->name as usize, symbol as *u8) { return false; }
    run->scope.scope = symbol;
    return crust_eval_bind(run->eval, symbol, package as *u8);
}

// Execute a package's ordinary source actions with stage bound to this package.
// Paths are relative to that package file. Include nesting is bounded at 64.
fn stage_include(stage: *StagePackage, path: *u8) -> bool {
    if stage->depth == 64usize { return native_error(stage->root->context, "stage include depth exceeds 64"); }
    var before: usize = stage->inputs.count;
    if !stage_capture(stage, path, &stage->inputs) { return false; }
    if stage->inputs.count == before { return true; }
    var source: *CrustSource = stage->inputs.items[before];
    if stage->root->next_identity == ~0u64 { return native_error(stage->root->context, "stage source identities are exhausted"); }
    source->identity = stage->root->next_identity;
    stage->root->next_identity = source->identity + 1u64;
    var saved: *u8 = stage->base;
    // Use the source directory, without assuming a current working directory.
    var size: usize = native_strlen(source->path);
    while size != 0usize && source->path[size - 1usize] != 47u8 { size = size - 1usize; }
    stage->base = crust_try_copy_string(stage->root->context, source->path, size);
    if stage->base == null(*u8) { return false; }
    stage->depth = stage->depth + 1usize;
    var child: CrustRun = uninit;
    var success: bool = crust_run_init(&child, stage->root->context, source, 0i32, null(**u8));
    if success { success = stage_bind(&child, &stage) && crust_run_loop(&child) && child.status == 0i32; }
    if !crust_run_destroy(&child) { success = false; }
    stage->depth = stage->depth - 1usize;
    stage->base = saved;
    return success;
}

fn stage_export(stage: *StagePackage, name: *u8) -> bool {
    return stage_export_as(stage, name, name);
}
