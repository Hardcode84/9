host_source(run, "load.crs");
if !stage_setup(run, "../..") {
    return 1i32;
};
if run -> argc < 1i32 {
    crust_set_error(
        run -> context,
        run -> source,
        run -> cursor,
        "expected a tool package and its arguments"
    );
    return 1i32;
};
var stages: *StageSession = stage_open(run, "../..", "../../build/stage-cache");
if stages == null(*StageSession) || !stage_load(stages, run -> argv[0usize]) {
    return 1i32;
};
extern fn stage_entry(argc: i32, argv: **u8) -> i32 = "crust_tool_main";
return stage_entry(run -> argc, run -> argv);
