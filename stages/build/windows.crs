fn stage_api(stage: *StagePackage, name: *u8) -> bool {
    return stage_api_from(stage, "../..", name);
}
fn stage_platform_sources(stage: *StagePackage) -> bool {
    return stage_source(stage, "../native/windows.crs");
}
fn stage_import_library(context: *CrustContext) -> *u8 {
    var seed: *u8 = win_seed_path(context);
    if seed == null(*u8) {
        return null(*u8);
    }
    return native_join(context, seed, ".a");
}
fn stage_link_inputs(context: *CrustContext, inputs: *CacheInputs, directory: *u8) -> bool {
    var library: *u8 = stage_import_library(context);
    return library != null(*u8) && cache_input(context, inputs, library);
}
fn stage_c_toolchain(toolchain: *StageToolchain) -> bool {
    toolchain -> object = stage_c_object;
    var context: *CrustContext = toolchain -> context;
    var directory: *u8 = stage_windows_installation(context);
    if directory == null(*u8) || !stage_windows_probe(toolchain) || !cache_tree(
        context,
        &toolchain -> inputs,
        directory,
        0usize
    ) {
        return false;
    }
    cache_sort_inputs(&toolchain -> inputs);
    return true;
}
fn stage_windows_tool_directory(context: *CrustContext, name: *u8) -> *u8 {
    var wide: *u16 = win_tool_path(context, name);
    if wide == null(*u16) {
        return null(*u8);
    }
    var path: *u8 = win_utf8(context, wide);
    if path == null(*u8) {
        return path;
    }
    path = win_existing_path(context, path);
    if path == null(*u8) {
        return path;
    }
    return win_directory_prefix(context, path);
}
fn stage_windows_installation(context: *CrustContext) -> *u8 {
    var bin: *u8 = stage_windows_tool_directory(context, "gcc");
    var other: *u8 = stage_windows_tool_directory(context, "objcopy");
    if bin == null(*u8) || other == null(*u8) {
        return null(*u8);
    }
    if cache_strcmp(bin, other) != 0i32 {
        native_error(context, "GCC and objcopy must belong to one self-contained toolchain");
        return null(*u8);
    }
    var size: usize = native_strlen(bin);
    if size < 5usize || cache_strcmp(bin + (size - 5usize) as isize, "/bin/") != 0i32 {
        native_error(context, "Windows toolchain must use a self-contained bin directory");
        return null(*u8);
    }
    return crust_try_copy_string(context, bin, size - 5usize);
}

fn stage_windows_environment(context: *CrustContext, inputs: *CacheInputs) -> bool {
    var environment: *u16 = win_tool_environment(context);
    if environment == null(*u16) {
        return false;
    }
    var size: usize = 0usize;
    while environment[size] != 0u16 || environment[size + 1usize] != 0u16 {
        size = size + 1usize;
    }
    return cache_value_input(
        context,
        inputs,
        "windows-tool-environment",
        environment as *u8,
        (size + 2usize) * 2usize
    );
}
fn stage_windows_probe(toolchain: *StageToolchain) -> bool {
    var context: *CrustContext = toolchain -> context;
    var work: CacheWork = make CacheWork {
        directory: null(*u8),
        manifest: null(*u8),
        digest: null(*u8),
        artifact: null(*u8),
        checksum: null(*u8)
    };
    var success: bool = stage_windows_environment(context, &toolchain -> inputs) && cache_work(
        context,
        toolchain -> directory,
        &work
    );
    if success {
        success = stage_windows_probe_build(context, &toolchain -> inputs, &work);
    }
    if !cache_cleanup(context, &work) {
        success = false;
    }
    return success;
}
fn stage_windows_probe_build(
    context: *CrustContext,
    inputs: *CacheInputs,
    work: *CacheWork
) -> bool {
    var source: *u8 = "#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n#include <limits.h>\nint crust_probe(void){return sizeof(uintptr_t)==8;}\n";
    if !cache_save(context, work -> manifest, source, native_strlen(source)) {
        return false;
    }
    var compile: [*u8; 12] = make [*u8; 12] {
        "gcc",
        "-std=c99",
        "-pedantic-errors",
        "-O2",
        "-fstack-clash-protection",
        "-x",
        "c",
        "inputs",
        "-c",
        "-o",
        "artifact.dll",
        null(*u8)
    };
    var copy: [*u8; 4] = make [*u8; 4] {
        "objcopy",
        "artifact.dll",
        "digest",
        null(*u8)
    };
    var link: [*u8; 9] = make [*u8; 9] {
        "gcc",
        "-shared",
        "-Wl,--export-all-symbols",
        "digest",
        "-lbcrypt",
        "-o",
        "artifact.dll",
        "-Wl,--no-insert-timestamp",
        null(*u8)
    };
    return stage_windows_gcc_probe(context, inputs, &compile[0usize], work -> directory) && cache_probe(
        context,
        inputs,
        &copy[0usize],
        work -> directory
    ) && stage_windows_gcc_probe(context, inputs, &link[0usize], work -> directory);
}
fn stage_windows_gcc_probe(
    context: *CrustContext,
    inputs: *CacheInputs,
    arguments: **u8,
    directory: *u8
) -> bool {
    var alias: WinToolAlias = uninit;
    var success: bool = win_gcc_prepare(context, arguments, directory, &alias);
    if success {
        success = cache_probe(context, inputs, alias.arguments, directory);
    }
    if !win_gcc_cleanup(context, &alias) {
        success = false;
    }
    return success;
}
fn stage_gcc(context: *CrustContext, source: *u8, output: *u8, preprocess: bool) -> bool {
    var arguments: [*u8; 13] = make [*u8; 13] {
        "gcc",
        "-std=c99",
        "-pedantic-errors",
        "-O2",
        "-fstack-clash-protection",
        "-Wno-overlength-strings",
        "-x",
        "c",
        source,
        "-o",
        output,
        "-c",
        null(*u8)
    };
    if preprocess {
        arguments[11usize] = "-E";
    }
    var directory: *u8 = win_directory_prefix(context, output);
    if directory == null(*u8) {
        return false;
    }
    arguments[8usize] = win_basename(source);
    arguments[10usize] = win_basename(output);
    return stage_windows_gcc(context, &arguments[0usize], directory);
}
fn stage_tools(
    context: *CrustContext,
    inputs: *CacheInputs,
    toolchain: *StageToolchain,
    output: *u8
) -> bool {
    var source: *u8 = native_join(context, output, ".input");
    var response: *u8 = native_join(context, output, ".symbols");
    var object: *u8 = native_join(context, output, ".o");
    var renamed: *u8 = native_join(context, output, ".renamed");
    var library: *u8 = stage_import_library(context);
    if source == null(*u8) || response == null(*u8) || object == null(*u8) || renamed == null(
        *u8
    ) || library == null(*u8) {
        return false;
    }
    var link: [*u8; 10] = make [*u8; 10] {
        "gcc",
        "-shared",
        "-Wl,--export-all-symbols",
        win_basename(renamed),
        "seed.a",
        "-lbcrypt",
        "-o",
        win_basename(output),
        "-Wl,--no-insert-timestamp",
        null(*u8)
    };
    var directory: *u8 = win_directory_prefix(context, output);
    if directory == null(*u8) {
        return false;
    }
    var copied: *u8 = native_join(context, directory, "seed.a");
    if copied == null(*u8) {
        return false;
    }
    var success: bool = stage_copy_import(context, library, copied) && stage_object_compile(
        toolchain,
        context,
        source,
        object
    ) && win_symbols(context, response, object, renamed, directory) && stage_windows_gcc(
        context,
        &link[0usize],
        directory
    );
    if !win_remove(context, copied, false) {
        success = false;
    }
    return success;
}

fn stage_c_object(request: *StageObject) -> bool {
    return stage_gcc(request -> context, request -> source, request -> output, false);
}

fn stage_windows_tool(context: *CrustContext, arguments: **u8, directory: *u8) -> bool {
    var status: u32 = 1u32;
    if !win_tool_in(context, arguments, null(*u8), &status, directory) {
        return false;
    }
    return win_status(context, status);
}
fn stage_windows_gcc(context: *CrustContext, arguments: **u8, directory: *u8) -> bool {
    var status: u32 = 1u32;
    return win_gcc_tool_in(context, arguments, null(*u8), &status, directory) && win_status(
        context,
        status
    );
}
fn stage_copy_import(context: *CrustContext, source: *u8, target: *u8) -> bool {
    var bytes: *u8 = null(*u8);
    var size: usize = 0usize;
    if crust0_host_read_file(source, &bytes, &size) != 0i32 {
        return native_error(context, "cannot read seed import library");
    }
    var success: bool = crust0_host_write_file(target, bytes, size) == 0i32;
    crust0_host_free(bytes);
    return success || native_error(context, "cannot copy seed import library");
}
