// Include api/crust0.crs and api/crust0_stage.crs before this consumer interface.
// Mode 0 emits an executable, 1 an object, 2 backend text, and 3 builds text
// without publication. Native outputs require a file path. Null or "-" selects
// stdout for text. Symbols selects a separate response file in mode 2.
// Keep option strings and compiler/linker flag arrays live until emission returns.
record BackendOptions {
    output: *u8;
    symbols: *u8;
    cflags: **u8;
    cflag_count: usize;
    ldflags: **u8;
    ldflag_count: usize;
    mode: u32;
}

// Require checked input and caller-owned names. Retain them through the call.
// Return 0, a failed tool's status, or 1 for another failure; retain diagnostics in context.
extern fn c_backend_build(context: *CrustContext, entry: *CrustDecl, options: *BackendOptions) -> i32 = "c_backend_build";

// Require an empty initialized context and source storage live through its destruction.
// Arguments contain compiler options and extra source paths, without an executable name.
// Return a status and retain diagnostics in the context without printing them.
extern fn c_program(request: *CrustBuild, emit:fn(*CrustContext,*CrustDecl,*BackendOptions)->i32) -> i32 = "c_program";

extern fn backend_output(context:*CrustContext,entry:*CrustDecl,options:*BackendOptions,emit:fn(*CrustContext,*CrustDecl,*BackendOptions)->i32)->i32="backend_output";
