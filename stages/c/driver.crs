fn c_driver_object(driver: *CDriver, source: *u8, output: *u8, mode: u32) -> bool {
    var arguments: **u8 = (*driver).command;
    arguments[0usize] = "gcc";
    arguments[1usize] = "-std=c99";
    arguments[2usize] = "-pedantic-errors";
    arguments[3usize] = "-O2";
    arguments[4usize] = "-g0";
    arguments[5usize] = "-fstack-clash-protection";
    arguments[6usize] = "-Wno-overlength-strings";
    var count: usize = 7usize;
    var index: usize = 0usize;
    while index < (*(*driver).options).cflag_count {
        arguments[count] = (*(*driver).options).cflags[index];
        count = count + 1usize;
        index = index + 1usize;
    }
    arguments[count] = "-c";
    arguments[count + 1usize] = "-x";
    arguments[count + 2usize] = "c";
    arguments[count + 3usize] = source;
    arguments[count + 4usize] = "-o";
    arguments[count + 5usize] = output;
    return c_driver_run(driver, count + 6usize, mode);
}

fn c_driver_compile(driver: *CDriver, compile: fn(*CDriver, *u8, *u8, u32) -> bool) -> bool {
    var kind: i32 = c_driver_output_kind(driver, (*(*driver).options).output);
    if kind < 0i32 {
        return false;
    }
    if kind == 2i32 || c_equal((*(*driver).options).output, "-") {
        return c_driver_error(
            driver,
            "object and executable outputs require a regular file path"
        );
    }
    var stage: *CStage = (*driver).stage;
    var mode: u32 = c_driver_output_mode(driver, (*(*driver).options).output);
    if mode == 0u32 {
        return false;
    }
    var destination: *u8 = (*(*driver).options).output;
    var source: *u8 = c_driver_temporary(driver, destination, 384u32);
    var response: *u8 = c_driver_temporary(driver, destination, 384u32);
    var original: *u8 = c_driver_temporary(driver, destination, mode);
    var object: *u8 = c_driver_temporary(driver, destination, mode);
    var binary: *u8 = c_driver_temporary(driver, destination, mode);
    var response_argument: *u8 = c_driver_join(&(*stage).status, "@", response);
    if (*stage).status.failed {
        return false;
    }
    if !c_driver_write(driver, source, &(*stage).header) || !c_driver_write(
        driver,
        response,
        &(*stage).renames
    ) {
        return false;
    }
    if !compile(driver, source, original, mode) {
        return false;
    }
    var arguments: **u8 = driver -> command;
    var count: usize = 0usize;
    var index: usize = 0usize;
    arguments[0usize] = "objcopy";
    arguments[1usize] = response_argument;
    arguments[2usize] = original;
    arguments[3usize] = object;
    if !c_driver_run(driver, 4usize, mode) {
        return false;
    }
    var result: *u8 = object;
    if (*(*driver).options).mode == 0u32 {
        arguments[0usize] = "gcc";
        arguments[1usize] = "-no-pie";
        arguments[2usize] = object;
        count = 3usize;
        index = 0usize;
        while index < (*(*driver).options).ldflag_count {
            arguments[count] = (*(*driver).options).ldflags[index];
            count = count + 1usize;
            index = index + 1usize;
        }
        arguments[count] = "-o";
        arguments[count + 1usize] = binary;
        if !c_driver_run(driver, count + 2usize, mode) {
            return false;
        }
        result = binary;
    }
    if !c_driver_cleanup(driver, result) {
        return c_driver_error(driver, "temporary cleanup failed");
    }
    return c_driver_publish(driver, result, (*(*driver).options).output);
}

fn c_driver_dump(driver: *CDriver) -> bool {
    var stage: *CStage = (*driver).stage;
    var output: *u8 = (*(*driver).options).output;
    var symbols: *u8 = (*(*driver).options).symbols;
    var output_temporary: *u8 = null(*u8);
    var symbols_temporary: *u8 = null(*u8);
    var stream_output: bool = output == null(*u8) || c_equal(output, "-");
    if !stream_output && !c_driver_dump_temporary(
        driver,
        output,
        &(*stage).header,
        &output_temporary
    ) {
        return false;
    }
    if symbols != null(*u8) && !c_driver_dump_temporary(
        driver,
        symbols,
        &(*stage).renames,
        &symbols_temporary
    ) {
        return false;
    }
    if symbols != null(*u8) {
        if symbols_temporary != null(*u8) {
            if !c_driver_publish(driver, symbols_temporary, symbols) {
                return false;
            }
        } else {
            if !c_driver_write(driver, symbols, &(*stage).renames) {
                return false;
            }
        }
    }
    if stream_output {
        if crust0_host_write_stream(
            1u32,
            (*stage).header.data,
            (*stage).header.size
        ) != 0i32 {
            return c_driver_error(driver, "cannot write standard output");
        }
        return true;
    }
    if output_temporary != null(*u8) {
        return c_driver_publish(driver, output_temporary, output);
    }
    return c_driver_write(driver, output, &(*stage).header);
}

fn c_driver_validate(driver: *CDriver) -> bool {
    if (*(*driver).options).mode > 3u32 {
        return c_driver_error(
            driver,
            "backend mode must be executable, object, text, or prepare"
        );
    }
    if (
        (*(*driver).options).cflag_count != 0usize && (*(*driver).options).cflags == null(**u8)
    ) || (
        (*(*driver).options).ldflag_count != 0usize && (*(*driver).options).ldflags == null(
            **u8
        )
    ) {
        return c_driver_error(driver, "backend flag array is null");
    }
    if (*(*driver).options).mode < 2u32 && (*(*driver).options).output == null(*u8) {
        return c_driver_error(driver, "object and executable modes require -o OUTPUT");
    }
    if (*(*driver).options).symbols != null(*u8) {
        if (*(*driver).options).mode != 2u32 {
            return c_driver_error(driver, "--symbols requires --emit");
        }
        if c_equal((*(*driver).options).symbols, "-") || (
            (*(*driver).options).output != null(*u8) && c_equal(
                (*(*driver).options).symbols,
                (*(*driver).options).output
            )
        ) {
            return c_driver_error(driver, "--symbols requires a separate file path");
        }
        if (*(*driver).options).output != null(*u8) && !c_equal(
            (*(*driver).options).output,
            "-"
        ) {
            return c_driver_distinct_outputs(driver);
        }
    }
    return true;
}

// Require checked trees, assigned caller-owned link names, and a valid hosted entry or null.
// Keep the context, entry, source storage, and options live for the complete call.
// Retain input trees and names unchanged. Record failures in the caller's context.
// Return 0 on success, a failed tool's status, or 1 for another failure.
fn c_backend_build(context: *CrustContext, entry: *CrustDecl, options: *BackendOptions) -> i32 {
    return c_backend_build_with_body(
        context,
        entry,
        options,
        null(fn(*CStage, *CrustDecl, *u8) -> bool),
        null(*u8)
    );
}

// Require valid target types, layouts, signatures, parameter symbols, assigned link
// names, checked constant initializers, and a valid hosted entry or null.
// The callback owns each complete body; declaration.body may be null.
// Keep callback code and user storage live until this synchronous call returns.
// Null requires checked seed bodies and selects the default emitter.
// A false callback result or a new diagnostic fails the build.
fn c_backend_build_with_body(
    context: *CrustContext,
    entry: *CrustDecl,
    options: *BackendOptions,
    body: fn(*CStage, *CrustDecl, *u8) -> bool,
    user: *u8
) -> i32 {
    var stage: CStage = uninit;
    c_stage_init(&stage, context);
    var driver: CDriver = make CDriver {
        stage: &stage,
        options: options,
        command: null(**u8),
        temporary: null(*CDriverTemp),
        process_status: 0i32
    };
    var success: bool = c_driver_validate(&driver);
    if success {
        success = c_emit_with_body(&stage, entry, body, user);
    }
    if success {
        c_buffer_bytes(&stage.header, stage.body.data, stage.body.size);
        success = !stage.status.failed;
    }
    var result: i32 = c_driver_finish(&driver, success, c_driver_object);
    c_stage_destroy(&stage);
    return result;
}

fn c_driver_finish(
    driver: *CDriver,
    success: bool,
    compile: fn(*CDriver, *u8, *u8, u32) -> bool
) -> i32 {
    if success && (*driver -> options).mode < 2u32 {
        var capacity: usize = (*driver -> options).cflag_count;
        if (*driver -> options).ldflag_count > capacity {
            capacity = (*driver -> options).ldflag_count;
        }
        if capacity > 9223372036854775807usize / sizeof(*u8) - 16usize {
            success = c_driver_error(driver, "backend argument array size overflow");
        } else {
            driver -> command = c_alloc(
                &driver -> stage -> status,
                (capacity + 16usize) * sizeof(*u8),
                alignof(*u8)
            ) as **u8;
            success = !driver -> stage -> status.failed;
        }
    }
    if success && driver -> options -> mode != 3u32 {
        if (*driver -> options).mode == 2u32 {
            success = c_driver_dump(driver);
        } else {
            success = c_driver_compile(driver, compile);
        }
    }
    if !c_driver_cleanup(driver, null(*u8)) {
        c_driver_error(driver, "temporary cleanup failed");
        success = false;
    }
    var result: i32 = 0i32;
    if !success {
        result = driver -> process_status;
        if result == 0i32 {
            result = 1i32;
        }
    }
    return result;
}

fn c_driver_dump_temporary(
    driver: *CDriver,
    path: *u8,
    buffer: *CBuffer,
    temporary: **u8
) -> bool {
    var kind: i32 = c_driver_output_kind(driver, path);
    if kind < 0i32 {
        return false;
    }
    if kind == 2i32 {
        return true;
    }
    * temporary = c_driver_temporary(driver, path, c_driver_output_mode(driver, path));
    return *temporary != null(*u8) && c_driver_write(driver, *temporary, buffer);
}

// Invoke a caller-selected emitter on checked raw bodies. Preserve its diagnostic.
fn backend_output(
    context: *CrustContext,
    entry: *CrustDecl,
    options: *BackendOptions,
    emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32
) -> i32 {
    var diagnostic: CStatus = make CStatus {
        context: context,
        blocks: null(*CBlock),
        failed: context -> error_count != 0usize
    };
    if emit == null(fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32) {
        c_error(&diagnostic, null(*CrustSource), 0usize, "output callback is required");
        return 1i32;
    }
    var status: i32 = emit(context, entry, options);
    if status != 0i32 && context -> error_count == 0usize {
        c_error(
            &diagnostic,
            null(*CrustSource),
            0usize,
            "output callback failed without a diagnostic"
        );
    }
    if context -> error_count != 0usize && status == 0i32 {
        return 1i32;
    }
    return status;
}
