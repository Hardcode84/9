// This host interface applies to the Linux x86-64 LP64 profile.
record CDriverStat {
    device: u64;
    inode: u64;
    links: u64;
    mode: u32;
    uid: u32;
    gid: u32;
    padding: i32;
    special_device: u64;
    size: i64;
    block_size: i64;
    blocks: i64;
    access_seconds: i64;
    access_nanoseconds: u64;
    modify_seconds: i64;
    modify_nanoseconds: u64;
    change_seconds: i64;
    change_nanoseconds: u64;
    reserved: [i64; 3];
}

extern fn c_driver_lstat(path: *u8, info: *CDriverStat) -> i32 = "lstat";
extern fn c_driver_errno() -> *i32 = "__errno_location";
extern fn c_driver_strerror(number: i32) -> *u8 = "strerror";
extern fn c_driver_open(path: *u8, flags: i32, mode: u32) -> i32 = "open";
extern fn c_driver_entropy(bytes: *u8, count: usize) -> i32 = "getentropy";
extern fn c_driver_chmod(path: *u8, mode: u32) -> i32 = "chmod";
extern fn c_driver_umask(mask: u32) -> u32 = "umask";
extern fn c_driver_close(descriptor: i32) -> i32 = "close";
extern fn c_driver_unlink(path: *u8) -> i32 = "unlink";
extern fn c_driver_rename(source: *u8, destination: *u8) -> i32 = "rename";
extern fn c_driver_realpath(path: *u8, resolved: *u8) -> *u8 = "realpath";
extern fn c_driver_fork() -> i32 = "fork";
extern fn c_driver_execvp(file: *u8, arguments: **u8) -> i32 = "execvp";
extern fn c_driver_waitpid(pid: i32, status: *i32, options: i32) -> i32 = "waitpid";
extern fn c_driver_exit(status: i32) -> unit = "_exit";

fn c_driver_io_error(driver: *CDriver, action: *u8, path: *u8, number: i32) -> bool {
    var buffer: CBuffer = uninit;
    c_driver_buffer(&(*(*driver).stage).status, &buffer);
    c_buffer_text(&buffer, action);
    if path != null(*u8) {
        c_buffer_text(&buffer, " '");
        c_buffer_text(&buffer, path);
        c_buffer_text(&buffer, "'");
    }
    c_buffer_text(&buffer, ": ");
    c_buffer_text(&buffer, c_driver_strerror(number));
    var message: *u8 = c_buffer_end(&buffer);
    if message != null(*u8) {
        c_driver_error(driver, message);
    }
    return false;
}

fn c_driver_temporary_name(driver: *CDriver, destination: *u8) -> *u8 {
    var random: [u8; 16] = uninit;
    if c_driver_entropy(&random[0usize], 16usize) != 0i32 {
        c_driver_io_error(
            driver,
            "cannot obtain temporary randomness",
            destination,
            *c_driver_errno()
        );
        return null(*u8);
    }
    var directory: usize = 0usize;
    var index: usize = 0usize;
    while destination[index] != 0u8 {
        if destination[index] == 47u8 {
            directory = index + 1usize;
        }
        index = index + 1usize;
    }
    var buffer: CBuffer = uninit;
    c_driver_buffer(&(*(*driver).stage).status, &buffer);
    if destination[0usize] != 47u8 &&!(
        destination[0usize] == 46u8 && destination[1usize] == 47u8
    ) {
        c_buffer_text(&buffer, "./");
    }
    c_buffer_bytes(&buffer, destination, directory);
    c_buffer_text(&buffer, ".crust-");
    var digits: *u8 = "0123456789abcdef";
    index = 0usize;
    while index < 16usize {
        c_buffer_bytes(&buffer, &digits[(random[index] >> 4u8) as usize], 1usize);
        c_buffer_bytes(&buffer, &digits[(random[index] & 15u8) as usize], 1usize);
        index = index + 1usize;
    }
    return c_buffer_end(&buffer);
}

fn c_driver_output_mode(driver: *CDriver, path: *u8) -> u32 {
    var info: CDriverStat = uninit;
    if c_driver_lstat(path, &info) == 0i32 {
        if (info.mode & 61440u32) != 32768u32 {
            c_driver_error(driver, "output changed to a nonregular file");
            return 0u32;
        }
        // The toolchain must read and write the temporary before publication.
        return (info.mode & 511u32) | 384u32;
    }
    if *c_driver_errno() == 2i32 {
        return 511u32;
    }
    c_driver_io_error(driver, "cannot inspect output permissions", path, *c_driver_errno());
    return 0u32;
}

fn c_driver_temporary(driver: *CDriver, destination: *u8, mode: u32) -> *u8 {
    if mode == 0u32 {
        return null(*u8);
    }
    var item: *CDriverTemp = c_alloc(
        &(*(*driver).stage).status,
        sizeof(CDriverTemp),
        alignof(CDriverTemp)
    ) as *CDriverTemp;
    if item == null(*CDriverTemp) {
        return null(*u8);
    }
    var attempt: usize = 0usize;
    while attempt < 128usize {
        var path: *u8 = c_driver_temporary_name(driver, destination);
        if path == null(*u8) {
            return null(*u8);
        }
        // Linux O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC.
        var descriptor: i32 = c_driver_open(path, 524481i32, mode & 438u32);
        if descriptor >= 0i32 {
            *item = make CDriverTemp {
                path: path,
                next: (*driver).temporary
            };
            (*driver).temporary = item;
            if c_driver_close(descriptor) == 0i32 {
                return path;
            }
            c_driver_io_error(driver, "cannot close temporary", path, *c_driver_errno());
            return null(*u8);
        }
        var error: i32 = *c_driver_errno();
        if error != 17i32 {
            c_driver_io_error(driver, "cannot create temporary for", destination, error);
            return null(*u8);
        }
        attempt = attempt + 1usize;
    }
    c_driver_io_error(driver, "cannot create temporary for", destination, 17i32);
    return null(*u8);
}

fn c_driver_cleanup(driver: *CDriver, keep: *u8) -> bool {
    var success: bool = true;
    var item: *CDriverTemp = (*driver).temporary;
    while item != null(*CDriverTemp) {
        if keep == null(*u8) || !c_equal((*item).path, keep) {
            if c_driver_unlink((*item).path) != 0i32 && *c_driver_errno() != 2i32 {
                var prefix: *u8 = "cannot remove temporary '";
                crust0_host_write_stream(2u32, prefix, c_length(prefix));
                crust0_host_write_stream(
                    2u32,
                    (*item).path,
                    c_length((*item).path)
                );
                crust0_host_write_stream(2u32, "'\n", 2usize);
                success = false;
            }
        }
        item = (*item).next;
    }
    return success;
}

// Return 0 for an absent path, 1 for a regular file, and 2 for another file kind.

fn c_driver_output_kind(driver: *CDriver, path: *u8) -> i32 {
    var info: CDriverStat = uninit;
    if c_driver_lstat(path, &info) == 0i32 {
        if (info.mode & 61440u32) == 32768u32 {
            return 1i32;
        }
        return 2i32;
    }
    var error: i32 = *c_driver_errno();
    if error == 2i32 {
        return 0i32;
    }
    c_driver_io_error(driver, "cannot inspect output", path, error);
    return -1i32;
}

fn c_driver_write(driver: *CDriver, path: *u8, buffer: *CBuffer) -> bool {
    if crust0_host_write_file(path, (*buffer).data, (*buffer).size) != 0i32 {
        return c_driver_io_error(driver, "cannot write output", path, *c_driver_errno());
    }
    return true;
}

fn c_driver_publish(driver: *CDriver, temporary: *u8, output: *u8) -> bool {
    var info: CDriverStat = uninit;
    if c_driver_lstat(output, &info) == 0i32 {
        if (info.mode & 61440u32) != 32768u32 {
            return c_driver_error(driver, "output changed to a nonregular file");
        }
        if c_driver_chmod(temporary, info.mode & 511u32) != 0i32 {
            return c_driver_io_error(
                driver,
                "cannot set output permissions",
                output,
                *c_driver_errno()
            );
        }
    } else {
        if *c_driver_errno() != 2i32 {
            return c_driver_io_error(
                driver,
                "cannot inspect output permissions",
                output,
                *c_driver_errno()
            );
        }
    }
    if c_driver_rename(temporary, output) != 0i32 {
        return c_driver_io_error(driver, "cannot publish output", output, *c_driver_errno());
    }
    return true;
}

fn c_driver_run(driver: *CDriver, count: usize, mode: u32) -> bool {
    (*driver).command[count] = null(*u8);
    var pid: i32 = c_driver_fork();
    if pid < 0i32 {
        return c_driver_io_error(
            driver,
            "cannot start",
            (*driver).command[0usize],
            *c_driver_errno()
        );
    }
    if pid == 0i32 {
        // Change only the child mask. Linkers add execute bits before publication.
        var inherited_mask: u32 = c_driver_umask(0u32);
        c_driver_umask(inherited_mask | ((~mode) & 511u32));
        c_driver_execvp((*driver).command[0usize], (*driver).command);
        var prefix: *u8 = "cannot execute ";
        crust0_host_write_stream(2u32, prefix, c_length(prefix));
        crust0_host_write_stream(
            2u32,
            (*driver).command[0usize],
            c_length((*driver).command[0usize])
        );
        crust0_host_write_stream(2u32, "\n", 1usize);
        c_driver_exit(127i32);
        trap;
    }
    var status: i32 = 0i32;
    while true {
        var result: i32 = c_driver_waitpid(pid, &status, 0i32);
        if result == pid {
            break;
        }
        if result < 0i32 && *c_driver_errno() == 4i32 {
            continue;
        }
        return c_driver_io_error(
            driver,
            "cannot wait for",
            (*driver).command[0usize],
            *c_driver_errno()
        );
    }
    if (status & 127i32) == 0i32 {
        (*driver).process_status = (status >> 8i32) & 255i32;
    } else {
        (*driver).process_status = 128i32 + (status & 127i32);
    }
    if (*driver).process_status == 0i32 {
        return true;
    }
    var message: CBuffer = uninit;
    c_driver_buffer(&(*(*driver).stage).status, &message);
    c_buffer_text(&message, (*driver).command[0usize]);
    c_buffer_text(&message, " failed with status ");
    c_buffer_number(&message, (*driver).process_status as u64);
    var text: *u8 = c_buffer_end(&message);
    if text != null(*u8) {
        c_driver_error(driver, text);
    }
    return false;
}

fn c_driver_canonical(driver: *CDriver, path: *u8) -> *u8 {
    var status: *CStatus = &(*(*driver).stage).status;
    var resolved: *u8 = c_driver_realpath(path, null(*u8));
    if resolved != null(*u8) {
        var copied: *u8 = c_driver_join(status, resolved, "");
        crust0_host_free(resolved);
        return copied;
    }
    var error: i32 = *c_driver_errno();
    if error != 2i32 {
        c_driver_io_error(driver, "cannot resolve paired output", path, error);
        return null(*u8);
    }
    var info: CDriverStat = uninit;
    if c_driver_lstat(path, &info) == 0i32 {
        c_driver_error(driver, "paired outputs require resolvable symbolic links");
        return null(*u8);
    }
    error = *c_driver_errno();
    if error != 2i32 {
        c_driver_io_error(driver, "cannot inspect paired output", path, error);
        return null(*u8);
    }
    var size: usize = c_length(path);
    if size == 0usize {
        c_driver_error(driver, "empty output path");
        return null(*u8);
    }
    var split: usize = size;
    while split != 0usize && path[split - 1usize] != 47u8 {
        split = split - 1usize;
    }
    var parent: CBuffer = uninit;
    c_driver_buffer(status, &parent);
    if split == 0usize {
        c_buffer_text(&parent, ".");
    } else {
        c_buffer_bytes(&parent, path, split);
    }
    var parent_path: *u8 = c_buffer_end(&parent);
    if (*status).failed {
        return null(*u8);
    }
    resolved = c_driver_realpath(parent_path, null(*u8));
    if resolved == null(*u8) {
        c_driver_io_error(
            driver,
            "cannot resolve output directory",
            parent_path,
            *c_driver_errno()
        );
        return null(*u8);
    }
    var result: CBuffer = uninit;
    c_driver_buffer(status, &result);
    c_buffer_text(&result, resolved);
    if resolved[c_length(resolved) - 1usize] != 47u8 {
        c_buffer_text(&result, "/");
    }
    c_buffer_bytes(&result, &path[split], size - split);
    crust0_host_free(resolved);
    return c_buffer_end(&result);
}

fn c_driver_distinct_outputs(driver: *CDriver) -> bool {
    var output_path: *u8 = c_driver_canonical(driver, (*(*driver).options).output);
    if output_path == null(*u8) {
        return false;
    }
    var symbols_path: *u8 = c_driver_canonical(driver, (*(*driver).options).symbols);
    if symbols_path == null(*u8) {
        return false;
    }
    if c_equal(output_path, symbols_path) {
        return c_driver_error(driver, "text and symbol outputs must name separate destinations");
    }
    var output_info: CDriverStat = uninit;
    var symbols_info: CDriverStat = uninit;
    var output_exists: bool = c_driver_lstat(output_path, &output_info) == 0i32;
    if !output_exists && *c_driver_errno() != 2i32 {
        return c_driver_io_error(
            driver,
            "cannot inspect paired output",
            output_path,
            *c_driver_errno()
        );
    }
    var symbols_exist: bool = c_driver_lstat(symbols_path, &symbols_info) == 0i32;
    if !symbols_exist && *c_driver_errno() != 2i32 {
        return c_driver_io_error(
            driver,
            "cannot inspect paired output",
            symbols_path,
            *c_driver_errno()
        );
    }
    if output_exists && symbols_exist && output_info.device == symbols_info.device && output_info.inode == symbols_info.inode {
        return c_driver_error(driver, "text and symbol outputs must name separate files");
    }
    return true;
}

fn c_driver_read_error(driver: *CDriver, path: *u8) -> bool {
    return c_driver_io_error(driver, "cannot read input", path, *c_driver_errno());
}
