fn c_signed(input: *CrustType) -> bool {
    var kind: u32 = (*input).kind;
    return kind == CRUST_T_I8 || kind == CRUST_T_I16 || kind == CRUST_T_I32 ||
           kind == CRUST_T_I64 || kind == CRUST_T_ISIZE;
}

fn c_integer(input: *CrustType) -> bool { return (*input).kind <= CRUST_T_USIZE; }

fn c_value(stage: *CStage, identity: usize) -> unit {
    c_text(stage, "r_v");
    c_number(stage, identity as u64);
}

fn c_temp(stage: *CStage, input: *CrustType) -> usize {
    var identity: usize = (*stage).next_temp;
    (*stage).next_temp = identity + 1usize;
    c_type_name(stage, input);
    c_text(stage, " ");
    c_value(stage, identity);
    return identity;
}

fn c_address_temp(stage: *CStage) -> usize {
    var identity: usize = (*stage).next_temp;
    (*stage).next_temp = identity + 1usize;
    c_text(stage, "void *");
    c_value(stage, identity);
    return identity;
}

fn c_symbol(stage: *CStage, input: *CrustSymbol) -> unit {
    var identity: usize = c_map_get(&(*stage).symbols, input as usize);
    if identity == 0usize {
        identity = (*stage).next_symbol;
        (*stage).next_symbol = identity + 1usize;
        c_map_set(&(*stage).status, &(*stage).symbols, input as usize, identity);
    }
    c_text(stage, "r_l");
    c_number(stage, identity as u64);
}

fn c_unsigned_name(stage: *CStage, input: *CrustType) -> unit {
    c_text(stage, "uint");
    c_number(stage, (*input).size * 8u64);
    c_text(stage, "_t");
}

fn c_wrap_begin(stage: *CStage, input: *CrustType) -> unit {
    if c_signed(input) {
        c_text(stage, "r_i");
        c_number(stage, (*input).size * 8u64);
        c_text(stage, "((");
    } else { c_text(stage, "(("); }
    c_unsigned_name(stage, input);
    c_text(stage, ")(");
}

fn c_literal(stage: *CStage, input: *CrustType, number: u64) -> unit {
    if (*input).kind == CRUST_T_BOOL {
        if number == 0u64 { c_text(stage, "false"); }
        else { c_text(stage, "true"); }
        return;
    }
    var bits: u64 = (*input).size * 8u64;
    var mask: u64 = 18446744073709551615u64;
    if bits < 64u64 { mask = (1u64 << bits) - 1u64; }
    var raw: u64 = number & mask;
    c_text(stage, "((");
    c_type_name(stage, input);
    c_text(stage, ")");
    if c_signed(input) {
        if (raw & (1u64 << (bits - 1u64))) != 0u64 {
            var magnitude: u64 = (0u64 - raw) & mask;
            if magnitude == 9223372036854775808u64 {
                c_text(stage, "(-INT64_C(9223372036854775807)-INT64_C(1))");
            } else {
                c_text(stage, "(-INT64_C(");
                c_number(stage, magnitude);
                c_text(stage, "))");
            }
        } else {
            c_text(stage, "INT64_C(");
            c_number(stage, raw);
            c_text(stage, ")");
        }
    } else {
        c_text(stage, "UINT64_C(");
        c_number(stage, raw);
        c_text(stage, ")");
    }
    c_text(stage, ")");
}

fn c_load(stage: *CStage, input: *CrustType, address: usize) -> usize {
    var result: usize = c_temp(stage, input);
    c_text(stage, ";\n__builtin_memcpy(&");
    c_value(stage, result);
    c_text(stage, ",");
    c_value(stage, address);
    c_text(stage, ",");
    c_number(stage, (*input).size);
    c_text(stage, "u);\n");
    return result;
}

fn c_place(stage: *CStage, input: *CrustExpr) -> usize {
    if (*stage).status.failed { return 0usize; }
    var kind: u32 = (*input).kind;
    if kind == CRUST_E_GROUP { return c_place(stage, (*input).left); }
    if kind == CRUST_E_UNARY && (*input).op == CRUST_OP_DEREF {
        return c_expression(stage, (*input).left);
    }
    if kind == CRUST_E_NAME {
        var result: usize = c_address_temp(stage);
        c_text(stage, "=(void*)&");
        var symbol: *CrustSymbol = (*input).symbol;
        if (*symbol).kind == CRUST_SYM_CONST { c_global(stage, (*symbol).decl); }
        else { c_symbol(stage, symbol); }
        c_text(stage, ";\n");
        return result;
    }
    if kind == CRUST_E_FIELD || kind == CRUST_E_INDEX {
        var left: *CrustExpr = (*input).left;
        var pointer: bool = (*(*left).type).kind == CRUST_T_POINTER;
        var base: usize = 0usize;
        var temporary: bool = false;
        if pointer { base = c_expression(stage, left); }
        else {
            if (*left).place { base = c_place(stage, left); }
            else { base = c_expression(stage, left); temporary = true; }
        }
        var index: usize = 0usize;
        if kind == CRUST_E_INDEX { index = c_expression(stage, (*input).right); }
        var result: usize = c_address_temp(stage);
        c_text(stage, "=r_addr((uintptr_t)");
        if temporary { c_text(stage, "&"); }
        c_value(stage, base);
        c_text(stage, "+");
        if kind == CRUST_E_FIELD { c_number(stage, (*(*input).field).offset); c_text(stage, "u"); }
        else {
            c_text(stage, "(uintptr_t)"); c_value(stage, index);
            c_text(stage, "*"); c_number(stage, (*(*input).type).size); c_text(stage, "u");
        }
        c_text(stage, ");\n");
        return result;
    }
    trap;
}

fn c_binary(stage: *CStage, input: *CrustExpr) -> usize {
    var operation: u32 = (*input).op;
    var left: usize = c_expression(stage, (*input).left);
    if operation == CRUST_OP_AND || operation == CRUST_OP_OR {
        var result: usize = c_temp(stage, (*input).type);
        c_text(stage, "="); c_value(stage, left); c_text(stage, ";\nif(");
        if operation == CRUST_OP_OR { c_text(stage, "!"); }
        c_value(stage, left); c_text(stage, "){\n");
        var right: usize = c_expression(stage, (*input).right);
        c_value(stage, result); c_text(stage, "="); c_value(stage, right); c_text(stage, ";\n}\n");
        return result;
    }
    var right: usize = c_expression(stage, (*input).right);
    var input_type: *CrustType = (*(*input).left).type;
    if operation == CRUST_OP_DIV || operation == CRUST_OP_REM {
        c_text(stage, "if("); c_value(stage, right); c_text(stage, "==0");
        if c_signed(input_type) {
            c_text(stage, "||("); c_value(stage, left); c_text(stage, "==");
            c_literal(stage, input_type, 1u64 << ((*input_type).size * 8u64 - 1u64));
            c_text(stage, "&&"); c_value(stage, right); c_text(stage, "==-1)");
        }
        c_text(stage, ")__builtin_trap();\n");
    }
    if operation == CRUST_OP_SHL || operation == CRUST_OP_SHR {
        c_text(stage, "if((uint64_t)"); c_value(stage, right); c_text(stage, ">=");
        c_number(stage, (*input_type).size * 8u64); c_text(stage, "u)__builtin_trap();\n");
    }
    var result: usize = c_temp(stage, (*input).type);
    c_text(stage, "=");
    if (*input_type).kind == CRUST_T_POINTER {
        if operation == CRUST_OP_ADD || operation == CRUST_OP_SUB {
            c_text(stage, "r_addr((uintptr_t)"); c_value(stage, left);
            if operation == CRUST_OP_ADD { c_text(stage, "+"); } else { c_text(stage, "-"); }
            c_text(stage, "(uintptr_t)"); c_value(stage, right); c_text(stage, "*");
            c_number(stage, (*(*input_type).base).size); c_text(stage, "u);\n");
            return result;
        }
    }
    var wrap: bool = operation == CRUST_OP_ADD || operation == CRUST_OP_SUB || operation == CRUST_OP_MUL ||
        operation == CRUST_OP_BIT_AND || operation == CRUST_OP_BIT_OR || operation == CRUST_OP_BIT_XOR ||
        operation == CRUST_OP_SHL;
    if wrap { c_wrap_begin(stage, (*input).type); c_text(stage, "(uint64_t)"); }
    c_value(stage, left);
    if operation == CRUST_OP_ADD { c_text(stage, "+"); }
    else { if operation == CRUST_OP_SUB { c_text(stage, "-"); }
    else { if operation == CRUST_OP_MUL { c_text(stage, "*"); }
    else { if operation == CRUST_OP_DIV { c_text(stage, "/"); }
    else { if operation == CRUST_OP_REM { c_text(stage, "%"); }
    else { if operation == CRUST_OP_BIT_AND { c_text(stage, "&"); }
    else { if operation == CRUST_OP_BIT_OR { c_text(stage, "|"); }
    else { if operation == CRUST_OP_BIT_XOR { c_text(stage, "^"); }
    else { if operation == CRUST_OP_SHL { c_text(stage, "<<"); }
    else { if operation == CRUST_OP_SHR { c_text(stage, ">>"); }
    else { if operation == CRUST_OP_EQ { c_text(stage, "=="); }
    else { if operation == CRUST_OP_NE { c_text(stage, "!="); }
    else { if operation == CRUST_OP_LT { c_text(stage, "<"); }
    else { if operation == CRUST_OP_LE { c_text(stage, "<="); }
    else { if operation == CRUST_OP_GT { c_text(stage, ">"); }
    else { if operation == CRUST_OP_GE { c_text(stage, ">="); }
    else { trap; } } } } } } } } } } } } } } } }
    if wrap { c_text(stage, "(uint64_t)"); }
    c_value(stage, right);
    if wrap { c_text(stage, "))"); }
    c_text(stage, ";\n");
    return result;
}

fn c_expression(stage: *CStage, input: *CrustExpr) -> usize {
    if (*stage).status.failed { return 0usize; }
    var kind: u32 = (*input).kind;
    if kind == CRUST_E_GROUP { return c_expression(stage, (*input).left); }
    if kind == CRUST_E_BINARY { return c_binary(stage, input); }
    if kind == CRUST_E_NAME && (*(*input).symbol).kind != CRUST_SYM_FUNCTION {
        var input_type: *CrustType = (*input).type;
        if (*input_type).kind != CRUST_T_ARRAY && (*input_type).kind != CRUST_T_RECORD {
            var result: usize = c_temp(stage, input_type);
            c_text(stage, "=");
            if (*(*input).symbol).kind == CRUST_SYM_CONST { c_global(stage, (*(*input).symbol).decl); }
            else { c_symbol(stage, (*input).symbol); }
            c_text(stage, ";\n");
            return result;
        }
        var address: usize = c_place(stage, input);
        return c_load(stage, (*input).type, address);
    }
    if kind == CRUST_E_FIELD || kind == CRUST_E_INDEX ||
       (kind == CRUST_E_UNARY && (*input).op == CRUST_OP_DEREF) {
        var address: usize = c_place(stage, input);
        return c_load(stage, (*input).type, address);
    }
    if kind == CRUST_E_UNARY && (*input).op == CRUST_OP_ADDRESS {
        return c_place(stage, (*input).left);
    }
    if kind == CRUST_E_CALL {
        var callee: usize = c_expression(stage, (*input).left);
        var arguments: *usize = c_alloc(&(*stage).status, (*input).arg_count * sizeof(usize), alignof(usize)) as *usize;
        if (*stage).status.failed { return 0usize; }
        var index: usize = 0usize;
        while index < (*input).arg_count {
            arguments[index] = c_expression(stage, (*input).args[index]);
            index = index + 1usize;
        }
        var result: usize = 0usize;
        if (*(*input).type).kind != CRUST_T_UNIT {
            result = c_temp(stage, (*input).type); c_text(stage, "=");
        }
        c_value(stage, callee); c_text(stage, "(");
        index = 0usize;
        while index < (*input).arg_count {
            if index != 0usize { c_text(stage, ","); }
            c_value(stage, arguments[index]);
            index = index + 1usize;
        }
        c_text(stage, ");\n");
        return result;
    }
    if kind == CRUST_E_RECORD || kind == CRUST_E_ARRAY {
        var result: usize = c_temp(stage, (*input).type);
        c_text(stage, ";\n");
        var initializer: *CrustInit = (*input).inits;
        var index: usize = 0usize;
        while initializer != null(*CrustInit) || index < (*input).arg_count {
            var item: *CrustExpr = null(*CrustExpr);
            var offset: u64 = 0u64;
            if kind == CRUST_E_RECORD {
                item = (*initializer).value;
                offset = (*(*initializer).field).offset;
                initializer = (*initializer).next;
            } else {
                item = (*input).args[index];
                offset = index as u64 * (*(*(*input).type).base).size;
                index = index + 1usize;
            }
            var value: usize = c_expression(stage, item);
            c_text(stage, "__builtin_memcpy((unsigned char*)&"); c_value(stage, result);
            c_text(stage, "+"); c_number(stage, offset); c_text(stage, "u,&"); c_value(stage, value);
            c_text(stage, ","); c_number(stage, (*(*item).type).size); c_text(stage, "u);\n");
        }
        return result;
    }
    var operand: usize = 0usize;
    if kind == CRUST_E_UNARY || kind == CRUST_E_CAST { operand = c_expression(stage, (*input).left); }
    var result: usize = c_temp(stage, (*input).type);
    c_text(stage, "=");
    if kind == CRUST_E_NAME { c_global(stage, (*(*input).symbol).decl); }
    else { if kind == CRUST_E_INTEGER || kind == CRUST_E_BOOL || kind == CRUST_E_SIZEOF ||
              kind == CRUST_E_ALIGNOF || kind == CRUST_E_OFFSETOF {
        c_literal(stage, (*input).type, (*input).integer);
    } else { if kind == CRUST_E_STRING {
        c_text(stage, "(void*)"); c_quote(stage, (*input).bytes, (*input).byte_count - 1usize);
    } else { if kind == CRUST_E_NULL { c_text(stage, "0"); }
    else { if kind == CRUST_E_UNARY {
        if (*input).op == CRUST_OP_NOT { c_text(stage, "!"); c_value(stage, operand); }
        else {
            c_wrap_begin(stage, (*input).type);
            if (*input).op == CRUST_OP_NEG { c_text(stage, "UINT64_C(0)-(uint64_t)"); }
            else { if (*input).op == CRUST_OP_BIT_NOT { c_text(stage, "~(uint64_t)"); }
                   else { trap; } }
            c_value(stage, operand); c_text(stage, "))");
        }
    } else { if kind == CRUST_E_CAST {
        var target: *CrustType = (*input).type;
        if (*target).kind == CRUST_T_POINTER {
            c_text(stage, "r_addr((uintptr_t)"); c_value(stage, operand); c_text(stage, ")");
        } else { if (*target).kind == CRUST_T_BOOL {
            c_text(stage, "("); c_value(stage, operand); c_text(stage, "!=0)");
        } else { if c_integer(target) {
            c_wrap_begin(stage, target);
            if (*(*(*input).left).type).kind == CRUST_T_POINTER { c_text(stage, "(uintptr_t)"); }
            c_value(stage, operand); c_text(stage, "))");
        } else { c_value(stage, operand); } } }
    } else { trap; } } } } } }
    c_text(stage, ";\n");
    return result;
}

fn c_statement(stage: *CStage, input: *CrustStmt) -> unit {
    if (*stage).status.failed { return; }
    var kind: u32 = (*input).kind;
    if kind == CRUST_S_BLOCK {
        c_text(stage, "{\n");
        var child: *CrustStmt = (*input).body;
        while child != null(*CrustStmt) { c_statement(stage, child); child = (*child).next; }
        c_text(stage, "}\n");
        return;
    }
    if kind == CRUST_S_VAR {
        var value: usize = 0usize;
        if !(*input).uninitialized { value = c_expression(stage, (*input).value); }
        var variable_type: *CrustType = (*(*input).symbol).type;
        c_type_name(stage, variable_type); c_text(stage, " "); c_symbol(stage, (*input).symbol); c_text(stage, ";\n");
        if !(*input).uninitialized {
            c_text(stage, "__builtin_memcpy(&"); c_symbol(stage, (*input).symbol);
            c_text(stage, ",&"); c_value(stage, value); c_text(stage, ",");
            c_number(stage, (*variable_type).size); c_text(stage, "u);\n");
        }
        return;
    }
    if kind == CRUST_S_ASSIGN {
        var address: usize = c_place(stage, (*input).expr);
        var value: usize = c_expression(stage, (*input).value);
        c_text(stage, "__builtin_memcpy("); c_value(stage, address); c_text(stage, ",&"); c_value(stage, value);
        c_text(stage, ","); c_number(stage, (*(*(*input).expr).type).size); c_text(stage, "u);\n");
        return;
    }
    if kind == CRUST_S_EXPR { c_expression(stage, (*input).expr); return; }
    if kind == CRUST_S_RETURN {
        var value: usize = 0usize;
        if (*input).expr != null(*CrustExpr) { value = c_expression(stage, (*input).expr); }
        c_text(stage, "return");
        if value != 0usize { c_text(stage, " "); c_value(stage, value); }
        c_text(stage, ";\n");
        return;
    }
    if kind == CRUST_S_IF {
        var condition: usize = c_expression(stage, (*input).expr);
        c_text(stage, "if("); c_value(stage, condition); c_text(stage, ")");
        c_statement(stage, (*input).body);
        if (*input).otherwise != null(*CrustStmt) { c_text(stage, "else "); c_statement(stage, (*input).otherwise); }
        return;
    }
    if kind == CRUST_S_WHILE {
        c_text(stage, "while(1){\n");
        var condition: usize = c_expression(stage, (*input).expr);
        c_text(stage, "if(!"); c_value(stage, condition); c_text(stage, ")break;\n");
        c_statement(stage, (*input).body);
        c_text(stage, "}\n");
        return;
    }
    if kind == CRUST_S_BREAK { c_text(stage, "break;\n"); return; }
    if kind == CRUST_S_CONTINUE { c_text(stage, "continue;\n"); return; }
    if kind == CRUST_S_TRAP { c_text(stage, "__builtin_trap();\n"); return; }
    trap;
}

fn c_constant(stage: *CStage, input: *CrustExpr) -> unit {
    if (*stage).status.failed { return; }
    var kind: u32 = (*input).kind;
    if kind == CRUST_E_GROUP { c_constant(stage, (*input).left); return; }
    if kind == CRUST_E_UNARY {
        c_literal(stage, (*input).type, 0u64 - (*(*input).left).integer); return;
    }
    if kind == CRUST_E_INTEGER || kind == CRUST_E_BOOL || kind == CRUST_E_SIZEOF ||
       kind == CRUST_E_ALIGNOF || kind == CRUST_E_OFFSETOF {
        c_literal(stage, (*input).type, (*input).integer); return;
    }
    if kind == CRUST_E_STRING {
        c_text(stage, "(void*)"); c_quote(stage, (*input).bytes, (*input).byte_count - 1usize); return;
    }
    if kind == CRUST_E_NULL { c_text(stage, "0"); return; }
    if kind == CRUST_E_NAME { c_global(stage, (*(*input).symbol).decl); return; }
    if kind == CRUST_E_RECORD {
        c_text(stage, "{");
        var initializer: *CrustInit = (*input).inits;
        while initializer != null(*CrustInit) {
            c_text(stage, ".r_f"); c_number(stage, (*(*initializer).field).index as u64);
            c_text(stage, "="); c_constant(stage, (*initializer).value); c_text(stage, ",");
            initializer = (*initializer).next;
        }
        c_text(stage, "}"); return;
    }
    if kind == CRUST_E_ARRAY {
        c_text(stage, "{{");
        var index: usize = 0usize;
        while index < (*input).arg_count {
            if index != 0usize { c_text(stage, ","); }
            c_constant(stage, (*input).args[index]); index = index + 1usize;
        }
        c_text(stage, "}}"); return;
    }
    trap;
}

// Require a valid function signature and its parameter symbols.
// Start the definition. The caller must emit its complete body.
fn c_function_header(stage: *CStage, declaration: *CrustDecl) -> unit {
    (*stage).next_temp = 1usize;
    c_type_name(stage, (*(*declaration).type).base); c_text(stage, " ");
    c_global(stage, declaration); c_text(stage, "(");
    var parameter: *CrustParam = (*declaration).params;
    if parameter == null(*CrustParam) { c_text(stage, "void"); }
    while parameter != null(*CrustParam) {
        c_type_name(stage, (*parameter).type); c_text(stage, " "); c_symbol(stage, (*parameter).symbol);
        parameter = (*parameter).next;
        if parameter != null(*CrustParam) { c_text(stage, ","); }
    }
    c_text(stage, ")\n");
}

fn c_function(stage: *CStage, declaration: *CrustDecl) -> unit {
    c_function_header(stage, declaration);
    c_statement(stage, (*declaration).body);
}

fn c_prelude(stage: *CStage) -> unit {
    c_text(stage, "/* Generated by the CRUST0 C metastage. */\n");
    c_text(stage, "#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n#include <limits.h>\n");
    c_text(stage, "#if !defined(__GNUC__) || !defined(__linux__) || !defined(__x86_64__)\n#error CRUST0 C output requires GCC on Linux x86-64\n#endif\n");
    c_text(stage, "typedef char r_profile[(CHAR_BIT==8 && sizeof(void*)==8 && sizeof(uintptr_t)==8 && sizeof(long)==8 && sizeof(bool)==1 && sizeof(void(*)(void))==8)?1:-1];\n");
    c_text(stage, "static inline void *r_addr(uintptr_t x){void *p;__asm__(\"\" : \"=r\"(p) : \"0\"(x));return p;}\n");
    var bits: u64 = 8u64;
    while bits <= 64u64 {
        c_text(stage, "static inline int"); c_number(stage, bits); c_text(stage, "_t r_i"); c_number(stage, bits);
        c_text(stage, "(uint"); c_number(stage, bits); c_text(stage, "_t x){int"); c_number(stage, bits);
        c_text(stage, "_t y;__builtin_memcpy(&y,&x,sizeof y);return y;}\n");
        bits = bits * 2u64;
    }
}

// Require checked trees, assigned link names, and a valid hosted entry or null.
// Use a newly initialized stage for each emission.
// The caller owns the input. Output buffers remain live until stage destruction.
fn c_emit(stage: *CStage, entry: *CrustDecl) -> bool {
    return c_emit_with_body(stage, entry, null(fn(*CStage,*CrustDecl,*u8)->bool), null(*u8));
}

// Require a fresh stage, valid target types, layouts, signatures, parameter symbols,
// assigned link names, checked constant initializers, and a valid hosted entry or null.
// The callback emits a complete function body, including braces, after its signature.
// A selected callback owns body semantics; declaration.body may be null.
// Node helpers require checked nodes. Name, type, and text helpers remain available.
// Calls are synchronous. Keep callback code and user storage live through this call.
// Null requires checked seed bodies and selects the default emitter.
// False or a new diagnostic stops emission. False without a diagnostic records one.
fn c_emit_with_body(stage: *CStage, entry: *CrustDecl,
                    body: fn(*CStage,*CrustDecl,*u8)->bool, user: *u8) -> bool {
    (*stage).entry = entry;
    (*stage).sink = &(*stage).body;
    var context: *CrustContext = (*stage).status.context;
    var parsed: *CrustUnit = (*context).units;
    while parsed != null(*CrustUnit) {
        var declaration: *CrustDecl = (*parsed).declarations;
        while declaration != null(*CrustDecl) {
            if (*declaration).kind != CRUST_D_RECORD {
                c_bind(stage, declaration, (*declaration).kind != CRUST_D_EXTERN);
            }
            declaration = (*declaration).next;
        }
        parsed = (*parsed).next;
    }
    if (*stage).status.failed { return false; }
    parsed = (*context).units;
    while parsed != null(*CrustUnit) {
        var declaration: *CrustDecl = (*parsed).declarations;
        while declaration != null(*CrustDecl) {
            if (*declaration).kind == CRUST_D_FUNCTION {
                if body == null(fn(*CStage,*CrustDecl,*u8)->bool) {
                    c_function(stage, declaration);
                } else {
                    c_function_header(stage, declaration);
                    if (*stage).status.failed { return false; }
                    var errors: usize = (*context).error_count;
                    var success: bool = body(stage, declaration, user);
                    if (*stage).status.failed { return false; }
                    if (*context).error_count != errors {
                        (*stage).status.failed = true;
                        return false;
                    }
                    if !success {
                        c_error(&(*stage).status, (*declaration).loc.source, (*declaration).loc.offset,
                                "C function body callback failed");
                        return false;
                    }
                }
            }
            if (*declaration).kind == CRUST_D_CONST {
                c_type_name(stage, (*declaration).type); c_text(stage, " const ");
                c_global(stage, declaration); c_text(stage, "="); c_constant(stage, (*declaration).init);
                c_text(stage, ";\n");
            }
            declaration = (*declaration).next;
        }
        parsed = (*parsed).next;
    }
    if entry != null(*CrustDecl) {
        c_text(stage, "int main(int argc,char **argv){return "); c_global(stage, entry);
        c_text(stage, "((int32_t)argc,(void*)argv);}\n");
    }
    if (*stage).status.failed { return false; }
    (*stage).sink = &(*stage).header;
    c_prelude(stage);
    c_emit_types(stage);
    c_emit_prototypes(stage);
    c_emit_renames(stage);
    return !(*stage).status.failed;
}
