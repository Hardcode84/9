fn main(argc: i32, argv: **u8) -> i32 {
    if argc == 2i32 && c_equal(argv[1usize], "--help") {
        if c_driver_usage() { return 0i32; }
        c_driver_stderr("crust-c: cannot write standard output\n");
        return 1i32;
    }
    if argc == 2i32 && c_equal(argv[1usize], "--version") {
        var text: *u8 = "crust-c (CRUST0 C stage, Linux x86-64 LP64)\n";
        if crust0_host_write_stream(1u32, text, c_length(text)) == 0i32 { return 0i32; }
        c_driver_stderr("crust-c: cannot write standard output\n");
        return 1i32;
    }
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var cli: CCli = uninit;
    var result: i32 = 1i32;
    if c_driver_init(&cli, &context, argc) && c_driver_parse(&cli, argc, argv, 1i32) {
        result = c_driver_build(&cli);
    }
    if result != 0i32 && context.error_count != 0usize { c_driver_diagnostic(&context); }
    c_stage_destroy(&cli.stage);
    crust_context_destroy(&context);
    return result;
}
