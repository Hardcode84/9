// SPDX-License-Identifier: Apache-2.0

record CBlock {
    next: *CBlock;
    used: usize;
    capacity: usize;
}

record CStatus {
    context: *CrustContext;
    blocks: *CBlock;
    failed: bool;
}

record CBuffer {
    status: *CStatus;
    data: *u8;
    size: usize;
    capacity: usize;
}

record CEntry { key: usize; value: usize; }
record CMap { entries: *CEntry; count: usize; capacity: usize; }

record CTypePair { left: *CrustType; right: *CrustType; slot: usize; }
record CComparison { pairs: *CTypePair; slots: *usize; count: usize; capacity: usize; }

record CTypeInfo {
    source: *CrustType;
    identity: usize;
    state: u32;
    next: *CTypeInfo;
    hash_next: *CTypeInfo;
}

record CBinding {
    source: *CrustDecl;
    definition: *CrustDecl;
    identity: usize;
    next: *CBinding;
    hash_next: *CBinding;
}

record CStage {
    status: CStatus;
    header: CBuffer;
    body: CBuffer;
    renames: CBuffer;
    sink: *CBuffer;
    types: CMap;
    type_shapes: CMap;
    declarations: CMap;
    native_names: CMap;
    symbols: CMap;
    comparison: CComparison;
    first_type: *CTypeInfo;
    last_type: *CTypeInfo;
    first_binding: *CBinding;
    last_binding: *CBinding;
    next_type: usize;
    next_binding: usize;
    next_temp: usize;
    next_symbol: usize;
    entry: *CrustDecl;
}
