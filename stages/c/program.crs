record CCli {
    stage: CStage;
    options: CBackendOptions;
    driver: CDriver;
    sources: *CrustSource;
    source_count: usize;
    exports: **u8;
    export_count: usize;
    root: *CrustSource;
    target_begin: usize;
    mode: u32;
    library: bool;
    entry_name: *u8;
}

fn c_driver_usage() -> bool {
    var text: *u8 = "usage: crust-c [--check | --prepare | --emit-c | --object]\n             [--library | --entry NAME] [-o OUTPUT] [--symbols RESPONSEFILE]\n             [--cflag ARG] [--ldflag ARG] [--export NAME] SOURCE...\n";
    return crust0_host_write_stream(1u32, text, c_length(text)) == 0i32;
}

fn c_driver_stderr(text: *u8) -> unit {
    crust0_host_write_stream(2u32, text, c_length(text));
}

fn c_driver_print_number(value: u64) -> unit {
    var digits: [u8; 20] = uninit;
    var index: usize = 20usize;
    while true {
        index = index - 1usize;
        digits[index] = (value % 10u64) as u8 + 48u8;
        value = value / 10u64;
        if value == 0u64 { break; }
    }
    crust0_host_write_stream(2u32, &digits[index], 20usize - index);
}

fn c_driver_diagnostic(context: *CrustContext, tool: *u8) -> unit {
    var source: *CrustSource = (*context).error_loc.source;
    if source == null(*CrustSource) {
        c_driver_stderr(tool);
        c_driver_stderr(": error: ");
    } else {
        var line: u64 = 1u64;
        var column: u64 = 1u64;
        var index: usize = 0usize;
        while index < (*context).error_loc.offset && index < (*source).size {
            if (*source).bytes[index] == 10u8 {
                line = line + 1u64;
                column = 1u64;
            } else { column = column + 1u64; }
            index = index + 1usize;
        }
        c_driver_stderr((*source).path);
        c_driver_stderr(":");
        c_driver_print_number(line);
        c_driver_stderr(":");
        c_driver_print_number(column);
        c_driver_stderr(": error: ");
    }
    c_driver_stderr(&(*context).error[0usize]);
    c_driver_stderr("\n");
}

fn c_driver_parse(cli: *CCli, argc: i32, argv: **u8, begin: i32) -> bool {
    var driver: *CDriver = &(*cli).driver;
    var index: i32 = begin;
    var options: bool = true;
    while index < argc {
        var arg: *u8 = argv[index as usize];
        index = index + 1i32;
        if options {
            if c_equal(arg, "--") { options = false; continue; }
            if c_equal(arg, "--check") { (*cli).mode = 3u32; continue; }
            if c_equal(arg, "--prepare") { (*cli).mode = 4u32; continue; }
            if c_equal(arg, "--emit-c") { (*cli).mode = 2u32; continue; }
            if c_equal(arg, "--object") { (*cli).mode = 1u32; continue; }
            if c_equal(arg, "--library") { (*cli).library = true; continue; }
            if c_cli_value_option(arg) {
                if !c_cli_argument(cli, argc, argv, &index, arg) { return false; }
                continue;
            }
            if arg[0usize] == 45u8 { return c_driver_error(driver, "unknown command option"); }
        }
        if !c_cli_source(cli, arg) { return false; }
    }
    return c_cli_finish_options(cli);
}

fn c_driver_names(driver: *CDriver) -> bool {
    var stage: *CStage = (*driver).stage;
    var private: *u8 = null(*u8);
    var parsed: *CrustUnit = (*(*stage).status.context).units;
    while parsed != null(*CrustUnit) {
        var declaration: *CrustDecl = (*parsed).declarations;
        while declaration != null(*CrustDecl) {
            if (*declaration).kind != CRUST_D_RECORD && (*declaration).link_name == null(*u8) {
                if private == null(*u8) {
                    private = crust_try_copy_string((*stage).status.context, "", 0usize);
                    if private == null(*u8) { return false; }
                }
                (*declaration).link_name = private;
            }
            declaration = (*declaration).next;
        }
        parsed = (*parsed).next;
    }
    return true;
}

fn c_driver_is_entry(declaration: *CrustDecl) -> bool {
    if (*declaration).kind != CRUST_D_FUNCTION || (*declaration).param_count != 2usize { return false; }
    var parameter: *CrustParam = (*declaration).params;
    if (*(*declaration).syntax_type).kind != CRUST_T_I32 ||
       (*(*parameter).syntax_type).kind != CRUST_T_I32 { return false; }
    var argument: *CrustTypeSyntax = (*(*parameter).next).syntax_type;
    return (*argument).kind == CRUST_T_POINTER && (*(*argument).base).kind == CRUST_T_POINTER &&
           (*(*(*argument).base).base).kind == CRUST_T_U8;
}

fn c_driver_entry(cli: *CCli) -> *CrustDecl {
    var driver: *CDriver = &(*cli).driver;
    var parsed: *CrustUnit = (*(*(*driver).stage).status.context).units;
    while parsed != null(*CrustUnit) {
        var declaration: *CrustDecl = (*parsed).declarations;
        while declaration != null(*CrustDecl) {
            if c_equal((*(*declaration).name).text, (*cli).entry_name) {
                if c_driver_is_entry(declaration) { return declaration; }
                c_driver_error(driver, "entry must be a defined fn(i32, **u8) -> i32");
                return null(*CrustDecl);
            }
            declaration = (*declaration).next;
        }
        parsed = (*parsed).next;
    }
    c_driver_error(driver, "entry function was not found");
    return null(*CrustDecl);
}

fn c_driver_build(cli: *CCli) -> i32 {
    var driver: *CDriver = &(*cli).driver;
    var stage: *CStage = (*driver).stage;
    var context: *CrustContext = (*stage).status.context;
    if !c_cli_read(cli) { return 1i32; }
    if !crust_collect(context) || !crust_resolve(context) || !crust_check(context) { return 1i32; }
    if !c_driver_exports(cli) { return 1i32; }
    if (*cli).mode == 3u32 { return 0i32; }
    if !c_driver_names(driver) { return 1i32; }
    var entry: *CrustDecl = null(*CrustDecl);
    if !(*cli).library {
        entry = c_driver_entry(cli);
        if entry == null(*CrustDecl) { return 1i32; }
    }
    if (*cli).mode == 4u32 {
        if c_emit(stage, entry) { return 0i32; }
        return 1i32;
    }
    return c_backend_build(context, entry, (*driver).options);
}

fn c_driver_option(argument: *u8, name: *u8) -> bool {
    var index: usize = 0usize;
    while name[index] != 0u8 {
        if argument[index] != name[index] { return false; }
        index = index + 1usize;
    }
    return argument[index] == 0u8 || argument[index] == 61u8;
}

fn c_driver_exports(cli: *CCli) -> bool {
    var context: *CrustContext = (*cli).stage.status.context;
    var index: usize = 0usize;
    while index < (*cli).export_count {
        var name: *u8 = (*cli).exports[index];
        var parsed: *CrustUnit = (*context).units;
        var found: bool = false;
        while parsed != null(*CrustUnit) && !found {
            var declaration: *CrustDecl = (*parsed).declarations;
            while declaration != null(*CrustDecl) {
                if c_equal((*(*declaration).name).text, name) {
                    if (*declaration).kind != CRUST_D_FUNCTION && (*declaration).kind != CRUST_D_CONST {
                        return c_driver_error(&(*cli).driver, "--export requires a defined function or constant");
                    }
                    var copied: *u8 = crust_try_copy_string(context, name, c_length(name));
                    if copied == null(*u8) { return false; }
                    (*declaration).link_name = copied;
                    found = true;
                    break;
                }
                declaration = (*declaration).next;
            }
            parsed = (*parsed).next;
        }
        if !found { return c_driver_error(&(*cli).driver, "exported declaration was not found"); }
        index = index + 1usize;
    }
    return true;
}

fn c_driver_init(cli: *CCli, context: *CrustContext, argc: i32) -> bool {
    c_stage_init(&(*cli).stage, context);
    (*cli).options = make CBackendOptions {
        mode: 0u32, output: null(*u8), symbols: null(*u8),
        cflags: null(**u8), cflag_count: 0usize, ldflags: null(**u8), ldflag_count: 0usize
    };
    (*cli).driver = make CDriver {
        stage: &(*cli).stage, options: &(*cli).options, command: null(**u8),
        temporary: null(*CDriverTemp), process_status: 0i32
    };
    (*cli).sources = null(*CrustSource);
    (*cli).source_count = 0usize;
    (*cli).exports = null(**u8);
    (*cli).export_count = 0usize;
    (*cli).root = null(*CrustSource);
    (*cli).target_begin = 0usize;
    (*cli).mode = 0u32;
    (*cli).library = false;
    (*cli).entry_name = "main";
    if argc < 0i32 { return c_driver_error(&(*cli).driver, "negative argument count"); }
    var capacity: usize = argc as usize + 32usize;
    (*cli).sources = crust_try_alloc(context, capacity * sizeof(CrustSource), alignof(CrustSource)) as *CrustSource;
    if (*cli).sources == null(*CrustSource) { return false; }
    (*cli).options.cflags = c_alloc(&(*cli).stage.status, capacity * sizeof(*u8), alignof(*u8)) as **u8;
    (*cli).options.ldflags = c_alloc(&(*cli).stage.status, capacity * sizeof(*u8), alignof(*u8)) as **u8;
    (*cli).exports = c_alloc(&(*cli).stage.status, capacity * sizeof(*u8), alignof(*u8)) as **u8;
    return !(*cli).stage.status.failed;
}

// Require an initialized context with no application units and a live source.
// Interpret request arguments as compiler options and extra source paths.
// Keep the source live through context destruction. Extra inputs and names belong to the context.
// Return a status and retain diagnostics in the context without printing them.
fn c_program(request: *CrustBuild) -> i32 {
    var context: *CrustContext = (*request).context;
    var cli: CCli = uninit;
    var success: bool = c_driver_init(&cli, context, (*request).argc);
    cli.root = (*request).source;
    cli.target_begin = (*request).target_begin;
    var result: i32 = 1i32;
    if success && c_driver_parse(&cli, (*request).argc, (*request).argv, 0i32) {
        result = c_driver_build(&cli);
    }
    c_stage_destroy(&cli.stage);
    return result;
}

fn c_cli_value_option(arg: *u8) -> bool {
    return c_driver_option(arg, "-o") || c_driver_option(arg, "--entry") || c_driver_option(arg, "--symbols") ||
           c_driver_option(arg, "--cflag") || c_driver_option(arg, "--ldflag") || c_driver_option(arg, "--export");
}

fn c_cli_argument(cli: *CCli, argc: i32, argv: **u8, index: *i32, arg: *u8) -> bool {
    var driver: *CDriver = &(*cli).driver;
    var split: usize = 0usize;
    while arg[split] != 0u8 && arg[split] != 61u8 { split = split + 1usize; }
    var value: *u8 = null(*u8);
    if arg[split] == 61u8 { value = &arg[split + 1usize]; }
    else {
        if *index == argc { return c_driver_error(driver, "missing option argument"); }
        value = argv[*index as usize];
        *index = *index + 1i32;
    }
    c_cli_option(cli, arg, value);
    return true;
}

fn c_cli_option(cli: *CCli, arg: *u8, value: *u8) -> unit {
    var driver: *CDriver = &(*cli).driver;
    if c_driver_option(arg, "-o") { (*(*driver).options).output = value; return; }
    if c_driver_option(arg, "--entry") { (*cli).entry_name = value; return; }
    if c_driver_option(arg, "--symbols") { (*(*driver).options).symbols = value; return; }
    if c_driver_option(arg, "--cflag") {
        (*(*driver).options).cflags[(*(*driver).options).cflag_count] = value;
        (*(*driver).options).cflag_count = (*(*driver).options).cflag_count + 1usize;
        return;
    }
    if c_driver_option(arg, "--export") {
        (*cli).exports[(*cli).export_count] = value;
        (*cli).export_count = (*cli).export_count + 1usize;
        return;
    }
    (*(*driver).options).ldflags[(*(*driver).options).ldflag_count] = value;
    (*(*driver).options).ldflag_count = (*(*driver).options).ldflag_count + 1usize;
}

fn c_cli_source(cli: *CCli, arg: *u8) -> bool {
    var driver: *CDriver = &(*cli).driver;
    var count: usize = (*cli).source_count;
    var context: *CrustContext = (*(*driver).stage).status.context;
    var path: *u8 = crust_try_copy_string(context, arg, c_length(arg));
    if path == null(*u8) { return false; }
    var identity: u64 = count as u64 + 1u64;
    if (*cli).root != null(*CrustSource) && identity >= (*(*cli).root).identity {
        identity = identity + 1u64;
    }
    (*cli).sources[count] = make CrustSource {
        path: path, bytes: null(*u8), size: 0usize, identity: identity
    };
    (*cli).source_count = count + 1usize;
    return true;
}

fn c_cli_finish_options(cli: *CCli) -> bool {
    var driver: *CDriver = &(*cli).driver;
    if (*cli).source_count == 0usize && (*cli).root == null(*CrustSource) { return c_driver_error(driver, "no source files"); }
    if (*cli).mode >= 3u32 {
        if (*(*driver).options).output != null(*u8) {
            return c_driver_error(driver, "-o requires C, object, or executable output");
        }
        if (*(*driver).options).symbols != null(*u8) {
            return c_driver_error(driver, "--symbols requires --emit-c");
        }
    } else { (*(*driver).options).mode = (*cli).mode; }
    return true;
}

fn c_cli_read(cli: *CCli) -> bool {
    var driver: *CDriver = &(*cli).driver;
    var context: *CrustContext = (*(*driver).stage).status.context;
    var index: usize = 0usize;
    if (*cli).root != null(*CrustSource) {
        var parsed: *CrustUnit = null(*CrustUnit);
        if !crust_read_range(context, (*cli).root, (*cli).target_begin, (*(*cli).root).size, &parsed) { return false; }
    }
    while index < (*cli).source_count {
        var source: *CrustSource = &(*cli).sources[index];
        var bytes: *u8 = null(*u8);
        var size: usize = 0usize;
        if crust0_host_read_file((*source).path, &bytes, &size) != 0i32 {
            c_driver_io_error(driver, "cannot read input", (*source).path, *c_driver_errno());
            return false;
        }
        (*source).bytes = crust_try_copy_string(context, bytes, size);
        (*source).size = size;
        crust0_host_free(bytes);
        if (*source).bytes == null(*u8) { return false; }
        var parsed: *CrustUnit = null(*CrustUnit);
        if !crust_read(context, source, &parsed) { return false; }
        index = index + 1usize;
    }
    return true;
}
