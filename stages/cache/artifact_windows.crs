// Build a fresh artifact. Never report a cache hit. The caller owns the directory
// and must retain successful artifacts until all runners that use them close.
fn cache_artifact(
    context: *CrustContext,
    directory: *u8,
    request: *CacheBuild,
    result: *CacheArtifact
) -> bool {
    *result = make CacheArtifact {
        path: null(*u8),
        hit: false
    };
    if !cache_absolute(directory) || request -> build == null(
        fn(*CrustContext, *CacheBuild, *u8) -> bool
    ) {
        return native_error(
            context,
            "artifact requires an absolute directory and a build function"
        );
    }
    var prefix: *u8 = native_join(context, directory, "/build-");
    if prefix == null(*u8) {
        return false;
    }
    var work: *u8 = win_unique(context, prefix, true);
    if work == null(*u8) {
        return false;
    }
    var path: *u8 = native_join(context, work, "/artifact.dll");
    var success: bool = false;
    if path != null(*u8) {
        var errors: usize = context -> error_count;
        success = request -> build(context, request, path);
        if !success && context -> error_count == errors {
            native_error(context, "artifact build failed without a diagnostic");
        }
        success = success && context -> error_count == errors;
    }
    if success {
        result -> path = path;
        return true;
    }
    if path != null(*u8) {
        win_remove(context, path, false);
    }
    win_remove(context, work, true);
    return false;
}

fn cache_absolute(path: *u8) -> bool {
    if path == null(*u8) {
        return false;
    }
    if path[0usize] == 47u8 || path[0usize] == 92u8 {
        return path[1usize] == path[0usize];
    }
    return path[0usize] != 0u8 && path[1usize] == 58u8 && (
        path[2usize] == 47u8 || path[2usize] == 92u8
    );
}
