fn cache_add(context: *CrustContext, inputs: *CacheInputs, source: *CrustSource) -> bool {
    if (*inputs).count == (*inputs).capacity {
        if (*inputs).capacity > ~0usize / (2usize * sizeof(*CrustSource)) {
            return native_error(context, "too many cache inputs");
        }
        var next: usize = (*inputs).capacity * 2usize;
        if next == 0usize {
            next = 16usize;
        }
        var items: **CrustSource = crust_try_grow_array(
            context,
            (*inputs).items as *u8,
            (*inputs).count,
            next,
            sizeof(*CrustSource),
            alignof(*CrustSource)
        ) as **CrustSource;
        if items == null(**CrustSource) {
            return false;
        }
        (*inputs).items = items;
        (*inputs).capacity = next;
    }
    (*inputs).items[(*inputs).count] = source;
    (*inputs).count = (*inputs).count + 1usize;
    return true;
}

fn cache_input(context: *CrustContext, inputs: *CacheInputs, path: *u8) -> bool {
    var source: *CrustSource = crust_try_alloc(
        context,
        sizeof(CrustSource),
        alignof(CrustSource)
    ) as *CrustSource;
    if source == null(*CrustSource) || !cache_read(context, path, source) {
        return false;
    }
    (*source).identity = (*inputs).count as u64 + 1u64;
    return cache_add(context, inputs, source);
}

// Retain the actual source snapshots used by this runner. Files can change
// after host_source; their new bytes do not replace already checked code.
fn cache_loaded_sources(root: *CrustRun, inputs: *CacheInputs) -> bool {
    var seen: CrustMap = make CrustMap {
        entries: null(*CrustMapEntry),
        count: 0usize,
        capacity: 0usize
    };
    var item: *CrustUnit = (*(*root).context).units;
    while item != null(*CrustUnit) {
        var source: *CrustSource = (*item).source;
        if source != null(*CrustSource) && crust_map_get(&seen, source as usize) == null(*u8) {
            if !cache_add((*root).context, inputs, source) || !crust_try_map_set(
                (*root).context,
                &seen,
                source as usize,
                source as *u8
            ) {
                return false;
            }
        }
        item = (*item).next;
    }
    return true;
}

fn cache_read(context: *CrustContext, path: *u8, result: *CrustSource) -> bool {
    var bytes: *u8 = null(*u8);
    var size: usize = 0usize;
    if crust0_host_read_file(path, &bytes, &size) != 0i32 {
        return native_error(context, "cannot read cache file");
    }
    var copy: *u8 = crust_try_copy_string(context, bytes, size);
    crust0_host_free(bytes);
    if copy == null(*u8) {
        return false;
    }
    * result = make CrustSource {
        path: path,
        bytes: copy,
        size: size,
        identity: 0u64
    };
    return true;
}
