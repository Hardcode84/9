// Tools remain unchanged during a build. Retain their digests, not their bytes.
fn cache_tool_input(
    context: *CrustContext,
    inputs: *CacheInputs,
    path: *u8,
    scratch: *u8
) -> bool {
    var digest: *u8 = cache_digest(context, path, scratch);
    if digest == null(*u8) {
        return false;
    }
    var source: *CrustSource = crust_try_alloc(
        context,
        sizeof(CrustSource),
        alignof(CrustSource)
    ) as *CrustSource;
    if source == null(*CrustSource) {
        return false;
    }
    * source = make CrustSource {
        path: path,
        bytes: digest,
        size: 64usize,
        identity: 0u64
    };
    return cache_add(context, inputs, source);
}

fn cache_tools(
    context: *CrustContext,
    inputs: *CacheInputs,
    paths: **u8,
    count: usize,
    directory: *u8
) -> bool {
    var work: CacheWork = make CacheWork {
        directory: null(*u8),
        manifest: null(*u8),
        digest: null(*u8),
        artifact: null(*u8),
        checksum: null(*u8)
    };
    var success: bool = cache_work(context, directory, &work);
    var index: usize = 0usize;
    while success && index < count {
        success = cache_tool_input(context, inputs, paths[index], work.digest);
        index = index + 1usize;
    }
    if !cache_cleanup(context, &work) {
        return false;
    }
    return success;
}

fn cache_host_input(context: *CrustContext, inputs: *CacheInputs) -> bool {
    return cache_input(context, inputs, "/proc/self/exe");
}
