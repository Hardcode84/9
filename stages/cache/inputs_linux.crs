// Tools remain unchanged during a build. Retain their digests, not their bytes.
fn cache_tool_input(
    context: *CrustContext,
    inputs: *CacheInputs,
    path: *u8,
    scratch: *u8
) -> bool {
    var digest: *u8 = cache_digest(context, path, scratch);
    if digest == null(*u8) {
        return false;
    }
    var source: *CrustSource = crust_try_alloc(
        context,
        sizeof(CrustSource),
        alignof(CrustSource)
    ) as *CrustSource;
    if source == null(*CrustSource) {
        return false;
    }
    * source = make CrustSource {
        path: path,
        bytes: digest,
        size: 64usize,
        identity: 0u64
    };
    return cache_add(context, inputs, source);
}

// Add the complete dynamic library closure reported by ldd in the same fixed
// environment used by cache_tool. Static tools need a different provider.
fn cache_tool_libraries(
    context: *CrustContext,
    inputs: *CacheInputs,
    path: *u8,
    scratch: *u8
) -> bool {
    var arguments: [*u8; 3] = make [*u8; 3] {
        "/usr/bin/ldd",
        path,
        null(*u8)
    };
    if !cache_tool(context, &arguments[0usize], scratch) {
        return false;
    }
    var source: CrustSource = uninit;
    if !cache_read(context, scratch, &source) {
        return false;
    }
    if cache_strstr(source.bytes, "not found") != null(*u8) {
        return native_error(context, "missing tool library");
    }
    var index: usize = 0usize;
    while index < source.size {
        var end: usize = index;
        while end < source.size && source.bytes[end] != 10u8 {
            end = end + 1usize;
        }
        var start: usize = index;
        while start < end && source.bytes[start] != 47u8 {
            start = start + 1usize;
        }
        if start < end && !cache_library_path(context, inputs, &source, start, end, scratch) {
            return false;
        }
        index = end + 1usize;
    }
    return true;
}

fn cache_tools(
    context: *CrustContext,
    inputs: *CacheInputs,
    paths: **u8,
    count: usize,
    directory: *u8
) -> bool {
    var work: CacheWork = make CacheWork {
        directory: null(*u8),
        manifest: null(*u8),
        digest: null(*u8),
        artifact: null(*u8),
        checksum: null(*u8)
    };
    var success: bool = cache_work(context, directory, &work);
    var index: usize = 0usize;
    while success && index < count {
        success = cache_tool_input(context, inputs, paths[index], work.digest) && cache_tool_libraries(
            context,
            inputs,
            paths[index],
            work.manifest
        );
        index = index + 1usize;
    }
    if !cache_cleanup(context, &work) {
        return false;
    }
    return success;
}

fn cache_library_path(
    context: *CrustContext,
    inputs: *CacheInputs,
    source: *CrustSource,
    start: usize,
    end: usize,
    scratch: *u8
) -> bool {
    var stop: usize = start;
    while stop + 1usize < end &&!(
        (*source).bytes[stop] == 32u8 && (*source).bytes[stop + 1usize] == 40u8
    ) {
        stop = stop + 1usize;
    }
    if stop + 1usize == end {
        return native_error(context, "invalid tool library listing");
    }
    var library: *u8 = crust_try_copy_string(
        context,
        (*source).bytes + start as isize,
        stop - start
    );
    if library == null(*u8) || !cache_tool_input(context, inputs, library, scratch) {
        return false;
    }
    return true;
}

fn cache_loaded_image(image: *CacheLoadedImage, size: usize, user: *u8) -> i32 {
    var state: *CacheLoadedInputs = user as *CacheLoadedInputs;
    var name: *u8 = (*image).name;
    // The main executable is captured through /proc/self/exe. The vDSO has no file.
    if name[0usize] == 0u8 || cache_strcmp(name, "linux-vdso.so.1") == 0i32 {
        return 0i32;
    }
    if !cache_input((*state).context, (*state).inputs, name) {
        return 1i32;
    }
    return 0i32;
}

// Capture the executable and the actual loaded files, including explicit native
// inputs and loader-selected libraries. Complete this call before loading output.
fn cache_loaded_inputs(context: *CrustContext, inputs: *CacheInputs) -> bool {
    if !cache_input(context, inputs, "/proc/self/exe") {
        return false;
    }
    var state: CacheLoadedInputs = make CacheLoadedInputs {
        context: context,
        inputs: inputs
    };
    return cache_images(cache_loaded_image, &state as *u8) == 0i32;
}

fn cache_libc(context: *CrustContext, inputs: *CacheInputs) -> *u8 {
    var index: usize = 0usize;
    while index < inputs -> count {
        var path: *u8 = inputs -> items[index] -> path;
        var size: usize = native_strlen(path);
        if size >= 10usize && cache_strcmp(path + (size - 10usize) as isize, "/libc.so.6") == 0i32 {
            return path;
        }
        index = index + 1usize;
    }
    native_error(context, "stage link requires captured libc.so.6");
    return null(*u8);
}
