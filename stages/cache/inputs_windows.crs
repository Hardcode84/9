// Digest external files instead of retaining toolchain-sized byte buffers.
fn cache_file_input(context: *CrustContext, inputs: *CacheInputs, path: *u8) -> bool {
    var index: usize = 0usize;
    while index < inputs -> count {
        if cache_strcmp(inputs -> items[index] -> path, path) == 0i32 {
            return true;
        }
        index = index + 1usize;
    }
    var digest: *u8 = cache_digest(context, path, null(*u8));
    return digest != null(*u8) && cache_value_input(context, inputs, path, digest, 64usize);
}
fn cache_value_input(
    context: *CrustContext,
    inputs: *CacheInputs,
    name: *u8,
    bytes: *u8,
    size: usize
) -> bool {
    var source: *CrustSource = crust_try_alloc(
        context,
        sizeof(CrustSource),
        alignof(CrustSource)
    ) as *CrustSource;
    if source == null(*CrustSource) {
        return false;
    }
    * source = make CrustSource {
        path: name,
        bytes: bytes,
        size: size,
        identity: 0u64
    };
    return cache_add(context, inputs, source);
}
// The caller keeps the host installation fixed for the cache lifetime.
fn cache_host_input(context: *CrustContext, inputs: *CacheInputs) -> bool {
    var path: *u8 = win_seed_path(context);
    return path != null(*u8) && cache_file_input(context, inputs, path);
}
fn cache_tools(
    context: *CrustContext,
    inputs: *CacheInputs,
    paths: **u8,
    count: usize,
    directory: *u8
) -> bool {
    var index: usize = 0usize;
    while index < count {
        var wide: *u16 = win_tool_path(context, paths[index]);
        if wide == null(*u16) {
            return false;
        }
        var path: *u8 = win_utf8(context, wide);
        if path == null(*u8) || !cache_file_input(context, inputs, win_slashes(path)) {
            return false;
        }
        index = index + 1usize;
    }
    return true;
}

fn cache_environment(context: *CrustContext, inputs: *CacheInputs) -> bool {
    var environment: *u16 = win_tool_environment(context);
    if environment == null(*u16) {
        return false;
    }
    var size: usize = 0usize;
    while environment[size] != 0u16 || environment[size + 1usize] != 0u16 {
        size = size + 1usize;
    }
    return cache_value_input(
        context,
        inputs,
        "windows-tool-environment",
        environment as *u8,
        (size + 2usize) * 2usize
    );
}
