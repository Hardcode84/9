record CcnOptions { limit: usize; begin: i32; warnings: bool; }

fn ccn_usage(stream: u32) -> i32 {
    var message: *u8 = "usage: crust-ccn [--CCN N] [-w] [--] SOURCE...\nDefault limit: 15. -w reports only functions over the limit.\n";
    if crust0_host_write_stream(stream, message, ccn_length(message)) != 0i32 { return 2i32; }
    return 0i32;
}

fn ccn_limit(text: *u8, result: *usize) -> bool {
    var value: usize = 0usize;
    var index: usize = 0usize;
    while text[index] != 0u8 {
        var digit: u8 = text[index] - 48u8;
        if digit > 9u8 || value > ((~0usize) - digit as usize) / 10usize { return false; }
        value = value * 10usize + digit as usize;
        index = index + 1usize;
    }
    if value == 0usize { return false; }
    *result = value;
    return true;
}

fn ccn_options(argc: i32, argv: **u8, options: *CcnOptions) -> bool {
    *options = make CcnOptions { limit: 15usize, begin: 0i32, warnings: false };
    while (*options).begin < argc {
        var argument: *u8 = argv[(*options).begin as usize];
        if argument[0usize] != 45u8 { break; }
        (*options).begin = (*options).begin + 1i32;
        if ccn_equal(argument, "--") { break; }
        if ccn_equal(argument, "-w") { (*options).warnings = true; continue; }
        if !ccn_equal(argument, "--CCN") || (*options).begin == argc { return false; }
        if !ccn_limit(argv[(*options).begin as usize], &(*options).limit) { return false; }
        (*options).begin = (*options).begin + 1i32;
    }
    return (*options).begin < argc;
}

fn ccn_file(path: *u8, options: *CcnOptions) -> i32 {
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var source: CrustSource = make CrustSource {
        path: path, bytes: null(*u8), size: 0usize, identity: 1u64
    };
    var status: i32 = 2i32;
    if crust0_host_read_file(path, &source.bytes, &source.size) != 0i32 {
        crust_set_error(&context, &source, 0usize, "cannot read CCN input");
    } else {
        var rows: *CcnRow = null(*CcnRow);
        if ccn_read(&context, &source, &rows) {
            status = ccn_report(&context, &source, rows, (*options).limit, (*options).warnings);
        }
    }
    if context.error_count != 0usize { crust_run_diagnostic(&context); }
    crust_context_destroy(&context);
    crust0_host_free(source.bytes);
    return status;
}

// Arguments exclude the executable name. Inspect files without executing them.
// Return 0 within limit, 1 over limit, or 2 for argument, source, or I/O errors.
fn ccn_program(argc: i32, argv: **u8) -> i32 {
    if argc == 1i32 && ccn_equal(argv[0usize], "--help") { return ccn_usage(1u32); }
    var options: CcnOptions = uninit;
    if !ccn_options(argc, argv, &options) { ccn_usage(2u32); return 2i32; }
    var status: i32 = 0i32;
    while options.begin < argc {
        var file_status: i32 = ccn_file(argv[options.begin as usize], &options);
        if file_status == 2i32 { return file_status; }
        if file_status > status { status = file_status; }
        options.begin = options.begin + 1i32;
    }
    return status;
}
