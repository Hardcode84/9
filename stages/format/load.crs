fn format_setup(run: *CrustRun, base: *u8) -> bool {
    var paths: [*u8; 12] = make [*u8; 12] {
        "stages/native/model.crs",
        stage_provider(run, "stages/native/", ".crs"),
        "stages/reader/model.crs",
        "stages/reader/lex.crs",
        "stages/highlight/model.crs",
        "stages/highlight/scan.crs",
        "stages/highlight/output.crs",
        "stages/format/model.crs",
        "stages/format/tokens.crs",
        "stages/format/layout.crs",
        stage_provider(run, "stages/format/", ".crs"),
        "stages/format/program.crs"
    };
    var index: usize = 0usize;
    while index < 12usize {
        var path: *u8 = stage_path(run, base, paths[index]);
        if path == null(*u8) || !host_source(run, path) {
            return false;
        }
        index = index + 1usize;
    }
    return true;
}
