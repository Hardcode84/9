fn fm_stderr(message: *u8) -> unit {
    if crust0_host_write_stream(2u32, message, hl_length(message)) != 0i32 {
        trap;
    }
}
fn fm_same(result: *FmResult) -> bool {
    var source: *CrustSource = result -> lexical.source;
    if source -> size != result -> output.size {
        return false;
    }
    var index: usize = 0usize;
    while index < source -> size {
        if source -> bytes[index] != result -> output.bytes[index] {
            return false;
        }
        index = index + 1usize;
    }
    return true;
}
fn fm_report(result: *FmResult, mode: u32, before: *FmStat) -> i32 {
    if mode == 0u32 {
        if crust0_host_write_stream(1u32, result -> output.bytes, result -> output.size) == 0i32 {
            return 0i32;
        }
        fm_error(result, 0usize, "cannot write formatted output");
        return 2i32;
    }
    if fm_same(result) {
        return 0i32;
    }
    if mode == 1u32 {
        var path: *u8 = result -> lexical.source -> path;
        if crust0_host_write_stream(1u32, path, hl_length(path)) != 0i32 || crust0_host_write_stream(
            1u32,
            "\n",
            1usize
        ) != 0i32 {
            fm_error(result, 0usize, "cannot write format check result");
            return 2i32;
        }
        return 1i32;
    }
    if fm_publish(result, before) {
        return 0i32;
    }
    return 2i32;
}
fn fm_read_format(
    result: *FmResult,
    mode: u32,
    service: fn(*FmResult, usize, usize, *u8) -> bool,
    user: *u8
) -> i32 {
    var before: FmStat = uninit;
    if mode == 2u32 && !fm_inspect(result, &before) {
        return 2i32;
    }
    var source: *CrustSource = result -> lexical.source;
    if crust0_host_read_file(source -> path, &source -> bytes, &source -> size) != 0i32 {
        fm_error(result, 0usize, "cannot read format input");
        return 2i32;
    }
    if !fm_region(result, 0usize, source -> size, service, user) || !fm_finish(result) {
        return 2i32;
    }
    return fm_report(result, mode, &before);
}
fn fm_file(
    path: *u8,
    mode: u32,
    service: fn(*FmResult, usize, usize, *u8) -> bool,
    user: *u8
) -> i32 {
    var source: CrustSource = make CrustSource {
        path: path,
        bytes: null(*u8),
        size: 0usize,
        identity: 1u64
    };
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var result: FmResult = uninit;
    fm_init(&result, &context, &source);
    var status: i32 = fm_read_format(&result, mode, service, user);
    if status == 2i32 {
        fm_stderr(path);
        fm_stderr(": ");
        fm_stderr(&context.error[0usize]);
        fm_stderr("\n");
    }
    crust_context_destroy(&context);
    crust0_host_free(source.bytes);
    return status;
}
fn fm_usage() -> i32 {
    fm_stderr("usage: crust-format [--check|--write] [--] SOURCE...\n");
    return 2i32;
}
// Arguments exclude the executable name. Input files are data, never executed.
// Return 0 on success, 1 for check differences, 2 on error. Services live through this call.
fn fm_program(
    argc: i32,
    argv: **u8,
    service: fn(*FmResult, usize, usize, *u8) -> bool,
    user: *u8
) -> i32 {
    if argc < 1i32 {
        return fm_usage();
    }
    var mode: u32 = 0u32;
    var index: usize = 0usize;
    if hl_equal(argv[0usize], "--check") {
        mode = 1u32;
        index = 1usize;
    } else if hl_equal(argv[0usize], "--write") {
        mode = 2u32;
        index = 1usize;
    }
    if index < argc as usize && hl_equal(argv[index], "--") {
        index = index + 1usize;
    } else if index < argc as usize && argv[index][0usize] == 45u8 {
        index = argc as usize;
    }
    if index == argc as usize || (mode == 0u32 && index + 1usize != argc as usize) {
        return fm_usage();
    }
    var status: i32 = 0i32;
    while index < argc as usize {
        var next: i32 = fm_file(argv[index], mode, service, user);
        if next > status {
            status = next;
        }
        index = index + 1usize;
    }
    return status;
}
