fn og_init(program: *OgProgram, allocator: *CrustAllocator, namespace: u64) -> unit {
    gp_init(&(*program).generics, allocator, namespace);
    rs_init(&(*program).parsed_resources, &(*program).generics.syntax);
    rs_init(&(*program).resources, &(*program).generics.context);
    os_init(&(*program).parsed, &(*program).parsed_resources);
    os_init(&(*program).ownership, &(*program).resources);
    (*program).references = make CrustMap { entries: null(*CrustMapEntry), count: 0usize, capacity: 0usize };
    (*program).ranges = (*program).references;
    (*program).resource_index = (*program).references;
    (*program).sealed_domains = (*program).references;
    (*program).proof_checks = 0usize;
    (*program).proof_bytes = 0usize;
    (*program).verified = (*program).references;
    (*program).proof_roots = (*program).references;
    (*program).parsed.reference_user = program as *u8;
    (*program).parsed.read_reference = og_read_reference;
    (*program).generics.clone_user = program as *u8;
    (*program).generics.clone_kind = og_clone_kind;
    (*program).generics.clone_statement = og_clone_statement;
    (*program).generics.clone_declaration = og_clone_declaration;
}

fn og_read_reference(reader: *CrustReader, user: *u8, kind: u32) -> *CrustName {
    var program: *OgProgram = user as *OgProgram;
    var application: *CrustTypeSyntax = gp_reader_type(reader, null(*u8));
    if application == null(*CrustTypeSyntax) {
        rr_error(reader, (*reader).token.offset, "expected a declaration name");
        return null(*CrustName);
    }
    if (*application).param_count == 0usize { return (*application).name; }
    if kind == CRUST_D_CONST {
        rr_error(reader, (*application).loc.offset, "domain references do not take generic arguments");
        return null(*CrustName);
    }
    var reference: *OgReference = rr_alloc(reader, sizeof(OgReference), alignof(OgReference)) as *OgReference;
    if reference == null(*OgReference) { return null(*CrustName); }
    (*reference).application = application;
    (*reference).kind = kind;
    var text: *u8 = gs_number_name((*reader).context, "$reference_", 0u64, (*program).references.count as u64);
    if text == null(*u8) { rr_allocation_failed(reader); return null(*CrustName); }
    var name: *CrustName = crust_try_intern((*reader).context, text, gs_length(text));
    if name == null(*CrustName) ||
       !crust_try_map_set((*reader).context, &(*program).references, name as usize, reference as *u8) {
        rr_allocation_failed(reader); return null(*CrustName);
    }
    return name;
}

fn og_read_declaration(reader: *CrustReader, user: *u8) -> *CrustDecl {
    var program: *OgProgram = user as *OgProgram;
    var resource: bool = rr_is_name(reader, "resource");
    if resource { (*reader).token.kind = RR_RECORD; }
    var token: u32 = (*reader).token.kind;
    if token != RR_RECORD && token != RR_FN && token != RR_EXTERN {
        return os_read_declaration(reader, &(*program).parsed as *u8);
    }
    var declaration: *CrustDecl = gp_reader_header(reader, &(*program).generics);
    if declaration == null(*CrustDecl) { return declaration; }
    if (*declaration).kind == CRUST_D_RECORD {
        if rr_record_body(reader, declaration) == null(*CrustDecl) { return null(*CrustDecl); }
        return os_read_record_suffix(reader, &(*program).parsed, declaration, resource);
    }
    if rr_function_signature(reader, declaration) == null(*CrustDecl) { return null(*CrustDecl); }
    return os_read_function_suffix(reader, &(*program).parsed, declaration);
}

fn og_read_statement(reader: *CrustReader, user: *u8) -> *CrustStmt {
    var program: *OgProgram = user as *OgProgram;
    return os_read_statement(reader, &(*program).parsed as *u8);
}

fn og_read_prefix(reader: *CrustReader, user: *u8) -> *CrustExpr {
    var program: *OgProgram = user as *OgProgram;
    var result: *CrustExpr = os_read_prefix(reader, &(*program).parsed as *u8);
    if result != null(*CrustExpr) || (*reader).failed { return result; }
    return gp_reader_prefix(reader, &(*program).generics as *u8);
}

fn og_read_type(reader: *CrustReader, user: *u8) -> *CrustTypeSyntax {
    var program: *OgProgram = user as *OgProgram;
    var result: *CrustTypeSyntax = os_read_type(reader, &(*program).parsed as *u8);
    if result != null(*CrustTypeSyntax) || (*reader).failed { return result; }
    return gp_reader_type(reader, &(*program).generics as *u8);
}

// Trust is selected by the root. It applies to definitions read by this call.
fn og_read_range(program: *OgProgram, source: *CrustSource,
                 begin: usize, end: usize, trusted: bool) -> bool {
    var hooks: CrustReaderHooks = make CrustReaderHooks { next:null(*CrustReaderHooks), function_end:null(fn(*CrustReader,*CrustDecl,*u8)->bool),
        user: program as *u8, declaration: og_read_declaration, statement: og_read_statement,
        prefix: og_read_prefix, type_syntax: og_read_type
    };
    if !gp_read_range_with_hooks(&(*program).generics, source, begin, end, &hooks) { return false; }
    if (*program).parsed_resources.failed { return false; }
    var context: *CrustContext = &(*program).generics.syntax;
    var range: *OgSourceRange = crust_try_alloc(context, sizeof(OgSourceRange), alignof(OgSourceRange)) as *OgSourceRange;
    if range == null(*OgSourceRange) { return false; }
    *range = make OgSourceRange { begin: begin, end: end };
    if !crust_try_map_set(context, &(*program).ranges, (*context).last_unit as usize, range as *u8) { return false; }
    if !trusted { return true; }
    var declaration: *CrustDecl = (*(*program).generics.syntax.last_unit).declarations;
    while declaration != null(*CrustDecl) {
        if !os_trust(&(*program).parsed, declaration) { return false; }
        declaration = (*declaration).next;
    }
    return true;
}

fn og_read(program: *OgProgram, source: *CrustSource, trusted: bool) -> bool {
    return og_read_range(program, source, 0usize, (*source).size, trusted);
}

fn og_resource_index(program: *OgProgram) -> bool {
    if (*program).parsed_resources.failed || (*program).resources.failed ||
       (*program).generics.syntax.error_count != 0usize || (*program).generics.context.error_count != 0usize { return false; }
    var resource: *RsResource = (*program).parsed_resources.resources;
    while resource != null(*RsResource) {
        if !crust_try_map_set(&(*program).generics.syntax, &(*program).resource_index,
            (*resource).declaration as usize, resource as *u8) { return false; }
        resource = (*resource).next;
    }
    return true;
}

fn og_lower_syntax(program: *OgProgram) -> bool {
    return og_resource_index(program) && gp_lower(&(*program).generics) && !(*program).resources.failed;
}
