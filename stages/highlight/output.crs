fn hl_length(text:*u8)->usize {
    var size:usize = 0usize;
    while text[size] != 0u8 { size = size+1usize; }
    return size;
}

fn hl_equal(left:*u8, right:*u8)->bool {
    var index:usize = 0usize;
    while left[index] == right[index] {
        if left[index] == 0u8 { return true; }
        index = index+1usize;
    }
    return false;
}

fn hl_bytes(result:*HlResult, text:*HlText, bytes:*u8, size:usize)->unit {
    if (*result).failed || size == 0usize { return; }
    if size > (~0usize)-(*text).size { hl_error(result, "highlight output is too large"); return; }
    var needed:usize = (*text).size+size;
    if needed > (*text).capacity {
        var capacity:usize = 4096usize;
        if (*text).capacity != 0usize { capacity = (*text).capacity; }
        while capacity < needed {
            if capacity > (~0usize)/2usize { capacity = needed; }
            else { capacity = capacity*2usize; }
        }
        var memory:*u8 = hl_alloc(result, capacity, 1usize);
        if memory == null(*u8) { return; }
        if (*text).size != 0usize { crust0_host_move_bytes(memory, (*text).bytes, (*text).size); }
        (*text).bytes = memory;
        (*text).capacity = capacity;
    }
    crust0_host_move_bytes((*text).bytes+(*text).size as isize, bytes, size);
    (*text).size = needed;
}

fn hl_text(result:*HlResult, text:*HlText, value:*u8)->unit {
    hl_bytes(result, text, value, hl_length(value));
}

fn hl_number(result:*HlResult, text:*HlText, value:usize)->unit {
    var digits:[u8;20] = uninit;
    var begin:usize = 20usize;
    while true {
        begin = begin-1usize;
        digits[begin] = 48u8+(value%10usize) as u8;
        value = value/10usize;
        if value == 0usize { break; }
    }
    hl_bytes(result, text, &digits[begin], 20usize-begin);
}

// Append protocol version 1 JSON. The source and result must remain live.
fn hl_json(result:*HlResult, text:*HlText)->bool {
    hl_text(result, text, "{\"version\":1,\"byteLength\":");
    hl_number(result, text, (*(*result).source).size);
    hl_text(result, text, ",\"tokenTypes\":[");
    var index:usize = 0usize;
    while index < 12usize {
        if index != 0usize { hl_text(result, text, ","); }
        hl_text(result, text, "\"");
        hl_text(result, text, hl_kinds[index]);
        hl_text(result, text, "\"");
        index = index+1usize;
    }
    hl_text(result, text, "],\"tokenModifiers\":[\"declaration\",\"readonly\"],\"spans\":[");
    index = 0usize;
    while index < (*result).count && !(*result).failed {
        var span:*HlSpan = &(*result).spans[index];
        if index != 0usize { hl_text(result, text, ","); }
        hl_text(result, text, "[");
        hl_number(result, text, (*span).begin);
        hl_text(result, text, ",");
        hl_number(result, text, (*span).end);
        hl_text(result, text, ",");
        hl_number(result, text, (*span).kind as usize);
        hl_text(result, text, ",");
        hl_number(result, text, (*span).modifiers as usize);
        hl_text(result, text, "]");
        index = index+1usize;
    }
    hl_text(result, text, "]}\n");
    return !(*result).failed;
}

fn hl_html_bytes(result:*HlResult, text:*HlText, begin:usize, end:usize)->unit {
    var bytes:*u8 = (*(*result).source).bytes;
    while begin < end && !(*result).failed {
        var byte:u8 = bytes[begin];
        var size:usize = hl_utf8(bytes, begin, end);
        if byte == 38u8 { hl_text(result, text, "&amp;"); }
        else { if byte == 60u8 { hl_text(result, text, "&lt;"); }
        else { if byte == 62u8 { hl_text(result, text, "&gt;"); }
        else { if size == 0usize || (byte < 32u8 && !hl_space(byte)) || byte == 127u8 {
            var hex:*u8 = "0123456789abcdef";
            var escaped:[u8;4] = make [u8;4] {92u8,120u8,hex[(byte>>4u8) as usize],hex[(byte&15u8) as usize]};
            hl_bytes(result, text, &escaped[0usize], 4usize);
        } else { hl_bytes(result, text, bytes+begin as isize, size); } } } }
        if size == 0usize { size = 1usize; }
        begin = begin+size;
    }
}

// Render an HTML document. Invalid UTF-8 and control bytes use visible byte escapes.
fn hl_html(result:*HlResult, text:*HlText)->bool {
    hl_text(result, text, "<!doctype html>\n<meta charset=\"utf-8\">\n<title>Crust source</title>\n");
    hl_text(result, text, "<style>body{background:#202124;color:#e8eaed}pre{padding:1rem;tab-size:4}");
    hl_text(result, text, ".hl-keyword{color:#c58af9}.hl-comment{color:#9aa0a6}.hl-string{color:#81c995}");
    hl_text(result, text, ".hl-number{color:#fdd663}.hl-type,.hl-struct{color:#78d9ec}.hl-function{color:#8ab4f8}");
    hl_text(result, text, ".hl-invalid{background:#652c2c}.hl-unresolved{text-decoration:underline wavy #fdd663}</style>\n<pre><code>");
    var cursor:usize = 0usize;
    var index:usize = 0usize;
    while index < (*result).count && !(*result).failed {
        var span:*HlSpan = &(*result).spans[index];
        hl_html_bytes(result, text, cursor, (*span).begin);
        hl_text(result, text, "<span class=\"hl-");
        hl_text(result, text, hl_kinds[(*span).kind as usize]);
        hl_text(result, text, "\">");
        hl_html_bytes(result, text, (*span).begin, (*span).end);
        hl_text(result, text, "</span>");
        cursor = (*span).end;
        index = index+1usize;
    }
    hl_html_bytes(result, text, cursor, (*(*result).source).size);
    hl_text(result, text, "</code></pre>\n");
    return !(*result).failed;
}
