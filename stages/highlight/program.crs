fn hl_stderr(message:*u8)->unit {
    if crust0_host_write_stream(2u32, message, hl_length(message)) != 0i32 { trap; }
}

// Arguments exclude the executable name. Read input as data and write to stdout.
// The service and its state remain live until this call returns.
fn hl_program(argc:i32, argv:**u8,
              service:fn(*HlResult,usize,usize,*u8)->bool, user:*u8)->i32 {
    var tokens:bool = false;
    var index:usize = 0usize;
    if argc > 0i32 {
        if hl_equal(argv[0usize], "--tokens") { tokens = true; index = 1usize; }
        else { if hl_equal(argv[0usize], "--html") { index = 1usize; } }
    }
    if argc < 1i32 || argc as usize != index+1usize || argv[index][0usize] == 45u8 {
        hl_stderr("usage: crust-highlight [--html|--tokens] SOURCE\n"); return 2i32;
    }
    var source:CrustSource = make CrustSource {
        path:argv[index], bytes:null(*u8), size:0usize, identity:1u64
    };
    if crust0_host_read_file(source.path, &source.bytes, &source.size) != 0i32 {
        hl_stderr("cannot read highlight input: "); hl_stderr(source.path); hl_stderr("\n"); return 1i32;
    }
    var context:CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var result:HlResult = uninit;
    hl_init(&result, &context, &source);
    if tokens { result.span_limit = 500000usize; }
    var output:HlText = make HlText {bytes:null(*u8),size:0usize,capacity:0usize};
    var success:bool = hl_region(&result, 0usize, source.size, service, user);
    if success {
        if tokens { success = hl_json(&result, &output); }
        else { success = hl_html(&result, &output); }
    }
    var status:i32 = 0i32;
    if !success {
        hl_stderr(&context.error[0usize]); hl_stderr("\n"); status = 1i32;
    } else {
        if crust0_host_write_stream(1u32, output.bytes, output.size) != 0i32 {
            hl_stderr("cannot write highlight output\n"); status = 1i32;
        }
    }
    crust_context_destroy(&context);
    crust0_host_free(source.bytes);
    return status;
}
