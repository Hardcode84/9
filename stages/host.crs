// Capture one input with the caller's declaration identity. Keep run.context live
// until all contexts that borrow this source have been destroyed.
fn host_input(run: *CrustRun, path: *u8, identity: u64) -> *CrustSource {
    var resolved: *u8 = host_path(run, path);
    if resolved == null(*u8) {
        return null(*CrustSource);
    }
    var result: *CrustSource = crust_try_alloc(
        (*run).context,
        sizeof(CrustSource),
        alignof(CrustSource)
    ) as *CrustSource;
    if result == null(*CrustSource) {
        return result;
    }
    (*result) = make CrustSource {
        path: resolved,
        bytes: null(*u8),
        size: 0usize,
        identity: identity
    };
    var bytes: *u8 = null(*u8);
    var size: usize = 0usize;
    if crust0_host_read_file(resolved, &bytes, &size) != 0i32 {
        crust_set_error((*run).context, result, 0usize, "cannot read source input");
        return null(*CrustSource);
    }
    var copy: *u8 = crust_try_copy_string((*run).context, bytes, size);
    crust0_host_free(bytes);
    if copy == null(*u8) {
        return null(*CrustSource);
    }
    (*result).bytes = copy;
    (*result).size = size;
    return result;
}

// Add and check one complete host declaration set. Functions in it can refer
// to each other. Return false with a retained diagnostic on failure.
fn host_source_unit(run: *CrustRun, path: *u8, library: *u8) -> bool {
    if (*run).next_identity == ~0u64 {
        crust_set_error(
            (*run).context,
            (*run).source,
            (*run).cursor,
            "host source identities are exhausted"
        );
        return false;
    }
    var captured: *CrustSource = host_input(run, path, (*run).next_identity);
    if captured == null(*CrustSource) {
        return false;
    }
    (*run).next_identity = (*run).next_identity + 1u64;
    var unit_value: *CrustUnit = null(*CrustUnit);
    if !crust_read((*run).context, captured, &unit_value) {
        return false;
    }
    if !host_api_unit(run, unit_value) {
        return false;
    }
    if library != null(*u8) {
        return crust_run_import_unit(run, library, unit_value);
    }
    return crust_run_check_unit(run, unit_value);
}

fn host_api_name(name: *u8) -> bool {
    var prefix: *u8 = "CRUST_ABI_";
    var index: usize = 0usize;
    while index < 10usize {
        if name[index] != prefix[index] {
            return false;
        }
        index = index + 1usize;
    }
    return true;
}

fn host_api_digest(value: *CrustExpr) -> bool {
    if value == null(*CrustExpr) || (*value).kind != CRUST_E_STRING || (*value).byte_count != 65usize {
        return false;
    }
    var index: usize = 0usize;
    while index < 64usize {
        if (*value).bytes[index] != CRUST_ABI_crust0[index] {
            return false;
        }
        index = index + 1usize;
    }
    return true;
}

fn host_api_unit(run: *CrustRun, unit_value: *CrustUnit) -> bool {
    var declaration: *CrustDecl = (*unit_value).declarations;
    while declaration != null(*CrustDecl) {
        if host_api_name((*(*declaration).name).text) && (
            (*declaration).kind != CRUST_D_CONST || !host_api_digest((*declaration).init)
        ) {
            crust_set_error(
                (*run).context,
                (*declaration).loc.source,
                (*declaration).loc.offset,
                "native API digest mismatch in host source; regenerate the API declarations"
            );
            return false;
        }
        declaration = (*declaration).next;
    }
    return true;
}

// Load declarations that use the predefined host interface.
fn host_source(run: *CrustRun, path: *u8) -> bool {
    return host_source_unit(run, path, null(*u8));
}

// Load declarations and bind their externs to one retained library.
fn host_import(run: *CrustRun, library: *u8, path: *u8) -> bool {
    if library == null(*u8) {
        crust_set_error(
            run -> context,
            run -> source,
            run -> cursor,
            "native import requires a library"
        );
        return false;
    }
    return host_source_unit(run, path, library);
}

// Open a root-relative native library. Loading publishes no symbols.
fn host_open(run: *CrustRun, path: *u8) -> *u8 {
    var resolved: *u8 = host_path(run, path);
    if resolved == null(*u8) {
        return null(*u8);
    }
    return crust_run_open(run, resolved);
}

// Bind an existing extern declaration to its export in the selected library.
fn host_bind(run: *CrustRun, library: *u8, name: *u8) -> bool {
    var size: usize = 0usize;
    while name[size] != 0u8 {
        size = size + 1usize;
    }
    var key: *CrustName = crust_try_intern(run -> context, name, size);
    if key == null(*CrustName) {
        return false;
    }
    var symbol: *CrustSymbol = crust_map_get(&run -> context -> globals, key as usize) as *CrustSymbol;
    if symbol == null(*CrustSymbol) || symbol -> decl == null(*CrustDecl) {
        crust_set_error(
            run -> context,
            run -> source,
            run -> cursor,
            "native import declaration is missing"
        );
        return false;
    }
    return crust_run_import(run, library, symbol -> decl);
}
