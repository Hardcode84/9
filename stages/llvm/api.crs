// Include api/crust0.crs, stages/c/model.crs and stages/llvm/model.crs first.
// Use a fresh stage at a stable address. Keep checked inputs and callbacks live
// through emission. Destroy the stage after the last output-buffer use.
extern fn ll_init(stage:*LlStage,context:*CrustContext)->unit="ll_init";
extern fn ll_destroy(stage:*LlStage)->unit="ll_destroy";
// Emit Linux x86-64 SysV IR from complete checked raw bodies and native names.
// Null entry selects a library. A hosted entry must have fn(i32,**u8)->i32 type.
// Empty native names select private definitions. Output is header followed by
// body; renames is an objcopy response file. Failure records a diagnostic.
extern fn ll_emit(stage:*LlStage,entry:*CrustDecl)->bool="ll_emit";
// These helpers require a live emission function and checked nodes/types.
// Operands and type names remain live until stage destruction.
extern fn ll_expression(function:*LlFunction,input:*CrustExpr)->*u8="ll_expression";
extern fn ll_value(function:*LlFunction,input:*CrustExpr)->*u8="ll_value";
extern fn ll_place(function:*LlFunction,input:*CrustExpr)->*u8="ll_place";
extern fn ll_statement(function:*LlFunction,input:*CrustStmt)->unit="ll_statement";
extern fn ll_type(stage:*LlStage,type:*CrustType)->*u8="ll_type";
extern fn ll_abi_type(stage:*LlStage,type:*CrustType,result:bool)->*u8="ll_abi_type";
extern fn ll_number(stage:*LlStage,value:u64)->*u8="ll_number";
extern fn ll_instruction(function:*LlFunction,operation:*u8,type:*u8,left:*u8,right:*u8)->*u8="ll_instruction";
extern fn ll_convert(function:*LlFunction,operation:*u8,from:*u8,value:*u8,to:*u8)->*u8="ll_convert";
extern fn ll_offset(function:*LlFunction,base:*u8,offset:*u8)->*u8="ll_offset";
extern fn ll_load(function:*LlFunction,type:*CrustType,address:*u8)->*u8="ll_load";
extern fn ll_store(function:*LlFunction,type:*CrustType,address:*u8,value:*u8)->unit="ll_store";
extern fn ll_alloca(function:*LlFunction,type:*CrustType)->*u8="ll_alloca";
extern fn ll_text(function:*LlFunction,text:*u8)->unit="ll_text";
extern fn ll_register(function:*LlFunction)->*u8="ll_register";
extern fn ll_id(stage:*LlStage,prefix:*u8)->*u8="ll_id";
extern fn ll_branch(function:*LlFunction,condition:*u8,yes:*u8,no:*u8)->unit="ll_branch";
extern fn ll_jump(function:*LlFunction,destination:*u8)->unit="ll_jump";
extern fn ll_block(function:*LlFunction,destination:*u8)->unit="ll_block";
extern fn ll_error(stage:*LlStage,message:*u8)->unit="ll_error";
