fn pm_destination(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *u8 {
    if (*statement).kind == CRUST_S_VAR {
        if pm_needs_storage(run, (*statement).symbol) {
            return pm_local_slot(run, state, (*statement).symbol, &(*statement).loc);
        }
        pf_bind(run, state, (*statement).symbol, null(*u8));
        return null(*u8);
    }
    var target: *CrustExpr = pf_ungroup(run, (*statement).expr);
    if pf_failed(run) { return null(*u8); }
    if (*target).kind == CRUST_E_NAME && !pm_needs_storage(run, (*target).symbol) { return null(*u8); }
    return pm_place(run, state, target, "true");
}

fn pm_assign_type(statement: *CrustStmt) -> *CrustType {
    if (*statement).kind == CRUST_S_VAR { return (*(*statement).symbol).type; }
    return (*(*statement).expr).type;
}

fn pm_put(run: *PfRun, state: *PfState, statement: *CrustStmt, address: *u8, value: *u8) -> unit {
    if address == null(*u8) {
        var symbol: *CrustSymbol = (*statement).symbol;
        if (*statement).kind == CRUST_S_ASSIGN {
            var target: *CrustExpr = pf_ungroup(run, (*statement).expr);
            if pf_failed(run) { return; }
            symbol = (*target).symbol;
        }
        pf_bind(run, state, symbol, value);
    } else if (*statement).kind == CRUST_S_VAR {
        pm_write(run, state, address, pm_assign_type(statement), value, false, &(*statement).loc);
    } else { pm_store(run, state, (*statement).expr, address, value, &(*statement).loc); }
}

fn pm_call_assignment(run: *PfRun, state: *PfState, statement: *CrustStmt,
                      address: *u8, call: *CrustExpr) -> *PfPath {
    var saved: *u8 = (*state).result;
    var paths: *PfPath = pf_call_results(run, state, call, (*run).calls);
    var path: *PfPath = paths;
    while path != null(*PfPath) && !pf_failed(run) {
        var after: *PfState = (*path).state;
        if (*after).flow == PF_NORMAL { pm_put(run, after, statement, address, (*after).result); }
        (*after).result = saved;
        path = (*path).next;
    }
    return paths;
}

fn pm_statement(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *PfPath {
    if (*statement).kind != CRUST_S_VAR && (*statement).kind != CRUST_S_ASSIGN {
        return pf_statement_inner(run, state, statement, (*run).calls);
    }
    var address: *u8 = pm_destination(run, state, statement);
    if pf_failed(run) { return null(*PfPath); }
    if (*statement).kind == CRUST_S_VAR && (*statement).uninitialized { return pf_path(run, state); }
    var type: *CrustType = pm_assign_type(statement);
    if (*type).kind == CRUST_T_RECORD || (*type).kind == CRUST_T_ARRAY {
        pm_initialize(run, state, address, type, (*statement).value, &(*statement).loc);
        return pf_path(run, state);
    }
    var value: *CrustExpr = pf_ungroup(run, (*statement).value);
    if pf_failed(run) { return null(*PfPath); }
    if (*value).kind == CRUST_E_CALL { return pm_call_assignment(run, state, statement, address, value); }
    var result: *u8 = pf_expression(run, state, value, "true");
    if !pf_failed(run) { pm_put(run, state, statement, address, result); }
    return pf_path(run, state);
}
