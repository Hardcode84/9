fn pm_world(run: *PfRun, state: *PfState) -> *PmWorld {
    return (*state).data as *PmWorld;
}

fn pm_change(run: *PfRun, state: *PfState) -> *PmWorld {
    var previous: *PmWorld = pm_world(run, state);
    var world: *PmWorld = pf_alloc(run, sizeof(PmWorld), alignof(PmWorld)) as *PmWorld;
    if world != null(*PmWorld) { *world = *previous; (*state).data = world as *u8; }
    return world;
}

fn pm_number(run: *PfRun, value: u64) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_number(&buffer, value);
    return c_buffer_end(&buffer);
}

fn pm_pointer(run: *PfRun, origin: *u8, offset: *u8) -> *u8 {
    return pf_binary(run, "ptr", origin, offset);
}

fn pm_origin(run: *PfRun, pointer: *u8) -> *u8 { return pf_unary(run, "origin", pointer); }
fn pm_offset(run: *PfRun, pointer: *u8) -> *u8 { return pf_unary(run, "offset", pointer); }

fn pm_numeric(run: *PfRun, state: *PfState, pointer: *u8) -> *u8 {
    var world: *PmWorld = pm_world(run, state);
    return pf_binary(run, "+", pf_select(run, (*world).bases, pm_origin(run, pointer)), pm_offset(run, pointer));
}

fn pm_require(run: *PfRun, state: *PfState, guard: *u8, claim: *u8, location: *CrustLoc) -> unit {
    pf_goal(run, state, pf_implies(run, guard, claim), location);
}

fn pm_array_store(run: *PfRun, sort: *u8, array: *u8, index: *u8, value: *u8) -> *u8 {
    return pf_define(run, sort, pf_store(run, array, index, value));
}

fn pm_sort(run: *PfRun, type: *CrustType) -> *u8 {
    if (*type).kind == CRUST_T_POINTER { return "Ptr"; }
    if (*type).kind == CRUST_T_BOOL { return "Bool"; }
    if crust_type_integer(type) { return "Int"; }
    return null(*u8);
}

fn pm_solver(stage: *PfStage, query: *u8, location: *CrustLoc) -> i32 {
    var policy: *PmPolicy = (*stage).user as *PmPolicy;
    return proof_z3_query((*stage).status.context, query, location, (*policy).milliseconds);
}

fn pm_pre(run: *PfRun, state: *PfState) -> bool {
    var world: *PmWorld = pf_alloc(run, sizeof(PmWorld), alignof(PmWorld)) as *PmWorld;
    if world == null(*PmWorld) { return false; }
    *world = make PmWorld {
        live: "((as const (Array Int Bool)) false)",
        sizes: "((as const (Array Int Int)) 0)",
        bases: "((as const (Array Int Int)) 0)",
        writable: "((as const (Array Int Bool)) false)",
        initialized: "((as const (Array Ptr Bool)) false)",
        integers: "((as const (Array Ptr Int)) 0)",
        pointers: "((as const (Array Ptr Ptr)) (ptr 0 0))",
        representations: "((as const (Array Ptr Int)) 0)",
        objects: null(*PmObject), cells: null(*PmCell), scope: null(*PmScope)
    };
    (*state).data = world as *u8;
    var parameter: *CrustParam = (*(*run).declaration).params;
    while parameter != null(*CrustParam) && !pf_failed(run) {
        var value: *u8 = pf_binding(state, (*parameter).symbol);
        if (*(*parameter).type).kind == CRUST_T_POINTER {
            pf_assume(run, state, pf_binary(run, "<=", pm_origin(run, value), "0"));
        } else {
            if crust_type_integer((*parameter).type) {
                pf_assume(run, state, pf_eq(run, value, pm_wrap(run, value, (*parameter).type)));
            }
        }
        parameter = (*parameter).next;
    }
    return true;
}

fn pm_access(run: *PfRun, state: *PfState, address: *u8, type: *CrustType,
             guard: *u8, write: bool, location: *CrustLoc) -> unit {
    var world: *PmWorld = pm_world(run, state);
    var identity: *u8 = pm_origin(run, address);
    var offset: *u8 = pm_offset(run, address);
    var size: *u8 = pm_number(run, (*type).size);
    var extent: *u8 = pf_select(run, (*world).sizes, identity);
    var range: *u8 = pf_and(run, pf_binary(run, ">=", offset, "0"),
        pf_binary(run, "<=", pf_binary(run, "+", offset, size), extent));
    var aligned: *u8 = pf_eq(run,
        pf_binary(run, "mod", pm_numeric(run, state, address), pm_number(run, (*type).align as u64)), "0");
    var valid: *u8 = pf_and(run, pf_select(run, (*world).live, identity), pf_and(run, range, aligned));
    if write { valid = pf_and(run, valid, pf_select(run, (*world).writable, identity)); }
    pm_require(run, state, guard, valid, location);
}

fn pm_representation(run: *PfRun, type: *CrustType) -> *u8 {
    if (*type).kind == CRUST_T_POINTER { return "1"; }
    return pm_number(run, (*type).kind as u64 + 2u64);
}

fn pm_load(run: *PfRun, state: *PfState, address: *u8, type: *CrustType,
           guard: *u8, location: *CrustLoc) -> *u8 {
    if pm_sort(run, type) == null(*u8) {
        pf_error((*run).stage, location, "memory proof requires scalar loads; aggregate copies need a checked contract");
        return null(*u8);
    }
    pm_access(run, state, address, type, guard, false, location);
    var world: *PmWorld = pm_world(run, state);
    var initialized: *u8 = pf_select(run, (*world).initialized, address);
    var representation: *u8 = pf_eq(run, pf_select(run, (*world).representations, address), pm_representation(run, type));
    pm_require(run, state, guard, pf_and(run, initialized, representation), location);
    if (*type).kind == CRUST_T_POINTER { return pf_select(run, (*world).pointers, address); }
    var value: *u8 = pf_select(run, (*world).integers, address);
    if (*type).kind == CRUST_T_BOOL { return pf_eq(run, value, "1"); }
    return value;
}

fn pm_disjoint(run: *PfRun, a: *u8, a_size: *u8, b: *u8, b_size: *u8) -> *u8 {
    var different: *u8 = pf_not(run, pf_eq(run, pm_origin(run, a), pm_origin(run, b)));
    var before: *u8 = pf_binary(run, "<=", pf_binary(run, "+", pm_offset(run, a), a_size), pm_offset(run, b));
    var after: *u8 = pf_binary(run, "<=", pf_binary(run, "+", pm_offset(run, b), b_size), pm_offset(run, a));
    return pf_or(run, different, pf_or(run, before, after));
}

fn pm_store_shape(run: *PfRun, state: *PfState, address: *u8, type: *CrustType, location: *CrustLoc) -> unit {
    var world: *PmWorld = pm_world(run, state);
    var cell: *PmCell = (*world).cells;
    while cell != null(*PmCell) && !pf_failed(run) {
        var same: *u8 = pf_and(run, pf_eq(run, address, (*cell).address),
            pf_eq(run, pm_representation(run, type), pm_representation(run, (*cell).type)));
        var apart: *u8 = pm_disjoint(run, address, pm_number(run, (*type).size),
            (*cell).address, pm_number(run, (*(*cell).type).size));
        pm_require(run, state, "true", pf_or(run, same, apart), location);
        cell = (*cell).next;
    }
}

fn pm_write(run: *PfRun, state: *PfState, address: *u8, type: *CrustType,
            value: *u8, persistent: bool, location: *CrustLoc) -> bool {
    if pm_sort(run, type) == null(*u8) {
        pf_error((*run).stage, location, "memory proof requires scalar stores; aggregate copies need a checked contract");
        return false;
    }
    pm_access(run, state, address, type, "true", true, location);
    pm_store_shape(run, state, address, type, location);
    if persistent && (*type).kind == CRUST_T_POINTER {
        var previous: *PmWorld = pm_world(run, state);
        var valid: *u8 = pf_select(run, (*previous).live, pm_origin(run, value));
        pm_require(run, state, "true", pf_or(run, pf_eq(run, value, "(ptr 0 0)"), valid), location);
    }
    var world: *PmWorld = pm_change(run, state);
    var cell: *PmCell = pf_alloc(run, sizeof(PmCell), alignof(PmCell)) as *PmCell;
    if world == null(*PmWorld) || cell == null(*PmCell) { return false; }
    *cell = make PmCell { address: address, type: type, next: (*world).cells, persistent: persistent };
    (*world).cells = cell;
    (*world).initialized = pm_array_store(run, "(Array Ptr Bool)", (*world).initialized, address, "true");
    (*world).representations = pm_array_store(run, "(Array Ptr Int)", (*world).representations, address, pm_representation(run, type));
    if (*type).kind == CRUST_T_POINTER {
        (*world).pointers = pm_array_store(run, "(Array Ptr Ptr)", (*world).pointers, address, value);
    }
    else {
        if (*type).kind == CRUST_T_BOOL { value = pf_ite(run, value, "1", "0"); }
        (*world).integers = pm_array_store(run, "(Array Ptr Int)", (*world).integers, address, value);
    }
    return !pf_failed(run);
}

fn pm_store(run: *PfRun, state: *PfState, source: *CrustExpr,
            address: *u8, value: *u8, location: *CrustLoc) -> bool {
    while (*source).kind == CRUST_E_GROUP { source = (*source).left; }
    return pm_write(run, state, address, (*source).type, value, (*source).kind != CRUST_E_NAME, location);
}
