// SPDX-License-Identifier: Apache-2.0

record PmContract {
    run: *PfRun;
    before: *PfState;
    after: *PfState;
}

// Require live, aligned storage of this extent. This does not require initialization.
fn pm_contract_access(contract: *PmContract, address: *u8, type: *CrustType, write: bool) -> unit {
    var run: *PfRun = (*contract).run;
    pm_access(run, (*contract).before, address, type, "true", write, &(*(*run).declaration).loc);
}

// Require an initialized scalar and return its value at function entry.
fn pm_contract_read(contract: *PmContract, address: *u8, type: *CrustType) -> *u8 {
    var run: *PfRun = (*contract).run;
    return pm_load(run, (*contract).before, address, type, "true", &(*(*run).declaration).loc);
}

// Permit a scalar write and set its required final value. Writes are ordered.
fn pm_contract_write(contract: *PmContract, address: *u8, type: *CrustType, value: *u8) -> unit {
    var run: *PfRun = (*contract).run;
    pm_write(run, (*contract).after, address, type, value, true, &(*(*run).declaration).loc);
}

// Require this Boolean term at function entry.
fn pm_contract_require(contract: *PmContract, condition: *u8) -> unit {
    var run: *PfRun = (*contract).run;
    pf_goal(run, (*contract).before, condition, &(*(*run).declaration).loc);
}

fn pm_contract_statement(run: *PfRun, statement: *CrustStmt) -> unit {
    var kind: u32 = (*statement).kind;
    if kind == CRUST_S_BLOCK { pm_contract_statements(run, (*statement).body); }
    else if kind == CRUST_S_IF {
        pm_contract_statements(run, (*statement).body);
        pm_contract_statements(run, (*statement).otherwise);
    } else if kind == CRUST_S_VAR { pm_summary_local(run, (*statement).symbol, &(*statement).loc); }
    else if kind == CRUST_S_ASSIGN {
        if pm_sort(run, (*(*statement).expr).type) == null(*u8) {
            pf_error((*run).stage, &(*statement).loc, "memory contract requires scalar assignments");
        }
    } else if kind != CRUST_S_RETURN || (*statement).expr != null(*CrustExpr) {
        pf_error((*run).stage, &(*statement).loc, "memory contract requires loop-free unit-returning bodies");
    }
}

fn pm_contract_statements(run: *PfRun, statement: *CrustStmt) -> unit {
    while statement != null(*CrustStmt) && !pf_failed(run) {
        if !pf_enter(run, &(*statement).loc) { return; }
        pm_summary_expression(run, (*statement).expr);
        pm_summary_expression(run, (*statement).value);
        pm_contract_statement(run, statement);
        (*run).depth = (*run).depth - 1usize;
        statement = (*statement).next;
    }
}

fn pm_contract_definitions(run: *PfRun, summary: *PmSummary) -> unit {
    var definition: *PfDefinition = (*summary).definitions;
    (*summary).definitions = null(*PfDefinition);
    while definition != null(*PfDefinition) {
        var next: *PfDefinition = (*definition).next;
        (*definition).next = (*summary).definitions;
        (*summary).definitions = definition;
        definition = next;
    }
    definition = (*summary).definitions;
    while definition != null(*PfDefinition) && !pf_failed(run) {
        pf_definition(run, (*definition).name, (*definition).sort, (*definition).value);
        definition = (*definition).next;
    }
}

fn pm_contract_goals(before: *PfState, after: *PfState) -> unit {
    var goal: *PfGoal = (*before).goals;
    if goal == null(*PfGoal) { return; }
    var tail: *PfGoal = goal;
    while (*tail).next != null(*PfGoal) { tail = (*tail).next; }
    (*tail).next = (*after).goals;
    (*after).goals = goal;
}

fn pm_contract_model(run: *PfRun, summary: *PmSummary,
                     describe: fn(*PmContract, *u8) -> unit, user: *u8) -> bool {
    var initial: *PfState = pf_state(run);
    if initial == null(*PfState) || !pf_parameters(run, initial) { return false; }
    if pm_summary_world(run, initial) == null(*PmWorld) { return false; }
    (*summary).before = initial;
    var contract: PmContract = make PmContract {
        run: run, before: pf_fork(run, initial), after: pf_fork(run, initial)
    };
    if pf_failed(run) { return false; }
    (*run).definitions = &(*summary).definitions;
    describe(&contract, user);
    (*run).definitions = null(**PfDefinition);
    if pf_failed(run) { return false; }
    pm_contract_goals(contract.before, contract.after);
    (*summary).after = contract.after;
    pm_contract_definitions(run, summary);
    return !pf_failed(run);
}

fn pm_contract_written(run: *PfRun, state: *PfState, cell: *PmCell, allowed: *PmCell) -> unit {
    var valid: *u8 = "false";
    while allowed != null(*PmCell) && !pf_failed(run) {
        var same: *u8 = pf_and(run, pf_eq(run, (*cell).address, (*allowed).address),
            pf_eq(run, pm_representation(run, (*cell).type), pm_representation(run, (*allowed).type)));
        valid = pf_or(run, valid, same);
        allowed = (*allowed).next;
    }
    pf_goal(run, state, valid, &(*(*run).declaration).loc);
}

fn pm_contract_frame(run: *PfRun, state: *PfState, expected: *PmWorld) -> unit {
    var actual: *PmWorld = pm_world(run, state);
    var location: *CrustLoc = &(*(*run).declaration).loc;
    pf_goal(run, state, pf_eq(run, (*actual).live, (*expected).live), location);
    pf_goal(run, state, pf_eq(run, (*actual).sizes, (*expected).sizes), location);
    pf_goal(run, state, pf_eq(run, (*actual).bases, (*expected).bases), location);
    pf_goal(run, state, pf_eq(run, (*actual).writable, (*expected).writable), location);
    pf_goal(run, state, pf_eq(run, (*actual).initialized, (*expected).initialized), location);
    pf_goal(run, state, pf_eq(run, (*actual).integers, (*expected).integers), location);
    pf_goal(run, state, pf_eq(run, (*actual).pointers, (*expected).pointers), location);
    pf_goal(run, state, pf_eq(run, (*actual).representations, (*expected).representations), location);
    // Final array equality alone would permit an undeclared write followed by restoration.
    var cell: *PmCell = (*actual).cells;
    while cell != null(*PmCell) && !pf_failed(run) {
        pm_contract_written(run, state, cell, (*expected).cells);
        cell = (*cell).next;
    }
}

fn pm_contract_prove(run: *PfRun, summary: *PmSummary) -> bool {
    var state: *PfState = pf_fork(run, (*summary).before);
    if state == null(*PfState) { return false; }
    var goal: *PfGoal = (*(*summary).after).goals;
    while goal != null(*PfGoal) && !pf_failed(run) {
        pf_assume(run, state, pf_implies(run, (*goal).assumptions, (*goal).value));
        goal = (*goal).next;
    }
    var declaration: *CrustDecl = (*summary).declaration;
    var location: *CrustLoc = &(*declaration).loc;
    var possible: i32 = pf_solve(run, pf_reachability_query(run, state), location);
    if possible != 1i32 {
        if possible == 0i32 { pf_error((*run).stage, location, "memory contract preconditions are inconsistent"); }
        return false;
    }
    (*run).before = pf_fork(run, state);
    if pf_failed(run) { return false; }
    var frame: PfCall = make PfCall { declaration: declaration, parent: null(*PfCall), guard: "true" };
    var paths: *PfPath = pf_statement(run, state, pf_body((*run).stage, declaration), &frame);
    while paths != null(*PfPath) && !pf_failed(run) {
        state = (*paths).state;
        if (*state).flow != PF_NORMAL && (*state).flow != PF_RETURN {
            pf_error((*run).stage, location, "memory contract requires normal completion");
            return false;
        }
        pm_contract_frame(run, state, pm_world(run, (*summary).after));
        if !pf_prove_goals(run, state) { return false; }
        paths = (*paths).next;
    }
    return !pf_failed(run);
}

// Require the checked memory policy and completed storage planning. Describe one
// contract with these helpers and generated terms from its input parameters/maps.
// Prove the complete body before installing the effect. Keep the body and policy
// unchanged until all callers have been checked. A second selection is an error.
fn pm_contract_register(stage: *PfStage, declaration: *CrustDecl,
                        describe: fn(*PmContract, *u8) -> unit, user: *u8) -> bool {
    if !pf_ready(stage, &(*declaration).loc) { return false; }
    var policy: *PmPolicy = (*stage).user as *PmPolicy;
    if (*declaration).kind != CRUST_D_FUNCTION || (*(*(*declaration).type).base).kind != CRUST_T_UNIT ||
       describe == null(fn(*PmContract, *u8) -> unit) {
        pf_error(stage, &(*declaration).loc, "memory contract requires a defined unit function and a model");
        return false;
    }
    if c_map_get(&(*policy).summaries, declaration as usize) != 0usize {
        pf_error(stage, &(*declaration).loc, "memory call contract or summary already selected");
        return false;
    }
    var run: PfRun = uninit;
    pf_run_init(&run, stage, declaration);
    if !pf_function(&run, declaration, &(*declaration).loc) { return false; }
    var parameter: *CrustParam = (*declaration).params;
    while parameter != null(*CrustParam) && !pf_failed(&run) {
        pm_summary_local(&run, (*parameter).symbol, &(*parameter).loc);
        parameter = (*parameter).next;
    }
    pm_contract_statements(&run, pf_body(stage, declaration));
    if pf_failed(&run) { return false; }
    var summary: *PmSummary = pf_alloc(&run, sizeof(PmSummary), alignof(PmSummary)) as *PmSummary;
    if summary == null(*PmSummary) { return false; }
    *summary = make PmSummary {
        declaration: declaration, before: null(*PfState), after: null(*PfState),
        definitions: null(*PfDefinition), next: null(*PmSummary)
    };
    if !pm_contract_model(&run, summary, describe, user) || !pm_contract_prove(&run, summary) { return false; }
    c_map_set(&(*stage).status, &(*policy).summaries, declaration as usize, summary as usize);
    (*stage).invoke = pm_summary_invoke;
    return !(*stage).status.failed;
}
