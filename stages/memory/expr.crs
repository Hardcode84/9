fn pm_signed(type: *CrustType) -> bool {
    var kind: u32 = (*type).kind;
    return kind == CRUST_T_I8 || kind == CRUST_T_I16 || kind == CRUST_T_I32 ||
           kind == CRUST_T_I64 || kind == CRUST_T_ISIZE;
}

fn pm_modulus(run: *PfRun, type: *CrustType) -> *u8 {
    var width: u64 = (*type).size * 8u64;
    if width == 64u64 { return "18446744073709551616"; }
    return pm_number(run, 1u64 << width);
}

fn pm_wrap(run: *PfRun, value: *u8, type: *CrustType) -> *u8 {
    var modulus: *u8 = pm_modulus(run, type);
    var reduced: *u8 = pf_binary(run, "mod", value, modulus);
    if !pm_signed(type) { return reduced; }
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_text(&buffer, "(let ((pm!wrapped ");
    c_buffer_text(&buffer, reduced);
    c_buffer_text(&buffer, ")) (ite (< pm!wrapped ");
    c_buffer_text(&buffer, pm_number(run, 1u64 << ((*type).size * 8u64 - 1u64)));
    c_buffer_text(&buffer, ") pm!wrapped (- pm!wrapped ");
    c_buffer_text(&buffer, modulus);
    c_buffer_text(&buffer, ")))");
    return c_buffer_end(&buffer);
}

fn pm_bitvector(run: *PfRun, value: *u8, type: *CrustType) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_text(&buffer, "((_ int2bv ");
    c_buffer_number(&buffer, (*type).size * 8u64);
    c_buffer_text(&buffer, ") ");
    c_buffer_text(&buffer, value);
    c_buffer_text(&buffer, ")");
    return c_buffer_end(&buffer);
}

fn pm_bit_result(run: *PfRun, value: *u8, type: *CrustType) -> *u8 {
    return pm_wrap(run, pf_unary(run, "bv2int", value), type);
}

fn pm_between(run: *PfRun, value: *u8, upper: *u8) -> *u8 {
    return pf_and(run, pf_binary(run, "<=", "0", value), pf_binary(run, "<=", value, upper));
}

fn pm_offset_valid(run: *PfRun, state: *PfState, pointer: *u8, offset: *u8) -> *u8 {
    var world: *PmWorld = pm_world(run, state);
    var origin: *u8 = pm_origin(run, pointer);
    var size: *u8 = pf_select(run, (*world).sizes, origin);
    var address: *u8 = pf_binary(run, "+", pf_select(run, (*world).bases, origin), offset);
    var valid: *u8 = pf_and(run, pf_not(run, pf_eq(run, origin, "0")),
                            pf_select(run, (*world).live, origin));
    valid = pf_and(run, valid, pm_between(run, pm_offset(run, pointer), size));
    valid = pf_and(run, valid, pm_between(run, offset, size));
    return pf_and(run, valid, pm_between(run, address, "18446744073709551615"));
}

fn pm_advance(run: *PfRun, state: *PfState, pointer: *u8, delta: *u8,
              guard: *u8, location: *CrustLoc) -> *u8 {
    var offset: *u8 = pf_binary(run, "+", pm_offset(run, pointer), delta);
    var null_offset: *u8 = pf_and(run, pf_eq(run, pointer, pm_pointer(run, "0", "0")),
                                  pf_eq(run, delta, "0"));
    pm_require(run, state, guard, pf_or(run, null_offset,
               pm_offset_valid(run, state, pointer, offset)), location);
    return pm_pointer(run, pm_origin(run, pointer), offset);
}

fn pm_index_place(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var base: *CrustExpr = (*expression).left;
    var base_type: *CrustType = (*base).type;
    var address: *u8 = null(*u8);
    if (*base_type).kind == CRUST_T_ARRAY {
        address = pm_place(run, state, base, guard);
    } else {
        address = pf_expression(run, state, base, guard);
    }
    var index: *u8 = pf_expression(run, state, (*expression).right, guard);
    if pf_failed(run) { return null(*u8); }
    if (*base_type).kind == CRUST_T_ARRAY {
        pm_require(run, state, guard, pf_binary(run, "<", index,
                   pm_number(run, (*base_type).count)), &(*expression).loc);
    }
    var delta: *u8 = pf_binary(run, "*", index, pm_number(run, (*(*expression).type).size));
    address = pm_advance(run, state, address, delta, guard, &(*expression).loc);
    pm_access(run, state, address, (*expression).type, guard, false, &(*expression).loc);
    return address;
}

fn pm_place_inner(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var kind: u32 = (*expression).kind;
    if kind == CRUST_E_GROUP { return pm_place(run, state, (*expression).left, guard); }
    if kind == CRUST_E_NAME {
        var symbol: *CrustSymbol = (*expression).symbol;
        if (*symbol).kind == CRUST_SYM_LOCAL || (*symbol).kind == CRUST_SYM_PARAM {
            return pm_local_address(run, state, symbol, &(*expression).loc);
        }
    }
    if kind == CRUST_E_UNARY && (*expression).op == CRUST_OP_DEREF {
        var address: *u8 = pf_expression(run, state, (*expression).left, guard);
        if pf_failed(run) { return null(*u8); }
        pm_access(run, state, address, (*expression).type, guard, false, &(*expression).loc);
        return address;
    }
    if kind == CRUST_E_FIELD {
        var address: *u8 = pm_place(run, state, (*expression).left, guard);
        if pf_failed(run) { return null(*u8); }
        return pm_pointer(run, pm_origin(run, address), pf_binary(run, "+",
                   pm_offset(run, address), pm_number(run, (*(*expression).field).offset)));
    }
    if kind == CRUST_E_INDEX { return pm_index_place(run, state, expression, guard); }
    pf_error((*run).stage, &(*expression).loc, "memory proof requires a local or live storage place");
    return null(*u8);
}

fn pm_place(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    if !pf_enter(run, &(*expression).loc) { return null(*u8); }
    var address: *u8 = pm_place_inner(run, state, expression, guard);
    (*run).depth = (*run).depth - 1usize;
    if pf_failed(run) { return null(*u8); }
    return pf_define(run, "Ptr", address);
}

fn pm_place_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    if (*(*expression).type).kind == CRUST_T_RECORD || (*(*expression).type).kind == CRUST_T_ARRAY {
        pf_error((*run).stage, &(*expression).loc, "memory proof requires scalar loads");
        return null(*u8);
    }
    var address: *u8 = pm_place(run, state, expression, guard);
    if pf_failed(run) { return null(*u8); }
    return pm_load(run, state, address, (*expression).type, guard, &(*expression).loc);
}

fn pm_compare(run: *PfRun, state: *PfState, expression: *CrustExpr,
              left: *u8, right: *u8) -> *u8 {
    var operation: u32 = (*expression).op;
    if (*(*(*expression).left).type).kind == CRUST_T_POINTER {
        left = pm_numeric(run, state, left);
        right = pm_numeric(run, state, right);
    }
    if operation == CRUST_OP_EQ { return pf_eq(run, left, right); }
    if operation == CRUST_OP_NE { return pf_not(run, pf_eq(run, left, right)); }
    if operation == CRUST_OP_LT { return pf_binary(run, "<", left, right); }
    if operation == CRUST_OP_LE { return pf_binary(run, "<=", left, right); }
    if operation == CRUST_OP_GT { return pf_binary(run, ">", left, right); }
    return pf_binary(run, ">=", left, right);
}

fn pm_division_safe(run: *PfRun, state: *PfState, expression: *CrustExpr,
                    left: *u8, right: *u8, guard: *u8) -> unit {
    var valid: *u8 = pf_not(run, pf_eq(run, right, "0"));
    var type: *CrustType = (*(*expression).left).type;
    if pm_signed(type) {
        var minimum: *u8 = pf_unary(run, "-", pm_number(run,
                                      1u64 << ((*type).size * 8u64 - 1u64)));
        var overflow: *u8 = pf_and(run, pf_eq(run, left, minimum),
                                    pf_eq(run, right, "(- 1)"));
        valid = pf_and(run, valid, pf_not(run, overflow));
    }
    pm_require(run, state, guard, valid, &(*expression).loc);
}

fn pm_quotient(run: *PfRun, left: *u8, right: *u8, type: *CrustType) -> *u8 {
    if !pm_signed(type) { return pf_binary(run, "div", left, right); }
    var negative_left: *u8 = pf_binary(run, "<", left, "0");
    var negative_right: *u8 = pf_binary(run, "<", right, "0");
    var magnitude: *u8 = pf_binary(run, "div",
        pf_ite(run, negative_left, pf_unary(run, "-", left), left),
        pf_ite(run, negative_right, pf_unary(run, "-", right), right));
    return pf_ite(run, pf_binary(run, "xor", negative_left, negative_right),
                  pf_unary(run, "-", magnitude), magnitude);
}

fn pm_division(run: *PfRun, state: *PfState, expression: *CrustExpr,
               left: *u8, right: *u8, guard: *u8) -> *u8 {
    pm_division_safe(run, state, expression, left, right, guard);
    var quotient: *u8 = pm_quotient(run, left, right, (*expression).type);
    if (*expression).op == CRUST_OP_DIV { return quotient; }
    return pf_binary(run, "-", left, pf_binary(run, "*", quotient, right));
}

fn pm_bits(run: *PfRun, state: *PfState, expression: *CrustExpr,
           left: *u8, right: *u8, guard: *u8) -> *u8 {
    var operation: u32 = (*expression).op;
    var type: *CrustType = (*expression).type;
    var spelling: *u8 = "bvxor";
    if operation == CRUST_OP_BIT_AND { spelling = "bvand"; }
    if operation == CRUST_OP_BIT_OR { spelling = "bvor"; }
    if operation == CRUST_OP_SHL || operation == CRUST_OP_SHR {
        var valid: *u8 = pf_and(run, pf_binary(run, "<=", "0", right),
            pf_binary(run, "<", right, pm_number(run, (*type).size * 8u64)));
        pm_require(run, state, guard, valid, &(*expression).loc);
        spelling = "bvshl";
        if operation == CRUST_OP_SHR {
            spelling = "bvlshr";
            if pm_signed(type) { spelling = "bvashr"; }
        }
    }
    return pm_bit_result(run, pf_binary(run, spelling,
        pm_bitvector(run, left, type), pm_bitvector(run, right, type)), type);
}

fn pm_arithmetic(run: *PfRun, state: *PfState, expression: *CrustExpr,
                 left: *u8, right: *u8, guard: *u8) -> *u8 {
    var operation: u32 = (*expression).op;
    var type: *CrustType = (*expression).type;
    if (*type).kind == CRUST_T_POINTER {
        var delta: *u8 = pf_binary(run, "*", right, pm_number(run, (*(*type).base).size));
        if operation == CRUST_OP_SUB { delta = pf_unary(run, "-", delta); }
        return pm_advance(run, state, left, delta, guard, &(*expression).loc);
    }
    if operation == CRUST_OP_DIV || operation == CRUST_OP_REM {
        return pm_division(run, state, expression, left, right, guard);
    }
    if operation >= CRUST_OP_SHL { return pm_bits(run, state, expression, left, right, guard); }
    var spelling: *u8 = "+";
    if operation == CRUST_OP_SUB { spelling = "-"; }
    if operation == CRUST_OP_MUL { spelling = "*"; }
    return pm_wrap(run, pf_binary(run, spelling, left, right), type);
}

fn pm_binary_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var operation: u32 = (*expression).op;
    var left: *u8 = pf_expression(run, state, (*expression).left, guard);
    if pf_failed(run) { return null(*u8); }
    var right_guard: *u8 = guard;
    if operation == CRUST_OP_AND { right_guard = pf_and(run, guard, left); }
    if operation == CRUST_OP_OR { right_guard = pf_and(run, guard, pf_not(run, left)); }
    var right: *u8 = pf_expression(run, state, (*expression).right, right_guard);
    if pf_failed(run) { return null(*u8); }
    if operation == CRUST_OP_AND { return pf_and(run, left, right); }
    if operation == CRUST_OP_OR { return pf_or(run, left, right); }
    if operation >= CRUST_OP_EQ { return pm_compare(run, state, expression, left, right); }
    return pm_arithmetic(run, state, expression, left, right, guard);
}

fn pm_unary_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var operation: u32 = (*expression).op;
    if operation == CRUST_OP_ADDRESS { return pm_place(run, state, (*expression).left, guard); }
    if operation == CRUST_OP_DEREF { return pm_place_value(run, state, expression, guard); }
    var value: *u8 = pf_expression(run, state, (*expression).left, guard);
    if pf_failed(run) { return null(*u8); }
    if operation == CRUST_OP_NOT { return pf_not(run, value); }
    if operation == CRUST_OP_NEG { return pm_wrap(run, pf_unary(run, "-", value), (*expression).type); }
    return pm_bit_result(run, pf_unary(run, "bvnot",
                         pm_bitvector(run, value, (*expression).type)), (*expression).type);
}

fn pm_pointer_cast(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var source: *CrustExpr = (*expression).left;
    if (*(*source).type).kind == CRUST_T_POINTER && (*(*expression).type).kind == CRUST_T_POINTER {
        return pf_expression(run, state, source, guard);
    }
    var literal: *CrustExpr = pf_ungroup(run, source);
    if pf_failed(run) { return null(*u8); }
    if (*(*expression).type).kind == CRUST_T_POINTER &&
       (*literal).kind == CRUST_E_INTEGER && (*literal).integer == 0u64 {
        return pm_pointer(run, "0", "0");
    }
    pf_error((*run).stage, &(*expression).loc, "memory proof rejects pointer and integer conversion except literal zero");
    return null(*u8);
}

fn pm_cast_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var source: *CrustType = (*(*expression).left).type;
    var target: *CrustType = (*expression).type;
    if (*source).kind == CRUST_T_POINTER || (*target).kind == CRUST_T_POINTER {
        return pm_pointer_cast(run, state, expression, guard);
    }
    if (*source).kind > CRUST_T_BOOL || (*target).kind > CRUST_T_BOOL {
        pf_error((*run).stage, &(*expression).loc, "memory proof requires integer, Boolean, or pointer casts");
        return null(*u8);
    }
    var value: *u8 = pf_expression(run, state, (*expression).left, guard);
    if pf_failed(run) { return null(*u8); }
    if (*source).kind == CRUST_T_BOOL {
        if (*target).kind == CRUST_T_BOOL { return value; }
        return pf_ite(run, value, "1", "0");
    }
    if (*target).kind == CRUST_T_BOOL { return pf_not(run, pf_eq(run, value, "0")); }
    return pm_wrap(run, value, target);
}

fn pm_binding_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var value: *u8 = pf_binding(state, (*expression).symbol);
    if value != null(*u8) { return value; }
    var sort: *u8 = pm_sort(run, (*expression).type);
    if sort == null(*u8) {
        pf_error((*run).stage, &(*expression).loc, "memory proof requires scalar local values");
        return null(*u8);
    }
    pm_require(run, state, guard, "false", &(*expression).loc);
    return pf_fresh(run, sort);
}

fn pm_name_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var symbol: *CrustSymbol = (*expression).symbol;
    if (*symbol).kind != CRUST_SYM_LOCAL && (*symbol).kind != CRUST_SYM_PARAM {
        pf_error((*run).stage, &(*expression).loc, "memory proof requires local values or direct function calls");
        return null(*u8);
    }
    if !pm_needs_storage(run, symbol) { return pm_binding_value(run, state, expression, guard); }
    var local: *PmLocal = pm_find_local(state, symbol);
    if local == null(*PmLocal) {
        pf_error((*run).stage, &(*expression).loc, "memory proof has no live storage for this binding");
        return null(*u8);
    }
    return pm_load(run, state, (*local).address, (*expression).type, guard, &(*expression).loc);
}

fn pm_value_inner(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var kind: u32 = (*expression).kind;
    if kind == CRUST_E_GROUP || kind == CRUST_E_CALL { return null(*u8); }
    if kind == CRUST_E_NAME { return pm_name_value(run, state, expression, guard); }
    if kind == CRUST_E_INTEGER { return pm_wrap(run, pm_number(run, (*expression).integer), (*expression).type); }
    if kind == CRUST_E_BOOL {
        if (*expression).integer == 0u64 { return "false"; }
        return "true";
    }
    if kind == CRUST_E_NULL && (*(*expression).type).kind == CRUST_T_POINTER {
        return pm_pointer(run, "0", "0");
    }
    return pm_other_value(run, state, expression, guard);
}

fn pm_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var value: *u8 = pm_value_inner(run, state, expression, guard);
    if value == null(*u8) || pf_failed(run) { return null(*u8); }
    return pf_define(run, pm_sort(run, (*expression).type), value);
}

fn pm_other_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var kind: u32 = (*expression).kind;
    if kind == CRUST_E_SIZEOF || kind == CRUST_E_ALIGNOF || kind == CRUST_E_OFFSETOF {
        return pm_number(run, (*expression).integer);
    }
    if kind == CRUST_E_FIELD || kind == CRUST_E_INDEX { return pm_place_value(run, state, expression, guard); }
    if kind == CRUST_E_UNARY { return pm_unary_value(run, state, expression, guard); }
    if kind == CRUST_E_BINARY { return pm_binary_value(run, state, expression, guard); }
    if kind == CRUST_E_CAST { return pm_cast_value(run, state, expression, guard); }
    pf_error((*run).stage, &(*expression).loc, "memory proof does not support this value expression");
    return null(*u8);
}
