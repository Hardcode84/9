fn pm_find_foreign(run: *PfRun, declaration: *CrustDecl) -> *PmForeign {
    var policy: *PmPolicy = (*(*run).stage).user as *PmPolicy;
    var entry: *PmForeign = (*policy).foreign;
    while entry != null(*PmForeign) {
        if (*entry).declaration == declaration { return entry; }
        entry = (*entry).next;
    }
    return null(*PmForeign);
}

fn pm_foreign_allocate(run: *PfRun, state: *PfState, call: *CrustExpr,
                       contract: *PmForeign, guard: *u8) -> *u8 {
    var size: *u8 = pf_expression(run, state, (*call).args[0usize], guard);
    if pf_failed(run) { return null(*u8); }
    var success: *u8 = pf_fresh(run, "Bool");
    var live: *u8 = pf_and(run, guard, success);
    var pointer: *u8 = pm_new_object(run, state, size, (*contract).alignment, true, live, &(*call).loc);
    if pf_failed(run) { return null(*u8); }
    return pf_ite(run, success, pointer, "(ptr 0 0)");
}

fn pm_heap_owner(run: *PfRun, state: *PfState, identity: *u8) -> *u8 {
    var world: *PmWorld = pm_world(run, state);
    var object: *PmObject = (*world).objects;
    var owned: *u8 = "false";
    while object != null(*PmObject) {
        if (*object).heap { owned = pf_or(run, owned, pf_eq(run, identity, (*object).identity)); }
        object = (*object).next;
    }
    return owned;
}

fn pm_foreign_release(run: *PfRun, state: *PfState, call: *CrustExpr,
                      guard: *u8) -> *u8 {
    var pointer: *u8 = pf_expression(run, state, (*call).args[0usize], guard);
    if pf_failed(run) { return null(*u8); }
    var world: *PmWorld = pm_world(run, state);
    var identity: *u8 = pm_origin(run, pointer);
    var active: *u8 = pf_and(run, guard, pf_not(run, pf_eq(run, pointer, "(ptr 0 0)")));
    var valid: *u8 = pf_and(run, pf_select(run, (*world).live, identity),
        pf_eq(run, pm_offset(run, pointer), "0"));
    valid = pf_and(run, valid, pm_heap_owner(run, state, identity));
    pm_require(run, state, active, valid, &(*call).loc);
    pm_retire(run, state, identity, active, &(*call).loc);
    return "0";
}

fn pm_foreign_scalar(run: *PfRun, state: *PfState, call: *CrustExpr, guard: *u8) -> *u8 {
    var index: usize = 0usize;
    while index < (*call).arg_count && !pf_failed(run) {
        pf_expression(run, state, (*call).args[index], guard);
        index = index + 1usize;
    }
    if pf_failed(run) { return null(*u8); }
    var type: *CrustType = (*call).type;
    if (*type).kind == CRUST_T_UNIT { return "0"; }
    var value: *u8 = pf_fresh(run, pm_sort(run, type));
    if (*type).kind == CRUST_T_BOOL { return value; }
    return pm_wrap(run, value, type);
}

fn pm_external(run: *PfRun, state: *PfState, call: *CrustExpr, guard: *u8) -> *u8 {
    var callee: *CrustExpr = (*call).left;
    while (*callee).kind == CRUST_E_GROUP { callee = (*callee).left; }
    var contract: *PmForeign = pm_find_foreign(run, (*(*callee).symbol).decl);
    if contract == null(*PmForeign) {
        pf_error((*run).stage, &(*call).loc, "foreign call has no explicit memory contract");
        return null(*u8);
    }
    if (*contract).kind == PM_ALLOCATE { return pm_foreign_allocate(run, state, call, contract, guard); }
    if (*contract).kind == PM_RELEASE { return pm_foreign_release(run, state, call, guard); }
    return pm_foreign_scalar(run, state, call, guard);
}

fn pm_foreign_signature(declaration: *CrustDecl, kind: u32) -> bool {
    if (*declaration).kind != CRUST_D_EXTERN { return false; }
    var parameter: *CrustParam = (*declaration).params;
    var result: *CrustType = (*(*declaration).type).base;
    if kind == PM_ALLOCATE {
        return (*declaration).param_count == 1usize && (*(*parameter).type).kind == CRUST_T_USIZE &&
            (*result).kind == CRUST_T_POINTER;
    }
    if kind == PM_RELEASE {
        return (*declaration).param_count == 1usize && (*(*parameter).type).kind == CRUST_T_POINTER &&
            (*result).kind == CRUST_T_UNIT;
    }
    if kind != PM_SCALAR { return false; }
    while parameter != null(*CrustParam) {
        if !crust_type_integer((*parameter).type) && (*(*parameter).type).kind != CRUST_T_BOOL { return false; }
        parameter = (*parameter).next;
    }
    return crust_type_integer(result) || (*result).kind == CRUST_T_BOOL || (*result).kind == CRUST_T_UNIT;
}

// Declare one trusted foreign effect before checking a closed application.
// Allocate is nullable and fresh, release consumes a heap allocation or accepts null,
// and scalar has no access to application storage and returns normally.
fn pm_foreign(stage: *PfStage, policy: *PmPolicy, declaration: *CrustDecl,
               kind: u32, alignment: usize) -> bool {
    if !pm_foreign_signature(declaration, kind) || alignment == 0usize ||
       (alignment & (alignment - 1usize)) != 0usize {
        pf_error(stage, &(*declaration).loc, "foreign memory contract has an invalid signature or alignment");
        return false;
    }
    var entry: *PmForeign = c_alloc(&(*stage).status, sizeof(PmForeign), alignof(PmForeign)) as *PmForeign;
    if entry == null(*PmForeign) { return false; }
    *entry = make PmForeign {
        declaration: declaration, next: (*policy).foreign,
        alignment: alignment, kind: kind
    };
    (*policy).foreign = entry;
    return true;
}
