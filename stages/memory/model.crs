// SPDX-License-Identifier: Apache-2.0

record PmForeign {
    declaration: *CrustDecl;
    next: *PmForeign;
    alignment: usize;
    kind: u32;
}

record PmPolicy {
    addressed: CMap;
    summaries: CMap;
    foreign: *PmForeign;
    first_summary: *PmSummary;
    milliseconds: u32;
}

record PmSummary {
    declaration: *CrustDecl;
    before: *PfState;
    after: *PfState;
    definitions: *PfDefinition;
    next: *PmSummary;
}

record PmWorld {
    live: *u8;
    sizes: *u8;
    bases: *u8;
    writable: *u8;
    initialized: *u8;
    integers: *u8;
    pointers: *u8;
    representations: *u8;
    objects: *PmObject;
    cells: *PmCell;
    scope: *PmScope;
}

record PmObject {
    identity: *u8;
    size: *u8;
    base: *u8;
    next: *PmObject;
    scope_next: *PmObject;
    heap: bool;
}

record PmCell {
    address: *u8;
    type: *CrustType;
    next: *PmCell;
    persistent: bool;
}

record PmWrite { address: *u8; type: *CrustType; value: *u8; next: *PmWrite; }

record PmScope {
    block: *CrustStmt;
    locals: *PmLocal;
    objects: *PmObject;
    parent: *PmScope;
}

record PmLocal {
    symbol: *CrustSymbol;
    address: *u8;
    next: *PmLocal;
}
