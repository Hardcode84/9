const PM_ALLOCATE: u32 = 1u32;
const PM_RELEASE: u32 = 2u32;
const PM_SCALAR: u32 = 3u32;

record PmForeignSpec {
    name: *u8;
    alignment: usize;
    kind: u32;
}

record PmOptions {
    foreign: *PmForeignSpec;
    foreign_count: usize;
    max_depth: usize;
    max_paths: usize;
    max_iterations: usize;
    milliseconds: u32;
}
