fn pm_lookup(context: *CrustContext, name: *u8) -> *CrustDecl {
    var interned: *CrustName = crust_try_intern(context, name, c_length(name));
    if interned == null(*CrustName) { return null(*CrustDecl); }
    var symbol: *CrustSymbol = crust_map_get(&(*context).globals, interned as usize) as *CrustSymbol;
    if symbol != null(*CrustSymbol) && (*symbol).decl != null(*CrustDecl) { return (*symbol).decl; }
    crust_set_error(context, null(*CrustSource), 0usize, "memory policy names an absent declaration");
    return null(*CrustDecl);
}

fn pm_setup(stage: *PfStage, policy: *PmPolicy, context: *CrustContext, options: *PmOptions) -> bool {
    *policy = make PmPolicy {
        addressed: make CMap { entries: null(*CEntry), count: 0usize, capacity: 0usize },
        summaries: make CMap { entries: null(*CEntry), count: 0usize, capacity: 0usize },
        foreign: null(*PmForeign), first_summary: null(*PmSummary), milliseconds: (*options).milliseconds
    };
    pf_init(stage, context);
    pm_configure(stage, policy);
    (*stage).max_depth = (*options).max_depth;
    (*stage).max_paths = (*options).max_paths;
    (*stage).max_iterations = (*options).max_iterations;
    var index: usize = 0usize;
    var success: bool = true;
    while index < (*options).foreign_count && success {
        var specification: *PmForeignSpec = &(*options).foreign[index];
        var declaration: *CrustDecl = pm_lookup(context, (*specification).name);
        if declaration == null(*CrustDecl) { success = false; }
        else {
            success = pm_foreign(stage, policy, declaration, (*specification).kind, (*specification).alignment);
        }
        index = index + 1usize;
    }
    if success { success = pm_summary_select(stage, options); }
    return success;
}

fn pm_verify(context: *CrustContext, entry: *CrustDecl, options: *PmOptions) -> bool {
    var policy: PmPolicy = uninit;
    var stage: PfStage = uninit;
    var success: bool = pm_setup(&stage, &policy, context, options);
    if success { success = pm_plan(&stage, &policy); }
    if success { success = pf_verify(&stage, entry); }
    pf_destroy(&stage);
    return success;
}

fn pm_driver_build(cli: *CCli, options: *PmOptions) -> i32 {
    var context: *CrustContext = (*cli).stage.status.context;
    if (*cli).library || (*cli).export_count != 0usize {
        c_driver_error(&(*cli).driver, "closed-program memory checking does not accept library exports");
        return 1i32;
    }
    if !c_cli_read(cli) { return 1i32; }
    if !crust_collect(context) || !crust_resolve(context) || !crust_check(context) { return 1i32; }
    var entry: *CrustDecl = c_driver_entry(cli);
    if entry == null(*CrustDecl) { return 1i32; }
    if !pm_verify(context, entry, options) { return 1i32; }
    if (*cli).mode == 3u32 { return 0i32; }
    if !c_driver_names(&(*cli).driver) { return 1i32; }
    if (*cli).mode == 4u32 {
        if c_emit(&(*cli).stage, entry) { return 0i32; }
        return 1i32;
    }
    return c_backend_build(context, entry, &(*cli).options);
}

// Check all executions of a closed entry within explicit proof budgets.
// Every remaining loop continuation must be unreachable. Failure stops output.
// Source, contracts, and options must remain live through the call.
fn memory_program(request: *CrustBuild, options: *PmOptions) -> i32 {
    var cli: CCli = uninit;
    var context: *CrustContext = (*request).context;
    var success: bool = c_driver_init(&cli, context, (*request).argc);
    cli.root = (*request).source;
    cli.target_begin = (*request).target_begin;
    var result: i32 = 1i32;
    if success && c_driver_parse(&cli, (*request).argc, (*request).argv, 0i32) {
        result = pm_driver_build(&cli, options);
    }
    c_stage_destroy(&cli.stage);
    return result;
}
