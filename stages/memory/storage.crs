fn pm_find_local(state: *PfState, symbol: *CrustSymbol) -> *PmLocal {
    var world: *PmWorld = (*state).data as *PmWorld;
    var scope: *PmScope = (*world).scope;
    while scope != null(*PmScope) {
        var local: *PmLocal = (*scope).locals;
        while local != null(*PmLocal) {
            if (*local).symbol == symbol { return local; }
            local = (*local).next;
        }
        scope = (*scope).parent;
    }
    return null(*PmLocal);
}

fn pm_storage_placement(run: *PfRun, state: *PfState, base: *u8, size: *u8, valid: *u8) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_text(&buffer, "(and ");
    c_buffer_text(&buffer, valid);
    var world: *PmWorld = pm_world(run, state);
    var object: *PmObject = (*world).objects;
    while object != null(*PmObject) && !pf_failed(run) {
        var before: *u8 = pf_binary(run, "<=", pf_binary(run, "+", base, size), (*object).base);
        var after: *u8 = pf_binary(run, "<=", pf_binary(run, "+", (*object).base, (*object).size), base);
        var prior_live: *u8 = pf_select(run, (*world).live, (*object).identity);
        c_buffer_text(&buffer, " ");
        c_buffer_text(&buffer, pf_implies(run, prior_live, pf_or(run, before, after)));
        object = (*object).next;
    }
    c_buffer_text(&buffer, ")");
    return c_buffer_end(&buffer);
}

fn pm_storage_range(run: *PfRun, base: *u8, size: *u8, alignment: usize) -> *u8 {
    var valid: *u8 = pf_and(run, pf_binary(run, ">", base, "0"), pf_binary(run, ">=", size, "0"));
    valid = pf_and(run, valid, pf_binary(run, "<=", pf_binary(run, "+", base, size), "18446744073709551615"));
    return pf_and(run, valid, pf_eq(run, pf_binary(run, "mod", base, pm_number(run, alignment as u64)), "0"));
}

fn pm_stack_available(run: *PfRun, state: *PfState, size: *u8, alignment: usize,
                      live: *u8, location: *CrustLoc) -> unit {
    // N occupied intervals leave N+1 gaps. Reserve size+alignment in each gap:
    // this sufficient bound guarantees a positive aligned placement regardless
    // of the intervals' numeric addresses. It can reject a feasible tight layout.
    var gap: *u8 = pf_binary(run, "+", size, pm_number(run, alignment as u64));
    var required: *u8 = gap;
    var world: *PmWorld = pm_world(run, state);
    var object: *PmObject = (*pm_world(run, state)).objects;
    while object != null(*PmObject) && !pf_failed(run) {
        var occupied: *u8 = pf_binary(run, "+", (*object).size, gap);
        required = pf_define(run, "Int", pf_binary(run, "+", required,
            pf_ite(run, pf_select(run, (*world).live, (*object).identity), occupied, "0")));
        object = (*object).next;
    }
    // Capture the goal before the chosen base can discard any unsafe prefix.
    pm_require(run, state, live, pf_binary(run, "<=", required, "18446744073709551615"), location);
}

fn pm_new_object(run: *PfRun, state: *PfState, size: *u8, alignment: usize,
                 heap: bool, live: *u8, location: *CrustLoc) -> *u8 {
    var base: *u8 = pf_fresh(run, "Int");
    var identity: *u8 = pm_number(run, ((*run).next_name + 1usize) as u64);
    (*run).next_name = (*run).next_name + 1usize;
    var valid: *u8 = pm_storage_range(run, base, size, alignment);
    var placement: *u8 = pm_storage_placement(run, state, base, size, valid);
    if !heap { pm_stack_available(run, state, size, alignment, live, location); }
    pf_assume(run, state, pf_implies(run, live, placement));
    var world: *PmWorld = pm_change(run, state);
    var object: *PmObject = pf_alloc(run, sizeof(PmObject), alignof(PmObject)) as *PmObject;
    if world == null(*PmWorld) || object == null(*PmObject) { return null(*u8); }
    *object = make PmObject {
        identity: identity, size: size, base: base, next: (*world).objects,
        scope_next: null(*PmObject), heap: heap
    };
    (*world).objects = object;
    (*world).live = pm_array_store(run, "(Array Int Bool)", (*world).live, identity, live);
    (*world).writable = pm_array_store(run, "(Array Int Bool)", (*world).writable, identity, "true");
    (*world).sizes = pm_array_store(run, "(Array Int Int)", (*world).sizes, identity, size);
    (*world).bases = pm_array_store(run, "(Array Int Int)", (*world).bases, identity, base);
    if !heap { pm_scope_object(run, state, object); }
    return pm_pointer(run, identity, "0");
}

fn pm_scope_copy(run: *PfRun, state: *PfState) -> *PmScope {
    var world: *PmWorld = pm_change(run, state);
    if world == null(*PmWorld) { return null(*PmScope); }
    var scope: *PmScope = pf_alloc(run, sizeof(PmScope), alignof(PmScope)) as *PmScope;
    if scope == null(*PmScope) { return scope; }
    *scope = *(*world).scope;
    (*world).scope = scope;
    return scope;
}

fn pm_scope_object(run: *PfRun, state: *PfState, object: *PmObject) -> unit {
    var scope: *PmScope = pm_scope_copy(run, state);
    if scope == null(*PmScope) { return; }
    (*object).scope_next = (*scope).objects;
    (*scope).objects = object;
}

fn pm_guarded_slot(run: *PfRun, state: *PfState, symbol: *CrustSymbol,
                   guard: *u8, location: *CrustLoc) -> *u8 {
    var address: *u8 = pm_new_object(run, state, pm_number(run, (*(*symbol).type).size),
        (*(*symbol).type).align as usize, false, guard, location);
    if pf_failed(run) { return null(*u8); }
    var scope: *PmScope = pm_scope_copy(run, state);
    var local: *PmLocal = pf_alloc(run, sizeof(PmLocal), alignof(PmLocal)) as *PmLocal;
    if scope == null(*PmScope) || local == null(*PmLocal) { return null(*u8); }
    *local = make PmLocal { symbol: symbol, address: address, next: (*scope).locals };
    (*scope).locals = local;
    return address;
}

fn pm_local_slot(run: *PfRun, state: *PfState, symbol: *CrustSymbol, location: *CrustLoc) -> *u8 {
    return pm_guarded_slot(run, state, symbol, "true", location);
}

fn pm_local_address(run: *PfRun, state: *PfState, symbol: *CrustSymbol, location: *CrustLoc) -> *u8 {
    var local: *PmLocal = pm_find_local(state, symbol);
    if local != null(*PmLocal) { return (*local).address; }
    pf_error((*run).stage, location, "memory proof has no live source binding for this address");
    return null(*u8);
}

fn pm_parameter_slot(run: *PfRun, state: *PfState, parameter: *CrustParam, guard: *u8) -> bool {
    var value: *u8 = pf_binding(state, (*parameter).symbol);
    var type: *CrustType = (*parameter).type;
    var address: *u8 = pm_guarded_slot(run, state, (*parameter).symbol, guard, &(*parameter).loc);
    if pf_failed(run) { return false; }
    var world: *PmWorld = pm_change(run, state);
    var cell: *PmCell = pf_alloc(run, sizeof(PmCell), alignof(PmCell)) as *PmCell;
    if world == null(*PmWorld) || cell == null(*PmCell) { return false; }
    // The call initializes a fresh slot. Its access and separation facts have the call guard.
    *cell = make PmCell { address: address, type: type, next: (*world).cells, persistent: false };
    (*world).cells = cell;
    (*world).initialized = pm_array_store(run, "(Array Ptr Bool)", (*world).initialized, address, "true");
    (*world).representations = pm_array_store(run, "(Array Ptr Int)", (*world).representations, address, pm_representation(run, type));
    if (*type).kind == CRUST_T_POINTER {
        (*world).pointers = pm_array_store(run, "(Array Ptr Ptr)", (*world).pointers, address, value);
    }
    else {
        if (*type).kind == CRUST_T_BOOL { value = pf_ite(run, value, "1", "0"); }
        (*world).integers = pm_array_store(run, "(Array Ptr Int)", (*world).integers, address, value);
    }
    return !pf_failed(run);
}

fn pm_scope_parameters(run: *PfRun, state: *PfState, block: *CrustStmt) -> bool {
    var frame: *PfCall = (*run).calls;
    if block != pf_body((*run).stage, (*frame).declaration) { return true; }
    var parameter: *CrustParam = (*(*frame).declaration).params;
    while parameter != null(*CrustParam) {
        if pm_needs_storage(run, (*parameter).symbol) {
            if !pm_parameter_slot(run, state, parameter, (*frame).guard) { return false; }
        }
        parameter = (*parameter).next;
    }
    return true;
}

fn pm_no_incoming(run: *PfRun, state: *PfState, identity: *u8,
                  guard: *u8, location: *CrustLoc) -> unit {
    var world: *PmWorld = pm_world(run, state);
    var cell: *PmCell = (*world).cells;
    while cell != null(*PmCell) && !pf_failed(run) {
        if (*cell).persistent && (*(*cell).type).kind == CRUST_T_POINTER {
            var owner: *u8 = pm_origin(run, (*cell).address);
            var outside: *u8 = pf_not(run, pf_eq(run, owner, identity));
            var retained: *u8 = pf_and(run, outside, pf_select(run, (*world).live, owner));
            retained = pf_and(run, retained, pf_select(run, (*world).initialized, (*cell).address));
            var value: *u8 = pf_select(run, (*world).pointers, (*cell).address);
            var separate: *u8 = pf_not(run, pf_eq(run, pm_origin(run, value), identity));
            pm_require(run, state, pf_and(run, guard, retained), separate, location);
        }
        cell = (*cell).next;
    }
}

fn pm_expire(run: *PfRun, state: *PfState, identity: *u8, guard: *u8) -> unit {
    var world: *PmWorld = pm_change(run, state);
    if world == null(*PmWorld) { return; }
    var live: *u8 = pf_select(run, (*world).live, identity);
    (*world).live = pm_array_store(run, "(Array Int Bool)", (*world).live, identity, pf_and(run, live, pf_not(run, guard)));
}

fn pm_retire(run: *PfRun, state: *PfState, identity: *u8, guard: *u8, location: *CrustLoc) -> unit {
    pm_no_incoming(run, state, identity, guard, location);
    pm_expire(run, state, identity, guard);
}

fn pm_scope_end(run: *PfRun, state: *PfState, scope: *PmScope, guard: *u8, location: *CrustLoc) -> unit {
    if (*state).flow == PF_TRAP { return; }
    var object: *PmObject = (*scope).objects;
    // All storage in this lexical scope ends together, after its cleanup.
    while object != null(*PmObject) && !pf_failed(run) {
        pm_expire(run, state, (*object).identity, guard);
        object = (*object).scope_next;
    }
    object = (*scope).objects;
    while object != null(*PmObject) && !pf_failed(run) {
        pm_no_incoming(run, state, (*object).identity, guard, location);
        object = (*object).scope_next;
    }
}

fn pm_scope(run: *PfRun, state: *PfState, block: *CrustStmt, entering: bool) -> bool {
    var world: *PmWorld = pm_change(run, state);
    if world == null(*PmWorld) { return false; }
    var scope: *PmScope = (*world).scope;
    if entering {
        var child: *PmScope = pf_alloc(run, sizeof(PmScope), alignof(PmScope)) as *PmScope;
        if child == null(*PmScope) { return false; }
        *child = make PmScope {
            block: block, locals: null(*PmLocal), objects: null(*PmObject), parent: scope
        };
        (*world).scope = child;
        return pm_scope_parameters(run, state, block);
    }
    var guard: *u8 = "true";
    if block == pf_body((*run).stage, (*(*run).calls).declaration) { guard = (*(*run).calls).guard; }
    pm_scope_end(run, state, scope, guard, &(*block).loc);
    world = pm_change(run, state);
    if world == null(*PmWorld) { return false; }
    (*world).scope = (*scope).parent;
    return !pf_failed(run);
}
