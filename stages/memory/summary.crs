fn pm_summary_build(run: *PfRun, summary: *PmSummary) -> bool {
    var declaration: *CrustDecl = (*summary).declaration;
    var local: PfRun = uninit;
    pf_run_init(&local, (*run).stage, declaration);
    var parameter: *CrustParam = (*declaration).params;
    while parameter != null(*CrustParam) && !pf_failed(run) {
        pm_summary_local(&local, (*parameter).symbol, &(*parameter).loc);
        parameter = (*parameter).next;
    }
    var body: *CrustStmt = pf_body((*run).stage, declaration);
    pm_summary_statement(&local, body);
    if pf_failed(run) { return false; }
    var state: *PfState = pf_state(&local);
    if state == null(*PfState) || !pf_parameters(&local, state) { return false; }
    if pm_summary_world(&local, state) == null(*PmWorld) { return false; }
    (*summary).before = pf_fork(&local, state);
    local.definitions = &(*summary).definitions;
    var frame: PfCall = make PfCall { declaration: declaration, parent: null(*PfCall), guard: "true" };
    var paths: *PfPath = pf_statement(&local, state, body, &frame);
    if pf_failed(run) { return false; }
    (*summary).after = (*paths).state;
    var definition: *PfDefinition = (*summary).definitions;
    (*summary).definitions = null(*PfDefinition);
    while definition != null(*PfDefinition) {
        var next: *PfDefinition = (*definition).next;
        (*definition).next = (*summary).definitions;
        (*summary).definitions = definition;
        definition = next;
    }
    return !pf_failed(run);
}

fn pm_summaries(run: *PfRun) -> bool {
    var policy: *PmPolicy = (*(*run).stage).user as *PmPolicy;
    var summary: *PmSummary = (*policy).first_summary;
    while summary != null(*PmSummary) && !pf_failed(run) {
        if !pm_summary_build(run, summary) { return false; }
        summary = (*summary).next;
    }
    return !pf_failed(run);
}

fn pm_summary_footprint(run: *PfRun, state: *PfState, summary: *PmSummary, prefix: *u8) -> unit {
    var cell: *PmCell = (*pm_world(run, (*summary).after)).cells;
    var world: *PmWorld = pm_world(run, state);
    var first: *PmCell = null(*PmCell);
    var tail: **PmCell = &first;
    while cell != null(*PmCell) && !pf_failed(run) {
        var address: *u8 = pm_summary_rebind(run, (*cell).address, prefix);
        // The template has obligations between its own writes. Also require
        // typed separation from storage present before this call.
        pm_store_shape(run, state, address, (*cell).type, &(*(*summary).declaration).loc);
        var retained: *PmCell = pf_alloc(run, sizeof(PmCell), alignof(PmCell)) as *PmCell;
        if retained == null(*PmCell) { return; }
        *retained = make PmCell {
            address: address, type: (*cell).type, next: null(*PmCell), persistent: (*cell).persistent
        };
        *tail = retained;
        tail = &(*retained).next;
        cell = (*cell).next;
    }
    *tail = (*world).cells;
    (*world).cells = first;
}

fn pm_summary_invoke(run: *PfRun, state: *PfState, frame: *PfCall) -> *PfPath {
    var declaration: *CrustDecl = (*frame).declaration;
    var policy: *PmPolicy = (*(*run).stage).user as *PmPolicy;
    var summary: *PmSummary = c_map_get(&(*policy).summaries, declaration as usize) as *PmSummary;
    if summary == null(*PmSummary) { return pf_statement(run, state, pf_body((*run).stage, declaration), frame); }
    var prefix: CBuffer = uninit;
    pf_buffer(run, &prefix);
    c_buffer_text(&prefix, pf_name(run));
    c_buffer_text(&prefix, "!");
    var name: *u8 = c_buffer_end(&prefix);
    pm_summary_inputs(run, summary, state, name);
    pm_summary_goals(run, summary, state, name);
    var world: *PmWorld = pm_change(run, state);
    if world == null(*PmWorld) { return null(*PfPath); }
    pm_summary_footprint(run, state, summary, name);
    var after: *PmWorld = pm_world(run, (*summary).after);
    (*world).initialized = pm_summary_rebind(run, (*after).initialized, name);
    (*world).integers = pm_summary_rebind(run, (*after).integers, name);
    (*world).pointers = pm_summary_rebind(run, (*after).pointers, name);
    (*world).representations = pm_summary_rebind(run, (*after).representations, name);
    return pf_path(run, state);
}
