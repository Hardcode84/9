fn pm_summary_select(stage: *PfStage, options: *PmOptions) -> bool {
    var policy: *PmPolicy = (*stage).user as *PmPolicy;
    var index: usize = 0usize;
    while index < (*options).summary_count && !(*stage).status.failed {
        var declaration: *CrustDecl = pm_lookup((*stage).status.context, (*options).summaries[index]);
        if declaration == null(*CrustDecl) { return false; }
        if (*declaration).kind != CRUST_D_FUNCTION ||
           (*(*(*declaration).type).base).kind != CRUST_T_UNIT {
            pf_error(stage, &(*declaration).loc, "memory summary requires a defined unit-returning function");
            return false;
        }
        if c_map_get(&(*policy).summaries, declaration as usize) != 0usize {
            pf_error(stage, &(*declaration).loc, "memory summary selects the same declaration twice");
            return false;
        }
        var summary: *PmSummary = c_alloc(&(*stage).status, sizeof(PmSummary), alignof(PmSummary)) as *PmSummary;
        if summary == null(*PmSummary) { return false; }
        *summary = make PmSummary {
            declaration: declaration, before: null(*PfState), after: null(*PfState),
            definitions: null(*PfDefinition), next: (*policy).first_summary
        };
        (*policy).first_summary = summary;
        c_map_set(&(*stage).status, &(*policy).summaries, declaration as usize, summary as usize);
        index = index + 1usize;
    }
    if (*policy).first_summary != null(*PmSummary) { (*stage).invoke = pm_summary_invoke; }
    return !(*stage).status.failed;
}

fn pm_summary_expression(run: *PfRun, expression: *CrustExpr) -> unit {
    if expression == null(*CrustExpr) { return; }
    if !pf_enter(run, &(*expression).loc) { return; }
    if (*expression).kind == CRUST_E_CALL {
        pf_error((*run).stage, &(*expression).loc, "memory summary body cannot contain calls");
    } else {
        pm_summary_expression(run, (*expression).left);
        pm_summary_expression(run, (*expression).right);
        var index: usize = 0usize;
        while index < (*expression).arg_count && !pf_failed(run) {
            pm_summary_expression(run, (*expression).args[index]);
            index = index + 1usize;
        }
        var item: *CrustInit = (*expression).inits;
        while item != null(*CrustInit) && !pf_failed(run) {
            pm_summary_expression(run, (*item).value);
            item = (*item).next;
        }
    }
    (*run).depth = (*run).depth - 1usize;
}

fn pm_summary_local(run: *PfRun, symbol: *CrustSymbol, location: *CrustLoc) -> unit {
    if pm_needs_storage(run, symbol) || pm_sort(run, (*symbol).type) == null(*u8) {
        pf_error((*run).stage, location, "memory summary requires scalar bindings without local storage");
    }
}

fn pm_summary_statement(run: *PfRun, statement: *CrustStmt) -> unit {
    while statement != null(*CrustStmt) && !pf_failed(run) {
        if !pf_enter(run, &(*statement).loc) { return; }
        var kind: u32 = (*statement).kind;
        if kind == CRUST_S_BLOCK { pm_summary_statement(run, (*statement).body); }
        else if kind == CRUST_S_VAR { pm_summary_local(run, (*statement).symbol, &(*statement).loc); }
        else if kind == CRUST_S_ASSIGN {
            if pm_sort(run, (*(*statement).expr).type) == null(*u8) {
                pf_error((*run).stage, &(*statement).loc, "memory summary requires scalar assignments");
            }
        } else if kind != CRUST_S_RETURN || (*statement).expr != null(*CrustExpr) {
            pf_error((*run).stage, &(*statement).loc, "memory summary requires straight-line statements");
        }
        pm_summary_expression(run, (*statement).expr);
        pm_summary_expression(run, (*statement).value);
        (*run).depth = (*run).depth - 1usize;
        statement = (*statement).next;
    }
}
