// All paths are root-relative. Sources contain declarations only. Exports use
// source names. Require an empty context. Retain a diagnostic on failure.
fn native_prepare(root: *CrustRun, context: *CrustContext, sources: **u8, count: usize,
                  exports: **u8, export_count: usize) -> bool {
    var index: usize = 0usize;
    while index < count {
        var source: *CrustSource = host_input(root, sources[index], index as u64 + 1u64);
        if source == null(*CrustSource) { return false; }
        var parsed: *CrustUnit = null(*CrustUnit);
        if !crust_read(context, source, &parsed) { return false; }
        index = index + 1usize;
    }
    if !crust_collect(context) || !crust_resolve(context) || !crust_check(context) { return false; }
    var unit_value: *CrustUnit = (*context).units;
    while unit_value != null(*CrustUnit) {
        var declaration: *CrustDecl = (*unit_value).declarations;
        while declaration != null(*CrustDecl) {
            if (*declaration).kind != CRUST_D_EXTERN { (*declaration).link_name = ""; }
            declaration = (*declaration).next;
        }
        unit_value = (*unit_value).next;
    }
    index = 0usize;
    while index < export_count {
        var name: *CrustName = crust_try_intern(context, exports[index], native_strlen(exports[index]));
        if name == null(*CrustName) { return false; }
        var symbol: *CrustSymbol = crust_map_get(&(*context).globals, name as usize) as *CrustSymbol;
        if symbol == null(*CrustSymbol) || (*(*symbol).decl).kind != CRUST_D_FUNCTION {
            return native_error(context, "native export must name a defined function");
        }
        (*(*symbol).decl).link_name = (*name).text;
        index = index + 1usize;
    }
    return true;
}

// Prepare the selected library with the seed, run its native continuation, then
// remove all temporary images on success or failure. Session storage stays live.
fn native_bootstrap(root: *CrustRun, session: *NativeSession, sources: **u8, count: usize,
                    exports: **u8, export_count: usize) -> i32 {
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var status: i32 = 1i32;
    var image: *NativeImage = native_image((*root).context, session);
    if image != null(*NativeImage) && native_prepare(root, &context, sources, count, exports, export_count) &&
       native_asm_image(&context, session, image) && crust_run_link(root, (*image).library) {
        status = native_start(root, session);
    }
    if context.error_count != 0usize {
        crust_set_error((*root).context, context.error_loc.source, context.error_loc.offset, &context.error[0usize]);
    }
    crust_context_destroy(&context);
    if !native_cleanup((*root).context, session) { return 1i32; }
    return status;
}
