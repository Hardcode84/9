// Include api/crust0.crs, api/crust0_stage.crs, and stages/c/api.crs before this interface.
// Keep request sources live through context destruction. Return the compiler status.
extern fn overload_program(request:*CrustBuild, emit:fn(*CrustContext,*CrustDecl,*BackendOptions)->i32)->i32 = "overload_program";
// Compile the retained source range, print failures, and release its target context.
extern fn overload_build(source:*CrustSource, begin:usize, argc:i32, argv:**u8, emit:fn(*CrustContext,*CrustDecl,*BackendOptions)->i32)->i32 = "overload_build";
