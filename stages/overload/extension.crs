// SPDX-License-Identifier: Apache-2.0

// Include api/crust0.crs and stages/overload/model.crs before this interface.
// Keep the context, stage, hooks, ABI domain, and source storage live through use.
// Use a different ABI domain when type encodings, contracts, or calling rules differ.
extern fn ov_init(stage:*OvStage, context:*CrustContext, abi:*u8, hooks:*OvHooks)->unit = "ov_init";
// Read a complete declaration range before preparation. Failures retain a diagnostic.
extern fn ov_read(stage:*OvStage, source:*CrustSource, begin:usize, end:usize)->bool = "ov_read";
// Collect, resolve, and mangle once. Run the next checker after success.
extern fn ov_prepare(stage:*OvStage)->bool = "ov_prepare";
// Each operation requires successful completion of the previous operation.
extern fn ov_collect(stage:*OvStage)->bool = "ov_collect";
extern fn ov_resolve(stage:*OvStage)->bool = "ov_resolve";
extern fn ov_mangle(stage:*OvStage)->bool = "ov_mangle";

// Return arena storage or set a diagnostic. Zero size returns null without failure.
extern fn ov_alloc(stage:*OvStage, size:usize, alignment:usize)->*u8 = "ov_alloc";
extern fn ov_error(stage:*OvStage, loc:*CrustLoc, message:*u8)->unit = "ov_error";
extern fn ov_put(stage:*OvStage, map:*CrustMap, key:usize, value:*u8)->unit = "ov_put";
extern fn ov_intern(stage:*OvStage, bytes:*u8, size:usize)->*CrustName = "ov_intern";
extern fn ov_type(stage:*OvStage, kind:u32, loc:*CrustLoc)->*CrustTypeSyntax = "ov_type";

// Require collected signatures. Names refer to the original source namespace.
extern fn ov_global(stage:*OvStage, name:*CrustName)->*OvGlobal = "ov_global";
extern fn ov_function_syntax(stage:*OvStage, declaration:*CrustDecl)->*CrustTypeSyntax = "ov_function_syntax";
extern fn ov_select(stage:*OvStage, group:*OvGlobal, syntax:*CrustTypeSyntax, parameters_only:bool, loc:*CrustLoc)->*OvFunction = "ov_select";
extern fn ov_same(stage:*OvStage, a:*CrustTypeSyntax, b:*CrustTypeSyntax)->bool = "ov_same";

// Type hooks append a self-delimiting ASCII payload without NUL after the x tag.
// Include a stable extension name. Context-owned kind numbers must not enter keys.
// Distinct types need distinct payloads. Use ov_part or a fixed count of child encodings.
// Use depth + 1 for child types. This operation enforces the type nesting bound.
// A type hook can call ov_same and ov_select. These queries preserve its output prefix.
extern fn ov_encode_type(stage:*OvStage, syntax:*CrustTypeSyntax, buffer:*OvText, depth:usize)->unit = "ov_encode_type";
extern fn ov_text(stage:*OvStage, buffer:*OvText, text:*u8)->unit = "ov_text";
extern fn ov_bytes(stage:*OvStage, buffer:*OvText, bytes:*u8, size:usize)->unit = "ov_bytes";
// Append a decimal number with an underscore terminator, or a length-prefixed byte string.
extern fn ov_number(stage:*OvStage, buffer:*OvText, value:u64)->unit = "ov_number";
extern fn ov_part(stage:*OvStage, buffer:*OvText, bytes:*u8, size:usize)->unit = "ov_part";

// Walk helpers retain original source types and rewrite selected function names.
// Expected types select function values. A null expected type requires independent inference.
extern fn ov_expression(walk:*OvWalk, expression:*CrustExpr, expected:*CrustTypeSyntax)->*CrustTypeSyntax = "ov_expression";
extern fn ov_statement(walk:*OvWalk, statement:*CrustStmt)->unit = "ov_statement";
// Bypass the current hook. Child expressions and statements still use hooks.
extern fn ov_standard_expression(walk:*OvWalk, expression:*CrustExpr, expected:*CrustTypeSyntax)->*CrustTypeSyntax = "ov_standard_expression";
extern fn ov_standard_statement(walk:*OvWalk, statement:*CrustStmt)->unit = "ov_standard_statement";
extern fn ov_scope(walk:*OvWalk)->unit = "ov_scope";
extern fn ov_leave_scope(walk:*OvWalk)->unit = "ov_leave_scope";
extern fn ov_lookup(walk:*OvWalk, name:*CrustName)->*OvLocal = "ov_lookup";
extern fn ov_bind(walk:*OvWalk, name:*CrustName, syntax:*CrustTypeSyntax, loc:*CrustLoc)->unit = "ov_bind";
extern fn ov_block(walk:*OvWalk, statement:*CrustStmt)->unit = "ov_block";
extern fn ov_field_type(stage:*OvStage, syntax:*CrustTypeSyntax, name:*CrustName, loc:*CrustLoc)->*CrustTypeSyntax = "ov_field_type";
