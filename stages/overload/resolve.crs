fn ov_scope(walk:*OvWalk)->unit {
    var scope:*OvScope=ov_alloc((*walk).stage,sizeof(OvScope),alignof(OvScope)) as *OvScope;
    if scope!=null(*OvScope) { (*scope).parent=(*walk).scope; (*walk).scope=scope; }
}

fn ov_leave_scope(walk:*OvWalk)->unit {
    (*walk).scope=(*(*walk).scope).parent;
}

fn ov_lookup(walk:*OvWalk,name:*CrustName)->*OvLocal {
    var scope:*OvScope=(*walk).scope;
    while scope!=null(*OvScope) {
        var local:*OvLocal=crust_map_get(&(*scope).bindings,name as usize) as *OvLocal;
        if local!=null(*OvLocal) { return local; }
        scope=(*scope).parent;
    }
    return null(*OvLocal);
}

fn ov_bind(walk:*OvWalk,name:*CrustName,syntax:*CrustTypeSyntax,location:*CrustLoc)->unit {
    var stage:*OvStage=(*walk).stage;
    if (*stage).failed { return; }
    if ov_lookup(walk,name)!=null(*OvLocal) || ov_global(stage,name)!=null(*OvGlobal) {
        ov_error(stage,location,"local name is already visible");
        return;
    }
    var local:*OvLocal=ov_alloc(stage,sizeof(OvLocal),alignof(OvLocal)) as *OvLocal;
    if local==null(*OvLocal) { return; }
    (*local).syntax=syntax;
    ov_put(stage,&(*(*walk).scope).bindings,name as usize,local as *u8);
}

fn ov_binding_value(walk:*OvWalk,syntax:*CrustTypeSyntax)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    if (*stage).failed { return null(*CrustTypeSyntax); }
    var hooks:*OvHooks=(*stage).hooks;
    if hooks!=null(*OvHooks) && (*hooks).binding_type!=null(fn(*OvStage,*CrustTypeSyntax,*u8)->*CrustTypeSyntax) {
        var errors:usize=(*(*stage).context).error_count;
        var result:*CrustTypeSyntax=(*hooks).binding_type(stage,syntax,(*hooks).user);
        if (*(*stage).context).error_count!=errors { (*stage).failed=true; }
        if (*stage).failed { return null(*CrustTypeSyntax); }
        if result==null(*CrustTypeSyntax) {
            ov_error(stage,&(*syntax).loc,"binding type callback failed");
        }
        return result;
    }
    return syntax;
}

// Return the declared type of a field in a named source record.
fn ov_field_type(stage:*OvStage,syntax:*CrustTypeSyntax,name:*CrustName,location:*CrustLoc)->*CrustTypeSyntax {
    if (*stage).failed { return null(*CrustTypeSyntax); }
    if (*syntax).kind!=CRUST_T_NAME {
        ov_error(stage,location,"field access requires a named record");
        return null(*CrustTypeSyntax);
    }
    var global:*OvGlobal=ov_global(stage,(*syntax).name);
    if global==null(*OvGlobal) || (*global).declaration==null(*CrustDecl) ||
       (*(*global).declaration).kind!=CRUST_D_RECORD {
        ov_error(stage,location,"field access requires a declared record");
        return null(*CrustTypeSyntax);
    }
    var field:*CrustField=crust_map_get(&(*global).fields,name as usize) as *CrustField;
    if field!=null(*CrustField) { return (*field).syntax_type; }
    ov_error(stage,location,"record has no such field");
    return null(*CrustTypeSyntax);
}

fn ov_function_value(walk:*OvWalk,expression:*CrustExpr,group:*OvGlobal,
                     expected:*CrustTypeSyntax)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var selected:*OvFunction=null(*OvFunction);
    if expected!=null(*CrustTypeSyntax) && (*expected).kind==CRUST_T_FUNCTION {
        selected=ov_select(stage,group,expected,false,&(*expression).loc);
    } else {
        if (*group).count!=1usize {
            ov_error(stage,&(*expression).loc,"overloaded function value requires an exact function type");
            return null(*CrustTypeSyntax);
        }
        selected=(*group).first;
    }
    if selected==null(*OvFunction) || (*stage).failed { return null(*CrustTypeSyntax); }
    (*expression).name=(*selected).internal_name;
    return (*selected).syntax;
}

fn ov_call(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var callee:*CrustExpr=(*expression).left;
    var groups:usize=0usize;
    while (*callee).kind==CRUST_E_GROUP {
        if (*walk).depth+groups>=256usize {
            ov_error(stage,&(*callee).loc,"overload expression nesting limit of 256 exceeded");
            return null(*CrustTypeSyntax);
        }
        groups=groups+1usize;
        callee=(*callee).left;
    }
    var group:*OvGlobal=null(*OvGlobal);
    if (*callee).kind==CRUST_E_NAME && ov_lookup(walk,(*callee).name)==null(*OvLocal) {
        group=ov_global(stage,(*callee).name);
        if group!=null(*OvGlobal) && (*group).first==null(*OvFunction) { group=null(*OvGlobal); }
    }
    var signature:*CrustTypeSyntax=null(*CrustTypeSyntax);
    var index:usize=0usize;
    if group!=null(*OvGlobal) && (*group).count>1usize {
        return ov_overloaded_call(walk,expression,group);
    }
    signature=ov_expression(walk,(*expression).left,null(*CrustTypeSyntax));
    if (*stage).failed { return null(*CrustTypeSyntax); }
    if (*signature).kind!=CRUST_T_FUNCTION {
        ov_error(stage,&(*expression).loc,"call requires a function value");
        return null(*CrustTypeSyntax);
    }
    if (*signature).param_count!=(*expression).arg_count {
        ov_error(stage,&(*expression).loc,"wrong number of call arguments");
        return null(*CrustTypeSyntax);
    }
    while index<(*expression).arg_count && !(*stage).failed {
        ov_expression(walk,(*expression).args[index],(*signature).params[index]);
        index=index+1usize;
    }
    if (*stage).failed { return null(*CrustTypeSyntax); }
    return (*signature).base;
}

// Infer one seed expression and rewrite selected function names.
// Bypass the current expression hook. Child expressions still use their hooks.
fn ov_standard_expression(walk:*OvWalk,expression:*CrustExpr,expected:*CrustTypeSyntax)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    if (*stage).failed { return null(*CrustTypeSyntax); }
    var kind:u32=(*expression).kind;
    var location:*CrustLoc=&(*expression).loc;
    if kind==CRUST_E_NAME {
        return ov_name_expression(walk,expression,expected);
    }
    if kind==CRUST_E_INTEGER { return ov_type(stage,(*expression).literal_type,location); }
    if kind==CRUST_E_BOOL { return ov_type(stage,CRUST_T_BOOL,location); }
    if kind==CRUST_E_STRING {
        return ov_string_expression(walk,expression);
    }
    if kind==CRUST_E_GROUP { return ov_expression(walk,(*expression).left,expected); }
    if kind==CRUST_E_CALL { return ov_call(walk,expression); }
    if kind==CRUST_E_NULL { return (*expression).syntax_type; }
    if kind==CRUST_E_SIZEOF || kind==CRUST_E_ALIGNOF || kind==CRUST_E_OFFSETOF {
        return ov_type(stage,CRUST_T_USIZE,location);
    }
    if kind==CRUST_E_CAST {
        return ov_cast_expression(walk,expression);
    }
    if kind==CRUST_E_UNARY {
        return ov_unary_expression(walk,expression);
    }
    if kind==CRUST_E_BINARY {
        return ov_binary_expression(walk,expression);
    }
    return ov_aggregate_expression(walk,expression);
}

// Infer one expression with optional expected function type and extension hooks.
fn ov_expression(walk:*OvWalk,expression:*CrustExpr,expected:*CrustTypeSyntax)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    if (*stage).failed { return null(*CrustTypeSyntax); }
    if (*walk).depth>=256usize {
        ov_error(stage,&(*expression).loc,"overload expression nesting limit of 256 exceeded");
        return null(*CrustTypeSyntax);
    }
    (*walk).depth=(*walk).depth+1usize;
    var result:*CrustTypeSyntax=null(*CrustTypeSyntax);
    var hooks:*OvHooks=(*stage).hooks;
    if hooks!=null(*OvHooks) && (*hooks).expression!=null(fn(*OvWalk,*CrustExpr,*CrustTypeSyntax,*u8)->*CrustTypeSyntax) {
        var errors:usize=(*(*stage).context).error_count;
        result=(*hooks).expression(walk,expression,expected,(*hooks).user);
        if (*(*stage).context).error_count!=errors { (*stage).failed=true; }
    }
    if result==null(*CrustTypeSyntax) && !(*stage).failed { result=ov_standard_expression(walk,expression,expected); }
    (*walk).depth=(*walk).depth-1usize;
    if (*stage).failed { return null(*CrustTypeSyntax); }
    return result;
}

// Visit a block in a new local scope. Do not visit the block's next sibling.
fn ov_block(walk:*OvWalk,statement:*CrustStmt)->unit {
    var stage:*OvStage=(*walk).stage;
    if (*stage).failed { return; }
    ov_scope(walk);
    if (*stage).failed { return; }
    var child:*CrustStmt=(*statement).body;
    while child!=null(*CrustStmt) && !(*stage).failed {
        ov_statement(walk,child);
        child=(*child).next;
    }
    ov_leave_scope(walk);
}

// Visit one seed statement without its hook. Nested statements still use hooks.
fn ov_standard_statement(walk:*OvWalk,statement:*CrustStmt)->unit {
    var stage:*OvStage=(*walk).stage;
    if (*stage).failed { return; }
    var kind:u32=(*statement).kind;
    if kind==CRUST_S_BLOCK { ov_block(walk,statement); return; }
    if kind==CRUST_S_VAR {
        if !(*statement).uninitialized { ov_expression(walk,(*statement).value,(*statement).syntax_type); }
        ov_bind(walk,(*statement).name,(*statement).syntax_type,&(*statement).loc);
        return;
    }
    if kind==CRUST_S_IF || kind==CRUST_S_WHILE {
        ov_expression(walk,(*statement).expr,ov_type(stage,CRUST_T_BOOL,&(*statement).loc));
        ov_statement(walk,(*statement).body);
        if (*statement).otherwise!=null(*CrustStmt) { ov_statement(walk,(*statement).otherwise); }
        return;
    }
    if kind==CRUST_S_RETURN {
        if (*statement).expr!=null(*CrustExpr) { ov_expression(walk,(*statement).expr,(*walk).result); }
        return;
    }
    if kind==CRUST_S_EXPR { ov_expression(walk,(*statement).expr,null(*CrustTypeSyntax)); return; }
    if kind==CRUST_S_ASSIGN {
        var expected:*CrustTypeSyntax=ov_expression(walk,(*statement).expr,null(*CrustTypeSyntax));
        ov_expression(walk,(*statement).value,expected);
        return;
    }
    if kind==CRUST_S_BREAK || kind==CRUST_S_CONTINUE || kind==CRUST_S_TRAP { return; }
    ov_error(stage,&(*statement).loc,"unhandled source statement kind");
}

// Visit one statement with extension hooks and a bounded traversal depth.
fn ov_statement(walk:*OvWalk,statement:*CrustStmt)->unit {
    var stage:*OvStage=(*walk).stage;
    if (*stage).failed { return; }
    if (*walk).depth>=256usize {
        ov_error(stage,&(*statement).loc,"overload statement nesting limit of 256 exceeded");
        return;
    }
    (*walk).depth=(*walk).depth+1usize;
    var handled:bool=false;
    var hooks:*OvHooks=(*stage).hooks;
    if hooks!=null(*OvHooks) && (*hooks).statement!=null(fn(*OvWalk,*CrustStmt,*u8)->bool) {
        var errors:usize=(*(*stage).context).error_count;
        handled=(*hooks).statement(walk,statement,(*hooks).user);
        if (*(*stage).context).error_count!=errors { (*stage).failed=true; }
    }
    if !handled && !(*stage).failed { ov_standard_statement(walk,statement); }
    (*walk).depth=(*walk).depth-1usize;
}

// Require collected source signatures and assigned internal names.
// Resolve constants and defined bodies once, before the next checker runs.
fn ov_resolve(stage:*OvStage)->bool {
    if (*stage).failed { return false; }
    var global:*OvGlobal=(*stage).first_global;
    while global!=null(*OvGlobal) && !(*stage).failed {
        var declaration:*CrustDecl=(*global).declaration;
        if declaration!=null(*CrustDecl) && (*declaration).kind==CRUST_D_CONST {
            var walk:OvWalk=make OvWalk {stage:stage,scope:null(*OvScope),result:null(*CrustTypeSyntax),depth:0usize};
            ov_expression(&walk,(*declaration).init,(*declaration).syntax_type);
        }
        global=(*global).next;
    }
    var function:*OvFunction=(*stage).first_function;
    while function!=null(*OvFunction) && !(*stage).failed {
        var declaration:*CrustDecl=(*function).declaration;
        if (*declaration).body!=null(*CrustStmt) {
            var walk:OvWalk=make OvWalk {stage:stage,scope:null(*OvScope),result:(*(*function).syntax).base,depth:0usize};
            ov_scope(&walk);
            var parameter:*CrustParam=(*declaration).params;
            while parameter!=null(*CrustParam) && !(*stage).failed {
                ov_bind(&walk,(*parameter).name,(*parameter).syntax_type,&(*parameter).loc);
                parameter=(*parameter).next;
            }
            ov_statement(&walk,(*declaration).body);
        }
        function=(*function).all_next;
    }
    return !(*stage).failed;
}

fn ov_overloaded_call(walk:*OvWalk,expression:*CrustExpr,group:*OvGlobal)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var signature:*CrustTypeSyntax=null(*CrustTypeSyntax);
    var index:usize=0usize;
    signature=ov_type(stage,CRUST_T_FUNCTION,&(*expression).loc);
    if signature==null(*CrustTypeSyntax) { return signature; }
    (*signature).base=ov_type(stage,CRUST_T_UNIT,&(*expression).loc);
    (*signature).param_count=(*expression).arg_count;
    (*signature).params=ov_alloc(stage,(*expression).arg_count*sizeof(*CrustTypeSyntax),alignof(*CrustTypeSyntax)) as **CrustTypeSyntax;
    if (*stage).failed { return null(*CrustTypeSyntax); }
    while index<(*expression).arg_count && !(*stage).failed {
        (*signature).params[index]=ov_expression(walk,(*expression).args[index],null(*CrustTypeSyntax));
        index=index+1usize;
    }
    if (*stage).failed { return null(*CrustTypeSyntax); }
    var selected:*OvFunction=ov_select(stage,group,signature,true,&(*expression).loc);
    if selected==null(*OvFunction) || (*stage).failed { return null(*CrustTypeSyntax); }
    signature=ov_expression(walk,(*expression).left,(*selected).syntax);
    if (*stage).failed { return null(*CrustTypeSyntax); }
    if (*signature).kind!=CRUST_T_FUNCTION {
        ov_error(stage,&(*expression).loc,"call requires a function value");
        return null(*CrustTypeSyntax);
    }
    return (*signature).base;
}

fn ov_name_expression(walk:*OvWalk,expression:*CrustExpr,expected:*CrustTypeSyntax)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var location:*CrustLoc=&(*expression).loc;
    var local:*OvLocal=ov_lookup(walk,(*expression).name);
    if local!=null(*OvLocal) { return ov_binding_value(walk,(*local).syntax); }
    var global:*OvGlobal=ov_global(stage,(*expression).name);
    if global==null(*OvGlobal) {
        ov_error(stage,location,"unknown source value name");
        return null(*CrustTypeSyntax);
    }
    if (*global).first!=null(*OvFunction) { return ov_function_value(walk,expression,global,expected); }
    if (*(*global).declaration).kind!=CRUST_D_CONST {
        ov_error(stage,location,"record name is not a value");
        return null(*CrustTypeSyntax);
    }
    return ov_binding_value(walk,(*(*global).declaration).syntax_type);
}

fn ov_unary_expression(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var location:*CrustLoc=&(*expression).loc;
    var operand:*CrustTypeSyntax=ov_expression(walk,(*expression).left,null(*CrustTypeSyntax));
    if (*stage).failed { return null(*CrustTypeSyntax); }
    if (*expression).op==CRUST_OP_ADDRESS {
        var syntax:*CrustTypeSyntax=ov_type(stage,CRUST_T_POINTER,location);
        if syntax!=null(*CrustTypeSyntax) { (*syntax).base=operand; }
        return syntax;
    }
    if (*expression).op==CRUST_OP_DEREF {
        if (*operand).kind!=CRUST_T_POINTER {
            ov_error(stage,location,"dereference requires a pointer");
            return null(*CrustTypeSyntax);
        }
        return (*operand).base;
    }
    if (*expression).op==CRUST_OP_NOT { return ov_type(stage,CRUST_T_BOOL,location); }
    if (*expression).op==CRUST_OP_NEG || (*expression).op==CRUST_OP_BIT_NOT { return operand; }
    ov_error(stage,location,"unknown unary operation");
    return null(*CrustTypeSyntax);
}

fn ov_binary_expression(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var location:*CrustLoc=&(*expression).loc;
    var left:*CrustTypeSyntax=ov_expression(walk,(*expression).left,null(*CrustTypeSyntax));
    ov_expression(walk,(*expression).right,null(*CrustTypeSyntax));
    if (*stage).failed { return null(*CrustTypeSyntax); }
    if (*expression).op>=CRUST_OP_EQ && (*expression).op<=CRUST_OP_OR {
        return ov_type(stage,CRUST_T_BOOL,location);
    }
    return left;
}

fn ov_aggregate_expression(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var location:*CrustLoc=&(*expression).loc;
    var kind:u32=(*expression).kind;
    if kind==CRUST_E_INDEX {
        var base:*CrustTypeSyntax=ov_expression(walk,(*expression).left,null(*CrustTypeSyntax));
        var index_type:*CrustTypeSyntax=ov_type(stage,CRUST_T_USIZE,location);
        ov_expression(walk,(*expression).right,index_type);
        if (*stage).failed { return null(*CrustTypeSyntax); }
        if (*base).kind!=CRUST_T_ARRAY && (*base).kind!=CRUST_T_POINTER {
            ov_error(stage,location,"indexing requires an array or pointer");
            return null(*CrustTypeSyntax);
        }
        return (*base).base;
    }
    if kind==CRUST_E_FIELD {
        var base:*CrustTypeSyntax=ov_expression(walk,(*expression).left,null(*CrustTypeSyntax));
        if (*stage).failed { return null(*CrustTypeSyntax); }
        return ov_field_type(stage,base,(*expression).field_name,location);
    }
    if kind==CRUST_E_RECORD {
        return ov_record_expression(walk,expression);
    }
    if kind==CRUST_E_ARRAY {
        return ov_array_expression(walk,expression);
    }
    ov_error(stage,location,"unhandled source expression kind");
    return null(*CrustTypeSyntax);
}

fn ov_record_expression(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var item:*CrustInit=(*expression).inits;
    while item!=null(*CrustInit) && !(*stage).failed {
        var field:*CrustTypeSyntax=ov_field_type(stage,(*expression).syntax_type,(*item).name,&(*item).loc);
        ov_expression(walk,(*item).value,field);
        item=(*item).next;
    }
    if (*stage).failed { return null(*CrustTypeSyntax); }
    return (*expression).syntax_type;
}

fn ov_array_expression(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var location:*CrustLoc=&(*expression).loc;
    var syntax:*CrustTypeSyntax=(*expression).syntax_type;
    if (*syntax).kind!=CRUST_T_ARRAY {
        ov_error(stage,location,"array construction requires an array type");
        return null(*CrustTypeSyntax);
    }
    var index:usize=0usize;
    while index<(*expression).arg_count && !(*stage).failed {
        ov_expression(walk,(*expression).args[index],(*syntax).base);
        index=index+1usize;
    }
    if (*stage).failed { return null(*CrustTypeSyntax); }
    return syntax;
}

fn ov_string_expression(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    var location:*CrustLoc=&(*expression).loc;
    var syntax:*CrustTypeSyntax=ov_type(stage,CRUST_T_POINTER,location);
    if syntax!=null(*CrustTypeSyntax) { (*syntax).base=ov_type(stage,CRUST_T_U8,location); }
    if (*stage).failed { return null(*CrustTypeSyntax); }
    return syntax;
}

fn ov_cast_expression(walk:*OvWalk,expression:*CrustExpr)->*CrustTypeSyntax {
    var stage:*OvStage=(*walk).stage;
    ov_expression(walk,(*expression).left,(*expression).syntax_type);
    if (*stage).failed { return null(*CrustTypeSyntax); }
    return (*expression).syntax_type;
}
