fn ov_resources_check(stage:*OvStage)->bool {
    if !ov_prepare(stage) { return false; }
    return rs_prepare((*(*stage).hooks).user as *RsStage);
}

// Require an empty initialized context and retained source storage.
// Complete overload selection, ownership checking, cleanup, and the requested output.
fn overload_resource_program(request:*CrustBuild)->i32 {
    var context:*CrustContext = (*request).context;
    var cli:CCli = uninit;
    var success:bool = c_driver_init(&cli, context, (*request).argc);
    cli.root = (*request).source;
    cli.target_begin = (*request).target_begin;
    var resources:RsStage = uninit;
    rs_init(&resources, context);
    var hooks:CsHooks = uninit;
    var overloads:OvStage = uninit;
    rs_source_hooks(&resources, &hooks, null(*CsHooks));
    ov_init(&overloads, context, "resources_x64_v1", &hooks);
    var result:i32 = 1i32;
    if success && c_driver_parse(&cli, (*request).argc, (*request).argv, 0i32) {
        result = ov_driver_build(&cli, &overloads, ov_resource_read, ov_resources_check,
            rs_c_body, &resources as *u8);
    }
    c_stage_destroy(&cli.stage);
    return result;
}

// Compile the retained source from begin through EOF, print failures, and release its context.
fn overload_resource_build(source:*CrustSource, begin:usize, argc:i32, argv:**u8)->i32 {
    var context:CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var request:CrustBuild = make CrustBuild {
        context:&context, source:source, target_begin:begin, argc:argc, argv:argv
    };
    var result:i32 = overload_resource_program(&request);
    if context.error_count != 0usize { c_driver_diagnostic(&context, "overload_resource_build"); }
    crust_context_destroy(&context);
    return result;
}

fn ov_resource_read(stage:*OvStage, source:*CrustSource, begin:usize, end:usize)->bool {
    var resources:*RsStage = (*(*stage).hooks).user as *RsStage;
    var source_hooks:CrustReaderHooks = uninit; ov_reader_hooks(&source_hooks,null(*CrustReaderHooks));
    var resource_hooks:CrustReaderHooks = uninit; rs_reader_hooks(resources,&resource_hooks,&source_hooks);
    if rr_read((*stage).context,source,begin,end,&resource_hooks) == null(*CrustUnit) {
        (*stage).failed = true; return false;
    }
    return true;
}
