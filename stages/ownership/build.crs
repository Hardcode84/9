// Check and compile the captured source and selected files. Report diagnostics.
fn ownership_build(source: *CrustSource, begin: usize, argc: i32, argv: **u8) -> i32 {
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var request: CrustBuild = make CrustBuild {
        context: &context, source: source, target_begin: begin, argc: argc, argv: argv
    };
    var result: i32 = ownership_program(&request);
    if context.error_count != 0usize { crust_run_diagnostic(&context); }
    crust_context_destroy(&context);
    return result;
}
