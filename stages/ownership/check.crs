fn os_validate_record(check: *OsCheck, global: *RsGlobal) -> unit {
    var declaration: *CrustDecl = (*global).source;
    var contract: *OsRecord = crust_map_get(&(*(*check).stage).records, declaration as usize) as *OsRecord;
    if contract == null(*OsRecord) { os_error(check, &(*declaration).loc, "schema requires an ownership schema"); return; }
    if (os_storage_fields((*contract).owns) || (*contract).references != null(*OsField) ||
        (*contract).conditions != null(*OsCondition)) && (*contract).domain == null(*CrustName) {
        os_error(check, &(*declaration).loc, "stored pointer contracts require a declared domain"); return;
    }
    if (*contract).owns != null(*OsField) && (*global).resource == null(*RsResource) {
        os_error(check, &(*declaration).loc, "owned fields require a resource destructor"); return;
    }
    os_validate_schema(check, contract);
    os_validate_view_record(check, global, contract);
    (*contract).tracked = (*contract).tracked || (*contract).references != null(*OsField) || (*contract).conditions != null(*OsCondition);
    os_validate_names(check, global, (*contract).owns);
    os_validate_names(check, global, (*contract).references);
    var field: *CrustField = (*declaration).fields;
    while field != null(*CrustField) && !os_failed(check) {
        os_validate_field(check, contract, field);
        field = (*field).next;
    }
}

fn os_validate_names(check: *OsCheck, global: *RsGlobal, fields: *OsField) -> unit {
    while fields != null(*OsField) && !os_failed(check) {
        if crust_map_get(&(*global).fields, (*fields).name as usize) == null(*u8) {
            os_error(check, &(*(*global).source).loc, "ownership contract names an absent field"); return;
        }
        fields = (*fields).next;
    }
}

fn os_validate_field(check: *OsCheck, contract: *OsRecord, field: *CrustField) -> unit {
    var owner: *OsField = os_field((*contract).owns, (*field).name);
    var reference: *OsField = os_field((*contract).references, (*field).name);
    if owner != null(*OsField) && reference != null(*OsField) {
        os_error(check, &(*field).loc, "field cannot both own and borrow its target"); return;
    }
    if owner != null(*OsField) { os_validate_owner(check, contract, field); return; }
    if reference != null(*OsField) { os_validate_reference(check, contract, field); return; }
    if os_borrowed((*field).syntax_type) { os_validate_view_field(check, field); return; }
    if rs_owns((*(*check).stage).resources, (*field).syntax_type) {
        os_validate_embedded(check, contract, field); return;
    }
    if (*(*field).syntax_type).kind == CRUST_T_POINTER || (*(*field).syntax_type).kind == CRUST_T_FUNCTION ||
       (*(*field).syntax_type).kind == CRUST_T_ARRAY {
        os_error(check, &(*field).loc, "persistent pointers require an owns or references field contract");
    }
}

fn os_validate_owner(check: *OsCheck, contract: *OsRecord, field: *CrustField) -> unit {
    var syntax: *CrustTypeSyntax = (*field).syntax_type;
    var owner: *OsField = os_field((*contract).owns, (*field).name);
    (*owner).field = field;
    if !(*owner).storage {
        if (*syntax).kind == CRUST_T_UNIT || (*syntax).kind > CRUST_T_POINTER {
            os_error(check, &(*field).loc, "native owned fields require a scalar representation; embed resource records directly"); return;
        }
        os_validate_sentinel(check, owner, syntax, &(*field).loc);
        return;
    }
    if (*syntax).kind != CRUST_T_POINTER {
        os_error(check, &(*field).loc, "storage ownership requires a pointer field"); return;
    }
    var target: *OsRecord = os_record((*check).stage, (*syntax).base);
    if target == null(*OsRecord) || (*target).domain != (*contract).domain {
        os_error(check, &(*field).loc, "owned allocation and handle must share a declared domain");
    }
}

fn os_validate_reference(check: *OsCheck, contract: *OsRecord, field: *CrustField) -> unit {
    var syntax: *CrustTypeSyntax = (*field).syntax_type;
    if (*syntax).kind != CRUST_T_POINTER {
        os_error(check, &(*field).loc, "references requires a pointer field"); return;
    }
    var target: *OsRecord = os_record((*check).stage, (*syntax).base);
    if target == null(*OsRecord) || (*target).domain != (*contract).domain {
        os_error(check, &(*field).loc, "retained references must target a schema in the same domain"); return;
    }
    (*target).tracked = true;
}

fn os_validate_foreign(check: *OsCheck, contract: *OsFunction) -> unit {
    var declaration: *CrustDecl = (*contract).declaration;
    if (*declaration).kind != CRUST_D_EXTERN {
        os_error(check, &(*declaration).loc, "foreign effects require an external declaration"); return;
    }
    if (*contract).foreign == OS_NATIVE { os_validate_native(check, contract); return; }
    if (*contract).foreign == OS_SCALAR {
        if (*(*declaration).syntax_type).kind >= CRUST_T_POINTER {
            os_error(check, &(*declaration).loc, "scalar foreign result must be a scalar type");
        }
        return;
    }
    var parameter: *CrustParam = (*declaration).params;
    if parameter == null(*CrustParam) || (*parameter).next != null(*CrustParam) {
        os_error(check, &(*declaration).loc, "allocation and release interfaces require one parameter"); return;
    }
    if (*contract).foreign == OS_ALLOCATE {
        if (*(*parameter).syntax_type).kind != CRUST_T_USIZE || (*(*declaration).syntax_type).kind != CRUST_T_POINTER {
            os_error(check, &(*declaration).loc, "allocate interface requires usize to pointer");
        }
    } else { if (*(*parameter).syntax_type).kind != CRUST_T_POINTER || (*(*declaration).syntax_type).kind != CRUST_T_UNIT {
        os_error(check, &(*declaration).loc, "release interface requires pointer to unit");
    } }
}

fn os_parameter(check: *OsCheck, state: *OsState, parameter: *CrustParam) -> unit {
    var syntax: *CrustTypeSyntax = (*parameter).syntax_type;
    var base: *CrustTypeSyntax = syntax;
    var borrowed: bool = os_borrowed(syntax);
    var pointer: bool = (*syntax).kind == CRUST_T_POINTER;
    if borrowed || pointer { base = (*syntax).base; }
    var output: bool = os_field((*(*check).function).initializes, (*parameter).name) != null(*OsField);
    var object: *OsObject = null(*OsObject);
    if (*base).kind == CRUST_T_NAME {
        if pointer { object = os_cursor_parameter(check, state, parameter, output); }
        else { object = os_object(check, state, base, null(*OsObject), (*state).scope, true); }
        if object == null(*OsObject) { return; }
        os_abstract_value(check, state, object, false);
    } else { if output { os_error(check, &(*parameter).loc, "initializes requires a schema pointer parameter"); return; } }
    var value: *OsValue = os_value(check, syntax, object, pointer);
    if value == null(*OsValue) { return; }
    (*value).owner = !borrowed && os_affine(check, syntax);
    (*value).unknown = pointer && object == null(*OsObject);
    (*value).fresh = true;
    os_parameter_bind(check, state, parameter, value, borrowed);
}

fn os_abstract_value(check: *OsCheck, state: *OsState, object: *OsObject, uncertain: bool) -> unit {
    if !os_enter(check, &(*(*object).syntax).loc) { return; }
    (*object).abstract = true;
    (*object).uncertain = (*object).uncertain || uncertain;
    var slot: *OsSlot = os_fields(state, object);
    while slot != null(*OsSlot) && !os_failed(check) {
        var value: *OsValue = os_bound(state, slot);
        if value != null(*OsValue) && (*value).object != null(*OsObject) {
            os_abstract_value(check, state, (*value).object, uncertain);
        }
        slot = (*slot).next;
    }
    (*check).depth = (*check).depth - 1usize;
}

fn os_function_exit(check: *OsCheck, state: *OsState, location: *CrustLoc) -> unit {
    var scope: *OsScope = (*state).scope;
    while (*scope).parent != null(*OsScope) { scope = (*scope).parent; }
    var slot: *OsSlot = (*scope).locals;
    while slot != null(*OsSlot) && !os_failed(check) {
        var value: *OsValue = os_bound(state, slot);
        if (*slot).argument && value != null(*OsValue) && (*value).object != null(*OsObject) {
            if (*slot).authority { os_destructor_end(check, state, (*value).object, location); }
            else { if ((*(*slot).syntax).kind == RS_READ || (*(*slot).syntax).kind == RS_MUT) &&
                        !os_initialized(check, state, (*value).object) {
                os_error(check, location, "borrowed parameter must be initialized on return");
            } }
        }
        slot = (*slot).next;
    }
}

fn os_check_function(stage: *OsStage, global: *RsGlobal, contract: *OsFunction) -> unit {
    if os_imported(stage, (*global).source) { return; }
    var declaration: *CrustDecl = (*global).source;
    var check: OsCheck = uninit;
    os_check_init(&check, stage, contract);
    check.drop = (*global).drop_only;
    if (*contract).foreign != 0u32 { return; }
    if (*declaration).kind != CRUST_D_FUNCTION {
        os_error(&check, &(*declaration).loc, "external call requires a declared foreign effect"); return;
    }
    os_validate_borrows(&check, declaration);
    if os_failed(&check) { return; }
    var state: OsState = uninit;
    os_state_init(&state, contract);
    os_heap_start(&check, &state);
    os_scope(&check, &state);
    if os_failed(&check) { return; }
    var parameter: *CrustParam = (*declaration).params;
    while parameter != null(*CrustParam) && !os_failed(&check) {
        os_parameter(&check, &state, parameter);
        parameter = (*parameter).next;
    }
    os_conditions(&check, &state, (*contract).ensures, check.parameters);
    os_assume(&check, &state, os_conditions(&check, &state, (*contract).requires, check.parameters));
    os_statement(&check, &state, (*declaration).body);
    if os_failed(&check) { return; }
    if state.flow == PF_NORMAL { os_function_exit(&check, &state, &(*declaration).loc); }
    if state.flow == PF_NORMAL { os_scope_end(&check, &state, &(*declaration).loc); }
    if state.flow == PF_NORMAL { os_contract_end(&check, &state, &(*declaration).loc); }
}

fn os_validate_borrows(check: *OsCheck, declaration: *CrustDecl) -> unit {
    var parameter: *CrustParam = (*declaration).params;
    while parameter != null(*CrustParam) && !os_failed(check) {
        var kind: u32 = (*(*parameter).syntax_type).kind;
        if kind == RS_READ || kind == RS_MUT { os_validate_borrow_parameter(check, parameter); }
        parameter = (*parameter).next;
    }
}

fn os_validate_borrow_parameter(check: *OsCheck, parameter: *CrustParam) -> unit {
    var syntax: *CrustTypeSyntax = (*parameter).syntax_type;
    var schema: *OsRecord = os_record((*check).stage, (*syntax).base);
    var effect: u32 = (*(*check).function).effect;
    if schema != null(*OsRecord) && (*schema).domain != null(*CrustName) {
        if (*schema).domain != (*(*check).function).domain || effect == 0u32 {
            os_error(check, &(*parameter).loc, "borrowed value requires its declared domain authority"); return;
        }
    }
    if (*check).drop { return; }
    if ((*syntax).kind == RS_READ && effect > OS_READ) ||
       ((*syntax).kind == RS_MUT && effect == OS_RECLAIM) {
        os_error(check, &(*parameter).loc, "borrowed parameters cannot grant reclamation authority");
    }
}

fn os_check(stage: *OsStage) -> bool {
    var check: OsCheck = uninit;
    os_check_init(&check, stage, null(*OsFunction));
    var global: *RsGlobal = (*(*stage).resources).first_global;
    while global != null(*RsGlobal) && !os_failed(&check) {
        if (*(*global).source).kind == CRUST_D_RECORD { os_validate_record(&check, global); }
        global = (*global).next;
    }
    os_validate_domains(&check);
    os_resolve_functions(&check);
    os_validate_conditions(&check);
    pf_destroy(&(*stage).proof);
    global = (*(*stage).resources).first_global;
    while global != null(*RsGlobal) && !os_failed(&check) {
        var declaration: *CrustDecl = (*global).source;
        if (*declaration).kind == CRUST_D_FUNCTION || (*declaration).kind == CRUST_D_EXTERN {
            var contract: *OsFunction = crust_map_get(&(*stage).functions, declaration as usize) as *OsFunction;
            if contract == null(*OsFunction) { os_error(&check, &(*declaration).loc, "function requires an ownership interface"); }
            else {
                os_check_function(stage, global, contract);
                os_solver_drop(stage);
                pf_destroy(&(*stage).proof);
            }
        }
        global = (*global).next;
    }
    return !os_failed(&check);
}
