fn os_check_init(check: *OsCheck, stage: *OsStage, contract: *OsFunction) -> unit {
    (*check).stage = stage;
    (*check).function = contract;
    (*check).objects = null(*OsObject);
    (*check).loans = null(*OsLoan);
    (*check).parameters = null(*OsBinding);
    (*check).depth = 0usize;
    (*check).loop_depth = 0usize;
    (*check).drop = false;
    var declaration: *CrustDecl = null(*CrustDecl);
    if contract != null(*OsFunction) { declaration = (*contract).declaration; }
    pf_run_init(&(*check).proof, &(*stage).proof, declaration);
}

fn os_state_init(state: *OsState, contract: *OsFunction) -> unit {
    (*state).proof = make PfState { fields: null(*PfField), env: null(*PfBinding),
        assumptions: "true", goals: null(*PfGoal), terms: null(*PfTerm), data: null(*u8), result: null(*u8), flow: PF_NORMAL };
    (*state).facts = null(*OsFact);
    (*state).heaps = null(*OsHeap);
    (*state).snapshots = null(*OsSnapshot);
    (*state).grounded = null(*OsGround);
    (*state).scope = null(*OsScope);
    (*state).domain = null(*CrustName);
    (*state).effect = 0u32;
    if contract != null(*OsFunction) { (*state).domain = (*contract).domain; (*state).effect = (*contract).effect; }
    (*state).flow = PF_NORMAL;
}

fn os_cursor_parameter(check: *OsCheck, state: *OsState, parameter: *CrustParam, output: bool) -> *OsObject {
    var syntax: *CrustTypeSyntax = (*(*parameter).syntax_type).base;
    var schema: *OsRecord = os_record((*check).stage, syntax);
    if schema == null(*OsRecord) || (*schema).domain != (*state).domain || (*state).effect == 0u32 {
        os_error(check, &(*parameter).loc, "schema pointer requires access to its declared domain"); return null(*OsObject);
    }
    var object: *OsObject = os_object_header(check, state, syntax, null(*OsObject), (*state).scope, !output);
    if object == null(*OsObject) { return object; }
    os_mark(check, state, object, os_flags(state, object) & ~OS_NONNULL);
    (*object).cursor = !output;
    os_object_fields(check, state, object, !output);
    if output { os_heap_uninitialized(check, state, object); }
    else { os_heap_assume_object(check, state, object, true); }
    return object;
}

fn os_parameter_bind(check: *OsCheck, state: *OsState, parameter: *CrustParam, value: *OsValue, borrowed: bool) -> unit {
    var slot: *OsSlot = os_slot(check, (*parameter).syntax_type, (*parameter).name, null(*OsObject), (*state).scope);
    if slot == null(*OsSlot) { return; }
    (*slot).argument = true;
    (*slot).authority = (*check).drop && borrowed;
    (*slot).next = (*(*state).scope).locals;
    (*(*state).scope).locals = slot;
    os_set(check, state, slot as *u8, value, OS_READY);
    os_loan_parameter(check, state, slot, value);
    if (*slot).authority && (*value).object != null(*OsObject) {
        os_mark(check, state, (*value).object, os_flags(state, (*value).object) | OS_RETIRING);
    }
    var syntax: *CrustTypeSyntax = (*parameter).syntax_type;
    if os_borrowed(syntax) { syntax = (*syntax).base; }
    (*check).parameters = os_binding(check, (*parameter).name, syntax, os_term(check, value), (*check).parameters);
    if (*check).parameters != null(*OsBinding) { (*(*check).parameters).value = value; }
}

fn os_parameter_value(check: *OsCheck, state: *OsState, name: *CrustName) -> *OsValue {
    var binding: *OsBinding = (*check).parameters;
    while binding != null(*OsBinding) {
        if (*binding).name == name { return (*binding).value; }
        binding = (*binding).next;
    }
    return null(*OsValue);
}

fn os_resolve_functions(check: *OsCheck) -> unit {
    var global: *RsGlobal = (*(*(*check).stage).resources).first_global;
    while global != null(*RsGlobal) && !os_failed(check) {
        var contract: *OsFunction = crust_map_get(&(*(*check).stage).functions, (*global).source as usize) as *OsFunction;
        if contract != null(*OsFunction) { os_resolve_interface(check, contract); }
        global = (*global).next;
    }
}

fn os_cursor_argument(check: *OsCheck, state: *OsState, contract: *OsFunction,
                       parameter: *CrustParam, value: *OsValue, location: *CrustLoc) -> unit {
    var schema: *OsRecord = os_record((*check).stage, (*(*parameter).syntax_type).base);
    if schema == null(*OsRecord) || (*schema).domain != (*contract).domain || (*contract).effect == 0u32 {
        os_error(check, location, "pointer argument requires a declared domain interface"); return;
    }
    var output: bool = os_field((*contract).initializes, (*parameter).name) != null(*OsField);
    var object: *OsObject = (*value).object;
    if object == null(*OsObject) { if output { os_error(check, location, "initializes requires checked storage"); } return; }
    if output {
        if (os_flags(state, object) & OS_PUBLISHED) != 0u32 {
            os_error(check, location, "initializes cannot replace published storage"); return;
        }
        os_access_through(check, state, object, (*value).loan, true, location);
    } else { os_heap_publish(check, state, object, location); }
}

fn os_resolve_interface(check: *OsCheck, contract: *OsFunction) -> unit {
    var declaration: *CrustDecl = (*contract).declaration;
    if (*contract).domain != null(*CrustName) &&
       crust_map_get(&(*(*check).stage).domains, (*contract).domain as usize) == null(*u8) {
        os_error(check, &(*declaration).loc, "function access requires a declared domain"); return;
    }
    if (*contract).foreign != 0u32 && ((*contract).effect != 0u32 ||
       (*contract).requires != null(*OsCondition) || (*contract).ensures != null(*OsCondition) ||
       (*contract).initializes != null(*OsField) || (*contract).has_modifies) {
        os_error(check, &(*declaration).loc, "foreign effects do not accept checked body contracts"); return;
    }
    os_resolve_modifies(check, contract);
    os_resolve_view_result(check, contract);
    var item: *OsField = (*contract).initializes;
    while item != null(*OsField) && !os_failed(check) {
        os_resolve_output(check, contract, (*item).name);
        item = (*item).next;
    }
}

fn os_resolve_output(check: *OsCheck, contract: *OsFunction, name: *CrustName) -> unit {
    var declaration: *CrustDecl = (*contract).declaration;
    var parameter: *CrustParam = (*declaration).params;
    while parameter != null(*CrustParam) && (*parameter).name != name { parameter = (*parameter).next; }
    if parameter == null(*CrustParam) || (*(*parameter).syntax_type).kind != CRUST_T_POINTER {
        os_error(check, &(*declaration).loc, "initializes requires a declared record pointer parameter"); return;
    }
    var schema: *OsRecord = os_record((*check).stage, (*(*parameter).syntax_type).base);
    if schema == null(*OsRecord) || (*schema).domain != (*contract).domain || (*contract).effect < OS_EDIT {
        os_error(check, &(*parameter).loc, "initializes requires edit access to the output domain");
    }
}
