fn os_validate_embedded(check: *OsCheck, contract: *OsRecord, field: *CrustField) -> unit {
    var child: *OsRecord = os_record((*check).stage, (*field).syntax_type);
    if child == null(*OsRecord) || (*child).domain != (*contract).domain {
        os_error(check, &(*field).loc, "embedded resource and containing record must share a declared domain");
    }
}

fn os_unmanaged_isolated(check: *OsCheck, state: *OsState, object: *OsObject, location: *CrustLoc) -> bool {
    os_unfold(check, state, object);
    if (*object).family != null(*OsField) { return os_isolated(check, state, object); }
    if !os_enter(check, location) { return false; }
    var valid: bool = true;
    var slot: *OsSlot = os_fields(state, object);
    while slot != null(*OsSlot) && valid && !os_failed(check) {
        var value: *OsValue = os_bound(state, slot);
        if !(*slot).owns && value != null(*OsValue) && !(*value).pointer && (*value).object != null(*OsObject) {
            valid = os_unmanaged_isolated(check, state, (*value).object, location);
        }
        slot = (*slot).next;
    }
    (*check).depth = (*check).depth - 1usize;
    return valid && !os_failed(check);
}

fn os_drop_callback(check: *OsCheck, state: *OsState, object: *OsObject, location: *CrustLoc) -> unit {
    var global: *RsGlobal = rs_global((*(*check).stage).resources, (*(*object).syntax).name);
    if (*global).resource == null(*RsResource) {
        if !os_unmanaged_isolated(check, state, object, location) {
            os_error(check, location, "field destruction requires all unmanaged member hooks to be isolated");
        }
        return;
    }
    var destructor: *OsFunction = os_function((*check).stage, (*(*global).resource).drop_name);
    if destructor == null(*OsFunction) || (*destructor).effect != OS_RECLAIM {
        os_error(check, location, "resource destructor requires a reclamation contract"); return;
    }
    os_call_effect(check, state, destructor, location);
}

fn os_drop_contract(check: *OsCheck, state: *OsState, object: *OsObject, location: *CrustLoc) -> unit {
    os_unfold(check, state, object);
    if !os_enter(check, location) { return; }
    os_drop_callback(check, state, object, location);
    var slot: *OsSlot = os_fields(state, object);
    while slot != null(*OsSlot) && !os_failed(check) {
        var value: *OsValue = os_bound(state, slot);
        if (*slot).owns && value != null(*OsValue) && !(*value).pointer && (*value).object != null(*OsObject) {
            os_drop_contract(check, state, (*value).object, location);
        }
        slot = (*slot).next;
    }
    (*check).depth = (*check).depth - 1usize;
}

fn os_release_fields(check: *OsCheck, state: *OsState, object: *OsObject, location: *CrustLoc) -> unit {
    if (os_flags(state, object) & OS_DESTROYED) != 0u32 { return; }
    if rs_owns((*(*check).stage).resources, (*object).syntax) {
        os_error(check, location, "release requires destruction of the stored resource value");
    }
}

fn os_drop_pointer(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> unit {
    var value: *OsValue = os_expr(check, state, (*expression).left);
    if value == null(*OsValue) || os_failed(check) { return; }
    var object: *OsObject = (*value).object;
    if !(*value).pointer || object == null(*OsObject) || !(*object).heap || (*object).parent != null(*OsObject) ||
       (*value).place == null(*OsSlot) || !(*(*value).place).owns {
        os_error(check, &(*expression).loc, "drop through a pointer requires the unique allocation owner"); return;
    }
    if !os_access(check, state, object, true, &(*expression).loc) ||
       !os_reclaim(check, state, object, &(*expression).loc) { return; }
    if !rs_owns((*(*check).stage).resources, (*object).syntax) {
        os_error(check, &(*expression).loc, "drop requires a resource or a record with resource fields"); return;
    }
    os_drop_object(check, state, object, &(*expression).loc);
    if !os_failed(check) { os_mark(check, state, object, os_flags(state, object) | OS_LIVE); }
}

fn os_drop_statement(check: *OsCheck, state: *OsState, statement: *CrustStmt) -> unit {
    var expression: *CrustExpr = (*statement).expr;
    while (*expression).kind == CRUST_E_GROUP { expression = (*expression).left; }
    if (*expression).kind == CRUST_E_UNARY && (*expression).op == CRUST_OP_DEREF {
        os_drop_pointer(check, state, expression); return;
    }
    if (*expression).kind != CRUST_E_NAME {
        os_error(check, &(*statement).loc, "drop requires a whole owner or an owned allocation"); return;
    }
    var slot: *OsSlot = os_place(check, state, expression);
    if slot == null(*OsSlot) || os_failed(check) { return; }
    var value: *OsValue = os_read_slot(check, state, slot, &(*statement).loc);
    if value == null(*OsValue) || os_failed(check) { return; }
    if !(*slot).owns || (*value).pointer || os_borrowed((*slot).syntax) {
        os_error(check, &(*statement).loc, "drop requires a whole owner or an owned allocation"); return;
    }
    os_drop_object(check, state, (*value).object, &(*statement).loc);
    os_set(check, state, slot as *u8, null(*OsValue), 0u32);
}
