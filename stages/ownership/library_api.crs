// Include library_model.crs. Directory is absolute and caller-owned with no
// untrusted writers. Retain the returned path and digest in trusted build state.
// Check the provider, emit its object, and publish its complete source interface.
// The checker host and its loaded images must remain unchanged during the call.
// Receipt strings belong to request.context. Copy them before destroying it.
extern fn ownership_publish(request: *CrustBuild, directory: *u8,
                            result: *OwnershipLibrary, trusted: *CrustSource, count: usize) -> i32 = "ownership_publish";

// Require an empty context and receipts from trusted publication. Capture and
// validate each bundle, check client bodies, and link private object snapshots.
// No provider source or provider body is read. Keep all arguments live to return.
extern fn ownership_import_program(request: *CrustBuild,
                                   imports: *OwnershipImports) -> i32 = "ownership_import_program";
