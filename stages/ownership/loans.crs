fn os_borrowed(check: *OsCheck, syntax: *CrustTypeSyntax) -> bool {
    return syntax != null(*CrustTypeSyntax) && ((*syntax).kind == rs_kind((*(*check).stage).resources, RS_READ) || (*syntax).kind == rs_kind((*(*check).stage).resources, RS_MUT));
}

fn os_loan_flags(state: *OsState, loan: *OsLoan) -> u32 {
    var fact: *OsFact = os_fact(state, loan as *u8);
    if fact == null(*OsFact) { return 0u32; }
    return (*fact).flags;
}

fn os_loan_ancestor(check: *OsCheck, ancestor: *OsLoan, loan: *OsLoan) -> bool {
    (*check).ancestry_stamp = (*check).ancestry_stamp + 1usize;
    var budget: usize = 128usize;
    return os_loan_search(check, ancestor, loan, budget);
}

fn os_loan_search(check: *OsCheck, ancestor: *OsLoan, loan: *OsLoan, budget: usize) -> bool {
    while loan != null(*OsLoan) {
        if loan == ancestor { return true; }
        if (*loan).ancestry_stamp == (*check).ancestry_stamp { return false; }
        (*loan).ancestry_stamp = (*check).ancestry_stamp;
        if budget == 0usize {
            os_error(check, &(*(*(*check).function).declaration).loc, "loan ancestry exceeds 128"); return false;
        }
        budget = budget - 1usize;
        if os_selection_ancestor(check, ancestor, (*loan).selection, budget) { return true; }
        if (*loan).via != null(*OsLoan) && os_loan_search(check, ancestor, (*loan).via, budget) { return true; }
        loan = (*loan).parent;
    }
    return false;
}

fn os_owner(state: *OsState, object: *OsObject) -> *OsObject {
    var fact: *OsFact = os_fact(state, &(*object).owner as *u8);
    if fact == null(*OsFact) { return (*object).owner; }
    if (*fact).value == null(*OsValue) { return null(*OsObject); }
    return (*(*fact).value).object;
}

fn os_set_owner(check: *OsCheck, state: *OsState, object: *OsObject, owner: *OsObject) -> unit {
    var value: *OsValue = null(*OsValue);
    if owner != null(*OsObject) { value = os_value(check, (*owner).syntax, owner, false); }
    os_set(check, state, &(*object).owner as *u8, value, 0u32);
}

fn os_owner_root(check: *OsCheck, state: *OsState, object: *OsObject, location: *CrustLoc) -> *OsObject {
    var depth: usize = 0usize;
    while object != null(*OsObject) {
        object = os_root(object);
        var owner: *OsObject = os_owner(state, object);
        if owner == null(*OsObject) { return object; }
        object = owner;
        depth = depth + 1usize;
        if depth >= 128usize { os_error(check, location, "ownership ancestry exceeds 128"); return null(*OsObject); }
    }
    return object;
}

fn os_loan_overlap(check: *OsCheck, state: *OsState, a: *OsObject, b: *OsObject, location: *CrustLoc) -> bool {
    if a == null(*OsObject) || b == null(*OsObject) { return false; }
    // Distinct local handles keep distinct storage when their owned targets change.
    var possible: bool = ((*a).heap || (*b).heap) && ((*os_root(a)).uncertain || (*os_root(b)).uncertain);
    var left: *OsObject = os_owner_root(check, state, a, location);
    var right: *OsObject = os_owner_root(check, state, b, location);
    if left == right { return true; }
    if left == null(*OsObject) || right == null(*OsObject) { return false; }
    if (*left).domain == null(*CrustName) || (*left).brand != (*right).brand { return false; }
    return possible || (*left).aliased || (*right).aliased;
}

fn os_loan_permission(check: *OsCheck, state: *OsState, through: *OsLoan,
                       write: bool, location: *CrustLoc) -> bool {
    if through != null(*OsLoan) && (*through).via != null(*OsLoan) {
        if !os_enter(check, location) { return false; }
        var valid: bool = os_loan_permission(check, state, (*through).parent, write, location) &&
            os_loan_permission(check, state, (*through).via, write, location);
        (*check).depth = (*check).depth - 1usize;
        return valid;
    }
    if through != null(*OsLoan) && (os_loan_flags(state, through) & OS_LIVE) == 0u32 {
        os_error(check, location, "access uses an expired payload loan"); return false;
    }
    if through != null(*OsLoan) && write && (*through).mode != rs_kind((*(*check).stage).resources, RS_MUT) {
        os_error(check, location, "shared loan cannot grant mutable access"); return false;
    }
    return true;
}

fn os_loan_access(check: *OsCheck, state: *OsState, object: *OsObject,
                  through: *OsLoan, write: bool, location: *CrustLoc) -> bool {
    return os_region_access(check, state, object, null(*OsSlot), through, write, location) &&
        os_view_access(check, state, object, through, write, location);
}

fn os_object_contains(outer: *OsObject, inner: *OsObject) -> bool {
    while inner != null(*OsObject) {
        if outer == inner { return true; }
        inner = (*inner).parent;
    }
    return false;
}

fn os_region_field(slot: *OsSlot, object: *OsObject) -> *CrustField {
    if slot == null(*OsSlot) || (*slot).object != object || (*(*slot).syntax).kind == CRUST_T_NAME {
        return null(*CrustField);
    }
    return (*slot).field;
}

// Only fields in the same concrete storage tree establish disjointness.
// Owned pointees and opaque aliases still use the ownership overlap rule.
fn os_regions_overlap(check: *OsCheck, state: *OsState, object: *OsObject,
                      slot: *OsSlot, loan: *OsLoan, location: *CrustLoc) -> bool {
    if slot != null(*OsSlot) && slot == (*loan).place { return true; }
    var other: *OsObject = (*loan).object;
    if object == null(*OsObject) || other == null(*OsObject) { return false; }
    if os_root(object) != os_root(other) { return os_loan_overlap(check, state, object, other, location); }
    var field: *CrustField = os_region_field(slot, object);
    var other_field: *CrustField = os_region_field((*loan).place, other);
    if object == other { return field == null(*CrustField) || other_field == null(*CrustField) || field == other_field; }
    if os_object_contains(object, other) { return field == null(*CrustField); }
    if os_object_contains(other, object) { return other_field == null(*CrustField); }
    return false;
}

fn os_region_access(check: *OsCheck, state: *OsState, object: *OsObject, slot: *OsSlot,
                    through: *OsLoan, write: bool, location: *CrustLoc) -> bool {
    return os_loan_permission(check, state, through, write, location) &&
        os_region_conflicts(check, state, object, slot, through, write, location);
}

fn os_region_conflicts(check: *OsCheck, state: *OsState, object: *OsObject, slot: *OsSlot,
                       through: *OsLoan, write: bool, location: *CrustLoc) -> bool {
    var loan: *OsLoan = (*check).loans;
    while loan != null(*OsLoan) && !os_failed(check) {
        if (os_loan_flags(state, loan) & OS_LIVE) != 0u32 && !os_loan_ancestor(check, loan, through) &&
           os_loan_conflict(check, state, object, slot, loan, write, location) {
            os_error(check, location, "access conflicts with an active payload loan"); return false;
        }
        loan = (*loan).next;
    }
    return !os_failed(check);
}

fn os_loan_conflict(check: *OsCheck, state: *OsState, object: *OsObject, slot: *OsSlot,
                    loan: *OsLoan, write: bool, location: *CrustLoc) -> bool {
    if (write || (*loan).mode == rs_kind((*(*check).stage).resources, RS_MUT)) && os_regions_overlap(check, state, object, slot, loan, location) { return true; }
    return os_selection_conflict(check, state, object, slot, loan, write, location) ||
        os_view_conflict(check, state, object, slot, (*loan).object, write, (*loan).mode, location);
}

fn os_loan_new(check: *OsCheck, state: *OsState, value: *OsValue,
               mode: u32, location: *CrustLoc) -> *OsLoan {
    var object: *OsObject = (*value).object;
    if object == null(*OsObject) && (*value).place != null(*OsSlot) { object = (*(*value).place).object; }
    if object == null(*OsObject) && (*value).place == null(*OsSlot) {
        os_error(check, location, "loan requires checked storage"); return null(*OsLoan);
    }
    if (*value).object != null(*OsObject) && !os_initialized(check, state, (*value).object) {
        os_error(check, location, "loan requires initialized storage"); return null(*OsLoan);
    }
    if object != null(*OsObject) && !os_storage_access(check, state, object, (*value).loan, mode == rs_kind((*(*check).stage).resources, RS_MUT), location) {
        return null(*OsLoan);
    }
    if !os_loan_place_access(check, state, (*value).place, (*value).loan, mode == rs_kind((*(*check).stage).resources, RS_MUT), location) { return null(*OsLoan); }
    if !os_region_access(check, state, object, os_original((*value).place), (*value).loan, mode == rs_kind((*(*check).stage).resources, RS_MUT), location) { return null(*OsLoan); }
    if !os_view_access(check, state, (*value).object, (*value).loan, mode == rs_kind((*(*check).stage).resources, RS_MUT), location) { return null(*OsLoan); }
    return os_loan_create(check, state, value, object, mode);
}

// A projected view uses both its stored loan and the containing borrow.
// This authority expires with either source; it creates no separate reservation.
fn os_loan_via(check: *OsCheck, state: *OsState, loan: *OsLoan, through: *OsLoan) -> *OsLoan {
    if through == null(*OsLoan) || through == loan { return loan; }
    var inherited: *OsLoan = os_alloc(check, sizeof(OsLoan), alignof(OsLoan)) as *OsLoan;
    if inherited == null(*OsLoan) { return null(*OsLoan); }
    *inherited = *loan;
    (*inherited).parent = loan;
    (*inherited).via = through;
    (*inherited).scope = (*state).scope;
    (*inherited).next = null(*OsLoan);
    if (*through).mode == rs_kind((*(*check).stage).resources, RS_READ) { (*inherited).mode = rs_kind((*(*check).stage).resources, RS_READ); }
    var ready: u32 = os_loan_flags(state, loan) & os_loan_flags(state, through) & OS_READY;
    os_set(check, state, inherited as *u8, null(*OsValue), OS_LIVE | ready);
    return inherited;
}

fn os_loan_create(check: *OsCheck, state: *OsState, value: *OsValue, object: *OsObject, mode: u32) -> *OsLoan {
    var loan: *OsLoan = os_alloc(check, sizeof(OsLoan), alignof(OsLoan)) as *OsLoan;
    if loan == null(*OsLoan) { return loan; }
    (*loan).object = object;
    (*loan).place = os_original((*value).place);
    if (*loan).place == null(*OsSlot) {
        (*loan).place = os_slot(check, (*value).syntax, null(*CrustName), null(*OsObject), (*state).scope);
        if (*loan).place == null(*OsSlot) { return null(*OsLoan); }
        os_set(check, state, (*loan).place as *u8, value, OS_READY);
    }
    (*loan).parent = (*value).loan;
    if (*value).loan != null(*OsLoan) { (*loan).selection = (*(*value).loan).selection; }
    (*loan).scope = (*state).scope;
    (*loan).mode = mode;
    (*loan).next = (*check).loans;
    (*check).loans = loan;
    os_set(check, state, loan as *u8, null(*OsValue), OS_LIVE);
    return loan;
}

fn os_loan_place_access(check: *OsCheck, state: *OsState, slot: *OsSlot,
                        through: *OsLoan, write: bool, location: *CrustLoc) -> bool {
    return os_loan_permission(check, state, through, write, location) &&
        os_place_conflicts(check, state, slot, through, write, location);
}

fn os_place_conflicts(check: *OsCheck, state: *OsState, slot: *OsSlot,
                      through: *OsLoan, write: bool, location: *CrustLoc) -> bool {
    if slot == null(*OsSlot) { return true; }
    slot = os_original(slot);
    var object: *OsObject = (*slot).object;
    var value: *OsValue = os_bound(state, slot);
    if (*(*slot).syntax).kind == CRUST_T_NAME && value != null(*OsValue) { object = (*value).object; }
    if !os_region_conflicts(check, state, object, slot, through, write, location) { return false; }
    if (*(*slot).syntax).kind == CRUST_T_NAME { return os_view_access(check, state, object, through, write, location); }
    return true;
}

fn os_loan_keep(check: *OsCheck, state: *OsState, value: *OsValue) -> unit {
    if (*value).pointer && (*value).loan != null(*OsLoan) &&
       (os_loan_flags(state, (*value).loan) & OS_READY) == 0u32 {
        os_error(check, &(*(*value).syntax).loc, "stored cursor requires a named source loan"); return;
    }
    if !os_borrowed(check, (*value).syntax) || (*value).loan == null(*OsLoan) { return; }
    os_set(check, state, (*value).loan as *u8, null(*OsValue), OS_LIVE | OS_READY);
}

fn os_loan_end(check: *OsCheck, state: *OsState, value: *OsValue) -> unit {
    if !os_borrowed(check, (*value).syntax) || (*value).loan == null(*OsLoan) { return; }
    os_selection_end(check, state, (*value).loan);
    os_set(check, state, (*value).loan as *u8, null(*OsValue), 0u32);
}

fn os_end_expression(check: *OsCheck, state: *OsState, before: *OsLoan) -> unit {
    var loan: *OsLoan = (*check).loans;
    while loan != before && loan != null(*OsLoan) && !os_failed(check) {
        if os_loan_flags(state, loan) == OS_LIVE { os_selection_end(check, state, loan); os_set(check, state, loan as *u8, null(*OsValue), 0u32); }
        loan = (*loan).next;
    }
}

fn os_loan_slot(check: *OsCheck, slot: *OsSlot, loan: *OsLoan) -> *OsSlot {
    if slot == null(*OsSlot) || loan == null(*OsLoan) { return slot; }
    var result: *OsSlot = os_alloc(check, sizeof(OsSlot), alignof(OsSlot)) as *OsSlot;
    if result != null(*OsSlot) { *result = *slot; (*result).original = os_original(slot); (*result).loan = loan; }
    return result;
}

fn os_loan_parameter(check: *OsCheck, state: *OsState, slot: *OsSlot, value: *OsValue) -> unit {
    if !os_borrowed(check, (*slot).syntax) || (*slot).authority { return; }
    var target: *OsSlot = os_loan_storage(check, state, (*(*slot).syntax).base, (*value).object);
    if target == null(*OsSlot) { return; }
    (*value).place = target;
    (*value).loan = os_loan_new(check, state, value, (*(*slot).syntax).kind, &(*(*slot).syntax).loc);
    if (*value).loan != null(*OsLoan) { os_loan_keep(check, state, value); }
}

fn os_loan_scalar(check: *OsCheck, state: *OsState, value: *OsValue, location: *CrustLoc) -> *OsValue {
    if (*value).loan == null(*OsLoan) || (*(*value).loan).place == null(*OsSlot) {
        os_error(check, location, "dereference requires a live loan or checked pointer"); return null(*OsValue);
    }
    var place: *OsSlot = (*(*value).loan).place;
    if !os_loan_place_access(check, state, place, (*value).loan, false, location) { return null(*OsValue); }
    var result: *OsValue = os_copy(check, value);
    if result != null(*OsValue) {
        (*result).syntax = (*(*value).syntax).base;
        (*result).place = os_loan_slot(check, place, (*value).loan);
        (*result).object = null(*OsObject);
        (*result).pointer = false;
    }
    return result;
}

fn os_edit_loan_source(check: *OsCheck, state: *OsState, loan: *OsLoan,
                        arguments: **OsValue, count: usize, location: *CrustLoc) -> bool {
    var index: usize = 0usize;
    while index < count {
        if os_view_has_loan(check, state, arguments[index], loan, location) { return true; }
        index = index + 1usize;
    }
    return false;
}

fn os_call_loans(check: *OsCheck, state: *OsState, arguments: **OsValue,
                       count: usize, effect: u32, location: *CrustLoc) -> bool {
    var loan: *OsLoan = (*check).loans;
    while loan != null(*OsLoan) && !os_failed(check) {
        if (os_loan_flags(state, loan) & OS_LIVE) != 0u32 &&
           os_domain_loan_conflict(check, state, loan, arguments, count, effect, false, location) {
            os_error(check, location, "call authority conflicts with an active domain loan"); return false;
        }
        loan = (*loan).next;
    }
    return !os_failed(check);
}

fn os_handle_loan(check: *OsCheck, state: *OsState, loan: *OsLoan) -> bool {
    if loan == null(*OsLoan) || (*loan).object == null(*OsObject) || (*loan).place == null(*OsSlot) { return false; }
    var object: *OsObject = (*loan).object;
    var resources: *RsStage = (*(*check).stage).resources;
    if !os_opaque((*object).contract) || !rs_owns(resources, (*object).syntax) ||
       !rs_same(resources, (*(*loan).place).syntax, (*object).syntax) { return false; }
    var root: *OsObject = os_root(object);
    // A handle loan protects its own storage. Interior views still block reclamation.
    return !(*root).heap && !(*root).aliased && os_owner(state, root) == null(*OsObject);
}

fn os_no_domain_loans(check: *OsCheck, state: *OsState, domain: *CrustName, location: *CrustLoc) -> bool {
    var loan: *OsLoan = (*check).loans;
    while loan != null(*OsLoan) && !os_failed(check) {
        if (os_loan_flags(state, loan) & OS_LIVE) != 0u32 &&
           os_domain_loan_conflict(check, state, loan, null(**OsValue), 0usize, OS_RECLAIM, true, location) {
            os_error(check, location, "reclamation conflicts with an active domain loan"); return false;
        }
        loan = (*loan).next;
    }
    return !os_failed(check);
}

fn os_loan_storage(check: *OsCheck, state: *OsState, syntax: *CrustTypeSyntax, object: *OsObject) -> *OsSlot {
    var slot: *OsSlot = os_slot(check, syntax, null(*CrustName), null(*OsObject), (*state).scope);
    var value: *OsValue = os_value(check, syntax, object, false);
    if slot == null(*OsSlot) || value == null(*OsValue) { return null(*OsSlot); }
    // Scalar loan targets participate in the same joins and loops as named locals.
    if object == null(*OsObject) {
        (*slot).next = (*(*state).scope).locals;
        (*(*state).scope).locals = slot;
    }
    os_set(check, state, slot as *u8, value, OS_READY);
    return slot;
}

fn os_join_loans(check: *OsCheck, target: *OsState, left: *OsState, right: *OsState) -> unit {
    var loan: *OsLoan = (*check).loans;
    while loan != null(*OsLoan) && !os_failed(check) {
        var flags: u32 = os_loan_flags(left, loan) | os_loan_flags(right, loan);
        if flags != os_loan_flags(target, loan) { os_set(check, target, loan as *u8, null(*OsValue), flags); }
        loan = (*loan).next;
    }
}

fn os_domain_loan_conflict(check: *OsCheck, state: *OsState, loan: *OsLoan,
                           arguments: **OsValue, count: usize, effect: u32, reclaim: bool, location: *CrustLoc) -> bool {
    if (*loan).object != null(*OsObject) && (*(*loan).object).brand == (*state).brand {
        if reclaim { if !os_handle_loan(check, state, loan) { return true; } }
        else { if (effect >= OS_EDIT || (*loan).mode == rs_kind((*(*check).stage).resources, RS_MUT)) &&
                  !os_edit_loan_source(check, state, loan, arguments, count, location) { return true; } }
    }
    return os_selection_domain(check, state, loan, arguments, count, effect, reclaim, location);
}
