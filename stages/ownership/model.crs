const OS_NORMAL: u32 = 0u32;
const OS_RETURN: u32 = 1u32;
const OS_TRAP: u32 = 2u32;

const OS_READ: u32 = 1u32;
const OS_EDIT: u32 = 2u32;
const OS_RECLAIM: u32 = 3u32;
const OS_ALLOCATE: u32 = 1u32;
const OS_RELEASE: u32 = 2u32;
const OS_SCALAR: u32 = 3u32;
const OS_NATIVE: u32 = 4u32;
const OS_ACQUIRE: u32 = 5u32;
const OS_PRESENT: u32 = 1u32;

record OsStage {
    records: CrustMap;
    functions: CrustMap;
    blocks: CrustMap;
    imports: CrustMap;
    domains: CrustMap;
    trusted: CrustMap;
    resources: *RsStage;
}

record OsField {
    name: *CrustName;
    record_name: *CrustName;
    field: *CrustField;
    invalid: *CrustExpr;
    next: *OsField;
    storage: bool;
}

record OsDomain { declaration: *CrustDecl; records: *OsField; }

record OsRecord {
    declaration: *CrustDecl;
    domain: *CrustName;
    owns: *OsField;
    view_mode: u32;
    opaque: bool;
    stable: bool;
    scoped: bool;
}

record OsNative {
    parameter: *CrustName;
    schema: *CrustName;
    field: *CrustName;
    owner: *OsField;
    next: *OsNative;
    mode: u32;
}

record OsFunction {
    declaration: *CrustDecl;
    domain: *CrustName;
    result_path: *OsField;
    initializes: *OsField;
    modifies: *OsField;
    native: *OsNative;
    effect: u32;
    foreign: u32;
    has_modifies: bool;
}

record OsAccess { domain: *CrustName; effect: u32; fresh: bool; }

const OS_LIVE: u32 = 1u32;
const OS_NONNULL: u32 = 2u32;
const OS_PINNED: u32 = 4u32;
const OS_READY: u32 = 8u32;
const OS_ABSENT: u32 = 32u32;
const OS_DESTROYED: u32 = 128u32;
const OS_SUMMARY: u32 = 256u32;

record OsObject {
    syntax: *CrustTypeSyntax;
    contract: *OsRecord;
    parent: *OsObject;
    owner: *OsObject;
    domain: *CrustName;
    scope: *OsScope;
    brand: *OsScope;
    next: *OsObject;
    heap: bool;
    abstract: bool;
    uncertain: bool;
    aliased: bool;
}

record OsSlot {
    syntax: *CrustTypeSyntax;
    name: *CrustName;
    field: *CrustField;
    object: *OsObject;
    scope: *OsScope;
    next: *OsSlot;
    original: *OsSlot;
    deferred: *OsDeferred;
    loan: *OsLoan;
    owns: bool;
    authority: bool;
    argument: bool;
}

record OsValue {
    syntax: *CrustTypeSyntax;
    object: *OsObject;
    place: *OsSlot;
    allocation_type: *CrustTypeSyntax;
    native: *OsField;
    borrow_scope: *OsScope;
    loan: *OsLoan;
    presence: u32;
    owner: bool;
    pointer: bool;
    unknown: bool;
    fresh: bool;
}

record OsFact {
    fields: *OsSlot;
    key: *u8;
    value: *OsValue;
    next: *OsFact;
    flags: u32;
}

record OsLoan {
    object: *OsObject;
    place: *OsSlot;
    parent: *OsLoan;
    via: *OsLoan;
    scope: *OsScope;
    next: *OsLoan;
    mode: u32;
}

record OsScope { parent: *OsScope; locals: *OsSlot; domain: *CrustName; brand: *OsScope; effect: u32; access: bool; }
record OsBinding { name: *CrustName; value: *OsValue; next: *OsBinding; }

record OsState {
    facts: [*OsFact;64];
    scope: *OsScope;
    brand: *OsScope;
    domain: *CrustName;
    effect: u32;
    flow: u32;
}

record OsCheck {
    stage: *OsStage;
    function: *OsFunction;
    objects: *OsObject;
    loans: *OsLoan;
    parameters: *OsBinding;
    origin: *OsScope;
    depth: usize;
    loop_depth: usize;
    drop: bool;
}

record OsDeferred { contract: *OsFunction; arguments: **OsValue; location: *CrustLoc; count: usize; }
