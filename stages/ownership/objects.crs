fn os_slot(check: *OsCheck, syntax: *CrustTypeSyntax, name: *CrustName,
           object: *OsObject, scope: *OsScope) -> *OsSlot {
    var slot: *OsSlot = os_alloc(check, sizeof(OsSlot), alignof(OsSlot)) as *OsSlot;
    if slot == null(*OsSlot) { return slot; }
    (*slot).syntax = syntax;
    (*slot).name = name;
    (*slot).object = object;
    (*slot).scope = scope;
    (*slot).owns = rs_owns((*(*check).stage).resources, syntax);
    return slot;
}

fn os_member_family(check: *OsCheck, field: *OsField, location: *CrustLoc) -> *OsField {
    var global: *RsGlobal = rs_global((*(*check).stage).resources, (*field).record_name);
    if global == null(*RsGlobal) {
        os_error(check, location, "anchor requires a declared member record");
        return null(*OsField);
    }
    var schema: *OsRecord = crust_map_get(&(*(*check).stage).records, (*global).source as usize) as *OsRecord;
    var result: *OsField = null(*OsField);
    if schema != null(*OsRecord) { result = os_field((*schema).members, (*field).member_name); }
    if result == null(*OsField) { os_error(check, location, "anchor requires a declared member field"); }
    return result;
}

fn os_object(check: *OsCheck, state: *OsState, syntax: *CrustTypeSyntax,
             parent: *OsObject, scope: *OsScope, initialized: bool) -> *OsObject {
    if !os_enter(check, &(*syntax).loc) { return null(*OsObject); }
    var object: *OsObject = os_alloc(check, sizeof(OsObject), alignof(OsObject)) as *OsObject;
    if object != null(*OsObject) {
        (*object).syntax = syntax;
        (*object).contract = os_record((*check).stage, syntax);
        (*object).parent = parent;
        (*object).scope = scope;
        (*object).next = (*check).objects;
        (*check).objects = object;
        if (*object).contract != null(*OsRecord) { (*object).domain = (*(*object).contract).domain; }
        if parent != null(*OsObject) { (*object).domain = (*parent).domain; }
        var flags: u32 = OS_LIVE | OS_NONNULL;
        if initialized { flags = flags | OS_READY; }
        os_mark(check, state, object, flags);
        os_object_fields(check, state, object, initialized);
    }
    (*check).depth = (*check).depth - 1usize;
    return object;
}

fn os_object_fields(check: *OsCheck, state: *OsState, object: *OsObject, initialized: bool) -> unit {
    var syntax: *CrustTypeSyntax = (*object).syntax;
    if (*syntax).kind != CRUST_T_NAME { return; }
    var global: *RsGlobal = rs_global((*(*check).stage).resources, (*syntax).name);
    var field: *CrustField = (*(*global).source).fields;
    var last: *OsSlot = null(*OsSlot);
    while field != null(*CrustField) && !os_failed(check) {
        var slot: *OsSlot = os_slot(check, (*field).syntax_type, (*field).name, object, (*object).scope);
        if slot == null(*OsSlot) { return; }
        if last == null(*OsSlot) { (*object).fields = slot; }
        else { (*last).next = slot; }
        last = slot;
        os_object_field(check, state, object, slot, initialized);
        field = (*field).next;
    }
}

fn os_object_field(check: *OsCheck, state: *OsState, object: *OsObject,
                   slot: *OsSlot, initialized: bool) -> unit {
    var schema: *OsRecord = (*object).contract;
    var syntax: *CrustTypeSyntax = (*slot).syntax;
    if schema != null(*OsRecord) {
        if os_field((*schema).owns, (*slot).name) != null(*OsField) { (*slot).owns = true; }
    }
    var value: *OsValue = null(*OsValue);
    if (*syntax).kind == CRUST_T_NAME {
        var child: *OsObject = os_object(check, state, syntax, object, (*object).scope, initialized);
        if child == null(*OsObject) { return; }
        os_hook_field(check, state, child, schema, slot, initialized);
        value = os_value(check, syntax, child, false);
    } else { if initialized {
        value = os_field_value(check, state, slot);
    } }
    if value != null(*OsValue) { os_set(check, state, slot as *u8, value, OS_READY); }
}

fn os_hook_field(check: *OsCheck, state: *OsState, child: *OsObject,
                 schema: *OsRecord, slot: *OsSlot, initialized: bool) -> unit {
    if schema == null(*OsRecord) { return; }
    (*child).family = os_field((*schema).members, (*slot).name);
    if (*child).family != null(*OsField) {
        os_mark(check, state, child, os_flags(state, child) | OS_MEMBER);
    }
    var anchor: *OsField = os_field((*schema).anchors, (*slot).name);
    if anchor != null(*OsField) {
        (*child).family = os_member_family(check, anchor, &(*(*slot).syntax).loc);
        (*child).anchor = true;
    }
    if (*child).family != null(*OsField) && initialized {
        os_mark(check, state, os_root(child), os_flags(state, os_root(child)) | OS_PINNED);
    }
}

fn os_field_value(check: *OsCheck, state: *OsState, slot: *OsSlot) -> *OsValue {
    var syntax: *CrustTypeSyntax = (*slot).syntax;
    var target: *OsObject = null(*OsObject);
    if (*syntax).kind == CRUST_T_POINTER && (*slot).owns {
        target = os_object(check, state, (*syntax).base, null(*OsObject), null(*OsScope), true);
        if target == null(*OsObject) { return null(*OsValue); }
        (*target).heap = true;
        os_mark(check, state, target, os_flags(state, target) & ~OS_NONNULL);
    }
    var result: *OsValue = os_value(check, syntax, target, (*syntax).kind == CRUST_T_POINTER);
    if result != null(*OsValue) { (*result).owner = (*slot).owns; }
    return result;
}

fn os_object_slot(object: *OsObject, name: *CrustName) -> *OsSlot {
    var slot: *OsSlot = (*object).fields;
    while slot != null(*OsSlot) {
        if (*slot).name == name { return slot; }
        slot = (*slot).next;
    }
    return null(*OsSlot);
}

fn os_local(state: *OsState, name: *CrustName) -> *OsSlot {
    var scope: *OsScope = (*state).scope;
    while scope != null(*OsScope) {
        var slot: *OsSlot = (*scope).locals;
        while slot != null(*OsSlot) {
            if (*slot).name == name { return slot; }
            slot = (*slot).next;
        }
        scope = (*scope).parent;
    }
    return null(*OsSlot);
}

fn os_initialized(check: *OsCheck, state: *OsState, object: *OsObject) -> bool {
    if object == null(*OsObject) { return true; }
    if !os_enter(check, &(*(*object).syntax).loc) { return false; }
    var valid: bool = true;
    if (*object).family != null(*OsField) { valid = (os_flags(state, object) & OS_READY) != 0u32; }
    else {
        var slot: *OsSlot = (*object).fields;
        while slot != null(*OsSlot) && valid {
            var value: *OsValue = os_bound(state, slot);
            valid = value != null(*OsValue);
            if valid && !(*value).pointer && (*value).object != null(*OsObject) {
                valid = os_initialized(check, state, (*value).object);
            }
            if valid && (*slot).owns && (*value).pointer && (*value).object != null(*OsObject) &&
               (os_flags(state, (*value).object) & OS_ABSENT) == 0u32 {
                valid = os_initialized(check, state, (*value).object);
            }
            slot = (*slot).next;
        }
    }
    (*check).depth = (*check).depth - 1usize;
    return valid;
}

fn os_isolated(check: *OsCheck, state: *OsState, object: *OsObject) -> bool {
    if !os_enter(check, &(*(*object).syntax).loc) { return false; }
    var isolated: bool = true;
    if (*object).family != null(*OsField) {
        isolated = (os_flags(state, object) & OS_READY) == 0u32 ||
            (os_flags(state, object) & OS_ISOLATED) != 0u32;
    } else {
        var slot: *OsSlot = (*object).fields;
        while slot != null(*OsSlot) && isolated {
            var value: *OsValue = os_bound(state, slot);
            if value != null(*OsValue) && !(*value).pointer && (*value).object != null(*OsObject) {
                isolated = os_isolated(check, state, (*value).object);
            }
            slot = (*slot).next;
        }
    }
    (*check).depth = (*check).depth - 1usize;
    return isolated;
}
