fn os_slot(check: *OsCheck, syntax: *CrustTypeSyntax, name: *CrustName,
           object: *OsObject, scope: *OsScope) -> *OsSlot {
    var slot: *OsSlot = os_alloc(check, sizeof(OsSlot), alignof(OsSlot)) as *OsSlot;
    if slot == null(*OsSlot) { return slot; }
    (*slot).syntax = syntax;
    (*slot).name = name;
    (*slot).object = object;
    (*slot).scope = scope;
    (*slot).owns = os_affine(check, syntax);
    return slot;
}

fn os_object(check: *OsCheck, state: *OsState, syntax: *CrustTypeSyntax,
             parent: *OsObject, scope: *OsScope, initialized: bool) -> *OsObject {
    if !os_enter(check, &(*syntax).loc) { return null(*OsObject); }
    var object: *OsObject = os_object_header(check, state, syntax, parent, scope, initialized);
    if object != null(*OsObject) {
        os_object_fields(check, state, object, initialized);
    }
    (*check).depth = (*check).depth - 1usize;
    return object;
}

fn os_object_header(check: *OsCheck, state: *OsState, syntax: *CrustTypeSyntax,
                    parent: *OsObject, scope: *OsScope, initialized: bool) -> *OsObject {
    var object: *OsObject = os_alloc(check, sizeof(OsObject), alignof(OsObject)) as *OsObject;
    if object == null(*OsObject) { return object; }
    (*object).syntax = syntax;
    (*object).contract = os_record((*check).stage, syntax);
    (*object).parent = parent;
    (*object).scope = scope;
    (*object).next = (*check).objects;
    (*check).objects = object;
    if (*object).contract != null(*OsRecord) { (*object).domain = (*(*object).contract).domain; }
    if (*object).domain != null(*CrustName) {
        if (*object).domain != (*state).domain || (*state).brand == null(*OsScope) {
            os_error(check, &(*syntax).loc, "managed value requires its declared domain authority"); return null(*OsObject);
        }
        (*object).brand = (*state).brand;
    }
    if parent != null(*OsObject) { (*object).domain = (*parent).domain; (*object).brand = (*parent).brand; }
    var flags: u32 = OS_LIVE | OS_NONNULL;
    if initialized { flags = flags | OS_READY; }
    os_mark(check, state, object, flags);
    return object;
}

fn os_fields(state: *OsState, object: *OsObject) -> *OsSlot {
    var fact: *OsFact = os_fact(state, object as *u8);
    if fact == null(*OsFact) { return null(*OsSlot); }
    return (*fact).fields;
}

fn os_set_fields(check: *OsCheck, state: *OsState, object: *OsObject, fields: *OsSlot) -> unit {
    os_mark(check, state, object, os_flags(state, object));
    if !os_failed(check) { (*(*state).facts[os_fact_bucket(object as *u8)]).fields = fields; }
}

// An owned pointer promises an initialized value of its declared type.
// Its pointee fields belong to the current control-flow path.
fn os_unfold(check: *OsCheck, state: *OsState, object: *OsObject) -> unit {
    if (os_flags(state, object) & OS_SUMMARY) == 0u32 || os_failed(check) { return; }
    os_mark(check, state, object, os_flags(state, object) & ~OS_SUMMARY);
    os_object_fields(check, state, object, true);
    os_abstract_value(check, state, object, (*object).uncertain);
}

fn os_object_fields(check: *OsCheck, state: *OsState, object: *OsObject, initialized: bool) -> unit {
    var syntax: *CrustTypeSyntax = (*object).syntax;
    if (*syntax).kind != CRUST_T_NAME || os_opaque((*object).contract) { return; }
    var global: *RsGlobal = rs_global((*(*check).stage).resources, (*syntax).name);
    var field: *CrustField = (*(*global).source).fields;
    var fields: *OsSlot = null(*OsSlot);
    while field != null(*CrustField) && !os_failed(check) {
        var slot: *OsSlot = os_slot(check, (*field).syntax_type, (*field).name, object, (*object).scope);
        if slot == null(*OsSlot) { return; }
        (*slot).next = fields;
        fields = slot;
        (*slot).field = field;
        os_object_field(check, state, object, slot, initialized);
        field = (*field).next;
    }
    // Field cleanup follows reverse declaration order, as in resource lowering.
    if fields != null(*OsSlot) { os_set_fields(check, state, object, fields); }
}

fn os_object_field(check: *OsCheck, state: *OsState, object: *OsObject,
                   slot: *OsSlot, initialized: bool) -> unit {
    var schema: *OsRecord = (*object).contract;
    var syntax: *CrustTypeSyntax = (*slot).syntax;
    if schema != null(*OsRecord) {
        if os_field((*schema).owns, (*slot).name) != null(*OsField) { (*slot).owns = true; }
    }
    var value: *OsValue = null(*OsValue);
    if (*syntax).kind == CRUST_T_NAME {
        var child: *OsObject = os_object(check, state, syntax, object, (*object).scope, initialized);
        if child == null(*OsObject) { return; }
        value = os_value(check, syntax, child, false);
    } else { if initialized {
        value = os_field_value(check, state, slot);
    } }
    if value != null(*OsValue) { os_set(check, state, slot as *u8, value, OS_READY); }
}

fn os_pin(check: *OsCheck, state: *OsState, object: *OsObject) -> unit {
    while object != null(*OsObject) && !os_failed(check) {
        os_mark(check, state, object, os_flags(state, object) | OS_PINNED);
        object = (*object).parent;
    }
}

fn os_field_value(check: *OsCheck, state: *OsState, slot: *OsSlot) -> *OsValue {
    var syntax: *CrustTypeSyntax = (*slot).syntax;
    if os_borrowed(syntax) { return os_view_parameter(check, state, slot); }
    var owner: *OsField = os_owned_field(slot);
    if owner != null(*OsField) && !(*owner).storage { return os_native_value(check, owner); }
    var target: *OsObject = null(*OsObject);
    if (*syntax).kind == CRUST_T_POINTER && (*slot).owns {
        target = os_object_header(check, state, (*syntax).base, null(*OsObject), null(*OsScope), true);
        if target == null(*OsObject) { return null(*OsValue); }
        (*target).heap = true;
        (*target).owner = (*slot).object;
        os_mark(check, state, target, (os_flags(state, target) & ~OS_NONNULL) | OS_SUMMARY);
    }
    var result: *OsValue = os_value(check, syntax, target, (*syntax).kind == CRUST_T_POINTER);
    if result != null(*OsValue) { (*result).owner = (*slot).owns; }
    return result;
}

fn os_object_slot(check: *OsCheck, state: *OsState, object: *OsObject, name: *CrustName) -> *OsSlot {
    os_unfold(check, state, object);
    var slot: *OsSlot = os_fields(state, object);
    while slot != null(*OsSlot) {
        if (*slot).name == name { return slot; }
        slot = (*slot).next;
    }
    return null(*OsSlot);
}

fn os_local(state: *OsState, name: *CrustName) -> *OsSlot {
    var scope: *OsScope = (*state).scope;
    while scope != null(*OsScope) {
        var slot: *OsSlot = (*scope).locals;
        while slot != null(*OsSlot) {
            if (*slot).name == name { return slot; }
            slot = (*slot).next;
        }
        scope = (*scope).parent;
    }
    return null(*OsSlot);
}

fn os_initialized(check: *OsCheck, state: *OsState, object: *OsObject) -> bool {
    if object == null(*OsObject) { return true; }
    if (os_flags(state, object) & OS_DESTROYED) != 0u32 { return false; }
    if os_opaque((*object).contract) { return (os_flags(state, object) & OS_READY) != 0u32; }
    if (os_flags(state, object) & OS_SUMMARY) != 0u32 { return true; }
    if !os_enter(check, &(*(*object).syntax).loc) { return false; }
    var valid: bool = true;
    {
        var slot: *OsSlot = os_fields(state, object);
        while slot != null(*OsSlot) && valid {
            valid = os_initialized_field(check, state, slot);
            slot = (*slot).next;
        }
    }
    (*check).depth = (*check).depth - 1usize;
    return valid;
}

fn os_initialized_field(check: *OsCheck, state: *OsState, slot: *OsSlot) -> bool {
    var value: *OsValue = os_bound(state, slot);
    if value == null(*OsValue) { return false; }
    if os_borrowed((*slot).syntax) { return (*value).loan != null(*OsLoan) && (os_loan_flags(state, (*value).loan) & OS_LIVE) != 0u32; }
    if (*value).object == null(*OsObject) { return true; }
    if (*value).pointer {
        if !(*slot).owns || (os_flags(state, (*value).object) & OS_ABSENT) != 0u32 { return true; }
    }
    return os_initialized(check, state, (*value).object);
}
