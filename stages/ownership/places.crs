fn os_access(check: *OsCheck, state: *OsState, object: *OsObject,
             write: bool, location: *CrustLoc) -> bool {
    return os_access_through(check, state, object, null(*OsLoan), write, location);
}

fn os_access_through(check: *OsCheck, state: *OsState, object: *OsObject,
                     loan: *OsLoan, write: bool, location: *CrustLoc) -> bool {
    if object == null(*OsObject) {
        os_error(check, location, "pointer has no checked storage origin");
        return false;
    }
    var root: *OsObject = os_root(object);
    if write && (*root).readonly {
        os_error(check, location, "shared storage permits only reads");
        return false;
    }
    var flags: u32 = os_flags(state, root);
    if (flags & OS_LIVE) == 0u32 || (flags & (OS_ABSENT | OS_DESTROYED)) != 0u32 {
        os_error(check, location, "pointer access requires live non-null storage");
        return false;
    }
    if (flags & OS_NONNULL) == 0u32 {
        var valid: *u8 = pf_not(&(*check).proof, pf_eq(&(*check).proof, (*root).term, "0"));
        if (flags & OS_PUBLISHED) != 0u32 { valid = os_live_term(check, state, (*root).contract, (*root).term); }
        if !os_prove(check, state, valid, location, "pointer access requires live non-null storage") { return false; }
        os_mark(check, state, root, flags | OS_NONNULL);
    }
    if (*object).domain != null(*CrustName) {
        if (*state).domain != (*object).domain || (*state).effect == 0u32 || (write && (*state).effect == OS_READ) {
            os_error(check, location, "access requires the declared domain authority");
            return false;
        }
    }
    return os_loan_access(check, state, object, loan, write, location);
}

fn os_read_slot(check: *OsCheck, state: *OsState, slot: *OsSlot, location: *CrustLoc) -> *OsValue {
    var value: *OsValue = os_bound(state, slot);
    if value == null(*OsValue) {
        os_error(check, location, "value is uninitialized or has been moved");
        return null(*OsValue);
    }
    if (*value).unknown {
        os_error(check, location, "raw parameter has no checked storage contract");
        return null(*OsValue);
    }
    if !os_borrowed((*slot).syntax) && !os_loan_place_access(check, state, slot, (*slot).loan, false, location) {
        return null(*OsValue);
    }
    var result: *OsValue = os_copy(check, value);
    if result != null(*OsValue) {
        // Values outside symbolic field maps can change through another alias.
        if (*slot).field != null(*CrustField) && (*(*slot).syntax).kind < CRUST_T_POINTER {
            (*result).term = pf_fresh(&(*check).proof, os_sort((*slot).syntax));
        }
        (*result).place = slot; (*result).owner = false;
        (*result).fresh = false;
        if (*slot).loan != null(*OsLoan) { (*result).loan = (*slot).loan; }
        if (*result).pointer && (*result).object != null(*OsObject) && (*result).borrow_scope == null(*OsScope) {
            (*result).borrow_scope = os_cursor_scope(state, (*result).object);
        }
    }
    return result;
}

fn os_place(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> *OsSlot {
    while (*expression).kind == CRUST_E_GROUP { expression = (*expression).left; }
    if (*expression).kind == CRUST_E_NAME { return os_named_place(check, state, expression); }
    if (*expression).kind == CRUST_E_FIELD { return os_field_place(check, state, expression); }
    if (*expression).kind == CRUST_E_UNARY && (*expression).op == CRUST_OP_DEREF {
        return os_deref_place(check, state, expression);
    }
    os_error(check, &(*expression).loc, "ownership place must name checked storage");
    return null(*OsSlot);
}

fn os_named_place(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> *OsSlot {
    var local: *OsSlot = os_local(state, (*expression).name);
    if local == null(*OsSlot) { os_error(check, &(*expression).loc, "ownership place requires a local binding"); return local; }
    if os_borrowed((*local).syntax) {
        var borrowed: *OsValue = os_bound(state, local);
        if borrowed != null(*OsValue) && (*borrowed).loan != null(*OsLoan) {
            return os_loan_slot(check, (*(*borrowed).loan).place, (*borrowed).loan);
        }
    }
    return local;
}

fn os_field_place(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> *OsSlot {
    var base: *OsValue = os_expr(check, state, (*expression).left);
    if base == null(*OsValue) || os_failed(check) { return null(*OsSlot); }
    if (*base).owner && (*base).place == null(*OsSlot) {
        os_error(check, &(*expression).loc, "resource temporary cannot lend a field beyond its expression");
        return null(*OsSlot);
    }
    if !os_access_through(check, state, (*base).object, (*base).loan, false, &(*expression).loc) { return null(*OsSlot); }
    var field: *OsSlot = os_object_slot(check, state, (*base).object, (*expression).field_name);
    if field == null(*OsSlot) { os_error(check, &(*expression).loc, "ownership field does not exist"); }
    if field != null(*OsSlot) && os_borrowed((*field).syntax) {
        return os_view_place(check, state, field, (*base).loan, &(*expression).loc);
    }
    return os_loan_slot(check, field, (*base).loan);
}

fn os_deref_place(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> *OsSlot {
    var value: *OsValue = os_expr(check, state, (*expression).left);
    if value == null(*OsValue) || !os_borrowed((*value).syntax) || (*value).loan == null(*OsLoan) {
        os_error(check, &(*expression).loc, "assignment through a pointer requires a mutable loan"); return null(*OsSlot);
    }
    return os_loan_slot(check, (*(*value).loan).place, (*value).loan);
}

fn os_move(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> *OsValue {
    var slot: *OsSlot = os_place(check, state, (*expression).left);
    if slot == null(*OsSlot) || os_failed(check) { return null(*OsValue); }
    if (*slot).object != null(*OsObject) && (*os_root((*slot).object)).readonly {
        os_error(check, &(*expression).loc, "shared storage cannot transfer ownership");
        return null(*OsValue);
    }
    var value: *OsValue = os_read_slot(check, state, slot, &(*expression).loc);
    if value == null(*OsValue) { return value; }
    if !os_move_allowed(check, state, slot, value, &(*expression).loc) ||
       !os_field_write(check, slot, &(*expression).loc) { return null(*OsValue); }
    os_withdraw_owner(check, state, (*slot).object, &(*expression).loc);
    if os_failed(check) { return null(*OsValue); }
    os_set(check, state, os_original(slot) as *u8, null(*OsValue), 0u32);
    (*value).owner = true;
    (*value).place = null(*OsSlot);
    if (*value).pointer && (*value).object != null(*OsObject) { os_set_owner(check, state, (*value).object, null(*OsObject)); }
    if (*check).drop && (*slot).object != null(*OsObject) && (*value).pointer && (*value).object != null(*OsObject) {
        os_mark(check, state, (*value).object, os_flags(state, (*value).object) | OS_RETIRING);
    }
    return value;
}

fn os_move_allowed(check: *OsCheck, state: *OsState, slot: *OsSlot, value: *OsValue, location: *CrustLoc) -> bool {
    if !(*slot).owns {
        os_error(check, location, "move requires an owner place");
        return false;
    }
    if (*slot).object != null(*OsObject) {
        if (*os_root((*slot).object)).cursor {
            os_error(check, location, "owner transfer requires an ownership origin, not a retained reference"); return false;
        }
        if !os_access_through(check, state, (*slot).object, (*slot).loan, true, location) { return false; }
    }
    if !os_loan_place_access(check, state, slot, (*slot).loan, true, location) { return false; }
    if (*value).object != null(*OsObject) &&
       !os_loan_access(check, state, (*value).object, (*slot).loan, true, location) { return false; }
    if !(*value).pointer && (*value).object != null(*OsObject) &&
       (os_flags(state, (*value).object) & OS_PINNED) != 0u32 {
        os_error(check, location, "address-stable storage cannot move");
        return false;
    }
    return true;
}

fn os_store_record(check: *OsCheck, state: *OsState, target: *OsObject,
                   source: *OsObject, location: *CrustLoc) -> unit {
    if !os_enter(check, location) { return; }
    if (os_flags(state, target) & OS_PINNED) != 0u32 ||
       (os_flags(state, source) & OS_PINNED) != 0u32 {
        os_error(check, location, "assignment cannot copy address-stable storage");
        (*check).depth = (*check).depth - 1usize;
        return;
    }
    var slot: *OsSlot = os_fields(state, target);
    while slot != null(*OsSlot) && !os_failed(check) {
        os_store_record_field(check, state, slot, source, location);
        slot = (*slot).next;
    }
    if !os_failed(check) && os_initialized(check, state, target) {
        os_mark(check, state, target, os_flags(state, target) | OS_READY);
    }
    (*check).depth = (*check).depth - 1usize;
}

fn os_store(check: *OsCheck, state: *OsState, slot: *OsSlot,
            value: *OsValue, location: *CrustLoc) -> unit {
    if value == null(*OsValue) || os_failed(check) { return; }
    if !os_store_allowed(check, state, slot, value, location) { return; }
    value = os_stored_value(check, slot, value);
    if value == null(*OsValue) { return; }
    var previous: *OsValue = os_bound(state, slot);
    if previous != null(*OsValue) && (*slot).owns && !os_first_store(check, state, previous, location) {
        os_error(check, location, "assignment would overwrite a live owner"); return;
    }
    if !(*value).pointer && (*value).object != null(*OsObject) && previous != null(*OsValue) {
        os_store_record(check, state, (*previous).object, (*value).object, location);
    } else { os_set(check, state, os_original(slot) as *u8, value, OS_READY); }
    os_heap_store(check, state, slot, value, location);
    os_store_parent(check, state, slot, value);
    os_loan_keep(check, state, value);
}

fn os_stored_value(check: *OsCheck, slot: *OsSlot, value: *OsValue) -> *OsValue {
    if (*value).pointer || (*value).object != null(*OsObject) || os_borrowed((*slot).syntax) { return value; }
    var result: *OsValue = os_copy(check, value);
    if result != null(*OsValue) {
        (*result).loan = null(*OsLoan);
        (*result).borrow_scope = null(*OsScope);
        (*result).place = null(*OsSlot);
    }
    return result;
}

fn os_store_allowed(check: *OsCheck, state: *OsState, slot: *OsSlot,
                      value: *OsValue, location: *CrustLoc) -> bool {
    if !os_transferable(check, state, value, location) || !os_store_lifetime(check, slot, value, location) { return false; }
    if !os_loan_place_access(check, state, slot, (*slot).loan, true, location) { return false; }
    if (*slot).object != null(*OsObject) && !os_access_through(check, state, (*slot).object, (*slot).loan, true, location) { return false; }
    if !os_store_owner(check, state, slot, value, location) { return false; }
    if !os_borrowed((*slot).syntax) && !(*value).pointer && (*value).object != null(*OsObject) &&
       os_view_mode(check, (*slot).syntax) >= RS_READ {
        if (*slot).loan != null(*OsLoan) {
            os_error(check, location, "borrowed view records must retain their stored loan origins"); return false;
        }
        return os_view_lifetime(check, state, (*value).object, (*slot).scope, location);
    }
    return true;
}

fn os_store_parent(check: *OsCheck, state: *OsState, slot: *OsSlot, value: *OsValue) -> unit {
    if (*slot).owns && (*slot).object != null(*OsObject) && (*value).pointer && (*value).object != null(*OsObject) {
        os_set_owner(check, state, (*value).object, (*slot).object);
    }
}

fn os_first_store(check: *OsCheck, state: *OsState, value: *OsValue, location: *CrustLoc) -> bool {
    if (*value).pointer || (*value).object == null(*OsObject) { return false; }
    return os_pristine(check, state, (*value).object, location);
}

fn os_pristine(check: *OsCheck, state: *OsState, object: *OsObject, location: *CrustLoc) -> bool {
    if !os_enter(check, location) { return false; }
    var pristine: bool = (os_flags(state, object) & (OS_READY | OS_PINNED | OS_DESTROYED)) == 0u32;
    var slot: *OsSlot = os_fields(state, object);
    while slot != null(*OsSlot) && pristine && !os_failed(check) {
        var value: *OsValue = os_bound(state, slot);
        if value != null(*OsValue) {
            pristine = !(*value).pointer && (*value).object != null(*OsObject);
            if pristine { pristine = os_pristine(check, state, (*value).object, location); }
        }
        slot = (*slot).next;
    }
    (*check).depth = (*check).depth - 1usize;
    return pristine;
}

fn os_transferable(check: *OsCheck, state: *OsState, value: *OsValue, location: *CrustLoc) -> bool {
    if os_borrowed((*value).syntax) { return true; }
    if !(*value).pointer && (*value).object != null(*OsObject) {
        if (os_flags(state, (*value).object) & OS_PINNED) != 0u32 || (!(*value).fresh && !(*value).owner) {
            os_error(check, location, "schema transfer requires movable owned or fresh storage"); return false;
        }
    }
    return true;
}

fn os_store_lifetime(check: *OsCheck, slot: *OsSlot, value: *OsValue, location: *CrustLoc) -> bool {
    if os_symbolic_slot(slot) && (*(*slot).syntax).kind == CRUST_T_POINTER { return true; }
    if ((*value).pointer || os_borrowed((*value).syntax)) && !(*value).owner && (*value).borrow_scope != null(*OsScope) {
        if !os_scope_contains((*value).borrow_scope, (*slot).scope) {
            os_error(check, location, "cursor cannot outlive its access scope"); return false;
        }
    }
    return true;
}

fn os_store_owner(check: *OsCheck, state: *OsState, slot: *OsSlot, value: *OsValue, location: *CrustLoc) -> bool {
    if (*value).pointer && (*value).owner && !(*slot).owns {
        os_error(check, location, "owned pointer cannot initialize a borrowed pointer binding"); return false;
    }
    if (*slot).owns && !(*value).owner {
        if !(*value).pointer || (*value).object != null(*OsObject) {
            os_error(check, location, "owner initialization requires an explicit move");
            return false;
        }
    }
    if (*slot).owns && (*slot).object != null(*OsObject) && (*value).pointer && (*value).object != null(*OsObject) {
        return os_publish_owned(check, state, (*value).object, location);
    }
    return true;
}

fn os_address(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> *OsValue {
    var slot: *OsSlot = os_place(check, state, (*expression).left);
    if slot == null(*OsSlot) || os_failed(check) { return null(*OsValue); }
    var value: *OsValue = os_bound(state, slot);
    if value == null(*OsValue) || (*value).object == null(*OsObject) || (*value).pointer {
        os_error(check, &(*expression).loc, "address requires stable schema storage");
        return null(*OsValue);
    }
    os_assume(check, state, pf_not(&(*check).proof, pf_eq(&(*check).proof, (*(*value).object).term, "0")));
    var syntax: *CrustTypeSyntax = rs_pointer((*(*check).stage).resources, (*slot).syntax);
    var result: *OsValue = os_value(check, syntax, (*value).object, true);
    if result != null(*OsValue) { (*result).borrow_scope = os_cursor_scope(state, (*result).object); (*result).loan = (*slot).loan; }
    return result;
}

fn os_load(check: *OsCheck, state: *OsState, expression: *CrustExpr) -> *OsValue {
    var slot: *OsSlot = os_place(check, state, expression);
    if slot == null(*OsSlot) || os_failed(check) { return null(*OsValue); }
    if os_symbolic_slot(slot) { return os_heap_load(check, state, slot, &(*expression).loc); }
    return os_read_slot(check, state, slot, &(*expression).loc);
}

fn os_publish_owned(check: *OsCheck, state: *OsState, object: *OsObject, location: *CrustLoc) -> bool {
    if (os_flags(state, object) & OS_ABSENT) != 0u32 { return true; }
    if !os_initialized(check, state, object) {
        os_error(check, location, "owner field requires a fully initialized allocation"); return false;
    }
    return os_heap_publish(check, state, object, location);
}

fn os_store_record_field(check: *OsCheck, state: *OsState, slot: *OsSlot,
                         source: *OsObject, location: *CrustLoc) -> unit {
    var from: *OsSlot = os_object_slot(check, state, source, (*slot).name);
    var value: *OsValue = os_bound(state, from);
    if value != null(*OsValue) {
        var previous: *OsValue = os_bound(state, slot);
        if !os_borrowed((*slot).syntax) && !(*value).pointer && (*value).object != null(*OsObject) && previous != null(*OsValue) {
            os_store_record(check, state, (*previous).object, (*value).object, location);
        } else {
            os_set(check, state, slot as *u8, value, OS_READY);
            if (*slot).owns && (*value).pointer && (*value).object != null(*OsObject) {
                os_set_owner(check, state, (*value).object, (*slot).object);
            }
        }
        os_heap_store(check, state, slot, os_bound(state, slot), location);
    }
}
