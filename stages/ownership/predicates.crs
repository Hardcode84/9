fn os_predicate_name(check: *OsCheck, expression: *CrustExpr, bindings: *OsBinding) -> *OsTerm {
    while bindings != null(*OsBinding) {
        if (*bindings).name == (*expression).name { return os_term_new(check, (*bindings).term.syntax, (*bindings).term.value, (*bindings).term.valid); }
        bindings = (*bindings).next;
    }
    os_error(check, &(*expression).loc, "contract name must refer to self or a function parameter");
    return os_term_new(check, null(*CrustTypeSyntax), "0", "false");
}

fn os_predicate_field(check: *OsCheck, state: *OsState, expression: *CrustExpr,
                       bindings: *OsBinding) -> *OsTerm {
    var base: *OsTerm = os_predicate(check, state, (*expression).left, bindings);
    if os_failed(check) { return base; }
    if (*(*base).syntax).kind != CRUST_T_NAME {
        os_error(check, &(*expression).loc, "contract field requires a schema value"); return base;
    }
    var field: *CrustField = os_resolve_field(check, (*(*base).syntax).name, (*expression).field_name, &(*expression).loc);
    if field == null(*CrustField) { return base; }
    var entry: *PfField = os_field_state(state, field);
    if entry == null(*PfField) {
        os_error(check, &(*expression).loc, "contract field must belong to the checked storage schema"); return base;
    }
    return os_term_new(check, (*field).syntax_type, pf_select(&(*check).proof, (*entry).value, (*base).value), pf_and(&(*check).proof, (*base).valid, pf_select(&(*check).proof, (*entry).initialized, (*base).value)));
}

fn os_predicate_unary(check: *OsCheck, state: *OsState, expression: *CrustExpr,
                       bindings: *OsBinding) -> *OsTerm {
    var term: *OsTerm = os_predicate(check, state, (*expression).left, bindings);
    if os_failed(check) { return term; }
    var kind: u32 = (*(*term).syntax).kind;
    if (*expression).op == CRUST_OP_DEREF && kind == CRUST_T_POINTER {
        (*term).syntax = (*(*term).syntax).base;
        (*term).valid = pf_and(&(*check).proof, (*term).valid,
            os_live_term(check, state, os_record((*check).stage, (*term).syntax), (*term).value));
        return term;
    }
    if (*expression).op == CRUST_OP_NOT && kind == CRUST_T_BOOL {
        (*term).value = pf_not(&(*check).proof, (*term).value); return term;
    }
    os_error(check, &(*expression).loc, "contract unary operation must be typed dereference or Boolean negation");
    return term;
}

fn os_predicate_binary(check: *OsCheck, state: *OsState, expression: *CrustExpr,
                        bindings: *OsBinding) -> *OsTerm {
    var a: *OsTerm = os_predicate(check, state, (*expression).left, bindings);
    var b: *OsTerm = os_predicate(check, state, (*expression).right, bindings);
    if os_failed(check) { return a; }
    var op: u32 = (*expression).op;
    if !os_predicate_operands(check, expression, (*a).syntax, (*b).syntax) { return a; }
    if op == CRUST_OP_AND { (*b).valid = pf_implies(&(*check).proof, (*a).value, (*b).valid); }
    if op == CRUST_OP_OR { (*b).valid = pf_implies(&(*check).proof, pf_not(&(*check).proof, (*a).value), (*b).valid); }
    return os_term_new(check, os_syntax(check, CRUST_T_BOOL, &(*expression).loc), os_compare_term(check, op, (*a).value, (*b).value), pf_and(&(*check).proof, (*a).valid, (*b).valid));
}

fn os_predicate(check: *OsCheck, state: *OsState, expression: *CrustExpr,
                 bindings: *OsBinding) -> *OsTerm {
    var result: *OsTerm = os_term_new(check, null(*CrustTypeSyntax), "0", "false");
    if !os_enter(check, &(*expression).loc) { return result; }
    result = os_predicate_inner(check, state, expression, bindings);
    (*check).depth = (*check).depth - 1usize;
    return result;
}

fn os_predicate_inner(check: *OsCheck, state: *OsState, expression: *CrustExpr,
                       bindings: *OsBinding) -> *OsTerm {
    var kind: u32 = (*expression).kind;
    if kind == CRUST_E_NAME { return os_predicate_name(check, expression, bindings); }
    if kind == CRUST_E_FIELD { return os_predicate_field(check, state, expression, bindings); }
    if kind == CRUST_E_GROUP { return os_predicate(check, state, (*expression).left, bindings); }
    if kind == CRUST_E_UNARY { return os_predicate_unary(check, state, expression, bindings); }
    if kind == CRUST_E_BINARY { return os_predicate_binary(check, state, expression, bindings); }
    if kind == CRUST_E_NULL || kind == CRUST_E_INTEGER || kind == CRUST_E_BOOL {
        if kind == CRUST_E_INTEGER { os_contract_literal(check, expression); }
        var value: *OsValue = os_literal(check, expression);
        if value != null(*OsValue) {
            return os_term_new(check, (*value).syntax, os_term(check, value), "true");
        }
    } else { os_error(check, &(*expression).loc, "contract expression must be a finite pure field condition"); }
    return os_term_new(check, null(*CrustTypeSyntax), "0", "false");
}

fn os_conditions(check: *OsCheck, state: *OsState, list: *OsCondition, bindings: *OsBinding) -> *u8 {
    var result: *u8 = "true";
    while list != null(*OsCondition) && !os_failed(check) {
        var term: *OsTerm = os_predicate(check, state, (*list).expression, bindings);
        if os_failed(check) { return "false"; }
        if (*(*term).syntax).kind != CRUST_T_BOOL {
            os_error(check, &(*(*list).expression).loc, "contract condition must have Boolean type"); return "false";
        }
        result = pf_and(&(*check).proof, result, pf_and(&(*check).proof, (*term).valid, (*term).value));
        list = (*list).next;
    }
    return result;
}

fn os_record_term(check: *OsCheck, state: *OsState, schema: *OsRecord, address: *u8) -> *u8 {
    var syntax: *CrustTypeSyntax = os_syntax(check, CRUST_T_NAME, &(*(*schema).declaration).loc);
    if syntax == null(*CrustTypeSyntax) { return "false"; }
    (*syntax).name = (*(*schema).declaration).name;
    var self: *CrustName = crust_try_intern((*(*(*check).stage).resources).context, "self", 4usize);
    if self == null(*CrustName) { (*(*(*check).stage).resources).failed = true; return "false"; }
    var binding: *OsBinding = os_binding(check, self,
        rs_pointer((*(*check).stage).resources, syntax), address, null(*OsBinding));
    var term: *u8 = os_conditions(check, state, (*schema).conditions, binding);
    var field: *CrustField = (*(*schema).declaration).fields;
    while field != null(*CrustField) && !os_failed(check) {
        var entry: *PfField = os_field_state(state, field);
        term = pf_and(&(*check).proof, term, pf_select(&(*check).proof, (*entry).initialized, address));
        if os_field((*schema).references, (*field).name) != null(*OsField) {
            var value: *u8 = pf_select(&(*check).proof, (*entry).value, address);
            var target: *OsRecord = os_record((*check).stage, (*(*field).syntax_type).base);
            term = pf_and(&(*check).proof, term, pf_or(&(*check).proof,
                pf_eq(&(*check).proof, value, "0"), os_live_term(check, state, target, value)));
        }
        field = (*field).next;
    }
    return term;
}

fn os_term_new(check: *OsCheck, syntax: *CrustTypeSyntax, value: *u8, valid: *u8) -> *OsTerm {
    var term: *OsTerm = os_alloc(check, sizeof(OsTerm), alignof(OsTerm)) as *OsTerm;
    if term != null(*OsTerm) { *term = make OsTerm { syntax: syntax, value: value, valid: valid }; }
    return term;
}

fn os_predicate_operands(check: *OsCheck, expression: *CrustExpr,
                         left: *CrustTypeSyntax, right: *CrustTypeSyntax) -> bool {
    var op: u32 = (*expression).op;
    var kind: u32 = (*left).kind;
    if !rs_same((*(*check).stage).resources, left, right) || op < CRUST_OP_EQ || op > CRUST_OP_OR {
        os_error(check, &(*expression).loc, "contract comparison requires matching scalar types"); return false;
    }
    if kind >= CRUST_T_UNIT && kind != CRUST_T_POINTER {
        os_error(check, &(*expression).loc, "contract operands must be scalars or pointers"); return false;
    }
    if op == CRUST_OP_AND || op == CRUST_OP_OR {
        if kind == CRUST_T_BOOL { return true; }
    } else {
        if op == CRUST_OP_EQ || op == CRUST_OP_NE || kind < CRUST_T_BOOL { return true; }
    }
    os_error(check, &(*expression).loc, "contract operator is invalid for its operand type");
    return false;
}
