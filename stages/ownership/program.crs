fn os_driver_read(cli: *CCli, stage: *OsStage) -> bool {
    var context: *CrustContext = (*(*stage).resources).context;
    if (*cli).root != null(*CrustSource) {
        if !os_read(stage, (*cli).root, (*cli).target_begin, (*(*cli).root).size) { return false; }
    }
    var index: usize = 0usize;
    while index < (*cli).source_count {
        var source: *CrustSource = &(*cli).sources[index];
        var bytes: *u8 = null(*u8);
        var size: usize = 0usize;
        if crust0_host_read_file((*source).path, &bytes, &size) != 0i32 {
            c_driver_io_error(&(*cli).driver, "cannot read input", (*source).path, *c_driver_errno());
            return false;
        }
        (*source).bytes = crust_try_copy_string(context, bytes, size);
        (*source).size = size;
        crust0_host_free(bytes);
        if (*source).bytes == null(*u8) || !os_read(stage, source, 0usize, size) { return false; }
        index = index + 1usize;
    }
    return true;
}

fn os_lower(stage: *OsStage) -> bool {
    var resources: *RsStage = (*stage).resources;
    (*resources).delegate_memory = true;
    (*resources).delegate_return_loans = true;
    if !rs_collect(resources) || !os_prepare_outputs(stage) || !rs_publish(resources) { return false; }
    var global: *RsGlobal = (*resources).first_global;
    while global != null(*RsGlobal) && !(*resources).failed {
        if (*(*global).source).kind == CRUST_D_FUNCTION && !rs_function(resources, global) { return false; }
        global = (*global).next;
    }
    if (*resources).failed || !crust_check((*resources).context) { return false; }
    if !rs_check_constants(resources) { return false; }
    os_erase_domains(stage);
    return true;
}

fn os_verify(stage: *OsStage) -> bool { return os_check(stage); }

fn os_driver_emit(cli: *CCli, resources: *RsStage) -> i32 {
    if !c_driver_exports(cli) { return 1i32; }
    if (*cli).mode == 3u32 { return 0i32; }
    if !c_driver_names(&(*cli).driver) { return 1i32; }
    var entry: *CrustDecl = null(*CrustDecl);
    if !(*cli).library {
        entry = resource_driver_entry(cli, resources);
        if entry == null(*CrustDecl) { return 1i32; }
    }
    if (*cli).mode == 4u32 {
        if c_emit_with_body(&(*cli).stage, entry, rs_c_body, resources as *u8) { return 0i32; }
        return 1i32;
    }
    return c_backend_build_with_body((*resources).context, entry, &(*cli).options, rs_c_body, resources as *u8);
}

fn os_driver_build(cli: *CCli, trusted: *CrustSource, count: usize) -> i32 {
    var resources: RsStage = uninit;
    rs_init(&resources, (*cli).stage.status.context);
    var stage: OsStage = uninit;
    os_init(&stage, &resources);
    var result: i32 = 1i32;
    if os_trust_sources(&stage, trusted, count) && os_driver_read(cli, &stage) && os_lower(&stage) && os_verify(&stage) {
        result = os_driver_emit(cli, &resources);
    }
    return result;
}

// Check untrusted bodies against declared interfaces before producing output.
// Keep source and arguments alive until return. Retain diagnostics in context.
fn ownership_program(request: *CrustBuild, trusted: *CrustSource, count: usize) -> i32 {
    var cli: CCli = uninit;
    var success: bool = c_driver_init(&cli, (*request).context, (*request).argc);
    cli.root = (*request).source;
    cli.target_begin = (*request).target_begin;
    var result: i32 = 1i32;
    if success && c_driver_parse(&cli, (*request).argc, (*request).argv, 0i32) {
        result = os_driver_build(&cli, trusted, count);
    }
    c_stage_destroy(&cli.stage);
    return result;
}

fn os_erase_domains(stage: *OsStage) -> unit {
    // Domain declarations remain in the source interface, with no target storage.
    var unit_value: *CrustUnit = (*(*(*stage).resources).context).units;
    while unit_value != null(*CrustUnit) {
        var position: **CrustDecl = &(*unit_value).declarations;
        while *position != null(*CrustDecl) {
            var declaration: *CrustDecl = *position;
            if crust_map_get(&(*stage).domains, (*declaration).name as usize) != null(*u8) {
                *position = (*declaration).next;
            } else { position = &(*declaration).next; }
        }
        unit_value = (*unit_value).next;
    }
}
