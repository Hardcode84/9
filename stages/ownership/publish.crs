fn os_publish_object(cli: *CCli, stage: *OsStage, work: *OsLibraryWork,
                      interface_source: *CrustSource, object: *CrustSource) -> bool {
    var context: *CrustContext = (*(*stage).resources).context;
    var buffer: CBuffer = uninit;
    c_driver_buffer(&(*cli).stage.status, &buffer);
    if !os_library_sources(stage, work) || !os_interface_emit(stage, &buffer, (*work).provider) { return false; }
    *interface_source = make CrustSource {
        path: "ownership-interface", bytes: buffer.data, size: buffer.size, identity: 0u64
    };
    (*cli).options.mode = 1u32;
    (*cli).options.output = (*work).files.checksum;
    if !c_driver_names(&(*cli).driver) { return false; }
    if c_backend_build_with_body(context, null(*CrustDecl), &(*cli).options,
                                rs_c_body, (*stage).resources as *u8) != 0i32 { return false; }
    return cache_read(context, (*work).files.checksum, object);
}

fn os_publish_bundle(cli: *CCli, stage: *OsStage, directory: *u8,
                      work: *OsLibraryWork, result: *OwnershipLibrary) -> bool {
    var interface_source: CrustSource = uninit;
    var object: CrustSource = uninit;
    if !os_publish_object(cli, stage, work, &interface_source, &object) { return false; }
    var buffer: CBuffer = uninit;
    c_driver_buffer(&(*cli).stage.status, &buffer);
    if !os_library_pack(&buffer, work, &interface_source, &object) { return false; }
    var source: CrustSource = make CrustSource {
        path: "ownership-library-v1", bytes: buffer.data, size: buffer.size, identity: 0u64
    };
    return os_library_publish_bytes((*(*stage).resources).context, directory, work, &source, result);
}

fn os_publish_build(cli: *CCli, directory: *u8, result: *OwnershipLibrary) -> bool {
    var context: *CrustContext = (*cli).stage.status.context;
    if !os_publish_options(cli) { return false; }
    var resources: RsStage = uninit;
    rs_init(&resources, context);
    var stage: OsStage = uninit;
    os_init(&stage, &resources);
    var relations: RlStage = uninit;
    rl_init(&relations, context);
    var work: OsLibraryWork = uninit;
    var success: bool = os_library_begin(context, directory, &work) &&
        os_driver_read(cli, &stage) && os_lower(&stage, &relations) && os_verify(&stage, &relations);
    if success { success = os_publish_bundle(cli, &stage, directory, &work, result); }
    if !cache_cleanup(context, &work.files) { success = false; }
    rl_destroy(&relations);
    return success;
}

fn os_publish_options(cli: *CCli) -> bool {
    if (*cli).mode != 0u32 || (*cli).library || (*cli).export_count != 0usize ||
       (*cli).options.output != null(*u8) || (*cli).options.symbols != null(*u8) ||
       (*cli).options.ldflag_count != 0usize || !c_equal((*cli).entry_name, "main") {
        return os_library_error((*cli).stage.status.context,
            "ownership publication accepts provider sources and C flags; output and exports come from the library contract");
    }
    return true;
}

// Publish only after checking every provider body. Retain the receipt in trusted
// build state and keep the cache directory free of untrusted writers.
fn ownership_publish(request: *CrustBuild, directory: *u8, result: *OwnershipLibrary) -> i32 {
    *result = make OwnershipLibrary { artifact: null(*u8), digest: null(*u8) };
    var cli: CCli = uninit;
    var success: bool = c_driver_init(&cli, (*request).context, (*request).argc);
    cli.root = (*request).source;
    cli.target_begin = (*request).target_begin;
    if success { success = c_driver_parse(&cli, (*request).argc, (*request).argv, 0i32); }
    if success { success = os_publish_build(&cli, directory, result); }
    c_stage_destroy(&cli.stage);
    if success { return 0i32; }
    return 1i32;
}
