fn os_solver_start(check: *OsCheck, location: *CrustLoc) -> bool {
    var stage: *OsStage = (*check).stage;
    if (*stage).solver != null(*u8) { return true; }
    var config: *u8 = pf_z3_config();
    if config == null(*u8) { os_error(check, location, "cannot allocate proof solver configuration"); return false; }
    pf_z3_budget(config, 10000u32);
    (*stage).solver = pf_z3_context(config);
    pf_z3_config_drop(config);
    if (*stage).solver == null(*u8) { os_error(check, location, "cannot allocate proof solver context"); return false; }
    pf_z3_errors((*stage).solver, null(fn(*u8, u32) -> unit));
    return true;
}

fn os_solver_drop(stage: *OsStage) -> unit {
    if (*stage).solver != null(*u8) { pf_z3_context_drop((*stage).solver); }
    (*stage).solver = null(*u8);
    (*stage).sent = 0usize;
}

fn os_query(check: *OsCheck, state: *OsState, term: *u8) -> *u8 {
    var stage: *OsStage = (*check).stage;
    var buffer: *CBuffer = &(*check).proof.query;
    (*buffer).size = 0usize;
    if (*stage).solver == null(*u8) { c_buffer_text(buffer, "(set-logic ALL)\n"); }
    var declarations: *CBuffer = &(*check).proof.declarations;
    c_buffer_bytes(buffer, (*declarations).data + (*stage).sent as isize, (*declarations).size - (*stage).sent);
    (*stage).sent = (*declarations).size;
    c_buffer_text(buffer, "(push)\n");
    pf_assertions(buffer, (*check).proof.premises);
    c_buffer_text(buffer, "(assert ");
    c_buffer_text(buffer, (*state).proof.assumptions);
    c_buffer_text(buffer, ")\n(assert (not ");
    c_buffer_text(buffer, term);
    c_buffer_text(buffer, "))\n(check-sat)\n(pop)\n");
    return c_buffer_end(buffer);
}

fn os_number(check: *OsCheck, value: u64) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(&(*check).proof, &buffer);
    c_buffer_number(&buffer, value);
    return c_buffer_end(&buffer);
}

fn os_sort(syntax: *CrustTypeSyntax) -> *u8 {
    if (*syntax).kind == CRUST_T_BOOL { return "Bool"; }
    return "Int";
}

fn os_array_sort(check: *OsCheck, syntax: *CrustTypeSyntax) -> *u8 {
    if (*syntax).kind == CRUST_T_BOOL { return "(Array Int Bool)"; }
    return "(Array Int Int)";
}

fn os_term(check: *OsCheck, value: *OsValue) -> *u8 {
    if value == null(*OsValue) { return null(*u8); }
    if (*value).object != null(*OsObject) { return (*(*value).object).term; }
    if (*value).term == null(*u8) {
        if (*value).pointer { (*value).term = "0"; }
        else { (*value).term = pf_fresh(&(*check).proof, os_sort((*value).syntax)); }
    }
    return (*value).term;
}

fn os_integer_wrap(check: *OsCheck, term: *u8, syntax: *CrustTypeSyntax) -> *u8 {
    var type: *CrustType = rs_storage_type((*(*check).stage).resources, syntax);
    if type == null(*CrustType) { return null(*u8); }
    var bits: u64 = (*type).size * 8u64;
    var modulus: *u8 = "18446744073709551616";
    if bits < 64u64 { modulus = os_number(check, 1u64 << bits); }
    var reduced: *u8 = pf_binary(&(*check).proof, "mod", term, modulus);
    if ((*syntax).kind & 1u32) != 0u32 { return reduced; }
    return pf_ite(&(*check).proof,
        pf_binary(&(*check).proof, "<", reduced, os_number(check, 1u64 << (bits - 1u64))),
        reduced, pf_binary(&(*check).proof, "-", reduced, modulus));
}

fn os_compare_term(check: *OsCheck, operation: u32, a: *u8, b: *u8) -> *u8 {
    if operation == CRUST_OP_EQ { return pf_eq(&(*check).proof, a, b); }
    if operation == CRUST_OP_NE { return pf_not(&(*check).proof, pf_eq(&(*check).proof, a, b)); }
    if operation == CRUST_OP_AND { return pf_and(&(*check).proof, a, b); }
    if operation == CRUST_OP_OR { return pf_or(&(*check).proof, a, b); }
    if operation == CRUST_OP_LT { return pf_binary(&(*check).proof, "<", a, b); }
    if operation == CRUST_OP_LE { return pf_binary(&(*check).proof, "<=", a, b); }
    if operation == CRUST_OP_GT { return pf_binary(&(*check).proof, ">", a, b); }
    return pf_binary(&(*check).proof, ">=", a, b);
}

fn os_binary_term(check: *OsCheck, operation: u32, a: *u8, b: *u8, syntax: *CrustTypeSyntax) -> *u8 {
    if operation >= CRUST_OP_EQ && operation <= CRUST_OP_OR { return os_compare_term(check, operation, a, b); }
    var name: *u8 = null(*u8);
    if operation == CRUST_OP_ADD { name = "+"; }
    if operation == CRUST_OP_SUB { name = "-"; }
    if operation == CRUST_OP_MUL { name = "*"; }
    if name != null(*u8) {
        return os_integer_wrap(check, pf_binary(&(*check).proof, name, a, b), syntax);
    }
    // The typed operation executes normally. This abstraction retains no
    // relational fact about its result.
    return pf_fresh(&(*check).proof, os_sort(syntax));
}

fn os_assume(check: *OsCheck, state: *OsState, term: *u8) -> unit {
    if !os_failed(check) { pf_assume(&(*check).proof, &(*state).proof, term); }
}

fn os_binding(check: *OsCheck, name: *CrustName, syntax: *CrustTypeSyntax,
              value: *u8, next: *OsBinding) -> *OsBinding {
    var result: *OsBinding = os_alloc(check, sizeof(OsBinding), alignof(OsBinding)) as *OsBinding;
    if result != null(*OsBinding) {
        *result = make OsBinding { name: name, term: make OsTerm { syntax: syntax, value: value, valid: "true" }, next: next, value: null(*OsValue) };
    }
    return result;
}

fn os_field_state(state: *OsState, field: *CrustField) -> *PfField {
    var entry: *PfField = (*state).proof.fields;
    while entry != null(*PfField) {
        if (*entry).field == field { return entry; }
        entry = (*entry).next;
    }
    return null(*PfField);
}

fn os_entails(check: *OsCheck, state: *OsState, term: *u8, location: *CrustLoc) -> bool {
    if os_failed(check) { return false; }
    os_ground(check, state);
    var query: *u8 = os_query(check, state, term);
    if os_failed(check) || !os_solver_start(check, location) { return false; }
    var stage: *OsStage = (*check).stage;
    var output: *u8 = pf_z3_evaluate((*stage).solver, query);
    var result: i32 = pf_z3_result((*stage).proof.status.context, (*stage).solver, output, location);
    if result < 0i32 { (*stage).proof.status.failed = true; }
    return result == 0i32;
}

fn os_prove(check: *OsCheck, state: *OsState, term: *u8, location: *CrustLoc, message: *u8) -> bool {
    if !os_entails(check, state, term, location) {
        if !os_failed(check) { os_error(check, location, message); }
        return false;
    }
    return !os_failed(check);
}

fn os_observe(check: *OsCheck, state: *OsState, value: *u8) -> unit {
    if os_failed(check) { return; }
    var term: *PfTerm = (*state).proof.terms;
    while term != null(*PfTerm) {
        if c_equal((*term).value, value) { return; }
        term = (*term).next;
    }
    pf_observe(&(*check).proof, &(*state).proof, value);
}

fn os_cast_term(check: *OsCheck, value: *OsValue, target: *CrustTypeSyntax) -> *u8 {
    var term: *u8 = os_term(check, value);
    if (*target).kind == CRUST_T_BOOL {
        if (*(*value).syntax).kind == CRUST_T_BOOL { return term; }
        return pf_not(&(*check).proof, pf_eq(&(*check).proof, term, "0"));
    }
    if (*(*value).syntax).kind == CRUST_T_BOOL { term = pf_ite(&(*check).proof, term, "1", "0"); }
    return os_integer_wrap(check, term, target);
}

fn os_contract_literal(check: *OsCheck, expression: *CrustExpr) -> unit {
    var syntax: *CrustTypeSyntax = os_syntax(check, (*expression).literal_type, &(*expression).loc);
    if syntax == null(*CrustTypeSyntax) { return; }
    var type: *CrustType = rs_storage_type((*(*check).stage).resources, syntax);
    if type == null(*CrustType) { return; }
    var bits: u64 = (*type).size * 8u64;
    if ((*syntax).kind & 1u32) == 0u32 { bits = bits - 1u64; }
    if bits < 64u64 && (*expression).integer >= (1u64 << bits) {
        os_error(check, &(*expression).loc, "contract integer literal is outside its declared type");
    }
}
