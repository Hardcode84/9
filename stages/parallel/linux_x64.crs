// Linux x86-64 pthread_t is an unsigned long. All callbacks must be native.
extern fn parallel_create(
    thread: *usize,
    attributes: *u8,
    entry: fn(*u8) -> *u8,
    data: *u8
) -> i32 = "pthread_create";
extern fn parallel_join(thread: usize, result: **u8) -> i32 = "pthread_join";

fn parallel_start(worker: *ParallelWorker) -> bool {
    return parallel_create(&worker -> thread, null(*u8), parallel_execute, worker as *u8) == 0i32;
}
fn parallel_finish(thread: usize) -> bool {
    return parallel_join(thread, null(**u8)) == 0i32;
}
