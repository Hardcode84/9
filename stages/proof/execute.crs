fn pf_custom_store(run: *PfRun, state: *PfState, statement: *CrustStmt,
                   expression: *CrustExpr) -> unit {
    var stage: *PfStage = (*run).stage;
    var address: *u8 = (*stage).place(run, state, expression, "true");
    if address == null(*u8) {
        pf_error(stage, &(*statement).loc, "proof policy rejected the assignment place");
        return;
    }
    var value: *u8 = pf_expression(run, state, (*statement).value, "true");
    if pf_failed(run) { return; }
    pf_policy_result(run, (*stage).store(run, state, expression, address, value, &(*statement).loc),
                     &(*statement).loc, "proof policy rejected the assignment");
}

fn pf_assign(run: *PfRun, state: *PfState, statement: *CrustStmt) -> unit {
    var expression: *CrustExpr = pf_ungroup(run, (*statement).expr);
    if pf_failed(run) { return; }
    if (*expression).kind == CRUST_E_NAME {
        var value: *u8 = pf_expression(run, state, (*statement).value, "true");
        pf_bind(run, state, (*expression).symbol, value);
    } else if (*(*run).stage).store != null(fn(*PfRun, *PfState, *CrustExpr, *u8, *u8, *CrustLoc) -> bool) {
        pf_custom_store(run, state, statement, expression);
    } else if (*expression).kind == CRUST_E_FIELD {
        var place: PfPlace = uninit;
        pf_place(run, state, expression, "true", &place);
        var value: *u8 = pf_expression(run, state, (*statement).value, "true");
        if pf_failed(run) { return; }
        place.field = pf_field(run, state, (*expression).field);
        pf_access(run, state, &place, "true", true, &(*statement).loc);
        if pf_failed(run) { return; }
        pf_field_set(run, state, (*place.field).field,
            pf_store(run, (*place.field).value, place.target, value),
            pf_store(run, (*place.field).initialized, place.target, "true"));
    } else {
        pf_error((*run).stage, &(*statement).loc, "proof assignment requires a local or contracted field");
    }
}

fn pf_variable(run: *PfRun, state: *PfState, statement: *CrustStmt) -> unit {
    if (*statement).uninitialized {
        pf_error((*run).stage, &(*statement).loc, "proof does not support uninitialized locals");
        return;
    }
    if pf_value_sort(run, (*(*statement).symbol).type) == null(*u8) {
        pf_error((*run).stage, &(*statement).loc, "proof does not support this local type");
        return;
    }
    var value: *u8 = pf_expression(run, state, (*statement).value, "true");
    pf_bind(run, state, (*statement).symbol, value);
}

fn pf_call_results(run: *PfRun, state: *PfState, expression: *CrustExpr, stack: *PfCall) -> *PfPath {
    var declaration: *CrustDecl = pf_callee(run, expression, stack);
    if pf_failed(run) { return null(*PfPath); }
    if (*declaration).kind == CRUST_D_EXTERN {
        (*state).result = pf_external_value(run, state, expression, "true");
        return pf_path(run, state);
    }
    var called: *PfState = pf_arguments(run, state, expression, declaration, "true");
    if pf_failed(run) { return null(*PfPath); }
    var frame: PfCall = make PfCall { declaration: declaration, parent: stack, guard: "true" };
    (*called).result = null(*u8);
    var result: *PfPath = pf_statement(run, called, pf_body((*run).stage, declaration), &frame);
    var path: *PfPath = result;
    while path != null(*PfPath) {
        (*(*path).state).env = (*state).env;
        if (*(*path).state).flow == PF_RETURN { (*(*path).state).flow = PF_NORMAL; }
        path = (*path).next;
    }
    return result;
}

fn pf_call(run: *PfRun, state: *PfState, expression: *CrustExpr, stack: *PfCall) -> *PfPath {
    var saved: *u8 = (*state).result;
    var result: *PfPath = pf_call_results(run, state, expression, stack);
    var path: *PfPath = result;
    while path != null(*PfPath) {
        (*(*path).state).result = saved;
        path = (*path).next;
    }
    return result;
}

fn pf_join_paths(left: *PfPath, right: *PfPath) -> *PfPath {
    if left == null(*PfPath) { return right; }
    var tail: *PfPath = left;
    while (*tail).next != null(*PfPath) { tail = (*tail).next; }
    (*tail).next = right;
    return left;
}

fn pf_branch(run: *PfRun, state: *PfState, statement: *CrustStmt, stack: *PfCall) -> *PfPath {
    var condition: *u8 = pf_expression(run, state, (*statement).expr, "true");
    var yes: *PfState = pf_fork(run, state);
    var no: *PfState = pf_fork(run, state);
    if pf_failed(run) { return null(*PfPath); }
    pf_assume(run, yes, condition);
    pf_assume(run, no, pf_not(run, condition));
    var yes_live: bool = pf_reachable(run, yes, &(*statement).loc);
    var no_live: bool = pf_reachable(run, no, &(*statement).loc);
    if pf_failed(run) { return null(*PfPath); }
    if yes_live && no_live && !pf_split(run, &(*statement).loc) { return null(*PfPath); }
    var left: *PfPath = null(*PfPath);
    var right: *PfPath = null(*PfPath);
    if yes_live { left = pf_statement(run, yes, (*statement).body, stack); }
    if no_live {
        if (*statement).otherwise == null(*CrustStmt) { right = pf_path(run, no); }
        else { right = pf_statement(run, no, (*statement).otherwise, stack); }
    }
    return pf_join_paths(left, right);
}

fn pf_block(run: *PfRun, state: *PfState, statement: *CrustStmt, stack: *PfCall) -> *PfPath {
    if !pf_scope(run, state, statement, true) { return null(*PfPath); }
    var paths: *PfPath = pf_path(run, state);
    var child: *CrustStmt = (*statement).body;
    while child != null(*CrustStmt) && !pf_failed(run) {
        var current: *PfPath = paths;
        paths = null(*PfPath);
        while current != null(*PfPath) && !pf_failed(run) {
            paths = pf_join_paths(paths, pf_statement(run, (*current).state, child, stack));
            current = (*current).next;
        }
        child = (*child).next;
    }
    var path: *PfPath = paths;
    while path != null(*PfPath) && !pf_failed(run) {
        if !pf_scope(run, (*path).state, statement, false) { return null(*PfPath); }
        path = (*path).next;
    }
    return paths;
}

fn pf_terminal(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *PfPath {
    var kind: u32 = (*statement).kind;
    if kind == CRUST_S_RETURN {
        if (*statement).expr != null(*CrustExpr) {
            (*state).result = pf_expression(run, state, (*statement).expr, "true");
        }
        (*state).flow = PF_RETURN;
        return pf_path(run, state);
    }
    if kind == CRUST_S_BREAK { (*state).flow = PF_BREAK; return pf_path(run, state); }
    if kind == CRUST_S_CONTINUE { (*state).flow = PF_CONTINUE; return pf_path(run, state); }
    if kind == CRUST_S_TRAP { (*state).flow = PF_TRAP; return pf_path(run, state); }
    pf_error((*run).stage, &(*statement).loc, "proof does not support this statement");
    return null(*PfPath);
}

fn pf_statement_inner(run: *PfRun, state: *PfState, statement: *CrustStmt, stack: *PfCall) -> *PfPath {
    var kind: u32 = (*statement).kind;
    if kind == CRUST_S_BLOCK { return pf_block(run, state, statement, stack); }
    if kind == CRUST_S_IF { return pf_branch(run, state, statement, stack); }
    if kind == CRUST_S_WHILE { return pf_while(run, state, statement, stack); }
    if kind == CRUST_S_VAR { pf_variable(run, state, statement); return pf_path(run, state); }
    if kind == CRUST_S_ASSIGN { pf_assign(run, state, statement); return pf_path(run, state); }
    if kind == CRUST_S_EXPR {
        var expression: *CrustExpr = pf_ungroup(run, (*statement).expr);
        if pf_failed(run) { return null(*PfPath); }
        if (*expression).kind == CRUST_E_CALL { return pf_call(run, state, expression, stack); }
    }
    return pf_terminal(run, state, statement);
}

fn pf_statement_policy(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *PfPath {
    if (*(*run).stage).statement == null(fn(*PfRun, *PfState, *CrustStmt) -> *PfPath) {
        return pf_statement_inner(run, state, statement, (*run).calls);
    }
    return (*(*run).stage).statement(run, state, statement);
}

fn pf_statement(run: *PfRun, state: *PfState, statement: *CrustStmt, stack: *PfCall) -> *PfPath {
    if !pf_enter(run, &(*statement).loc) { return null(*PfPath); }
    var saved: *PfCall = (*run).calls;
    (*run).calls = stack;
    var result: *PfPath = null(*PfPath);
    if (*state).flow != PF_NORMAL {
        result = pf_path(run, state);
    } else {
        result = pf_statement_policy(run, state, statement);
    }
    (*run).calls = saved;
    (*run).depth = (*run).depth - 1usize;
    return result;
}

fn pf_loop_collect(loop: *PfLoop, paths: *PfPath) -> unit {
    while paths != null(*PfPath) {
        var next: *PfPath = (*paths).next;
        (*paths).next = null(*PfPath);
        var state: *PfState = (*paths).state;
        if (*state).flow == PF_NORMAL || (*state).flow == PF_CONTINUE {
            (*state).flow = PF_NORMAL;
            (*loop).active = pf_join_paths((*loop).active, paths);
        } else {
            if (*state).flow == PF_BREAK { (*state).flow = PF_NORMAL; }
            (*loop).exits = pf_join_paths((*loop).exits, paths);
        }
        paths = next;
    }
}

fn pf_loop_step(run: *PfRun, state: *PfState, statement: *CrustStmt,
                stack: *PfCall, loop: *PfLoop, iteration: usize) -> unit {
    var condition: *u8 = pf_expression(run, state, (*statement).expr, "true");
    if pf_failed(run) { return; }
    if iteration == (*(*run).stage).max_iterations {
        // The cutoff condition is a goal, never an assumption.
        pf_goal(run, state, pf_not(run, condition), &(*statement).loc);
        (*loop).exits = pf_join_paths((*loop).exits, pf_path(run, state));
        return;
    }
    var exit: *PfState = pf_fork(run, state);
    if pf_failed(run) { return; }
    pf_assume(run, exit, pf_not(run, condition));
    pf_assume(run, state, condition);
    var body_live: bool = pf_reachable(run, state, &(*statement).loc);
    var exit_live: bool = pf_reachable(run, exit, &(*statement).loc);
    if pf_failed(run) { return; }
    if body_live && exit_live && !pf_split(run, &(*statement).loc) { return; }
    if exit_live { (*loop).exits = pf_join_paths((*loop).exits, pf_path(run, exit)); }
    if body_live { pf_loop_collect(loop, pf_statement(run, state, (*statement).body, stack)); }
}

fn pf_while(run: *PfRun, state: *PfState, statement: *CrustStmt, stack: *PfCall) -> *PfPath {
    var loop: PfLoop = make PfLoop { active: pf_path(run, state), exits: null(*PfPath) };
    var iteration: usize = 0usize;
    while loop.active != null(*PfPath) && !pf_failed(run) {
        var path: *PfPath = loop.active;
        loop.active = null(*PfPath);
        while path != null(*PfPath) && !pf_failed(run) {
            pf_loop_step(run, (*path).state, statement, stack, &loop, iteration);
            path = (*path).next;
        }
        iteration = iteration + 1usize;
    }
    return loop.exits;
}
