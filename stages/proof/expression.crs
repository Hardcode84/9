fn pf_access(run: *PfRun, state: *PfState, place: *PfPlace,
             guard: *u8, writing: bool, location: *CrustLoc) -> unit {
    if pf_failed(run) { return; }
    if (*(*run).stage).access == null(fn(*PfRun, *PfState, *CrustField, *u8, bool, *CrustLoc) -> *u8) {
        pf_error((*run).stage, location, "proof field access requires a permission callback");
        return;
    }
    var permission: *u8 = (*(*run).stage).access(
        run, state, (*(*place).field).field, (*place).target, writing, location);
    if permission == null(*u8) {
        pf_error((*run).stage, location, "proof policy did not supply an access permission");
        return;
    }
    if !writing {
        permission = pf_and(run, permission, pf_select(run, (*(*place).field).initialized, (*place).target));
    }
    pf_goal(run, state, pf_implies(run, guard, permission), location);
    pf_observe(run, state, (*place).target);
}

fn pf_object(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    if !pf_enter(run, &(*expression).loc) { return null(*u8); }
    var value: *u8 = null(*u8);
    if (*expression).kind == CRUST_E_GROUP {
        value = pf_object(run, state, (*expression).left, guard);
    } else if (*expression).kind == CRUST_E_UNARY && (*expression).op == CRUST_OP_DEREF {
        value = pf_expression(run, state, (*expression).left, guard);
    } else {
        pf_error((*run).stage, &(*expression).loc, "proof requires a field of a dereferenced pointer");
    }
    (*run).depth = (*run).depth - 1usize;
    return value;
}

fn pf_place(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8, result: *PfPlace) -> unit {
    *result = make PfPlace { field: null(*PfField), target: null(*u8) };
    if pf_sort((*(*expression).field).type) == null(*u8) {
        pf_error((*run).stage, &(*expression).loc, "proof supports only pointer and Boolean fields");
        return;
    }
    (*result).field = pf_field(run, state, (*expression).field);
    if pf_failed(run) { return; }
    (*result).target = pf_object(run, state, (*expression).left, guard);
    return;
}

fn pf_field_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var place: PfPlace = uninit;
    pf_place(run, state, expression, guard, &place);
    pf_access(run, state, &place, guard, false, &(*expression).loc);
    if pf_failed(run) { return null(*u8); }
    return pf_select(run, (*place.field).value, place.target);
}

fn pf_binary_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var op: u32 = (*expression).op;
    if op != CRUST_OP_EQ && op != CRUST_OP_NE && op != CRUST_OP_AND && op != CRUST_OP_OR {
        pf_error((*run).stage, &(*expression).loc, "proof does not support this binary operator");
        return null(*u8);
    }
    var left: *u8 = pf_expression(run, state, (*expression).left, guard);
    var right_guard: *u8 = guard;
    if op == CRUST_OP_AND { right_guard = pf_and(run, guard, left); }
    if op == CRUST_OP_OR { right_guard = pf_and(run, guard, pf_not(run, left)); }
    var right: *u8 = pf_expression(run, state, (*expression).right, right_guard);
    if op == CRUST_OP_EQ { return pf_eq(run, left, right); }
    if op == CRUST_OP_NE { return pf_not(run, pf_eq(run, left, right)); }
    if op == CRUST_OP_AND { return pf_and(run, left, right); }
    return pf_or(run, left, right);
}

fn pf_name_value(run: *PfRun, state: *PfState, expression: *CrustExpr) -> *u8 {
    var value: *u8 = pf_binding(state, (*expression).symbol);
    if value == null(*u8) {
        pf_error((*run).stage, &(*expression).loc, "proof local is uninitialized or has no symbolic value");
    }
    return value;
}

fn pf_expression_inner(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var kind: u32 = (*expression).kind;
    if kind == CRUST_E_GROUP { return pf_expression(run, state, (*expression).left, guard); }
    if kind == CRUST_E_NAME { return pf_name_value(run, state, expression); }
    if kind == CRUST_E_NULL { return "0"; }
    if kind == CRUST_E_BOOL {
        if (*expression).integer == 0u64 { return "false"; }
        return "true";
    }
    if kind == CRUST_E_CALL { return pf_value_call(run, state, expression, guard); }
    if kind == CRUST_E_FIELD { return pf_field_value(run, state, expression, guard); }
    if kind == CRUST_E_BINARY { return pf_binary_value(run, state, expression, guard); }
    if kind == CRUST_E_UNARY && (*expression).op == CRUST_OP_NOT {
        return pf_not(run, pf_expression(run, state, (*expression).left, guard));
    }
    pf_error((*run).stage, &(*expression).loc, "proof does not support this expression");
    return null(*u8);
}

fn pf_expression(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    if !pf_enter(run, &(*expression).loc) { return null(*u8); }
    var result: *u8 = null(*u8);
    if (*(*run).stage).value != null(fn(*PfRun, *PfState, *CrustExpr, *u8) -> *u8) {
        result = (*(*run).stage).value(run, state, expression, guard);
    }
    if result == null(*u8) && !pf_failed(run) {
        result = pf_expression_inner(run, state, expression, guard);
    }
    (*run).depth = (*run).depth - 1usize;
    return result;
}

fn pf_function(run: *PfRun, declaration: *CrustDecl, location: *CrustLoc) -> bool {
    if (*declaration).kind != CRUST_D_FUNCTION || !(*declaration).checked {
        pf_error((*run).stage, location, "proof requires a checked function body");
        return false;
    }
    if (*(*(*declaration).type).base).kind != CRUST_T_UNIT &&
       pf_value_sort(run, (*(*declaration).type).base) == null(*u8) {
        pf_error((*run).stage, location, "proof does not support this function result type");
        return false;
    }
    return true;
}

fn pf_callee(run: *PfRun, expression: *CrustExpr, stack: *PfCall) -> *CrustDecl {
    var name: *CrustExpr = pf_ungroup(run, (*expression).left);
    if pf_failed(run) { return null(*CrustDecl); }
    if (*name).kind != CRUST_E_NAME || (*(*name).symbol).kind != CRUST_SYM_FUNCTION {
        pf_error((*run).stage, &(*expression).loc, "proof requires a direct call to a checked body");
        return null(*CrustDecl);
    }
    var declaration: *CrustDecl = (*(*name).symbol).decl;
    if (*declaration).kind == CRUST_D_EXTERN { return declaration; }
    if !pf_function(run, declaration, &(*expression).loc) { return null(*CrustDecl); }
    while stack != null(*PfCall) {
        if (*stack).declaration == declaration {
            pf_error((*run).stage, &(*expression).loc, "recursive proof calls require a modular contract");
            return null(*CrustDecl);
        }
        stack = (*stack).parent;
    }
    return declaration;
}

fn pf_arguments(run: *PfRun, state: *PfState, expression: *CrustExpr,
                declaration: *CrustDecl, guard: *u8) -> *PfState {
    var bindings: PfState = *state;
    bindings.env = null(*PfBinding);
    var parameter: *CrustParam = (*declaration).params;
    var index: usize = 0usize;
    while parameter != null(*CrustParam) {
        if pf_value_sort(run, (*parameter).type) == null(*u8) {
            pf_error((*run).stage, &(*parameter).loc, "proof supports only pointer and Boolean parameters");
            return null(*PfState);
        }
        var value: *u8 = pf_expression(run, state, (*expression).args[index], guard);
        pf_bind(run, &bindings, (*parameter).symbol, value);
        if pf_failed(run) { return null(*PfState); }
        parameter = (*parameter).next;
        index = index + 1usize;
    }
    var called: *PfState = pf_fork(run, state);
    if called != null(*PfState) { (*called).env = bindings.env; }
    return called;
}


fn pf_external_value(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var stage: *PfStage = (*run).stage;
    if (*run).projector_depth != 0usize {
        pf_error(stage, &(*expression).loc, "proof projector cannot call an external function");
        return null(*u8);
    }
    if (*stage).external == null(fn(*PfRun, *PfState, *CrustExpr, *u8) -> *u8) {
        pf_error(stage, &(*expression).loc, "external proof call requires an explicit contract");
        return null(*u8);
    }
    var value: *u8 = (*stage).external(run, state, expression, guard);
    if value == null(*u8) {
        pf_error(stage, &(*expression).loc, "proof policy rejected the external call");
    }
    return value;
}

fn pf_projector_body(run: *PfRun, declaration: *CrustDecl) -> *CrustStmt {
    var body: *CrustStmt = (*declaration).body;
    if (*body).kind == CRUST_S_BLOCK { body = (*body).body; }
    if body != null(*CrustStmt) {
        if (*body).kind == CRUST_S_RETURN && (*body).expr != null(*CrustExpr) &&
           (*body).next == null(*CrustStmt) { return body; }
    }
    pf_error((*run).stage, &(*declaration).loc,
             "proof value call requires one unconditional return expression");
    return null(*CrustStmt);
}

fn pf_projector(run: *PfRun, state: *PfState, expression: *CrustExpr,
                declaration: *CrustDecl, guard: *u8) -> *u8 {
    var body: *CrustStmt = pf_projector_body(run, declaration);
    if pf_failed(run) { return null(*u8); }
    var called: *PfState = pf_arguments(run, state, expression, declaration, guard);
    if pf_failed(run) { return null(*u8); }
    var frame: PfCall = make PfCall { declaration: declaration, parent: (*run).calls, guard: guard };
    (*run).calls = &frame;
    if !pf_scope(run, called, (*declaration).body, true) {
        (*run).calls = frame.parent;
        return null(*u8);
    }
    (*run).projector_depth = (*run).projector_depth + 1usize;
    var value: *u8 = pf_expression(run, called, (*body).expr, guard);
    (*run).projector_depth = (*run).projector_depth - 1usize;
    (*called).result = value;
    (*called).flow = PF_RETURN;
    var success: bool = !pf_failed(run) && pf_scope(run, called, (*declaration).body, false);
    (*run).calls = frame.parent;
    if !success { return null(*u8); }
    (*called).env = (*state).env;
    (*called).result = (*state).result;
    (*called).flow = (*state).flow;
    *state = *called;
    return value;
}

fn pf_value_call(run: *PfRun, state: *PfState, expression: *CrustExpr, guard: *u8) -> *u8 {
    var declaration: *CrustDecl = pf_callee(run, expression, (*run).calls);
    if pf_failed(run) { return null(*u8); }
    if (*declaration).kind == CRUST_D_EXTERN { return pf_external_value(run, state, expression, guard); }
    return pf_projector(run, state, expression, declaration, guard);
}
