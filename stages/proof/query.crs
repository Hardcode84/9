fn pf_assertions(buffer: *CBuffer, fact: *PfTerm) -> unit {
    while fact != null(*PfTerm) {
        c_buffer_text(buffer, "(assert ");
        c_buffer_text(buffer, (*fact).value);
        c_buffer_text(buffer, ")\n");
        fact = (*fact).next;
    }
}

fn pf_query_start(run: *PfRun) -> *CBuffer {
    var buffer: *CBuffer = &(*run).query;
    (*buffer).size = 0usize;
    c_buffer_text(buffer, "(set-logic ALL)\n");
    c_buffer_text(buffer, (*(*run).stage).preamble);
    c_buffer_bytes(buffer, (*run).declarations.data, (*run).declarations.size);
    pf_assertions(buffer, (*run).premises);
    return buffer;
}

fn pf_query(run: *PfRun, goal: *PfGoal) -> *u8 {
    var buffer: *CBuffer = pf_query_start(run);
    c_buffer_text(buffer, "(assert ");
    c_buffer_text(buffer, (*goal).assumptions);
    c_buffer_text(buffer, ")\n(assert (not ");
    c_buffer_text(buffer, (*goal).value);
    c_buffer_text(buffer, "))\n(check-sat)\n");
    return c_buffer_end(buffer);
}

fn pf_solve(run: *PfRun, query: *u8, location: *CrustLoc) -> i32 {
    if pf_failed(run) { return -1i32; }
    var result: i32 = (*(*run).stage).solve((*run).stage, query, location);
    if !pf_policy_result(run, result == 0i32 || result == 1i32, location,
                         "proof solver returned unknown or failed") { return -1i32; }
    return result;
}

fn pf_goal_error(run: *PfRun, goal: *PfGoal) -> bool {
    pf_error((*run).stage, &(*goal).loc,
        "proof rejected: a counterexample satisfies the contract premises");
    return false;
}

fn pf_diagnose_goals(run: *PfRun, goal: *PfGoal) -> bool {
    while goal != null(*PfGoal) {
        if !(*goal).proven {
            var result: i32 = pf_solve(run, pf_query(run, goal), &(*goal).loc);
            if result == -1i32 { return false; }
            if result == 1i32 { return pf_goal_error(run, goal); }
        }
        goal = (*goal).next;
    }
    pf_error((*run).stage, &(*(*run).declaration).loc,
        "proof solver returned inconsistent results for the failed obligation batch");
    return false;
}

fn pf_batch_query(run: *PfRun, goal: *PfGoal) -> *u8 {
    var buffer: *CBuffer = pf_query_start(run);
    c_buffer_text(buffer, "(assert (not (and");
    while goal != null(*PfGoal) {
        if !(*goal).proven {
            c_buffer_text(buffer, "\n(=> ");
            c_buffer_text(buffer, (*goal).assumptions);
            c_buffer_text(buffer, " ");
            c_buffer_text(buffer, (*goal).value);
            c_buffer_text(buffer, ")");
        }
        goal = (*goal).next;
    }
    c_buffer_text(buffer, ")))\n(check-sat)\n");
    return c_buffer_end(buffer);
}

fn pf_mark_goals(run: *PfRun, goal: *PfGoal) -> unit {
    while goal != null(*PfGoal) {
        if !(*goal).proven {
            (*goal).proven = true;
            (*(*run).stage).obligations = (*(*run).stage).obligations + 1usize;
        }
        goal = (*goal).next;
    }
}

fn pf_prove_goals(run: *PfRun, state: *PfState) -> bool {
    var goal: *PfGoal = (*state).goals;
    while goal != null(*PfGoal) && (*goal).proven { goal = (*goal).next; }
    if goal == null(*PfGoal) { return true; }
    var result: i32 = pf_solve(run, pf_batch_query(run, goal), &(*goal).loc);
    if result == -1i32 { return false; }
    if result == 1i32 { return pf_diagnose_goals(run, goal); }
    pf_mark_goals(run, goal);
    return true;
}

fn pf_reachability_query(run: *PfRun, state: *PfState) -> *u8 {
    var buffer: *CBuffer = pf_query_start(run);
    c_buffer_text(buffer, "(assert ");
    c_buffer_text(buffer, (*state).assumptions);
    c_buffer_text(buffer, ")\n(check-sat)\n");
    return c_buffer_end(buffer);
}

// Discard an impossible continuation only after its prefix obligations pass.
fn pf_reachable(run: *PfRun, state: *PfState, location: *CrustLoc) -> bool {
    if pf_failed(run) { return false; }
    if !(*(*run).stage).prune { return true; }
    var result: i32 = pf_solve(run, pf_reachability_query(run, state), location);
    if result == -1i32 { return false; }
    if result == 1i32 { return true; }
    pf_prove_goals(run, state);
    return false;
}

fn pf_split(run: *PfRun, location: *CrustLoc) -> bool {
    if (*run).paths >= (*(*run).stage).max_paths {
        pf_error((*run).stage, location, "proof path budget exceeded");
        return false;
    }
    (*run).paths = (*run).paths + 1usize;
    return true;
}
