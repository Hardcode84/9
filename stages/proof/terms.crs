fn pf_unary(run: *PfRun, operation: *u8, value: *u8) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_text(&buffer, "(");
    c_buffer_text(&buffer, operation);
    c_buffer_text(&buffer, " ");
    c_buffer_text(&buffer, value);
    c_buffer_text(&buffer, ")");
    return c_buffer_end(&buffer);
}

fn pf_binary(run: *PfRun, operation: *u8, left: *u8, right: *u8) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_text(&buffer, "(");
    c_buffer_text(&buffer, operation);
    c_buffer_text(&buffer, " ");
    c_buffer_text(&buffer, left);
    c_buffer_text(&buffer, " ");
    c_buffer_text(&buffer, right);
    c_buffer_text(&buffer, ")");
    return c_buffer_end(&buffer);
}

fn pf_ternary(run: *PfRun, operation: *u8, first: *u8, second: *u8, third: *u8) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_text(&buffer, "(");
    c_buffer_text(&buffer, operation);
    c_buffer_text(&buffer, " ");
    c_buffer_text(&buffer, first);
    c_buffer_text(&buffer, " ");
    c_buffer_text(&buffer, second);
    c_buffer_text(&buffer, " ");
    c_buffer_text(&buffer, third);
    c_buffer_text(&buffer, ")");
    return c_buffer_end(&buffer);
}

fn pf_select(run: *PfRun, array: *u8, index: *u8) -> *u8 {
    return pf_binary(run, "select", array, index);
}

fn pf_store(run: *PfRun, array: *u8, index: *u8, value: *u8) -> *u8 {
    return pf_ternary(run, "store", array, index, value);
}

fn pf_not(run: *PfRun, value: *u8) -> *u8 { return pf_unary(run, "not", value); }
fn pf_and(run: *PfRun, left: *u8, right: *u8) -> *u8 { return pf_binary(run, "and", left, right); }
fn pf_or(run: *PfRun, left: *u8, right: *u8) -> *u8 { return pf_binary(run, "or", left, right); }
fn pf_eq(run: *PfRun, left: *u8, right: *u8) -> *u8 { return pf_binary(run, "=", left, right); }
fn pf_implies(run: *PfRun, left: *u8, right: *u8) -> *u8 { return pf_binary(run, "=>", left, right); }
fn pf_ite(run: *PfRun, condition: *u8, yes: *u8, no: *u8) -> *u8 {
    return pf_ternary(run, "ite", condition, yes, no);
}

// Names, sorts, and terms are SMT-LIB supplied by the policy.
fn pf_declare(run: *PfRun, name: *u8, sort: *u8) -> unit {
    c_buffer_text(&(*run).declarations, "(declare-const ");
    c_buffer_text(&(*run).declarations, name);
    c_buffer_text(&(*run).declarations, " ");
    c_buffer_text(&(*run).declarations, sort);
    c_buffer_text(&(*run).declarations, ")\n");
}

// Policy names must not use the pf! prefix, which is reserved for fresh names.
fn pf_name(run: *PfRun) -> *u8 {
    var buffer: CBuffer = uninit;
    pf_buffer(run, &buffer);
    c_buffer_text(&buffer, "pf!");
    c_buffer_number(&buffer, (*run).next_name as u64);
    (*run).next_name = (*run).next_name + 1usize;
    return c_buffer_end(&buffer);
}

fn pf_fresh(run: *PfRun, sort: *u8) -> *u8 {
    var result: *u8 = pf_name(run);
    pf_declare(run, result, sort);
    return result;
}

// Name a term without adding a premise. Value can refer to previous global
// declarations and definitions. It must have no free local SMT variables.
fn pf_define(run: *PfRun, sort: *u8, value: *u8) -> *u8 {
    var name: *u8 = pf_name(run);
    c_buffer_text(&(*run).declarations, "(define-fun ");
    c_buffer_text(&(*run).declarations, name);
    c_buffer_text(&(*run).declarations, " () ");
    c_buffer_text(&(*run).declarations, sort);
    c_buffer_text(&(*run).declarations, " ");
    c_buffer_text(&(*run).declarations, value);
    c_buffer_text(&(*run).declarations, ")\n");
    return name;
}
