fn pf_parameters(run: *PfRun, state: *PfState) -> bool {
    var parameter: *CrustParam = (*(*run).declaration).params;
    while parameter != null(*CrustParam) {
        var sort: *u8 = pf_value_sort(run, (*parameter).type);
        if sort == null(*u8) {
            pf_error((*run).stage, &(*parameter).loc, "proof does not support this parameter type");
            return false;
        }
        var value: *u8 = pf_fresh(run, sort);
        pf_bind(run, state, (*parameter).symbol, value);
        if (*(*parameter).type).kind == CRUST_T_POINTER { pf_observe(run, state, value); }
        parameter = (*parameter).next;
    }
    (*run).parameters = (*state).env;
    return !pf_failed(run);
}

fn pf_prove(run: *PfRun, state: *PfState) -> bool {
    var stage: *PfStage = (*run).stage;
    var location: *CrustLoc = &(*(*run).declaration).loc;
    if !pf_policy_result(run, (*stage).post(run, state), location,
                         "proof policy rejected the postcondition") { return false; }
    return pf_prove_goals(run, state);
}

fn pf_ready(stage: *PfStage, location: *CrustLoc) -> bool {
    if (*stage).status.failed { return false; }
    if (*stage).solve == null(fn(*PfStage, *u8, *CrustLoc) -> i32) ||
       (*stage).pre == null(fn(*PfRun, *PfState) -> bool) ||
       (*stage).post == null(fn(*PfRun, *PfState) -> bool) {
        pf_error(stage, location, "proof requires solver, precondition, and postcondition callbacks");
        return false;
    }
    if (*stage).max_depth == 0usize || (*stage).max_paths == 0usize {
        pf_error(stage, location, "proof budgets must be nonzero");
        return false;
    }
    if ((*stage).place == null(fn(*PfRun, *PfState, *CrustExpr, *u8) -> *u8)) !=
       ((*stage).store == null(fn(*PfRun, *PfState, *CrustExpr, *u8, *u8, *CrustLoc) -> bool)) {
        pf_error(stage, location, "proof place and store callbacks must be supplied together");
        return false;
    }
    return true;
}

// Verify the actual checked body under the supplied policy. Every solver query
// must return UNSAT; unsupported operations and exhausted budgets are errors.
fn pf_verify(stage: *PfStage, declaration: *CrustDecl) -> bool {
    if !pf_ready(stage, &(*declaration).loc) { return false; }
    var run: PfRun = make PfRun {
        declarations: make CBuffer {
            status: &(*stage).status, data: null(*u8), size: 0usize, capacity: 0usize
        },
        query: make CBuffer {
            status: &(*stage).status, data: null(*u8), size: 0usize, capacity: 0usize
        },
        stage: stage, declaration: declaration, before: null(*PfState),
        parameters: null(*PfBinding), premises: null(*PfTerm), calls: null(*PfCall), projector_depth: 0usize,
        next_name: 0usize, depth: 0usize, paths: 1usize
    };
    if !pf_function(&run, declaration, &(*declaration).loc) { return false; }
    var state: *PfState = pf_state(&run);
    if state == null(*PfState) { return false; }
    if !pf_parameters(&run, state) { return false; }
    if !pf_policy_result(&run, (*stage).pre(&run, state), &(*declaration).loc,
                         "proof policy rejected the precondition") { return false; }
    run.before = pf_fork(&run, state);
    if pf_failed(&run) { return false; }
    var frame: PfCall = make PfCall { declaration: declaration, parent: null(*PfCall), guard: "true" };
    var path: *PfPath = pf_statement(&run, state, (*declaration).body, &frame);
    if pf_failed(&run) { return false; }
    while path != null(*PfPath) {
        if !pf_prove(&run, (*path).state) { return false; }
        path = (*path).next;
    }
    return true;
}
