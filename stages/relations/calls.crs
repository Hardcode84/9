fn rl_havoc(run: *PfRun, state: *PfState) -> unit {
    var world: *RlWorld = rl_copy_world(run, state);
    if world == null(*RlWorld) { return; }
    var family: *RlFamily = (*(*rl_stage(run)).current).family;
    (*world).colors = pf_fresh(run, "(Array Int Int)");
    pf_field_set(run, state, (*family).first, pf_fresh(run, "(Array Int Int)"), (*world).live);
    pf_field_set(run, state, (*family).second, pf_fresh(run, "(Array Int Int)"), (*world).live);
}

fn rl_call_roles(run: *PfRun, state: *PfState, contract: *RlContract) -> bool {
    var parameter: *RlParam = (*contract).parameters;
    while parameter != null(*RlParam) && !pf_failed(run) {
        var value: *u8 = pf_binding(state, (*(*parameter).parameter).symbol);
        rl_ground(run, state, value);
        pf_goal(run, state, rl_role(run, state, value, (*parameter).role), &(*(*parameter).parameter).loc);
        parameter = (*parameter).next;
    }
    return pf_prove_goals(run, state);
}

fn rl_invoke(run: *PfRun, state: *PfState, frame: *PfCall) -> *PfPath {
    var stage: *RlStage = rl_stage(run);
    var contract: *RlContract = crust_map_get(&(*stage).contracts, (*frame).declaration as usize) as *RlContract;
    if contract == null(*RlContract) || (*contract).family != (*(*stage).current).family {
        pf_error((*run).stage, &(*(*frame).declaration).loc, "link call requires an interface for the same reciprocal family");
        return null(*PfPath);
    }
    if (*contract).effect == RL_EDIT && (*(*stage).current).effect != RL_EDIT {
        pf_error((*run).stage, &(*(*frame).declaration).loc, "read link contract cannot call an editor");
        return null(*PfPath);
    }
    if !rl_close(run, state, &(*(*frame).declaration).loc) || !rl_call_roles(run, state, contract) {
        return null(*PfPath);
    }
    if (*contract).effect == RL_EDIT { rl_havoc(run, state); }
    rl_publish(run, state, contract, false);
    var family: *RlFamily = (*contract).family;
    pf_field_set(run, state, (*family).first,
        (*pf_field(run, state, (*family).first)).value, (*rl_world(state)).live);
    pf_field_set(run, state, (*family).second,
        (*pf_field(run, state, (*family).second)).value, (*rl_world(state)).live);
    rl_results(run, state, contract, false, true);
    rl_snapshot(run, state);
    return pf_path(run, state);
}

// Mutable outer locals require a loop-carried value contract. Stable cursors
// need only the reciprocal invariant at the loop boundary.
fn rl_loop_locals(run: *PfRun, state: *PfState, statement: *CrustStmt) -> bool {
    if statement == null(*CrustStmt) { return true; }
    if !pf_enter(run, &(*statement).loc) { return false; }
    var valid: bool = true;
    if (*statement).kind == CRUST_S_ASSIGN {
        var expression: *CrustExpr = pf_ungroup(run, (*statement).expr);
        if !pf_failed(run) && (*expression).kind == CRUST_E_NAME &&
           pf_binding(state, (*expression).symbol) != null(*u8) {
            pf_error((*run).stage, &(*statement).loc, "link loop cannot change an outer local without a value invariant");
            valid = false;
        }
    }
    if valid { valid = rl_loop_locals(run, state, (*statement).body); }
    if valid { valid = rl_loop_locals(run, state, (*statement).otherwise); }
    if valid { valid = rl_loop_locals(run, state, (*statement).next); }
    (*run).depth = (*run).depth - 1usize;
    return valid && !pf_failed(run);
}

fn rl_loop_frame(run: *PfRun, state: *PfState, before: *RlWorld, location: *CrustLoc) -> unit {
    var after: *RlWorld = rl_world(state);
    var same: *u8 = pf_and(run, pf_eq(run, (*before).live, (*after).live),
                               pf_eq(run, (*before).heads, (*after).heads));
    same = pf_and(run, same, pf_eq(run, (*before).construction, (*after).construction));
    pf_goal(run, state, same, location);
}

fn rl_loop_paths(run: *PfRun, paths: *PfPath, before: *RlWorld, location: *CrustLoc) -> *PfPath {
    var exits: *PfPath = null(*PfPath);
    while paths != null(*PfPath) && !pf_failed(run) {
        var state: *PfState = (*paths).state;
        if (*state).flow == PF_RETURN || (*state).flow == PF_TRAP {
            exits = pf_join_paths(exits, pf_path(run, state));
        } else {
            if (*state).flow != PF_BREAK { rl_loop_frame(run, state, before, location); }
            if rl_close(run, state, location) && (*state).flow == PF_BREAK {
                (*state).flow = PF_NORMAL;
                exits = pf_join_paths(exits, pf_path(run, state));
            }
        }
        paths = (*paths).next;
    }
    return exits;
}

fn rl_loop(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *PfPath {
    if !rl_loop_locals(run, state, (*statement).body) || !rl_close(run, state, &(*statement).loc) {
        return null(*PfPath);
    }
    rl_havoc(run, state);
    rl_snapshot(run, state);
    var condition: *u8 = pf_expression(run, state, (*statement).expr, "true");
    var body: *PfState = pf_fork(run, state);
    var exit_state: *PfState = pf_fork(run, state);
    if pf_failed(run) { return null(*PfPath); }
    pf_assume(run, body, condition);
    pf_assume(run, exit_state, pf_not(run, condition));
    var before: *RlWorld = rl_world(state);
    var paths: *PfPath = pf_statement(run, body, (*statement).body, (*run).calls);
    var exits: *PfPath = rl_loop_paths(run, paths, before, &(*statement).loc);
    return pf_join_paths(exits, pf_path(run, exit_state));
}

fn rl_statement(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *PfPath {
    if (*statement).kind == CRUST_S_WHILE { return rl_loop(run, state, statement); }
    return pf_statement_inner(run, state, statement, (*run).calls);
}
