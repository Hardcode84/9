const RL_LINK: u32 = 1u32;
const RL_HEAD: u32 = 2u32;
const RL_MEMBER: u32 = 3u32;
const RL_CONSTRUCT: u32 = 4u32;
const RL_READ: u32 = 1u32;
const RL_EDIT: u32 = 2u32;

record RlStage {
    proof: PfStage;
    families: CrustMap;
    contracts: CrustMap;
    current: *RlContract;
    milliseconds: u32;
}

record RlFamily {
    declaration: *CrustDecl;
    first: *CrustField;
    second: *CrustField;
}

record RlParam {
    parameter: *CrustParam;
    unless_same: *CrustParam;
    next: *RlParam;
    role: u32;
    isolated: bool;
}

record RlContract {
    declaration: *CrustDecl;
    family: *RlFamily;
    // Parameters are listed in the declaration's argument order.
    parameters: *RlParam;
    effect: u32;
}

record RlSnapshot {
    first: *u8;
    second: *u8;
    live: *u8;
    heads: *u8;
    colors: *u8;
    next: *RlSnapshot;
}

record RlWorld {
    live: *u8;
    heads: *u8;
    colors: *u8;
    construction: *u8;
    snapshots: *RlSnapshot;
}
