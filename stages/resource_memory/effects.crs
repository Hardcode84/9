fn rm_forget_fields(run: *PfRun, state: *PfState, address: *u8, type: *CrustType, location: *CrustLoc) -> unit {
    if (*type).kind == CRUST_T_RECORD {
        var field: *CrustField = (*(*type).record_decl).fields;
        while field != null(*CrustField) && !pf_failed(run) {
            rm_forget_value(run, state, pm_subobject(run, address, (*field).offset), (*field).type, location);
            field = (*field).next;
        }
    } else {
        if (*type).count > (*(*run).stage).max_iterations as u64 {
            pf_error((*run).stage, location, "resource transfer exceeds the proof iteration budget");
            return;
        }
        var index: u64 = 0u64;
        while index < (*type).count && !pf_failed(run) {
            rm_forget_value(run, state, pm_subobject(run, address, index * (*(*type).base).size), (*type).base, location);
            index = index + 1u64;
        }
    }
}

fn rm_forget_value(run: *PfRun, state: *PfState, address: *u8, type: *CrustType, location: *CrustLoc) -> unit {
    if !pf_enter(run, location) { return; }
    if (*type).kind == CRUST_T_RECORD || (*type).kind == CRUST_T_ARRAY {
        rm_forget_fields(run, state, address, type, location);
    } else {
        var world: *PmWorld = pm_change(run, state);
        if world != null(*PmWorld) {
            (*world).initialized = pm_array_store(run, "(Array Ptr Bool)", (*world).initialized, address, "false");
        }
    }
    (*run).depth = (*run).depth - 1usize;
}

fn rm_effect(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *PfPath {
    var policy: *RmPolicy = (*(*run).stage).user as *RmPolicy;
    var transfers: *RsTransfer = c_map_get(&(*policy).transfers, statement as usize) as *RsTransfer;
    var paths: *PfPath = pm_statement(run, state, statement);
    if transfers == null(*RsTransfer) { return paths; }
    var path: *PfPath = paths;
    while path != null(*PfPath) && !pf_failed(run) {
        var transfer: *RsTransfer = transfers;
        while transfer != null(*RsTransfer) && (*(*path).state).flow == PF_NORMAL && !pf_failed(run) {
            var place: *CrustExpr = (*transfer).place;
            var address: *u8 = pm_place(run, (*path).state, place, "true");
            if !pf_failed(run) { rm_forget_value(run, (*path).state, address, (*place).type, &(*statement).loc); }
            transfer = (*transfer).next;
        }
        path = (*path).next;
    }
    return paths;
}
