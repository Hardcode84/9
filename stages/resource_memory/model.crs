record RmPolicy {
    memory: PmPolicy;
    bodies: CMap;
    ends: CMap;
    transfers: CMap;
}

record RmStorage { declaration: *CrustStmt; next: *RmStorage; }

record RmPlan {
    bindings: CMap;
    scopes: CMap;
    stage: *PfStage;
    policy: *RmPolicy;
    function: *RsFunction;
}
