fn rm_empty_map(map: *CMap) -> unit {
    *map = make CMap { entries: null(*CEntry), count: 0usize, capacity: 0usize };
}

fn rm_copy_node(plan: *RmPlan, source: *CrustStmt) -> *CrustStmt {
    var copy: *CrustStmt = c_alloc(&(*(*plan).stage).status, sizeof(CrustStmt), alignof(CrustStmt)) as *CrustStmt;
    if copy != null(*CrustStmt) { *copy = *source; (*copy).next = null(*CrustStmt); }
    return copy;
}

fn rm_block(plan: *RmPlan, source: *CrustStmt, items: *RsStatements) -> *CrustStmt {
    var block: *CrustStmt = rm_copy_node(plan, source);
    if block != null(*CrustStmt) {
        (*block).kind = CRUST_S_BLOCK;
        (*block).body = (*items).first;
        (*block).otherwise = null(*CrustStmt);
        (*block).expr = null(*CrustExpr);
        (*block).value = null(*CrustExpr);
    }
    return block;
}

fn rm_bind_storage(plan: *RmPlan, scope: *RsScope, local: *RsLocal) -> unit {
    var name: usize = (*local).storage as usize;
    var captured: *RsScope = crust_map_get(&(*(*plan).function).captures, name) as *RsScope;
    if captured != null(*RsScope) { scope = captured; }
    c_map_set(&(*(*plan).stage).status, &(*plan).bindings, name, scope as usize);
}

fn rm_storage(plan: *RmPlan, declaration: *CrustStmt) -> unit {
    var scope: usize = c_map_get(&(*plan).bindings, (*declaration).name as usize);
    var storage: *RmStorage = c_alloc(&(*(*plan).stage).status, sizeof(RmStorage), alignof(RmStorage)) as *RmStorage;
    if storage == null(*RmStorage) { return; }
    *storage = make RmStorage {
        declaration: declaration, next: c_map_get(&(*plan).scopes, scope) as *RmStorage
    };
    c_map_set(&(*(*plan).stage).status, &(*plan).scopes, scope, storage as usize);
}

fn rm_plan_storage(plan: *RmPlan) -> unit {
    var function: *RsFunction = (*plan).function;
    var index: usize = 0usize;
    while index < (*function).scopes.capacity && !(*(*plan).stage).status.failed {
        if (*function).scopes.entries[index].key != 0usize {
            var scope: *RsScope = (*function).scopes.entries[index].value as *RsScope;
            var local: *RsLocal = (*scope).first;
            while local != null(*RsLocal) && !(*(*plan).stage).status.failed {
                rm_bind_storage(plan, scope, local);
                local = (*local).next;
            }
        }
        index = index + 1usize;
    }
    // Declaration order keeps proof allocation order independent of map layout.
    var declaration: *CrustStmt = (*function).declarations;
    while declaration != null(*CrustStmt) && !(*(*plan).stage).status.failed {
        rm_storage(plan, declaration);
        if declaration == (*function).last_declaration { break; }
        declaration = (*declaration).next;
    }
}

fn rm_declarations(plan: *RmPlan, source: *CrustStmt, items: *RsStatements) -> unit {
    var scope: *RsScope = crust_map_get(&(*(*plan).function).scopes, source as usize) as *RsScope;
    var storage: *RmStorage = c_map_get(&(*plan).scopes, scope as usize) as *RmStorage;
    while storage != null(*RmStorage) && !(*(*plan).stage).status.failed {
        rs_append(items, rm_copy_node(plan, (*storage).declaration));
        storage = (*storage).next;
    }
}

fn rm_end_scope(plan: *RmPlan, scope: *RsScope, source: *CrustStmt, items: *RsStatements) -> unit {
    var storage: *RmStorage = c_map_get(&(*plan).scopes, scope as usize) as *RmStorage;
    if storage == null(*RmStorage) { return; }
    var empty: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
    var end: *CrustStmt = rm_block(plan, source, &empty);
    if end == null(*CrustStmt) { return; }
    c_map_set(&(*(*plan).stage).status, &(*(*plan).policy).ends, end as usize, storage as usize);
    rs_append(items, end);
}

fn rm_exit(plan: *RmPlan, source: *CrustStmt, exit_value: *RsExit, items: *RsStatements, depth: usize) -> unit {
    var scope: *RsScope = (*exit_value).scope;
    var chain: *RsChain = (*exit_value).chain;
    while scope != (*exit_value).stop && !(*(*plan).stage).status.failed {
        while (*chain).action != null(*RsAction) && (*(*chain).action).scope == scope && !(*(*plan).stage).status.failed {
            rs_append(items, rm_statement_view(plan, (*(*chain).action).statement, depth + 1usize));
            chain = (*chain).next;
        }
        rm_end_scope(plan, scope, source, items);
        scope = (*scope).parent;
    }
}

fn rm_statement_view(plan: *RmPlan, source: *CrustStmt, depth: usize) -> *CrustStmt {
    if source == null(*CrustStmt) { return null(*CrustStmt); }
    if !pm_plan_enter((*plan).stage, depth, &(*source).loc) { return null(*CrustStmt); }
    var copy: *CrustStmt = rm_copy_node(plan, source);
    if copy == null(*CrustStmt) { return copy; }
    var transfer: *RsTransfer = crust_map_get(&(*(*plan).function).transfers, source as usize) as *RsTransfer;
    if transfer != null(*RsTransfer) {
        c_map_set(&(*(*plan).stage).status, &(*(*plan).policy).transfers, copy as usize, transfer as usize);
    }
    var items: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
    if (*source).kind == CRUST_S_BLOCK {
        rm_declarations(plan, source, &items);
        var child: *CrustStmt = (*source).body;
        while child != null(*CrustStmt) && !(*(*plan).stage).status.failed {
            rs_append(&items, rm_statement_view(plan, child, depth + 1usize));
            child = (*child).next;
        }
        (*copy).body = items.first;
    } else {
        (*copy).body = rm_statement_view(plan, (*source).body, depth + 1usize);
        (*copy).otherwise = rm_statement_view(plan, (*source).otherwise, depth + 1usize);
    }
    var exit_value: *RsExit = crust_map_get(&(*(*plan).function).exits, source as usize) as *RsExit;
    if exit_value == null(*RsExit) { return copy; }
    rm_exit(plan, source, exit_value, &items, depth);
    if (*source).kind == CRUST_S_BLOCK { (*copy).body = items.first; return copy; }
    rs_append(&items, copy);
    return rm_block(plan, source, &items);
}

fn rm_function_view(stage: *PfStage, policy: *RmPolicy, function: *RsFunction) -> unit {
    var plan: RmPlan = make RmPlan {
        bindings: make CMap { entries:null(*CEntry), count:0usize, capacity:0usize },
        scopes: make CMap { entries:null(*CEntry), count:0usize, capacity:0usize },
        stage: stage, policy: policy, function: function
    };
    rm_plan_storage(&plan);
    var declaration: *CrustDecl = (*(*function).global).lowered;
    var items: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
    rm_declarations(&plan, (*declaration).body, &items);
    rs_append(&items, rm_statement_view(&plan, (*function).body, 0usize));
    var body: *CrustStmt = rm_block(&plan, (*declaration).body, &items);
    if body != null(*CrustStmt) { c_map_set(&(*stage).status, &(*policy).bodies, declaration as usize, body as usize); }
}

fn rm_body(stage: *PfStage, declaration: *CrustDecl) -> *CrustStmt {
    var policy: *RmPolicy = (*stage).user as *RmPolicy;
    var body: *CrustStmt = c_map_get(&(*policy).bodies, declaration as usize) as *CrustStmt;
    if body != null(*CrustStmt) { return body; }
    return (*declaration).body;
}

fn rm_statement(run: *PfRun, state: *PfState, statement: *CrustStmt) -> *PfPath {
    var policy: *RmPolicy = (*(*run).stage).user as *RmPolicy;
    var storage: *RmStorage = c_map_get(&(*policy).ends, statement as usize) as *RmStorage;
    if storage == null(*RmStorage) { return rm_effect(run, state, statement); }
    var ending: *RmStorage = storage;
    while storage != null(*RmStorage) && !pf_failed(run) {
        var symbol: *CrustSymbol = (*(*storage).declaration).symbol;
        if pm_needs_storage(run, symbol) {
            var address: *u8 = pm_local_address(run, state, symbol, &(*statement).loc);
            if !pf_failed(run) { pm_expire(run, state, pm_origin(run, address), "true"); }
        }
        storage = (*storage).next;
    }
    while ending != null(*RmStorage) && !pf_failed(run) {
        var symbol: *CrustSymbol = (*(*ending).declaration).symbol;
        if pm_needs_storage(run, symbol) {
            var address: *u8 = pm_local_address(run, state, symbol, &(*statement).loc);
            if !pf_failed(run) { pm_no_incoming(run, state, pm_origin(run, address), "true", &(*statement).loc); }
        }
        ending = (*ending).next;
    }
    return pf_path(run, state);
}
