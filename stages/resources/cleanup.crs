fn rs_clone_expr_depth(stage: *RsStage, source: *CrustExpr, depth: u32) -> *CrustExpr {
    if source == null(*CrustExpr) || (*stage).failed { return null(*CrustExpr); }
    if depth >= 256u32 {
        rs_error(stage, &(*source).loc, "semantic traversal depth limit of 256 exceeded");
        return null(*CrustExpr);
    }
    var target: *CrustExpr = rs_expr_node(stage, (*source).kind, &(*source).loc);
    if target == null(*CrustExpr) { return target; }
    (*target).op = (*source).op;
    (*target).name = (*source).name;
    (*target).field_name = (*source).field_name;
    (*target).syntax_type = (*source).syntax_type;
    (*target).literal_type = (*source).literal_type;
    (*target).integer = (*source).integer;
    (*target).bytes = (*source).bytes;
    (*target).byte_count = (*source).byte_count;
    (*target).left = rs_clone_expr_depth(stage, (*source).left, depth + 1u32);
    (*target).right = rs_clone_expr_depth(stage, (*source).right, depth + 1u32);
    (*target).arg_count = (*source).arg_count;
    if (*source).arg_count != 0usize {
        (*target).args = rs_alloc(stage, (*source).arg_count * sizeof(*CrustExpr), alignof(*CrustExpr)) as **CrustExpr;
        if (*stage).failed { return null(*CrustExpr); }
        var index: usize = 0usize;
        while index < (*source).arg_count && !(*stage).failed {
            (*target).args[index] = rs_clone_expr_depth(stage, (*source).args[index], depth + 1u32);
            index = index + 1usize;
        }
    }
    var item: *CrustInit = (*source).inits;
    var last: *CrustInit = null(*CrustInit);
    while item != null(*CrustInit) && !(*stage).failed {
        var copy: *CrustInit = rs_alloc(stage, sizeof(CrustInit), alignof(CrustInit)) as *CrustInit;
        if copy == null(*CrustInit) { return null(*CrustExpr); }
        (*copy).name = (*item).name;
        (*copy).loc = (*item).loc;
        (*copy).value = rs_clone_expr_depth(stage, (*item).value, depth + 1u32);
        if last == null(*CrustInit) { (*target).inits = copy; }
        else { (*last).next = copy; }
        last = copy;
        item = (*item).next;
    }
    if (*stage).failed { return null(*CrustExpr); }
    return target;
}

// Copy each expression occurrence. Keep immutable syntax and literal storage.
// The result has no checked type, symbol, field, or place facts.
fn rs_clone_expr(stage: *RsStage, source: *CrustExpr) -> *CrustExpr {
    return rs_clone_expr_depth(stage, source, 0u32);
}

fn rs_cleanup_number(stage: *RsStage, value: u64, location: *CrustLoc) -> *CrustExpr {
    var expression: *CrustExpr = rs_expr_node(stage, CRUST_E_INTEGER, location);
    if expression != null(*CrustExpr) {
        (*expression).literal_type = CRUST_T_USIZE;
        (*expression).integer = value;
    }
    return expression;
}

fn rs_cleanup_binary(stage: *RsStage, op: u32, left: *CrustExpr, right: *CrustExpr,
                     location: *CrustLoc) -> *CrustExpr {
    var expression: *CrustExpr = rs_expr_node(stage, CRUST_E_BINARY, location);
    if expression != null(*CrustExpr) {
        (*expression).op = op;
        (*expression).left = left;
        (*expression).right = right;
    }
    return expression;
}

fn rs_drop_call(stage: *RsStage, name: *CrustName, place: *CrustExpr) -> *CrustStmt {
    if (*stage).failed { return null(*CrustStmt); }
    var location: *CrustLoc = &(*place).loc;
    var call: *CrustExpr = rs_expr_node(stage, CRUST_E_CALL, location);
    var invoke: *CrustStmt = rs_stmt_node(stage, CRUST_S_EXPR, location);
    if (*stage).failed { return null(*CrustStmt); }
    (*call).left = rs_named(stage, name, location);
    (*call).arg_count = 1usize;
    (*call).args = rs_alloc(stage, sizeof(*CrustExpr), alignof(*CrustExpr)) as **CrustExpr;
    if (*stage).failed { return null(*CrustStmt); }
    (*call).args[0usize] = rs_unary(stage, CRUST_OP_ADDRESS, rs_clone_expr(stage, place), location);
    (*invoke).expr = call;
    return invoke;
}

fn rs_drop_header(stage: *RsStage, global: *RsGlobal) -> *CrustDecl {
    var context: *CrustContext = (*stage).context;
    var location: *CrustLoc = &(*(*global).source).loc;
    if (*stage).next_helper_identity == ~0u64 {
        rs_error(stage, location, "too many declarations for generated resource cleanup");
        return null(*CrustDecl);
    }
    if (*stage).helpers == null(*CrustUnit) {
        var helpers: *CrustUnit = rs_alloc(stage, sizeof(CrustUnit), alignof(CrustUnit)) as *CrustUnit;
        if helpers == null(*CrustUnit) { return null(*CrustDecl); }
        (*helpers).source = (*(*context).units).source;
        (*(*context).last_unit).next = helpers;
        (*context).last_unit = helpers;
        (*stage).helpers = helpers;
    }
    var declaration: *CrustDecl = rs_alloc(stage, sizeof(CrustDecl), alignof(CrustDecl)) as *CrustDecl;
    var parameter: *CrustParam = rs_alloc(stage, sizeof(CrustParam), alignof(CrustParam)) as *CrustParam;
    var record_type: *CrustTypeSyntax = rs_type_node(stage, CRUST_T_NAME, location);
    if (*stage).failed { return null(*CrustDecl); }
    (*record_type).name = (*(*global).source).name;
    (*parameter).name = rs_name(stage);
    (*parameter).loc = *location;
    (*parameter).syntax_type = rs_pointer(stage, record_type);
    (*declaration).kind = CRUST_D_FUNCTION;
    (*declaration).loc = *location;
    (*declaration).name = rs_name(stage);
    (*declaration).link_name = "";
    (*declaration).syntax_type = rs_type_node(stage, CRUST_T_UNIT, location);
    (*declaration).params = parameter;
    (*declaration).param_count = 1usize;
    (*stage).next_helper_identity = (*stage).next_helper_identity + 1u64;
    (*declaration).identity = (*stage).next_helper_identity;
    (*declaration).unit_identity = (*(*(*stage).helpers).source).identity;
    if (*stage).failed { return null(*CrustDecl); }
    var single: CrustUnit = make CrustUnit {
        source: (*(*stage).helpers).source, declarations: declaration, next: null(*CrustUnit)
    };
    if !crust_collect_unit(context, &single) || !crust_resolve_unit(context, &single) {
        (*stage).failed = true;
        return null(*CrustDecl);
    }
    if (*stage).last_helper == null(*CrustDecl) { (*(*stage).helpers).declarations = declaration; }
    else { (*(*stage).last_helper).next = declaration; }
    (*stage).last_helper = declaration;
    (*global).drop_helper = declaration;
    return declaration;
}

fn rs_drop_helper(stage: *RsStage, global: *RsGlobal) -> *CrustDecl {
    if (*global).drop_helper != null(*CrustDecl) { return (*global).drop_helper; }
    var declaration: *CrustDecl = rs_drop_header(stage, global);
    var function: *RsFunction = rs_alloc(stage, sizeof(RsFunction), alignof(RsFunction)) as *RsFunction;
    if (*stage).failed { return null(*CrustDecl); }
    (*function).stage = stage;
    rs_scope(function);
    var location: *CrustLoc = &(*declaration).loc;
    var place: *CrustExpr = rs_unary(stage, CRUST_OP_DEREF,
        rs_named(stage, (*(*declaration).params).name, location), location);
    var output: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
    if (*global).resource != null(*RsResource) {
        rs_append(&output, rs_drop_call(stage, (*(*(*global).drop).lowered).name, place));
    }
    var fields: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
    var field: *CrustField = (*(*global).source).fields;
    while field != null(*CrustField) && !(*stage).failed {
        if rs_owns(stage, (*field).syntax_type) {
            var field_place: *CrustExpr = rs_expr_node(stage, CRUST_E_FIELD, location);
            if field_place == null(*CrustExpr) { return null(*CrustDecl); }
            (*field_place).left = rs_clone_expr(stage, place);
            (*field_place).field_name = (*field).name;
            var drop: *CrustStmt = rs_drop_tree(function, (*field).syntax_type, field_place);
            if (*stage).failed { return null(*CrustDecl); }
            (*drop).next = fields.first;
            fields.first = drop;
            if fields.last == null(*CrustStmt) { fields.last = drop; }
        }
        field = (*field).next;
    }
    if (*stage).failed { return null(*CrustDecl); }
    if fields.first != null(*CrustStmt) {
        if output.last == null(*CrustStmt) { output.first = fields.first; }
        else { (*output.last).next = fields.first; }
        output.last = fields.last;
    }
    var body: RsStatements = make RsStatements {
        first: (*function).declarations, last: (*function).last_declaration
    };
    rs_append(&body, rs_block(stage, &output, location));
    (*declaration).body = rs_block(stage, &body, location);
    return declaration;
}

// Require a resolved owning source type and an owner place without side effects.
// Return one unchecked seed statement. Destroy the record before its owned fields.
fn rs_drop_tree(function: *RsFunction, syntax: *CrustTypeSyntax, place: *CrustExpr) -> *CrustStmt {
    var stage: *RsStage = (*function).stage;
    if (*stage).failed { return null(*CrustStmt); }
    var location: *CrustLoc = &(*place).loc;
    var output: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
    if !rs_owns(stage, syntax) { return rs_block(stage, &output, location); }
    if (*syntax).kind == CRUST_T_ARRAY {
        var counter_type: *CrustTypeSyntax = rs_type_node(stage, CRUST_T_USIZE, location);
        if counter_type == null(*CrustTypeSyntax) { return null(*CrustStmt); }
        var counter: *RsLocal = rs_local(function, null(*CrustName), counter_type, null(*CrustParam), location);
        if counter == null(*RsLocal) { return null(*CrustStmt); }
        rs_assign(function, &output, rs_place_local(function, counter, location),
                  rs_cleanup_number(stage, (*syntax).count, location), location);
        var condition: *CrustExpr = rs_cleanup_binary(stage, CRUST_OP_GT,
            rs_place_local(function, counter, location), rs_cleanup_number(stage, 0u64, location), location);
        var body: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
        var decrement: *CrustExpr = rs_cleanup_binary(stage, CRUST_OP_SUB,
            rs_place_local(function, counter, location), rs_cleanup_number(stage, 1u64, location), location);
        rs_assign(function, &body, rs_place_local(function, counter, location), decrement, location);
        var element: *CrustExpr = rs_expr_node(stage, CRUST_E_INDEX, location);
        if element == null(*CrustExpr) { return null(*CrustStmt); }
        (*element).left = rs_clone_expr(stage, place);
        (*element).right = rs_place_local(function, counter, location);
        rs_append(&body, rs_drop_tree(function, (*syntax).base, element));
        var loop: *CrustStmt = rs_stmt_node(stage, CRUST_S_WHILE, location);
        if loop == null(*CrustStmt) { return null(*CrustStmt); }
        (*loop).expr = condition;
        (*loop).body = rs_block(stage, &body, location);
        rs_append(&output, loop);
        return rs_block(stage, &output, location);
    }
    var global: *RsGlobal = rs_global(stage, (*syntax).name);
    var helper: *CrustDecl = rs_drop_helper(stage, global);
    if (*stage).failed { return null(*CrustStmt); }
    return rs_drop_call(stage, (*helper).name, place);
}

// Attach one action to the function's seed-check validation list once.
fn rs_prepare_action(function: *RsFunction, action: *RsAction) -> unit {
    var stage: *RsStage = (*function).stage;
    if (*stage).failed || (*action).validated { return; }
    if (*action).statement == null(*CrustStmt) {
        var owner: *RsLocal = (*action).owner;
        if owner == null(*RsLocal) { trap; }
        var location: *CrustLoc = &(*(*owner).syntax).loc;
        var place: *CrustExpr = rs_place_local(function, owner, location);
        if place == null(*CrustExpr) { return; }
        (*action).statement = rs_drop_tree(function, (*owner).syntax, place);
    }
    if (*stage).failed { return; }
    if (*function).validation == null(*CrustStmt) { (*function).validation = (*action).statement; }
    else { (*(*function).last_validation).next = (*action).statement; }
    (*function).last_validation = (*action).statement;
    (*action).validated = true;
}
