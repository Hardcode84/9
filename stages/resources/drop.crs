fn rs_drop_local(function: *RsFunction, source: *CrustExpr, place: *RsValue) -> bool {
    while (*source).kind == CRUST_E_GROUP { source = (*source).left; }
    var local: *RsLocal = (*place).local;
    return (*source).kind == CRUST_E_NAME && local != null(*RsLocal) && (*local).mode == 0u32;
}

fn rs_drop_borrow(function: *RsFunction, local: *RsLocal, location: *CrustLoc) -> bool {
    var stage: *RsStage = (*function).stage;
    // Parameters occupy the outer function scope; source locals occupy its body.
    if (*(*local).scope).parent == null(*RsScope) {
        rs_error(stage, location, "cannot drop a borrowed value"); return false;
    }
    rs_access(function, local, false, location);
    if !(*stage).delegate_memory && ((*local).readers != 0usize || (*local).exclusive) {
        rs_error(stage, location, "cannot end a borrow with live child loans"); return false;
    }
    if (*stage).failed { return false; }
    rs_end_loan(function, local);
    rs_live(function, local, false);
    return true;
}

fn rs_lower_drop(function: *RsFunction, source: *CrustStmt, output: *RsStatements) -> bool {
    var stage: *RsStage = (*function).stage;
    var operand: *CrustExpr = (*source).expr;
    while (*operand).kind == CRUST_E_GROUP { operand = (*operand).left; }
    if (*operand).kind == CRUST_E_NAME {
        var binding: *RsLocal = crust_map_get(&(*function).locals, (*operand).name as usize) as *RsLocal;
        if binding != null(*RsLocal) && (*binding).mode != 0u32 {
            return rs_drop_borrow(function, binding, &(*source).loc);
        }
    }
    var effects: RsStatements = make RsStatements { first: null(*CrustStmt), last: null(*CrustStmt) };
    rs_scope(function);
    var place: *RsValue = rs_place(function, (*source).expr, &effects, true, false);
    if (*stage).failed { return false; }
    if (*(*place).syntax).kind != CRUST_T_NAME || (!(*stage).delegate_memory && !rs_owns(stage, (*place).syntax)) {
        rs_error(stage, &(*source).loc, "drop requires a resource or a record with resource fields"); return false;
    }
    var local: bool = rs_drop_local(function, (*source).expr, place);
    if !local && (*function).unsafe_depth == 0usize {
        rs_error(stage, &(*source).loc, "drop requires a whole owner or checked destruction authority"); return false;
    }
    var action: *CrustStmt = rs_drop_action(function, place, &(*source).loc);
    if (*stage).failed { return false; }
    rs_append(&effects, action);
    if local { rs_live(function, (*place).local, false); }
    rs_append(output, rs_expression_scope(function, &effects, &(*source).loc));
    return !(*stage).failed;
}

fn rs_drop_action(function: *RsFunction, place: *RsValue, location: *CrustLoc) -> *CrustStmt {
    var stage: *RsStage = (*function).stage;
    var action: *CrustStmt = null(*CrustStmt);
    var consumed: *CrustExpr = (*place).expression;
    if rs_owns(stage, (*place).syntax) {
        action = rs_drop_tree(function, (*place).syntax, consumed);
        if action == null(*CrustStmt) { return action; }
        consumed = (*(*(*action).expr).args[0usize]).left;
    } else { action = rs_stmt_node(stage, CRUST_S_BLOCK, location); }
    if action != null(*CrustStmt) { rs_transfer_place(function, action, consumed); }
    return action;
}
