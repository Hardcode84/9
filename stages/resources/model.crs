// Offsets in the range owned by one RsStage. Obtain a node kind with rs_kind.
const RS_READ: u32 = 0u32;
const RS_MUT: u32 = 1u32;
const RS_MOVE: u32 = 2u32;
const RS_DEFER: u32 = 3u32;
const RS_UNSAFE: u32 = 4u32;
const RS_FORGET: u32 = 5u32;
const RS_DROP: u32 = 6u32;
const RS_END: u32 = 7u32;

record RsResource {
    declaration: *CrustDecl;
    drop_name: *CrustName;
    next: *RsResource;
}

record RsReturnLoan {
    parameter: *CrustName;
    index: usize;
}

record RsGlobal {
    fields: CrustMap;
    source: *CrustDecl;
    lowered: *CrustDecl;
    syntax: *CrustTypeSyntax;
    resource: *RsResource;
    drop: *RsGlobal;
    drop_helper: *CrustDecl;
    next: *RsGlobal;
    unsafe_call: bool;
    drop_only: bool;
}

record RsStage {
    globals: CrustMap;
    unsafe_functions: CrustMap;
    source_imports: CrustMap;
    lowered_types: CrustMap;
    ownership: CrustMap;
    affine_types: CrustMap;
    functions: CrustMap;
    return_sources: CrustMap;
    return_loans: CrustMap;
    initialized_parameters: CrustMap;
    context: *CrustContext;
    sources: *CrustUnit;
    resources: *RsResource;
    first_global: *RsGlobal;
    last_global: *RsGlobal;
    helpers: *CrustUnit;
    last_helper: *CrustDecl;
    next_helper_identity: u64;
    next_name: usize;
    kind_base: u32;
    delegate_memory: bool;
    delegate_return_loans: bool;
    failed: bool;
}

record RsScope {
    parent: *RsScope;
    first: *RsLocal;
    first_action: *RsAction;
    last_action: *RsAction;
}

record RsLocal {
    name: *CrustName;
    syntax: *CrustTypeSyntax;
    storage: *CrustName;
    readers: usize;
    parent_loan: *RsLocal;
    stamp: usize;
    scope: *RsScope;
    next: *RsLocal;
    mode: u32;
    indirect: bool;
    initialized: bool;
    owning: bool;
    exclusive: bool;
}

record RsValue {
    syntax: *CrustTypeSyntax;
    expression: *CrustExpr;
    // A raw place has no checked storage owner.
    local: *RsLocal;
    mode: u32;
    owned: bool;
    unsafe_call: bool;
    initializes: bool;
}

record RsAction {
    owner: *RsLocal;
    scope: *RsScope;
    statement: *CrustStmt;
    next: *RsAction;
    validated: bool;
}

record RsChain {
    action: *RsAction;
    next: *RsChain;
    identity: usize;
    hash_next: *RsChain;
    all_next: *RsChain;
}

record RsExit {
    chain: *RsChain;
    continuation: *RsChain;
    scope: *RsScope;
    stop: *RsScope;
}

record RsTransfer { place: *CrustExpr; next: *RsTransfer; }

record RsChange {
    local: *RsLocal;
    readers: usize;
    next: *RsChange;
    initialized: bool;
    exclusive: bool;
}

record RsLoopExit { changes: *RsChange; next: *RsLoopExit; }

record RsLoop {
    parent: *RsLoop;
    scope: *RsScope;
    break_target: *RsChain;
    continue_target: *RsChain;
    entry: *RsChange;
    exits: *RsLoopExit;
}

record RsFunction {
    locals: CrustMap;
    exits: CrustMap;
    loop_targets: CrustMap;
    seed_blocks: CrustMap;
    chain_map: CrustMap;
    scopes: CrustMap;
    captures: CrustMap;
    transfers: CrustMap;
    stage: *RsStage;
    global: *RsGlobal;
    scope: *RsScope;
    loop: *RsLoop;
    changes: *RsChange;
    declarations: *CrustStmt;
    last_declaration: *CrustStmt;
    validation: *CrustStmt;
    last_validation: *CrustStmt;
    chains: *RsChain;
    next_label: usize;
    result: *RsLocal;
    output: *CrustName;
    returned: *RsChain;
    body: *CrustStmt;
    epilogue: *CrustStmt;
    unsafe_depth: usize;
    stamp: usize;
    expression_depth: u32;
}

record RsStatements { first: *CrustStmt; last: *CrustStmt; }
