fn sp_tools(stage: *SpStage, driver: *CDriver, output: *u8) -> bool {
    var source: *u8 = c_driver_temporary(driver, output, 438u32);
    var binary: *u8 = c_driver_temporary(driver, output, 438u32);
    if source == null(*u8) || binary == null(*u8) {
        return false;
    }
    if !c_driver_write(driver, source, &stage -> llvm.memory.header) {
        return false;
    }
    var llc: *u8 = ll_join(&stage -> llvm, stage -> config -> llvm_directory, "/bin/llc");
    var arguments: [*u8; 8] = make [*u8; 8] {
        llc,
        "--spirv-ext=+SPV_KHR_float_controls",
        "-O0",
        "-filetype=obj",
        source,
        "-o",
        binary,
        null(*u8)
    };
    var context: *CrustContext = ll_context(&stage -> llvm);
    if !ll_ok(&stage -> llvm) || !cache_tool(context, &arguments[0usize], null(*u8)) {
        return false;
    }
    var validate: [*u8; 5] = make [*u8; 5] {
        stage -> config -> validator,
        "--target-env",
        "vulkan1.2",
        binary,
        null(*u8)
    };
    return cache_tool(context, &validate[0usize], null(*u8)) && c_driver_publish(
        driver,
        binary,
        output
    );
}
fn shader_build(
    context: *CrustContext,
    source: *CrustSource,
    config: *ShaderConfig,
    output: *u8
) -> bool {
    if context -> units != null(*CrustUnit) {
        return native_error(context, "shader build requires an empty context");
    }
    var stage: SpStage = uninit;
    ll_init(&stage.llvm, context);
    stage.llvm.boolean_type = "i1";
    stage.llvm.expression = sp_expression;
    stage.llvm.user = &stage as *u8;
    stage.functions = stage.llvm.types;
    stage.loop_conditions = stage.llvm.types;
    stage.config = config;
    stage.builtins = null(*CrustUnit);
    stage.entry = null(*CrustDecl);
    stage.barrier = null(*CrustDecl);
    stage.current = null(*CrustDecl);
    stage.depth = 0usize;
    var driver: CDriver = make CDriver {
        stage: &stage.llvm.memory,
        options: null(*BackendOptions),
        command: null(**u8),
        temporary: null(*CDriverTemp),
        process_status: 0i32
    };
    var unit_value: *CrustUnit = null(*CrustUnit);
    var success: bool = sp_config(&stage) && sp_prelude(&stage, source -> identity ^ 1u64) && crust_read(
        context,
        source,
        &unit_value
    ) && crust_collect(context) && crust_resolve(context) && crust_check(context) && sp_check(
        &stage
    ) && sp_emit(&stage);
    if success {
        success = sp_tools(&stage, &driver, output);
    }
    if !c_driver_cleanup(&driver, null(*u8)) {
        success = false;
    }
    ll_destroy(&stage.llvm);
    return success;
}
