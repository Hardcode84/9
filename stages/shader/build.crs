fn sp_tools(stage: *SpStage, driver: *CDriver, output: *u8) -> bool {
    var source: *u8 = c_driver_temporary(driver, output, 438u32);
    var binary: *u8 = c_driver_temporary(driver, output, 438u32);
    var normalized: *u8 = c_driver_temporary(driver, output, 438u32);
    if source == null(*u8) || binary == null(*u8) || normalized == null(*u8) {
        return false;
    }
    if !c_driver_write(driver, source, &stage -> llvm.memory.header) {
        return false;
    }
    var context: *CrustContext = ll_context(&stage -> llvm);
    var opt: *u8 = ll_join(&stage -> llvm, stage -> config -> llvm_directory, "/bin/opt");
    var normalize: [*u8; 7] = make [*u8; 7] {
        opt,
        "-S",
        "-passes=mem2reg,structurizecfg",
        source,
        "-o",
        normalized,
        null(*u8)
    };
    if !ll_ok(&stage -> llvm) || !cache_tool(context, &normalize[0usize], null(*u8)) {
        return false;
    }
    var llc: *u8 = ll_join(&stage -> llvm, stage -> config -> llvm_directory, "/bin/llc");
    var arguments: [*u8; 8] = make [*u8; 8] {
        llc,
        "--spirv-ext=+SPV_KHR_float_controls",
        "-O0",
        "-filetype=obj",
        normalized,
        "-o",
        binary,
        null(*u8)
    };
    if !ll_ok(&stage -> llvm) || !cache_tool(context, &arguments[0usize], null(*u8)) {
        return false;
    }
    var validate: [*u8; 5] = make [*u8; 5] {
        stage -> config -> validator,
        "--target-env",
        "vulkan1.2",
        binary,
        null(*u8)
    };
    return cache_tool(context, &validate[0usize], null(*u8)) && c_driver_publish(
        driver,
        binary,
        output
    );
}
fn sp_init(stage: *SpStage, context: *CrustContext, config: *ShaderConfig) -> unit {
    ll_init(&stage -> llvm, context);
    stage -> llvm.boolean_type = "i1";
    stage -> llvm.single_exit = true;
    stage -> llvm.expression = sp_expression;
    stage -> llvm.user = stage as *u8;
    stage -> functions = stage -> llvm.types;
    stage -> used = stage -> llvm.types;
    stage -> reachable = false;
    stage -> floating = false;
    stage -> loop_conditions = stage -> llvm.types;
    stage -> collective = stage -> llvm.types;
    stage -> early_returns = stage -> llvm.types;
    stage -> uniform_loops = stage -> llvm.types;
    stage -> config = config;
    stage -> builtins = null(*CrustUnit);
    stage -> entry = null(*CrustDecl);
    stage -> barrier = null(*CrustDecl);
    stage -> current = null(*CrustDecl);
    stage -> depth = 0usize;
}
fn shader_prepare(context: *CrustContext, config: *ShaderConfig, identity: u64) -> *CrustUnit {
    var stage: SpStage = uninit;
    sp_init(&stage, context, config);
    var unit_value: *CrustUnit = null(*CrustUnit);
    if sp_config(&stage) && sp_prelude(&stage, identity) {
        unit_value = stage.builtins;
    }
    ll_destroy(&stage.llvm);
    return unit_value;
}
fn shader_emit(
    context: *CrustContext,
    config: *ShaderConfig,
    builtins: *CrustUnit,
    ir: *CrustSource
) -> bool {
    var stage: SpStage = uninit;
    sp_init(&stage, context, config);
    stage.builtins = builtins;
    var success: bool = sp_check(&stage) && sp_emit(&stage);
    if success {
        ir -> bytes = crust_try_copy_string(
            context,
            stage.llvm.memory.header.data,
            stage.llvm.memory.header.size
        );
        ir -> size = stage.llvm.memory.header.size;
        ir -> path = "shader-llvm";
        ir -> identity = 0u64;
        success = ir -> bytes != null(*u8);
    }
    ll_destroy(&stage.llvm);
    return success;
}
fn shader_publish(
    context: *CrustContext,
    config: *ShaderConfig,
    ir: *CrustSource,
    output: *u8
) -> bool {
    if config -> llvm_directory == null(*u8) || config -> validator == null(*u8) {
        return native_error(
            context,
            "shader publication requires an explicit LLVM directory and SPIR-V validator"
        );
    }
    var stage: SpStage = uninit;
    sp_init(&stage, context, config);
    c_buffer_bytes(&stage.llvm.memory.header, ir -> bytes, ir -> size);
    var driver: CDriver = make CDriver {
        stage: &stage.llvm.memory,
        options: null(*BackendOptions),
        command: null(**u8),
        temporary: null(*CDriverTemp),
        process_status: 0i32
    };
    var success: bool = ll_ok(&stage.llvm) && sp_tools(&stage, &driver, output);
    if !c_driver_cleanup(&driver, null(*u8)) {
        success = false;
    }
    ll_destroy(&stage.llvm);
    return success;
}
fn shader_build(
    context: *CrustContext,
    source: *CrustSource,
    config: *ShaderConfig,
    output: *u8
) -> bool {
    var builtins: *CrustUnit = shader_prepare(context, config, source -> identity ^ 1u64);
    var unit_value: *CrustUnit = null(*CrustUnit);
    var ir: CrustSource = uninit;
    return builtins != null(*CrustUnit) && crust_read(context, source, &unit_value) && crust_collect(
        context
    ) && crust_resolve(context) && crust_check(context) && shader_emit(
        context,
        config,
        builtins,
        &ir
    ) && shader_publish(context, config, &ir, output);
}
