fn sp_intrinsics(stage: *SpStage) -> unit {
    sp_text(
        stage,
        "target triple = \"spirv1.5-unknown-vulkan1.2\"\n@sp_status_name = private unnamed_addr constant [8 x i8] c\"-status\\00\"\n@sp_failed = internal addrspace(10) global i1 false\ndeclare i32 @llvm.spv.thread.id.i32(i32)\ndeclare i32 @llvm.spv.thread.id.in.group.i32(i32)\ndeclare void @llvm.spv.all.memory.barrier.with.group.sync()\n"
    );
    var kind: u32 = 0u32;
    while kind <= SHADER_IMAGE_R32F {
        var resource: ShaderResource = make ShaderResource {
            name: "",
            kind: kind,
            set: 0u32,
            binding: 0u32,
            length: 1u32,
            height: 0u32
        };
        var type: *u8 = sp_handle_type(&resource);
        var suffix: *u8 = sp_suffix(&resource);
        sp_text(stage, "declare ");
        sp_text(stage, type);
        sp_text(stage, " @llvm.spv.resource.handlefrombinding.");
        sp_text(stage, suffix);
        sp_text(
            stage,
            "(i32, i32, i32, i32, ptr)\ndeclare ptr addrspace(11) @llvm.spv.resource.getpointer.p11."
        );
        sp_text(stage, suffix);
        var coord: *u8 = "i32";
        var overload: *u8 = ".i32";
        if kind == SHADER_IMAGE_R32F {
            coord = "<2 x i32>";
            overload = ".v2i32";
        }
        sp_text(stage, overload);
        sp_text(stage, "(");
        sp_text(stage, type);
        sp_text(stage, ", ");
        sp_text(stage, coord);
        sp_text(stage, ")\n");
        kind = kind + 1u32;
    }
}
fn sp_builtin_body(stage: *SpStage, name: *u8, before: *u8, after: *u8) -> unit {
    sp_text(stage, before);
    sp_text(stage, sp_name(stage, name));
    sp_text(stage, after);
}
fn sp_builtins(stage: *SpStage) -> unit {
    sp_builtin_body(
        stage,
        "shader_global_x",
        "define internal i32 ",
        "() {\n %v = call i32 @llvm.spv.thread.id.i32(i32 0)\n ret i32 %v\n}\n"
    );
    sp_builtin_body(
        stage,
        "shader_local_x",
        "define internal i32 ",
        "() {\n %v = call i32 @llvm.spv.thread.id.in.group.i32(i32 0)\n ret i32 %v\n}\n"
    );
    sp_builtin_body(
        stage,
        "shader_barrier",
        "define internal void ",
        "() convergent {\n call void @llvm.spv.all.memory.barrier.with.group.sync()\n ret void\n}\n"
    );
    sp_builtin_body(
        stage,
        "shader_failed",
        "define internal i1 ",
        "() {\n %v = load i1, ptr addrspace(10) @sp_failed\n ret i1 %v\n}\n"
    );
    sp_builtin_body(
        stage,
        "shader_require",
        "define internal void ",
        "(i1 %ok) {\n %bad = xor i1 %ok, true\n %old = load i1, ptr addrspace(10) @sp_failed\n %v = or i1 %bad, %old\n store i1 %v, ptr addrspace(10) @sp_failed\n ret void\n}\n"
    );
}
fn sp_entry(stage: *SpStage) -> unit {
    sp_text(
        stage,
        "define void @main() #0 {\nentry:\n  %global = call i32 @llvm.spv.thread.id.i32(i32 0)\n  %local = call i32 @llvm.spv.thread.id.in.group.i32(i32 0)\n  store i1 false, ptr addrspace(10) @sp_failed\n"
    );
    var index: usize = 0usize;
    var shared: bool = false;
    while index < stage -> config -> resource_count {
        var resource: *ShaderResource = &stage -> config -> resources[index];
        if resource -> kind == SHADER_WORKGROUP_F32 {
            sp_text(stage, "  call void @init_");
            sp_text(stage, resource -> name);
            sp_text(stage, "(i32 %local)\n");
            shared = true;
        }
        index = index + 1usize;
    }
    if shared {
        sp_text(stage, "  call void @llvm.spv.all.memory.barrier.with.group.sync()\n");
    }
    sp_text(stage, "  call void ");
    sp_text(stage, ll_global(&stage -> llvm, stage -> entry));
    sp_text(stage, "()\n");
    var status: ShaderResource = make ShaderResource {
        name: "",
        kind: SHADER_BUFFER_U32,
        set: stage -> config -> status_set,
        binding: stage -> config -> status_binding,
        length: stage -> config -> invocations,
        height: 0u32
    };
    sp_resource_pointer(stage, &status, "%global");
    sp_text(
        stage,
        "  %failed = load i1, ptr addrspace(10) @sp_failed\n  %code = zext i1 %failed to i32\n  %previous = load i32, ptr addrspace(11) %p, align 4\n  %statuscode = or i32 %previous, %code\n  store i32 %statuscode, ptr addrspace(11) %p, align 4\n  ret void\n}\nattributes #0 = { \"hlsl.numthreads\"=\""
    );
    sp_number(stage, stage -> config -> local_size);
    sp_text(stage, ",1,1\" \"hlsl.shader\"=\"compute\" }\n");
    if stage -> config -> preserve_denorms {
        sp_text(
            stage,
            "!spirv.ExecutionMode = !{!0,!1,!2}\n!0 = !{ptr @main, i32 4459, i32 32}\n"
        );
    } else {
        sp_text(stage, "!spirv.ExecutionMode = !{!1,!2}\n");
    }
    sp_text(stage, "!1 = !{ptr @main, i32 4461, i32 32}\n!2 = !{ptr @main, i32 4462, i32 32}\n");
}
fn sp_emit(stage: *SpStage) -> bool {
    sp_intrinsics(stage);
    sp_builtins(stage);
    var index: usize = 0usize;
    while index < stage -> config -> resource_count && ll_ok(&stage -> llvm) {
        var resource: *ShaderResource = &stage -> config -> resources[index];
        if resource -> kind == SHADER_WORKGROUP_F32 {
            sp_shared_init(stage, resource);
        } else {
            sp_resource_name(stage, resource);
        }
        sp_resource_access(stage, resource, false);
        sp_resource_access(stage, resource, true);
        index = index + 1usize;
    }
    var unit_value: *CrustUnit = ll_context(&stage -> llvm) -> units;
    while unit_value != null(*CrustUnit) && ll_ok(&stage -> llvm) {
        var declaration: *CrustDecl = unit_value -> declarations;
        while declaration != null(*CrustDecl) && ll_ok(&stage -> llvm) {
            if declaration -> kind == CRUST_D_FUNCTION {
                var binding: *LlBinding = ll_bind(&stage -> llvm, declaration, true);
                if binding != null(*LlBinding) {
                    ll_function(&stage -> llvm, binding);
                }
            }
            declaration = declaration -> next;
        }
        unit_value = unit_value -> next;
    }
    sp_entry(stage);
    c_buffer_bytes(
        &stage -> llvm.memory.header,
        stage -> llvm.memory.body.data,
        stage -> llvm.memory.body.size
    );
    return ll_ok(&stage -> llvm);
}
