record SpStage {
    llvm: LlStage;
    functions: CrustMap;
    used: CrustMap;
    loop_conditions: CrustMap;
    collective: CrustMap;
    early_returns: CrustMap;
    uniform_loops: CrustMap;
    config: *ShaderConfig;
    builtins: *CrustUnit;
    entry: *CrustDecl;
    barrier: *CrustDecl;
    current: *CrustDecl;
    depth: usize;
    reachable: bool;
    floating: bool;
}
