const SHADER_BUFFER_F32: u32 = 0u32;
const SHADER_BUFFER_U32: u32 = 1u32;
const SHADER_IMAGE_R32F: u32 = 2u32;
const SHADER_WORKGROUP_F32: u32 = 3u32;
const SHADER_WORKGROUP_U32: u32 = 4u32;
const SHADER_BUFFER_ATOMIC_U32: u32 = 5u32;
const SHADER_WORKGROUP_ATOMIC_U32: u32 = 6u32;

const SHADER_CHECKED: u32 = 0u32;
const SHADER_RAW: u32 = 1u32;
const SHADER_FIXED: u32 = 0u32;
const SHADER_COUNTED: u32 = 1u32;
const SHADER_UNBOUNDED: u32 = 2u32;

const SHADER_COMPUTE: u32 = 0u32;
const SHADER_VERTEX: u32 = 1u32;
const SHADER_FRAGMENT: u32 = 2u32;
const SHADER_LOCATION: u32 = 0u32;
const SHADER_POSITION: u32 = 1u32;
const SHADER_VERTEX_INDEX: u32 = 2u32;
const SHADER_INSTANCE_INDEX: u32 = 3u32;
const SHADER_FRAG_COORD: u32 = 4u32;
const SHADER_SMOOTH: u32 = 0u32;
const SHADER_FLAT: u32 = 1u32;
const SHADER_NOPERSPECTIVE: u32 = 2u32;

// Each interface provides name_load(component) or name_store(component, value).
// Components are in [0, components). Each output component must be written.
// kind is SHADER_BUFFER_F32 or SHADER_BUFFER_U32. Location interfaces use slot.
record ShaderInterface {
    name: *u8;
    kind: u32;
    components: u32;
    semantic: u32;
    slot: u32;
    interpolation: u32;
    output: bool;
}

// Buffers use length elements at stride four. Images use length by height texels.
// COUNTED buffers use a u32 count header and length zero; payload follows it.
// UNBOUNDED buffers have no header and require RAW execution and length zero.
// The caller must bind the header and at least that many four-byte elements.
// Workgroup arrays use length elements; set and binding must be zero.
record ShaderResource {
    name: *u8;
    kind: u32;
    layout: u32;
    set: u32;
    binding: u32;
    length: u32;
    height: u32;
}
// Dispatch at most invocations/local_size groups along X, and one along Y/Z.
// Status accumulates failure across ordered dispatches. Clear it before a sequence.
// Only dispatched invocations write status.
// The caller enforces the dispatch bound; the entry does not check it.
// CHECKED execution uses a separate status buffer of invocations u32 elements.
// RAW execution requires valid arithmetic and accesses; it has no status or automatic initialization.
record ShaderConfig {
    resources: *ShaderResource;
    interfaces: *ShaderInterface;
    entry: *u8;
    llvm_directory: *u8;
    validator: *u8;
    resource_count: usize;
    interface_count: usize;
    stage: u32;
    execution: u32;
    invocations: u32;
    local_size: u32;
    status_set: u32;
    status_binding: u32;
    preserve_denorms: bool;
}

fn shader_workgroup(kind: u32) -> bool {
    return kind == SHADER_WORKGROUP_F32 || kind == SHADER_WORKGROUP_U32 || kind == SHADER_WORKGROUP_ATOMIC_U32;
}

fn shader_checked(config: *ShaderConfig) -> bool {
    return config -> execution == SHADER_CHECKED;
}

fn shader_atomic(kind: u32) -> bool {
    return kind == SHADER_BUFFER_ATOMIC_U32 || kind == SHADER_WORKGROUP_ATOMIC_U32;
}
fn shader_integer(kind: u32) -> bool {
    return kind == SHADER_BUFFER_U32 || kind == SHADER_WORKGROUP_U32 || shader_atomic(kind);
}
fn shader_buffer(kind: u32) -> bool {
    return kind == SHADER_BUFFER_F32 || kind == SHADER_BUFFER_U32 || kind == SHADER_BUFFER_ATOMIC_U32;
}
