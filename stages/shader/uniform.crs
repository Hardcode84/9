fn sp_uniform_prelude(out: *CBuffer, r: *ShaderResource) -> unit {
    if !shader_workgroup(r -> kind) || shader_atomic(r -> kind) {
        return;
    }
    c_buffer_text(out, "extern fn ");
    c_buffer_text(out, r -> name);
    c_buffer_text(out, "_uniform_load(index:u32)->");
    var type: *u8 = "f32";
    if r -> kind == SHADER_WORKGROUP_U32 {
        type = "u32";
    }
    c_buffer_text(out, type);
    c_buffer_text(out, "=\"");
    c_buffer_text(out, r -> name);
    c_buffer_text(out, "_uniform_load\";\n");
}
fn sp_uniform_access(stage: *SpStage, r: *ShaderResource) -> unit {
    if !shader_workgroup(r -> kind) || shader_atomic(r -> kind) {
        return;
    }
    var name: *u8 = ll_join(&stage -> llvm, r -> name, "_uniform_load");
    if !sp_used(stage, name) {
        return;
    }
    var type: *u8 = sp_resource_type(r);
    sp_text(stage, "define internal ");
    sp_text(stage, type);
    sp_text(stage, " ");
    sp_text(stage, sp_name(stage, name));
    sp_text(stage, "(i32 %index) convergent {\nentry:\n");
    if shader_checked(stage -> config) {
        sp_resource_bounds(stage, r);
        sp_text(stage, "  br i1 %bad, label %invalid, label %valid\ninvalid:\n  ret ");
        sp_text(stage, type);
        sp_text(stage, " zeroinitializer\nvalid:\n");
    }
    sp_text(stage, "  call void @llvm.spv.group.memory.barrier.with.group.sync()\n");
    sp_resource_pointer(stage, r, "%index");
    sp_text(stage, "  %value = load ");
    sp_text(stage, type);
    sp_text(
        stage,
        ", ptr addrspace(3) %p, align 4\n  call void @llvm.spv.group.memory.barrier.with.group.sync()\n  ret "
    );
    sp_text(stage, type);
    sp_text(stage, " %value\n}\n");
}
fn wg_uniform_access(stage: *SpStage, r: *ShaderResource) -> unit {
    if !shader_workgroup(r -> kind) || shader_atomic(r -> kind) {
        return;
    }
    sp_text(stage, "fn s_");
    sp_text(stage, r -> name);
    sp_text(stage, "_uniform_load(index: u32) -> ");
    wg_resource_type(stage, r);
    sp_text(stage, " { ");
    if shader_checked(stage -> config) {
        sp_text(stage, "if (index >= ");
        sp_number(stage, r -> length);
        sp_text(stage, "u) { failed = true; return ");
        wg_zero(stage, r);
        sp_text(stage, "; } ");
    }
    sp_text(stage, "return workgroupUniformLoad(&r_");
    sp_text(stage, r -> name);
    sp_text(stage, "[index]); }\n");
}
