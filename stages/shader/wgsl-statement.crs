fn wg_block(stage: *SpStage, input: *CrustStmt) -> unit {
    sp_text(stage, "{\n");
    if input -> kind == CRUST_S_BLOCK {
        var child: *CrustStmt = input -> body;
        while child != null(*CrustStmt) {
            wg_statement(stage, child);
            child = child -> next;
        }
    } else {
        wg_statement(stage, input);
    }
    sp_text(stage, "}\n");
}
fn wg_control(stage: *SpStage, input: *CrustStmt) -> unit {
    var kind: u32 = input -> kind;
    if kind == CRUST_S_BLOCK {
        wg_block(stage, input);
        return;
    }
    var keyword: *u8 = "if (";
    if kind == CRUST_S_WHILE {
        keyword = "while (";
    }
    sp_text(stage, keyword);
    wg_expression(stage, input -> expr);
    sp_text(stage, ") ");
    wg_block(stage, input -> body);
    if input -> otherwise != null(*CrustStmt) {
        sp_text(stage, "else ");
        wg_block(stage, input -> otherwise);
    }
}
fn wg_statement(stage: *SpStage, input: *CrustStmt) -> unit {
    var kind: u32 = input -> kind;
    if kind == CRUST_S_BLOCK || kind == CRUST_S_IF || kind == CRUST_S_WHILE {
        wg_control(stage, input);
        return;
    }
    if kind == CRUST_S_VAR {
        sp_text(stage, "var ");
        wg_name(stage, input -> symbol -> name);
        sp_text(stage, ": ");
        wg_type(stage, input -> symbol -> type -> kind);
        sp_text(stage, " = ");
        wg_expression(stage, input -> value);
    } else {
        wg_effect(stage, input);
    }
    sp_text(stage, ";\n");
}
fn wg_effect(stage: *SpStage, input: *CrustStmt) -> unit {
    var kind: u32 = input -> kind;
    if kind == CRUST_S_ASSIGN {
        wg_expression(stage, input -> expr);
        sp_text(stage, " = ");
        wg_expression(stage, input -> value);
        return;
    }
    if kind == CRUST_S_RETURN {
        sp_text(stage, "return");
        if input -> expr != null(*CrustExpr) {
            sp_text(stage, " ");
            wg_expression(stage, input -> expr);
        }
        return;
    }
    if kind == CRUST_S_BREAK {
        sp_text(stage, "break");
        return;
    }
    if kind == CRUST_S_CONTINUE {
        sp_text(stage, "continue");
        return;
    }
    if kind == CRUST_S_EXPR {
        if input -> expr -> type -> kind != CRUST_T_UNIT {
            sp_text(stage, "_ = ");
        }
        wg_expression(stage, input -> expr);
        return;
    }
    sp_error(stage, "WGSL statement is not supported by the shader contract");
}
fn wg_function(stage: *SpStage, decl: *CrustDecl) -> unit {
    sp_text(stage, "fn ");
    wg_name(stage, decl -> name);
    sp_text(stage, "(");
    var p: *CrustParam = decl -> params;
    while p != null(*CrustParam) {
        if p != decl -> params {
            sp_text(stage, ", ");
        }
        sp_text(stage, "p_");
        sp_text(stage, p -> name -> text);
        sp_text(stage, ": ");
        wg_type(stage, p -> type -> kind);
        p = p -> next;
    }
    sp_text(stage, ")");
    if decl -> type -> base -> kind != CRUST_T_UNIT {
        sp_text(stage, " -> ");
        wg_type(stage, decl -> type -> base -> kind);
    }
    sp_text(stage, " {\n");
    p = decl -> params;
    while p != null(*CrustParam) {
        sp_text(stage, "var ");
        wg_name(stage, p -> name);
        sp_text(stage, " = p_");
        sp_text(stage, p -> name -> text);
        sp_text(stage, ";\n");
        p = p -> next;
    }
    wg_statement(stage, decl -> body);
    sp_text(stage, "}\n");
}
