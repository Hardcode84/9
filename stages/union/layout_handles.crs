// Declaration, layout, and location handles contain live non-null addresses.
// Cursors use null for the end. A size with zero alignment ends iteration;
// the context diagnostic distinguishes a failed step. Keep the arena live
// through the edit scope. Only context destruction retires its storage.
domain CompilerArena(SuArena,SuDeclaration,SuLayoutHandle,SuLocation,SuFields,SuVariants);
record SuArena{stage:*SuStage;} opaque;
record SuDeclaration{pointer:*CrustDecl;} opaque scoped;
record SuLayoutHandle{pointer:*SuLayout;} opaque scoped;
record SuLocation{pointer:*CrustLoc;} opaque scoped;
record SuFields{next:*CrustField;location:*CrustLoc;} opaque scoped;
record SuVariants{names:CrustMap;next:*SuVariant;} opaque scoped;
record SuSize{size:u64;align:u32;}
record SuLayoutData{size:u64;align:u32;state:u32;}

fn su_handle_publish(arena:read SuArena,decl:read SuDeclaration,layout:read SuLayoutHandle)->bool access(edit,CompilerArena){
    return crust_try_map_set(arena.stage->context,&arena.stage->layouts,decl.pointer as usize,layout.pointer as *u8);
}
fn su_handle_load(layout:read SuLayoutHandle)->SuLayoutData access(read,CompilerArena){
    return make SuLayoutData{size:layout.pointer->size,align:layout.pointer->align,state:layout.pointer->state};
}
fn su_handle_save(layout:read SuLayoutHandle,value:read SuLayoutData)->unit access(edit,CompilerArena){
    layout.pointer->size=value.size;layout.pointer->align=value.align;layout.pointer->state=value.state;
}
fn su_handle_fill(arena:read SuArena,decl:read SuDeclaration,layout:read SuLayoutHandle,depth:usize)->bool access(edit,CompilerArena){
    var sum:*SuType=su_cache_get!(SuType)(&arena.stage->types,decl.pointer->name as usize);
    if sum!=null(*SuType){
        var cursor:SuVariants=make SuVariants{names:make CrustMap{entries:null(*CrustMapEntry),count:0usize,capacity:0usize},next:sum->variants};
        return su_checked_variants(read arena,read decl,read layout,mut cursor,depth);
    }
    var cursor:SuFields=make SuFields{next:decl.pointer->fields,location:&decl.pointer->loc};
    return su_checked_fields(read arena,read decl,read layout,mut cursor,depth);
}
fn su_fields_next(arena:read SuArena,cursor:mut SuFields,depth:usize)->SuSize access(edit,CompilerArena){
    var value:SuSize=make SuSize{size:0u64,align:0u32};
    var field:*CrustField=cursor.next;
    if field==null(*CrustField){return value;}
    cursor.location=&field->loc;cursor.next=field->next;
    if !su_layout_syntax(arena.stage,field->syntax_type,depth,&value.size,&value.align){value.align=0u32;}
    return value;
}
fn su_fields_location(cursor:read SuFields)->SuLocation access(read,CompilerArena){
    return make SuLocation{pointer:cursor.location};
}
fn su_variants_next(arena:read SuArena,cursor:mut SuVariants,depth:usize)->SuSize access(edit,CompilerArena){
    var value:SuSize=make SuSize{size:0u64,align:0u32};
    var variant:*SuVariant=cursor.next;
    if variant==null(*SuVariant){return value;}
    cursor.next=variant->next;
    if su_cache_get!(SuVariant)(&cursor.names,variant->name as usize)!=null(*SuVariant){
        su_error(arena.stage,&variant->syntax->loc,"duplicate union variant");return value;
    }
    if !crust_try_map_set(arena.stage->context,&cursor.names,variant->name as usize,variant as *u8){return value;}
    value.align=1u32;
    if variant->syntax->kind!=CRUST_T_UNIT {
        if !su_layout_syntax(arena.stage,variant->syntax,depth,&value.size,&value.align){value.align=0u32;}
    }
    return value;
}
fn su_handle_storage(arena:read SuArena,decl:read SuDeclaration,size:u64,alignment:u32)->bool access(edit,CompilerArena){
    var sum:*SuType=su_cache_get!(SuType)(&arena.stage->types,decl.pointer->name as usize);
    // A record has no tagged storage to generate.
    if sum==null(*SuType){return true;}
    return su_storage_field(arena.stage,sum,size,alignment);
}
fn su_handle_location(decl:read SuDeclaration)->SuLocation access(read,CompilerArena){return make SuLocation{pointer:&decl.pointer->loc};}
fn su_handle_empty(arena:read SuArena,decl:read SuDeclaration)->unit access(edit,CompilerArena){su_error(arena.stage,&decl.pointer->loc,"records must have at least one field");}
fn su_handle_round(arena:read SuArena,decl:read SuDeclaration,size:u64,align:u32)->u64 access(edit,CompilerArena){
    var location:SuLocation=make SuLocation{pointer:&decl.pointer->loc};
    return su_checked_round(read arena,read location,size,align);
}
fn su_layout_diagnostic(arena:read SuArena,location:read SuLocation,code:u32)->unit access(edit,CompilerArena){
    var message:*u8="union layout exceeds isize limit";
    if code==1u32{message="array count must be positive";}
    if code==2u32{message="union payload array exceeds isize limit";}
    if code==3u32{message="record payload exceeds isize limit";}
    if code==4u32{message="tagged storage exceeds isize limit";}
    su_error(arena.stage,location.pointer,message);
}

fn su_handle_error(arena:read SuArena,decl:read SuDeclaration,cycle:bool)->unit access(edit,CompilerArena){
    if cycle{su_error(arena.stage,&decl.pointer->loc,"by-value cycle in union payload");}
    else{su_error(arena.stage,&decl.pointer->loc,"union layout depth exceeded");}
}
fn su_handle_failed(arena:read SuArena)->bool access(read,CompilerArena){return arena.stage->context->error_count!=0usize;}

fn su_layout_record(stage:*SuStage,decl:*CrustDecl,depth:usize)->*SuLayout {
    domain CompilerArena { edit CompilerArena {
        var arena:SuArena=make SuArena{stage:stage};
        var declaration:SuDeclaration=make SuDeclaration{pointer:decl};
        if !su_checked_layout_depth(read arena,read declaration,depth){return null(*SuLayout);}
        var pointer:*SuLayout=su_cache_get!(SuLayout)(&stage->layouts,decl as usize);
        if pointer==null(*SuLayout){
            pointer=su_alloc(stage,sizeof(SuLayout),alignof(SuLayout)) as *SuLayout;
            if pointer==null(*SuLayout){return pointer;}
            pointer->declaration=decl;
        }
        var layout:SuLayoutHandle=make SuLayoutHandle{pointer:pointer};
        if !su_checked_layout_record(read arena,read declaration,read layout,depth){return null(*SuLayout);}
        return pointer;
    } }
}

fn su_cache_get!(Value)(cache:*CrustMap,key:usize)->*Value {
    return crust_map_get(cache,key) as *Value;
}
