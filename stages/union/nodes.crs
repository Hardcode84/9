// Builder locations and arena storage stay live through the access scope.
// Node handles can be empty. Allocation failure remains in the context until
// the caller rejects the build; an empty handle never permits a dereference.
record SuBuilder{stage:*SuStage;location:*CrustLoc;} opaque scoped;
record SuName{pointer:*CrustName;} opaque scoped;
record SuSyntax{pointer:*CrustTypeSyntax;} opaque scoped;
record SuExpression{pointer:*CrustExpr;} opaque scoped;
record SuStatement{pointer:*CrustStmt;} opaque scoped;

fn su_fresh(builder:read SuBuilder)->SuName access(edit,CompilerArena){
    var stage:*SuStage=builder.stage;
    var bytes:[u8;32]=uninit;
    var cursor:usize=32usize;var number:usize=stage->serial;
    stage->serial=stage->serial+1usize;
    while true {
        cursor=cursor-1usize;bytes[cursor]=(number%10usize) as u8+48u8;number=number/10usize;
        if number==0usize { break; }
    }
    cursor=cursor-1usize;bytes[cursor]=36u8;
    return make SuName{pointer:crust_try_intern(stage->context,&bytes[cursor],32usize-cursor)};
}

fn su_named(builder:read SuBuilder,name:read SuName)->SuSyntax access(edit,CompilerArena){
    var result:*CrustTypeSyntax=su_type(builder.stage,CRUST_T_NAME,builder.location);
    if result!=null(*CrustTypeSyntax){result->name=name.pointer;}
    return make SuSyntax{pointer:result};
}
fn su_name(builder:read SuBuilder,name:read SuName)->SuExpression access(edit,CompilerArena){
    var result:*CrustExpr=su_expr(builder.stage,CRUST_E_NAME,builder.location);
    if result!=null(*CrustExpr){result->name=name.pointer;}
    return make SuExpression{pointer:result};
}
fn su_unary(builder:read SuBuilder,op:u32,operand:read SuExpression)->SuExpression access(edit,CompilerArena){
    var result:*CrustExpr=su_expr(builder.stage,CRUST_E_UNARY,builder.location);
    if result!=null(*CrustExpr){result->op=op;result->left=operand.pointer;}
    return make SuExpression{pointer:result};
}
fn su_tag(builder:read SuBuilder,base:read SuExpression)->SuExpression access(edit,CompilerArena){
    var result:*CrustExpr=su_expr(builder.stage,CRUST_E_FIELD,builder.location);
    if result!=null(*CrustExpr){result->left=base.pointer;result->field_name=builder.stage->tag_name;}
    return make SuExpression{pointer:result};
}
fn su_number(builder:read SuBuilder,value:u32)->SuExpression access(edit,CompilerArena){
    var result:*CrustExpr=su_expr(builder.stage,CRUST_E_INTEGER,builder.location);
    if result!=null(*CrustExpr){result->integer=value as u64;result->literal_type=CRUST_T_U32;}
    return make SuExpression{pointer:result};
}
fn su_pointer(builder:read SuBuilder,base:read SuSyntax)->SuSyntax access(edit,CompilerArena){
    var result:*CrustTypeSyntax=su_type(builder.stage,CRUST_T_POINTER,builder.location);
    if result!=null(*CrustTypeSyntax){result->base=base.pointer;}
    return make SuSyntax{pointer:result};
}
fn su_variable(builder:read SuBuilder,name:read SuName,syntax:read SuSyntax,value:read SuExpression)->SuStatement access(edit,CompilerArena){
    var result:*CrustStmt=su_stmt(builder.stage,CRUST_S_VAR,builder.location);
    if result!=null(*CrustStmt){result->name=name.pointer;result->syntax_type=syntax.pointer;result->value=value.pointer;}
    return make SuStatement{pointer:result};
}
fn su_assign(builder:read SuBuilder,place:read SuExpression,value:read SuExpression)->SuStatement access(edit,CompilerArena){
    var result:*CrustStmt=su_stmt(builder.stage,CRUST_S_ASSIGN,builder.location);
    if result!=null(*CrustStmt){result->expr=place.pointer;result->value=value.pointer;}
    return make SuStatement{pointer:result};
}
fn su_block(builder:read SuBuilder,body:read SuStatement)->SuStatement access(edit,CompilerArena){
    var result:*CrustStmt=su_stmt(builder.stage,CRUST_S_BLOCK,builder.location);
    if result!=null(*CrustStmt){result->body=body.pointer;}
    return make SuStatement{pointer:result};
}
fn su_equal(builder:read SuBuilder,left:read SuExpression,right:read SuExpression)->SuExpression access(edit,CompilerArena){
    var result:*CrustExpr=su_expr(builder.stage,CRUST_E_BINARY,builder.location);
    if result!=null(*CrustExpr){result->op=CRUST_OP_EQ;result->left=left.pointer;result->right=right.pointer;}
    return make SuExpression{pointer:result};
}
// Link a single first statement to the next fragment. An empty first fragment
// returns the next fragment. Keep all fragments in the same arena access scope.
fn su_sequence(first:read SuStatement,next:read SuStatement)->SuStatement access(edit,CompilerArena){
    if first.pointer==null(*CrustStmt){return make SuStatement{pointer:next.pointer};}
    first.pointer->next=next.pointer;
    return make SuStatement{pointer:first.pointer};
}
fn su_has_expression(value:read SuExpression)->bool access(read,CompilerArena){return value.pointer!=null(*CrustExpr);}
fn su_has_name(value:read SuName)->bool access(read,CompilerArena){return value.pointer!=null(*CrustName);}
fn su_no_statements()->SuStatement access(read,CompilerArena){return make SuStatement{pointer:null(*CrustStmt)};}
fn su_build_error(builder:read SuBuilder,payload:bool)->unit access(edit,CompilerArena){
    if payload{su_error(builder.stage,builder.location,"construction requires the variant payload, or no payload for unit");}
    else{su_error(builder.stage,builder.location,"unit variant has no binding");}
}
fn su_payload(builder:read SuBuilder,base:read SuExpression,syntax:read SuSyntax)->SuExpression access(edit,CompilerArena){
    var storage:*CrustExpr=su_expr(builder.stage,CRUST_E_FIELD,builder.location);
    var address:*CrustExpr=su_expr(builder.stage,CRUST_E_UNARY,builder.location);
    var cast:*CrustExpr=su_expr(builder.stage,CRUST_E_CAST,builder.location);
    var pointer:*CrustTypeSyntax=su_type(builder.stage,CRUST_T_POINTER,builder.location);
    var result:*CrustExpr=su_expr(builder.stage,CRUST_E_UNARY,builder.location);
    if builder.stage->context->error_count==0usize{
        storage->left=base.pointer;storage->field_name=builder.stage->storage_name;
        address->op=CRUST_OP_ADDRESS;address->left=storage;
        cast->left=address;cast->syntax_type=pointer;pointer->base=syntax.pointer;
        result->op=CRUST_OP_DEREF;result->left=cast;
    }
    return make SuExpression{pointer:result};
}
