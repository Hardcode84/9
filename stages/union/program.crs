// The native entry owns both frames until the checked driver returns.
record SuDriver{cli:*CCli;stage:*SuStage;} opaque scoped;
fn su_input_root(driver:read SuDriver)->bool access(edit,CompilerArena){
    var cli:*CCli=driver.cli;
    if cli->root==null(*CrustSource){return true;}
    return su_read(driver.stage,cli->root,cli->target_begin,cli->root->size);
}
fn su_input_count(driver:read SuDriver)->usize access(read,CompilerArena){return driver.cli->source_count;}
fn su_input_read(driver:read SuDriver,index:usize)->bool access(edit,CompilerArena){
    if index>=driver.cli->source_count{
        crust_set_error(driver.stage->context,null(*CrustSource),0usize,"union input index out of range");return false;
    }
    var source:*CrustSource=&driver.cli->sources[index];
    var bytes:*u8=null(*u8);var size:usize=0usize;
    if crust0_host_read_file(source->path,&bytes,&size)!=0i32{
        c_driver_io_error(&driver.cli->driver,"cannot read input",source->path,*c_driver_errno());return false;
    }
    source->bytes=crust_try_copy_string(driver.stage->context,bytes,size);source->size=size;
    crust0_host_free(bytes);
    return source->bytes!=null(*u8) && su_read(driver.stage,source,0usize,size);
}
fn su_exports(driver:read SuDriver)->bool access(edit,CompilerArena){return c_driver_exports(driver.cli);}
fn su_names(driver:read SuDriver)->bool access(edit,CompilerArena){return c_driver_names(&driver.cli->driver);}
fn su_driver_mode(driver:read SuDriver)->u32 access(read,CompilerArena){return driver.cli->mode;}
fn su_output(driver:read SuDriver,emit:bool)->i32 access(edit,CompilerArena){
    var entry:*CrustDecl=null(*CrustDecl);
    if !driver.cli->library{entry=c_driver_entry(driver.cli);if entry==null(*CrustDecl){return 1i32;}}
    if emit{if c_emit(&driver.cli->stage,entry){return 0i32;}return 1i32;}
    return c_backend_build(driver.stage->context,entry,&driver.cli->options);
}
fn su_inputs(cli:*CCli,stage:*SuStage)->bool{
    domain CompilerArena{edit CompilerArena{
        var driver:SuDriver=make SuDriver{cli:cli,stage:stage};return su_checked_inputs(read driver);
    }}
}
fn su_driver_build(cli:*CCli,stage:*SuStage)->i32{
    domain CompilerArena{edit CompilerArena{
        var driver:SuDriver=make SuDriver{cli:cli,stage:stage};
        var arena:SuArena=make SuArena{stage:stage};
        return su_checked_driver(read driver,read arena);
    }}
}

// Require an empty initialized context. Keep request source bytes live until context destruction.
// Accept C-driver options. Retain diagnostics and return the build status.
fn union_program(request:*CrustBuild)->i32{
    var cli:CCli=uninit;var stage:SuStage=uninit;var result:i32=1i32;
    var success:bool=c_driver_init(&cli,request->context,request->argc);
    cli.root=request->source;cli.target_begin=request->target_begin;
    if success && su_init(&stage,request->context) && c_driver_parse(&cli,request->argc,request->argv,0i32){
        result=su_driver_build(&cli,&stage);
    }
    c_stage_destroy(&cli.stage);return result;
}
