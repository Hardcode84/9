record BodyTest {
    helper: *CrustDecl;
    helper_body: *CrustStmt;
    entry_body: *CrustStmt;
    calls: usize;
    mode: u32;
}

fn body_test_length(text:*u8)->usize {
    var size:usize = 0usize;
    while text[size] != 0u8 { size = size + 1usize; }
    return size;
}

fn body_test_equal(left:*u8, right:*u8)->bool {
    var index:usize = 0usize;
    while left[index] == right[index] {
        if left[index] == 0u8 { return true; }
        index = index + 1usize;
    }
    return false;
}

fn body_test_emit(stage:*CStage, declaration:*CrustDecl, opaque:*u8)->bool {
    var state:*BodyTest = opaque as *BodyTest;
    (*state).calls = (*state).calls + 1usize;
    if (*declaration).body != null(*CrustStmt) { return false; }
    if (*state).mode == 1u32 { return false; }
    if (*state).mode == 2u32 {
        c_error(&(*stage).status, (*declaration).loc.source, (*declaration).loc.offset, "selected body failure");
        return false;
    }
    if (*state).mode == 3u32 {
        crust_set_error((*stage).status.context, (*declaration).loc.source,
                      (*declaration).loc.offset, "selected context failure");
        return true;
    }
    var body:*CrustStmt = (*state).entry_body;
    if declaration == (*state).helper { body = (*state).helper_body; }
    c_text(stage, "{\n");
    var statement:*CrustStmt = (*body).body;
    while statement != null(*CrustStmt) {
        if (*statement).kind == CRUST_S_RETURN {
            var value:usize = c_expression(stage, (*statement).expr);
            c_text(stage, "goto extension_exit;\nextension_exit:\nreturn ");
            if declaration == (*state).helper { c_value(stage, value); }
            else {
                c_text(stage, "r_i32((uint32_t)((uint64_t)");
                c_value(stage, value);
                c_text(stage, "+UINT64_C(42)))");
            }
            c_text(stage, ";\n");
        } else { c_statement(stage, statement); }
        statement = (*statement).next;
    }
    c_text(stage, "}\n");
    return !(*stage).status.failed;
}

fn main(argc:i32, argv:**u8)->i32 {
    if argc != 3i32 { return 1i32; }
    var context:CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var text:*u8 = "fn helper(x:i32)->i32 { var result:i32=x+increment; return result; } fn entry(argc:i32,argv:**u8)->i32 { return helper(argc)-2i32; } const increment:i32=1i32; extern fn absent()->unit=\"body_absent\";";
    var source:CrustSource = make CrustSource {identity:1u64, path:"body-input", bytes:text, size:body_test_length(text)};
    var parsed:*CrustUnit = null(*CrustUnit);
    if !crust_read(&context, &source, &parsed) || !crust_collect(&context) ||
       !crust_resolve(&context) || !crust_check(&context) { return 2i32; }
    var helper:*CrustDecl = (*parsed).declarations;
    var entry:*CrustDecl = (*helper).next;
    var constant:*CrustDecl = (*entry).next;
    var external:*CrustDecl = (*constant).next;
    (*helper).link_name = "";
    (*constant).link_name = "";
    (*entry).link_name = "body_entry";
    var state:BodyTest = make BodyTest {
        helper:helper, helper_body:(*helper).body, entry_body:(*entry).body,
        calls:0usize, mode:0u32
    };
    (*helper).body = null(*CrustStmt);
    (*entry).body = null(*CrustStmt);
    var stage:CStage = uninit;
    state.mode = 1u32;
    while state.mode <= 3u32 {
        context.error_count = 0usize;
        context.error[0usize] = 0u8;
        state.calls = 0usize;
        c_stage_init(&stage, &context);
        if c_emit_with_body(&stage, entry, body_test_emit, &state as *u8) ||
           !stage.status.failed || state.calls != 1usize || context.error_count != 1usize {
            return 3i32;
        }
        var expected:*u8 = "C function body callback failed";
        if state.mode == 2u32 { expected = "selected body failure"; }
        if state.mode == 3u32 { expected = "selected context failure"; }
        if !body_test_equal(&context.error[0usize], expected) || context.error_loc.source != &source {
            return 4i32;
        }
        c_stage_destroy(&stage);
        if stage.status.blocks != null(*CBlock) { return 5i32; }
        state.mode = state.mode + 1u32;
    }
    context.error_count = 0usize;
    context.error[0usize] = 0u8;
    state.mode = 0u32;
    state.calls = 0usize;
    (*external).link_name = "";
    c_stage_init(&stage, &context);
    if c_emit_with_body(&stage, entry, body_test_emit, &state as *u8) ||
       !stage.status.failed || state.calls != 0usize || context.error_count != 1usize ||
       !body_test_equal(&context.error[0usize], "private C linkage requires a definition in this output") {
        return 7i32;
    }
    c_stage_destroy(&stage);
    (*external).link_name = "body_absent";
    context.error_count = 0usize;
    context.error[0usize] = 0u8;
    var flags:[*u8;1] = make [*u8;1] {"-O0"};
    var options:CBackendOptions = make CBackendOptions {
        mode:0u32, output:argv[1usize], symbols:null(*u8),
        cflags:&flags[0usize], cflag_count:1usize, ldflags:null(**u8), ldflag_count:0usize
    };
    var result:i32 = c_backend_build_with_body(&context, entry, &options, body_test_emit, &state as *u8);
    if result == 0i32 && (state.calls != 2usize || (*helper).body != null(*CrustStmt) ||
                         (*entry).body != null(*CrustStmt)) { result = 6i32; }
    crust_context_destroy(&context);
    if result == 0i32 { result = body_dag_test(argv[2usize]); }
    return result;
}

record BodyDag { callback:*CrustDecl; alias:*CrustDecl; }

fn body_dag_type(context:*CrustContext, leaf:*CrustType)->*CrustType {
    var result:*CrustType = leaf;
    var depth:usize = 0usize;
    while depth < 40usize {
        var node:*CrustType = crust_try_alloc(context, sizeof(CrustType), alignof(CrustType)) as *CrustType;
        var params:**CrustType = crust_try_alloc(context, 2usize * sizeof(*CrustType), alignof(*CrustType)) as **CrustType;
        if node == null(*CrustType) || params == null(**CrustType) { return null(*CrustType); }
        params[0usize] = result;
        params[1usize] = result;
        *node = make CrustType {
            kind:CRUST_T_FUNCTION, size:8u64, align:8u32,
            base:&(*context).builtins[CRUST_T_UNIT as usize], count:0u64, params:params,
            param_count:2usize, record_decl:null(*CrustDecl)
        };
        result = node;
        depth = depth + 1usize;
    }
    return result;
}

fn body_dag_signature(declaration:*CrustDecl, signature:*CrustType)->unit {
    (*declaration).type = signature;
    (*(*declaration).symbol).type = signature;
    var parameter:*CrustParam = (*declaration).params;
    var index:usize = 0usize;
    while parameter != null(*CrustParam) {
        (*parameter).type = (*signature).params[index];
        if (*parameter).symbol != null(*CrustSymbol) {
            (*(*parameter).symbol).type = (*parameter).type;
        }
        parameter = (*parameter).next;
        index = index + 1usize;
    }
}

fn body_dag_emit(stage:*CStage, declaration:*CrustDecl, user:*u8)->bool {
    var state:*BodyDag = user as *BodyDag;
    if declaration == (*state).callback { c_text(stage, "{}\n"); }
    else {
        c_text(stage, "{\n");
        c_global(stage, (*state).alias);
        c_text(stage, "(0,0);\nreturn ");
        c_global(stage, (*state).callback);
        c_text(stage, "==");
        c_global(stage, (*state).alias);
        c_text(stage, "?0:1;\n}\n");
    }
    return !(*stage).status.failed;
}

fn body_dag_test(output:*u8)->i32 {
    var context:CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var text:*u8 = "fn callback(a:fn()->unit,b:fn()->unit)->unit{} extern fn alias(a:fn()->unit,b:fn()->unit)->unit=\"dag_shared\"; fn entry(argc:i32,argv:**u8)->i32{return 0i32;}";
    var source:CrustSource = make CrustSource {identity:1u64, path:"body-type-dag", bytes:text, size:body_test_length(text)};
    var parsed:*CrustUnit = null(*CrustUnit);
    if !crust_read(&context, &source, &parsed) || !crust_collect(&context) ||
       !crust_resolve(&context) || !crust_check(&context) { return 10i32; }
    var callback:*CrustDecl = (*parsed).declarations;
    var alias:*CrustDecl = (*callback).next;
    var entry:*CrustDecl = (*alias).next;
    var left:*CrustType = body_dag_type(&context, &context.builtins[CRUST_T_ISIZE as usize]);
    var right:*CrustType = body_dag_type(&context, &context.builtins[CRUST_T_I64 as usize]);
    if left == null(*CrustType) || right == null(*CrustType) { return 11i32; }
    body_dag_signature(callback, left);
    body_dag_signature(alias, right);
    (*callback).body = null(*CrustStmt);
    (*entry).body = null(*CrustStmt);
    (*callback).link_name = "dag_shared";
    (*entry).link_name = "dag_entry";
    var state:BodyDag = make BodyDag {callback:callback, alias:alias};
    var options:CBackendOptions = make CBackendOptions {
        mode:0u32, output:output, symbols:null(*u8),
        cflags:null(**u8), cflag_count:0usize, ldflags:null(**u8), ldflag_count:0usize
    };
    var result:i32 = c_backend_build_with_body(&context, entry, &options, body_dag_emit, &state as *u8);
    if result == 0i32 {
        var leaf:*CrustType = right;
        while (*(*leaf).params[0usize]).kind == CRUST_T_FUNCTION { leaf = (*leaf).params[0usize]; }
        (*leaf).params[0usize] = &context.builtins[CRUST_T_U64 as usize];
        var stage:CStage = uninit;
        c_stage_init(&stage, &context);
        if c_emit_with_body(&stage, entry, body_dag_emit, &state as *u8) ||
           !stage.status.failed || context.error_count != 1usize ||
           !body_test_equal(&context.error[0usize], "conflicting native ABI for symbol") {
            result = 12i32;
        }
        c_stage_destroy(&stage);
    }
    crust_context_destroy(&context);
    return result;
}
