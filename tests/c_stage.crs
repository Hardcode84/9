// The Linux x86-64 oom mode checks host allocation failure and writes no output.
fn c_test_oom() -> i32 {
    var context: CrustContext = uninit;
    context.error_count = 0usize;
    var stage: CStage = uninit;
    c_stage_init(&stage, &context);
    if c_alloc(&stage.status, 1usize << 60usize, 8usize) != null(*u8) ||
       !stage.status.failed || context.error_count != 1usize || context.error[0usize] == 0u8 {
        c_stage_destroy(&stage);
        return 1i32;
    }
    c_error(&stage.status, null(*CrustSource), 99usize, "must not replace the allocation error");
    if c_alloc(&stage.status, 8usize, 8usize) != null(*u8) ||
       context.error_count != 1usize || context.error_loc.offset != 0usize {
        c_stage_destroy(&stage);
        return 2i32;
    }
    c_stage_destroy(&stage);
    if !stage.status.failed || stage.status.blocks != null(*CBlock) { return 3i32; }
    return 0i32;
}

// On success, write a C program that checks all byte values in one string.
// Compile this file with the public API and the C stage model and base files.
fn main(argc: i32, argv: **u8) -> i32 {
    if argc == 2i32 && c_equal(argv[1usize], "oom") { return c_test_oom(); }
    if argc != 1i32 { return 15i32; }
    var compared:i32 = c_test_comparison_reuse();
    if compared == 0i32 { compared = c_test_comparison_failures(); }
    if compared != 0i32 { return compared; }
    var context: CrustContext = uninit;
    context.error_count = 0usize;
    var stage: CStage = uninit;
    c_stage_init(&stage, &context);

    var result:i32 = c_test_map(&stage);
    if result == 0i32 { result = c_test_buffer_alias(&stage); }
    if result == 0i32 { result = c_test_buffer_growth(&stage); }
    if result == 0i32 { result = c_test_quote(&stage); }
    if result == 0i32 { result = c_test_failure(&stage); }
    c_stage_destroy(&stage);
    return result;
}

fn c_test_map(stage:*CStage)->i32 {
    var index: usize = 1usize;
    while index <= 129usize {
        c_map_set(&(*stage).status, &(*stage).symbols, index * 4096usize, index + 7usize);
        index = index + 1usize;
    }
    if (*stage).status.failed || (*stage).symbols.count != 129usize ||
       c_map_get(&(*stage).symbols, 1usize) != 0usize { return 1i32; }
    index = 1usize;
    while index <= 129usize {
        if c_map_get(&(*stage).symbols, index * 4096usize) != index + 7usize { return 2i32; }
        c_map_set(&(*stage).status, &(*stage).symbols, index * 4096usize, index + 11usize);
        if c_map_get(&(*stage).symbols, index * 4096usize) != index + 11usize { return 3i32; }
        index = index + 1usize;
    }
    if (*stage).symbols.count != 129usize { return 4i32; }

    return 0i32;
}

fn c_test_buffer_alias(stage:*CStage)->i32 {
    c_text(stage, "abcd");
    c_buffer_bytes(&(*stage).body, (*stage).body.data + 1isize, 3usize);
    if !c_equal(c_buffer_end(&(*stage).body), "abcdbcd") { return 5i32; }
    var repeats: usize = (*stage).body.capacity / 7usize + 2usize;
    var index:usize = 0usize;
    while index < repeats {
        c_buffer_bytes(&(*stage).body, (*stage).body.data, 7usize);
        index = index + 1usize;
    }
    if (*stage).status.failed || (*stage).body.size != (repeats + 1usize) * 7usize { return 6i32; }
    index = 0usize;
    var expected: *u8 = "abcdbcd";
    while index < (*stage).body.size {
        if (*stage).body.data[index] != expected[index % 7usize] { return 7i32; }
        index = index + 1usize;
    }
    var size: usize = (*stage).body.size;
    if c_buffer_end(&(*stage).body)[size] != 0u8 || (*stage).body.size != size { return 8i32; }

    return 0i32;
}

fn c_test_buffer_growth(stage:*CStage)->i32 {
    (*stage).body.size = 0usize;
    c_text(stage, "x");
    var previous: *u8 = (*stage).body.data;
    var previous_capacity: usize = (*stage).body.capacity;
    while (*stage).body.size < previous_capacity {
        c_buffer_end(&(*stage).body);
        c_buffer_text(&(*stage).body, (*stage).body.data + ((*stage).body.size - 1usize) as isize);
    }
    c_buffer_text(&(*stage).body, "x");
    if (*stage).status.failed || (*stage).body.size != previous_capacity + 1usize ||
       (*stage).body.data == previous || previous[0usize] != 120u8 { return 16i32; }
    var index:usize = 0usize;
    while index < (*stage).body.size {
        if (*stage).body.data[index] != 120u8 { return 17i32; }
        index = index + 1usize;
    }
    return 0i32;
}

fn c_test_quote(stage:*CStage)->i32 {
    (*stage).body.size = 0usize;
    c_number(stage, 0u64);
    c_text(stage, ":");
    c_number(stage, 18446744073709551615u64);
    if !c_equal(c_buffer_end(&(*stage).body), "0:18446744073709551615") { return 9i32; }
    (*stage).body.size = 0usize;
    var bytes: [u8; 256] = uninit;
    var index:usize = 0usize;
    while index < 256usize { bytes[index] = index as u8; index = index + 1usize; }
    c_text(stage, "static const unsigned char bytes[] = ");
    c_quote(stage, &bytes[0usize], 256usize);
    c_text(stage, ";\nint main(void){unsigned i;if(sizeof bytes!=257)return 1;for(i=0;i<256;++i)if(bytes[i]!=i)return 2;return bytes[256];}\n");
    if (*stage).status.failed { return 10i32; }
    return 0i32;
}

fn c_test_failure(stage:*CStage)->i32 {
    var context:*CrustContext = (*stage).status.context;
    var size:usize = (*stage).body.size;
    var output: *u8 = (*stage).body.data;

    if c_alloc(&(*stage).status, 18446744073709551615usize, 8usize) != null(*u8) ||
       !(*stage).status.failed || (*context).error_count != 1usize || (*context).error[0usize] == 0u8 {
        return 11i32;
    }
    c_error(&(*stage).status, null(*CrustSource), 99usize, "must not replace the allocation error");
    c_buffer_text(&(*stage).body, "must not append");
    c_map_set(&(*stage).status, &(*stage).symbols, 1usize, 1usize);
    if (*context).error_count != 1usize || (*context).error_loc.offset != 0usize ||
       (*stage).body.size != size || (*stage).body.data != output || (*stage).symbols.count != 129usize ||
       c_buffer_end(&(*stage).body) != null(*u8) { return 12i32; }
    if crust0_host_write_stream(1u32, output, size) != 0i32 { return 13i32; }
    return c_test_destroy(stage);
}

fn c_test_destroy(stage:*CStage)->i32 {
    c_stage_destroy(stage);
    if !(*stage).status.failed || (*stage).status.blocks != null(*CBlock) ||
       (*stage).body.data != null(*u8) || (*stage).symbols.capacity != 0usize { return 14i32; }
    c_stage_destroy(stage);
    return 0i32;
}
