fn main(argc:i32, argv:**u8)->i32 {
    if argc!=3i32 { return 2i32; }
    var context:CrustContext=uninit; crust_context_init(&context,null(*CrustAllocator));
    var source:CrustSource=make CrustSource {path:argv[1usize],bytes:null(*u8),size:0usize,identity:1u64};
    var cflags:[*u8;3]=make [*u8;3] {"-fsanitize=address,undefined","-fno-omit-frame-pointer","-fno-pie"};
    var ldflags:[*u8;2]=make [*u8;2] {"-fsanitize=address,undefined","-no-pie"};
    var options:CBackendOptions=make CBackendOptions {
        mode:0u32,output:argv[2usize],symbols:null(*u8),
        cflags:&cflags[0usize],cflag_count:3usize,ldflags:&ldflags[0usize],ldflag_count:2usize
    };
    if crust0_host_read_file(source.path,&source.bytes,&source.size)!=0i32 {
        crust_context_destroy(&context); return 3i32;
    }
    var success:bool=composition_build(&context,&source,&options);
    if !success { c_driver_diagnostic(&context,"composition"); }
    crust_context_destroy(&context); crust0_host_free(source.bytes);
    if success { return 0i32; } return 1i32;
}
