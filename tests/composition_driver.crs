fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 4i32 {
        return 2i32;
    }
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var source: CrustSource = make CrustSource {
        path: argv[1usize],
        bytes: null(*u8),
        size: 0usize,
        identity: 1u64
    };
    var options: BackendOptions = make BackendOptions {
        mode: 2u32,
        output: argv[2usize],
        symbols: argv[3usize],
        cflags: null(**u8),
        cflag_count: 0usize,
        ldflags: null(**u8),
        ldflag_count: 0usize
    };
    if crust0_host_read_file(source.path, &source.bytes, &source.size) != 0i32 {
        crust_context_destroy(&context);
        return 3i32;
    }
    var success: bool = composition_build(&context, &source, &options, c_backend_build);
    if !success {
        c_driver_diagnostic(&context, "composition");
    }
    crust_context_destroy(&context);
    crust0_host_free(source.bytes);
    if success {
        return 0i32;
    }
    return 1i32;
}
