extern fn native_float(
    callback: fn(f32) -> f32,
    tag: i32,
    a: f32,
    b: f32,
    c: f32,
    d: f32,
    e: f32,
    f: f32,
    g: f32,
    h: f32,
    i: f32
) -> f32 = "native_float";
const FRACTION: f32 = -1.25f32;
record FloatPair {
    first: f32;
    second: f32;
}
fn half(value: f32) -> f32 {
    return value / 2f32;
}
fn bits(value: f32) -> u32 {
    return *(&value as *u32);
}
fn arithmetic() -> bool {
    var pair: FloatPair = make FloatPair {
        first: 0.5f32,
        second: 1.5f32
    };
    if pair.first + pair.second != 2f32 {
        return false;
    }
    if FRACTION * 2f32 != -2.5f32 {
        return false;
    }
    if 1e-2f32 - 1e-2f32 != 0f32 {
        return false;
    }
    if bits(-0f32) != 0x80000000u32 {
        return false;
    }
    if bits(1e-45f32) != 1u32 {
        return false;
    }
    if 16777217u32 as f32 != 16777216f32 {
        return false;
    }
    return native_float(
        half,
        7i32,
        1f32,
        2f32,
        3f32,
        4f32,
        5f32,
        6f32,
        7f32,
        8f32,
        9f32
    ) == 29.5f32;
}
fn comparisons() -> bool {
    var nan: f32 = 0f32 / 0f32;
    if nan == nan ||!(nan != nan) {
        return false;
    }
    if nan < 0f32 || nan <= 0f32 || nan > 0f32 || nan >= 0f32 {
        return false;
    }
    if!(-1f32 < 0f32) ||!(1f32 >= 1f32) {
        return false;
    }
    return -0f32 == 0f32;
}
fn conversions() -> bool {
    var nan: f32 = 0f32 / 0f32;
    if nan as i32 != 0i32 || nan as u64 != 0u64 {
        return false;
    }
    if (-0f32) as bool ||!(nan as bool) {
        return false;
    }
    if 1e30f32 as i64 != 9223372036854775807i64 {
        return false;
    }
    if -1e30f32 as i64 != -9223372036854775808i64 {
        return false;
    }
    if 1e30f32 as u64 != 18446744073709551615u64 {
        return false;
    }
    if -1f32 as u64 != 0u64 {
        return false;
    }
    if 128f32 as i8 != 127i8 || -129f32 as i8 != -128i8 {
        return false;
    }
    if 257f32 as u8 != 255u8 {
        return false;
    }
    return -12.75f32 as i32 == -12i32;
}
fn main(argc: i32, argv: **u8) -> i32 {
    if !arithmetic() {
        return 1i32;
    }
    if !comparisons() {
        return 2i32;
    }
    if !conversions() {
        return 3i32;
    }
    return 0i32;
}
