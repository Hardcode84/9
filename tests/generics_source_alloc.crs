// SPDX-License-Identifier: Apache-2.0

record SourceAllocation { calls: usize; fail_at: usize; live: usize; }

fn source_allocate(user: *u8, size: usize) -> *u8 {
    var counts: *SourceAllocation = user as *SourceAllocation;
    (*counts).calls = (*counts).calls + 1usize;
    if (*counts).calls == (*counts).fail_at { return null(*u8); }
    var bytes: *u8 = crust0_host_alloc(size, 16usize);
    if bytes == null(*u8) { trap; }
    (*counts).live = (*counts).live + 1usize;
    return bytes;
}

fn source_release(user: *u8, bytes: *u8) -> unit {
    var counts: *SourceAllocation = user as *SourceAllocation;
    if bytes == null(*u8) || (*counts).live == 0usize { trap; }
    (*counts).live = (*counts).live - 1usize;
    crust0_host_free(bytes);
}

fn source_length(text: *u8) -> usize {
    var size: usize = 0usize;
    while text[size] != 0u8 { size = size + 1usize; }
    return size;
}

fn source_read(program: *GsProgram, text: *u8, identity: u64) -> bool {
    var source: CrustSource = make CrustSource {
        path: "generic-source-allocation", bytes: text, size: source_length(text), identity: identity
    };
    return gp_read(program, &source);
}

fn source_prepare(program: *GsProgram) -> bool {
    if !source_read(program,
        "fn main()->i32 {var node:Node!(i32)=make Node!(i32){value:10i32,next:null(*Node!(i32))}; var nested:Box!(Box!(i32))=make Box!(Box!(i32)){value:make Box!(i32){value:20i32}}; return helper(identity!(i32)(read!(i32)(&node)))+nested.value.value;}",
        1u64) { return false; }
    if !source_read(program,
        "record Box!(Element){value:Element;} record Node!(Element){value:Element;next:*Node!(Element);} fn read!(Element)(node:*Node!(Element))->Element{return (*node).value;} fn identity!(Element)(value:Element)->Element{return value;} fn helper(value:i32)->i32{return value+1i32;}",
        2u64) { return false; }
    return gp_lower(program) && gp_check(program) && gp_find(program, "main") != null(*CrustDecl);
}

fn source_sticky(program: *GsProgram, counts: *SourceAllocation) -> unit {
    var context: *CrustContext = &(*program).context;
    if (*program).syntax.error_count != 0usize { context = &(*program).syntax; }
    if (*context).error_count == 0usize { trap; }
    var location: CrustLoc = (*context).error_loc;
    var errors: usize = (*context).error_count;
    var calls: usize = (*counts).calls;
    var message: [u8; 512] = uninit;
    var index: usize = 0usize;
    while index < 512usize { message[index] = (*context).error[index]; index = index + 1usize; }
    if gp_lower(program) || gp_check(program) { trap; }
    if (*counts).calls != calls || (*context).error_count != errors ||
       (*context).error_loc.source != location.source || (*context).error_loc.offset != location.offset { trap; }
    index = 0usize;
    while index < 512usize {
        if message[index] != (*context).error[index] { trap; }
        index = index + 1usize;
    }
}

fn source_sweep() -> unit {
    var fail_at: usize = 1usize;
    while true {
        var counts: SourceAllocation = make SourceAllocation { calls: 0usize, fail_at: fail_at, live: 0usize };
        var allocator: CrustAllocator = make CrustAllocator {
            user: &counts as *u8, allocate: source_allocate, release: source_release
        };
        var program: GsProgram = uninit;
        gp_init(&program, &allocator, 10000u64);
        var success: bool = source_prepare(&program);
        if !success { source_sticky(&program, &counts); }
        gp_destroy(&program);
        if counts.live != 0usize { trap; }
        if success {
            if counts.calls >= fail_at { trap; }
            return;
        }
        if counts.calls != fail_at { trap; }
        fail_at = fail_at + 1usize;
    }
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 1i32 { return 1i32; }
    source_sweep();
    return 0i32;
}
