extern fn source_open(path: *u8, mode: *u8) -> *u8 = "fopen";
extern fn source_close(file: *u8) -> i32 = "fclose";

fn source_length(text: *u8) -> usize {
    var size: usize = 0usize;
    while text[size] != 0u8 { size = size + 1usize; }
    return size;
}

fn source_equal(left: *u8, right: *u8) -> bool {
    var index: usize = 0usize;
    while left[index] == right[index] {
        if left[index] == 0u8 { return true; }
        index = index + 1usize;
    }
    return false;
}

fn source_diagnostic(context: *CrustContext) -> unit {
    if (*context).error_count == 0usize { return; }
    var source: *CrustSource = (*context).error_loc.source;
    if source != null(*CrustSource) {
        if crust0_host_write_stream(2u32, (*source).path, source_length((*source).path)) != 0i32 ||
           crust0_host_write_stream(2u32, ": ", 2usize) != 0i32 { trap; }
    }
    var text: *u8 = &(*context).error[0usize];
    if crust0_host_write_stream(2u32, text, source_length(text)) != 0i32 ||
       crust0_host_write_stream(2u32, "\n", 1usize) != 0i32 { trap; }
}

fn source_read(program: *GsProgram, path: *u8, identity: u64) -> bool {
    var inputs: CrustContext = uninit;
    crust_context_init(&inputs, null(*CrustAllocator));
    var bytes: *u8 = null(*u8);
    var size: usize = 0usize;
    var source: CrustSource = make CrustSource {
        path: crust_try_copy_string(&inputs, path, source_length(path)),
        bytes: null(*u8), size: 0usize, identity: identity
    };
    var success: bool = false;
    if source.path != null(*u8) && crust0_host_read_file(path, &bytes, &size) == 0i32 {
        source.bytes = bytes;
        source.size = size;
        success = gp_read(program, &source);
    } else {
        crust_set_error(&(*program).syntax, null(*CrustSource), 0usize, "cannot read source test input");
    }
    // gp_read owns a copy of the descriptor, path, and bytes after return.
    crust0_host_free(bytes);
    crust_context_destroy(&inputs);
    return success;
}

fn source_read_all(program: *GsProgram, argc: i32, argv: **u8) -> bool {
    var index: i32 = 4i32;
    while index < argc {
        if !source_read(program, argv[index as usize], index as u64) { return false; }
        index = index + 1i32;
    }
    return true;
}

fn source_emit_c(program: *GsProgram, path: *u8, symbols: *u8) -> bool {
    var entry: *CrustDecl = gp_find(program, "main");
    if entry == null(*CrustDecl) { return false; }
    var options: CBackendOptions = make CBackendOptions {
        mode: 2u32, output: path, symbols: symbols,
        cflags: null(**u8), cflag_count: 0usize, ldflags: null(**u8), ldflag_count: 0usize
    };
    return c_backend_build(&(*program).context, entry, &options) == 0i32;
}

fn source_emit_asm(program: *GsProgram, path: *u8) -> bool {
    var entry: *CrustDecl = gp_find(program, "main");
    if entry == null(*CrustDecl) { return false; }
    var file: *u8 = source_open(path, "wb");
    if file == null(*u8) {
        crust_set_error(&(*program).context, null(*CrustSource), 0usize, "cannot open assembly output");
        return false;
    }
    var success: bool = crust_x64_emit(&(*program).context, file, entry);
    if source_close(file) != 0i32 {
        crust_set_error(&(*program).context, null(*CrustSource), 0usize, "cannot close assembly output");
        return false;
    }
    return success;
}

fn source_output(program: *GsProgram, argv: **u8) -> bool {
    var mode: *u8 = argv[1usize];
    if source_equal(mode, "check") { return true; }
    if source_equal(mode, "asm") { return source_emit_asm(program, argv[2usize]); }
    if source_equal(mode, "c") || source_equal(mode, "lower-c") || source_equal(mode, "reuse-c") {
        return source_emit_c(program, argv[2usize], argv[3usize]);
    }
    crust_set_error(&(*program).context, null(*CrustSource), 0usize, "unknown source test mode");
    return false;
}

fn source_execute(program: *GsProgram, argc: i32, argv: **u8) -> bool {
    if !source_read_all(program, argc, argv) { return false; }
    var mode: *u8 = argv[1usize];
    if source_equal(mode, "lower-c") && !gp_lower(program) { return false; }
    if !gp_check(program) { return false; }
    if source_equal(mode, "closed") { return source_read(program, argv[4usize], 1000u64); }
    if source_equal(mode, "reuse-c") && ((*program).specializations != 2usize ||
       (*program).hits == 0usize || (*program).requests <= (*program).specializations) {
        crust_set_error(&(*program).context, null(*CrustSource), 0usize, "repeated applications did not reuse their instances");
        return false;
    }
    return source_output(program, argv);
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 5i32 { return 2i32; }
    var program: GsProgram = uninit;
    gp_init(&program, null(*CrustAllocator), 10000u64);
    var success: bool = source_execute(&program, argc, argv);
    source_diagnostic(&program.syntax);
    source_diagnostic(&program.context);
    gp_destroy(&program);
    if success { return 0i32; }
    return 1i32;
}
