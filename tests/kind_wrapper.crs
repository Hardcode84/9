record KwNode { syntax: *CrustTypeSyntax; next: *KwNode; }
record KwStage { nodes: *KwNode; kind: u32; }

fn kw_init(stage: *KwStage, context: *CrustContext) -> unit {
    (*stage).nodes = null(*KwNode);
    (*stage).kind = crust_allocate_kinds(context, 1u32);
}

fn kw_read_type(reader: *CrustReader, user: *u8) -> *CrustTypeSyntax {
    if !rr_is_name(reader, "wrapped") { return null(*CrustTypeSyntax); }
    var stage: *KwStage = user as *KwStage;
    var syntax: *CrustTypeSyntax = rr_new_type(reader, (*stage).kind, (*reader).token.offset);
    var node: *KwNode = rr_alloc(reader, sizeof(KwNode), alignof(KwNode)) as *KwNode;
    if (*reader).failed { return null(*CrustTypeSyntax); }
    *node = make KwNode { syntax: syntax, next: (*stage).nodes };
    (*stage).nodes = node;
    rr_next(reader);
    if !(*reader).failed { (*syntax).base = rr_type(reader); }
    return syntax;
}

// Require a successful read. Replace every wrapper with its contained type.
fn kw_lower(stage: *KwStage) -> unit {
    var node: *KwNode = (*stage).nodes;
    while node != null(*KwNode) {
        var syntax: *CrustTypeSyntax = (*node).syntax;
        var location: CrustLoc = (*syntax).loc;
        *syntax = *(*syntax).base;
        (*syntax).loc = location;
        node = (*node).next;
    }
}
