// Override scalar addition through the same interface used by nested expressions.
fn llvm_test_expression(function: *LlFunction, input: *CrustExpr) -> *u8 {
    if input -> kind == CRUST_E_BINARY && input -> op == CRUST_OP_ADD && input -> type -> kind == CRUST_T_I32 {
        var left: *u8 = ll_value(function, input -> left);
        var right: *u8 = ll_value(function, input -> right);
        return ll_instruction(function, "sub", "i32", left, right);
    }
    return ll_expression(function, input);
}
fn llvm_test_bad_expression(function: *LlFunction, input: *CrustExpr) -> *u8 {
    return null(*u8);
}
fn llvm_test_read(cli: *CCli, context: *CrustContext, argc: i32, argv: **u8) -> bool {
    return c_driver_init(cli, context, argc) && c_driver_parse(cli, argc, argv, 2i32) && c_cli_read(
        cli
    ) && crust_collect(context) && crust_resolve(context) && crust_check(context);
}
fn llvm_test_emit(argc: i32, argv: **u8) -> i32 {
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var cli: CCli = uninit;
    var success: bool = llvm_test_read(&cli, &context, argc, argv);
    var entry: *CrustDecl = null(*CrustDecl);
    if success {
        if !cli.library {
            entry = c_driver_entry(&cli);
        }
        success = c_driver_exports(&cli) && c_driver_names(&cli.driver);
    }
    var stage: LlStage = uninit;
    ll_init(&stage, &context);
    stage.single_exit = c_equal(argv[1usize], "single-exit");
    if c_equal(argv[1usize], "override") {
        stage.expression = llvm_test_expression;
    }
    if c_equal(argv[1usize], "bad-override") {
        stage.expression = llvm_test_bad_expression;
    }
    if success {
        success = ll_emit(&stage, entry);
    }
    if success {
        c_buffer_bytes(
            &stage.memory.header,
            stage.memory.body.data,
            stage.memory.body.size
        );
        cli.driver.stage = &stage.memory;
        success = c_driver_dump(&cli.driver);
    }
    if !c_driver_cleanup(&cli.driver, null(*u8)) {
        success = false;
    }
    if context.error_count != 0usize {
        c_driver_diagnostic(&context, argv[0usize]);
    }
    ll_destroy(&stage);
    c_stage_destroy(&cli.stage);
    crust_context_destroy(&context);
    if success {
        return 0i32;
    }
    return 1i32;
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2i32 {
        return 2i32;
    }
    if c_equal(argv[1usize], "allocation") {
        return llvm_test_allocation(argc, argv);
    }
    if !c_equal(argv[1usize], "raw") && !c_equal(argv[1usize], "single-exit") && !c_equal(
        argv[1usize],
        "override"
    ) && !c_equal(argv[1usize], "bad-override") {
        return 2i32;
    }
    return llvm_test_emit(argc, argv);
}
