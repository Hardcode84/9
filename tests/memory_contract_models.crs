fn contract_test_empty(contract: *PmContract, user: *u8) -> unit {}
fn contract_test_false(contract: *PmContract, user: *u8) -> unit { pm_contract_require(contract, "false"); }

fn contract_test_write(contract: *PmContract, user: *u8) -> unit {
    var run: *PfRun = (*contract).run;
    var type: *CrustType = (*(*(*(*run).declaration).params).type).base;
    pm_contract_write(contract, pf_parameter(run, 0usize), type, pf_parameter(run, 1usize));
}

fn contract_test_swap(contract: *PmContract, user: *u8) -> unit {
    var run: *PfRun = (*contract).run;
    var type: *CrustType = (*(*(*(*run).declaration).params).type).base;
    var a: *u8 = pf_parameter(run, 0usize);
    var b: *u8 = pf_parameter(run, 1usize);
    var scratch: *u8 = pf_parameter(run, 2usize);
    var first: *u8 = pm_contract_read(contract, a, type);
    var second: *u8 = pm_contract_read(contract, b, type);
    pm_contract_read(contract, scratch, type);
    pm_contract_access(contract, scratch, type, true);
    pm_contract_write(contract, a, type, second);
    pm_contract_write(contract, b, type, first);
}

fn contract_test_prepare(stage: *PfStage, user: *u8) -> bool {
    var model: *u8 = user;
    if c_equal(model, "failed-prepare") { return false; }
    var declaration: *CrustDecl = pm_lookup((*stage).status.context, "rewrite");
    if declaration == null(*CrustDecl) { return false; }
    var describe: fn(*PmContract, *u8) -> unit = null(fn(*PmContract, *u8) -> unit);
    if c_equal(model, "empty") { describe = contract_test_empty; }
    else if c_equal(model, "false") { describe = contract_test_false; }
    else if c_equal(model, "write") || c_equal(model, "duplicate") { describe = contract_test_write; }
    else if c_equal(model, "swap") { describe = contract_test_swap; }
    if describe == contract_test_write || describe == contract_test_swap {
        var count: usize = 2usize;
        if describe == contract_test_swap { count = 3usize; }
        if (*declaration).param_count != count || (*(*(*declaration).params).type).kind != CRUST_T_POINTER {
            pf_error(stage, &(*declaration).loc, "test contract requires pointer parameters");
            return false;
        }
    }
    if !pm_contract_register(stage, declaration, describe, null(*u8)) { return false; }
    if c_equal(model, "duplicate") { return pm_contract_register(stage, declaration, describe, null(*u8)); }
    return true;
}
