fn loop_test_program(request: *CrustBuild, options: *PmOptions) -> i32 {
    if (*request).argc >= 3i32 && c_equal((*request).argv[0usize], "--walk") {
        var names: WalkNames = make WalkNames { function_name: (*request).argv[1usize], next: (*request).argv[2usize] };
        (*request).argc = (*request).argc - 3i32;
        (*request).argv = (*request).argv + 3isize;
        return intrusive_walk_program(request, options, &names);
    }
    if (*request).argc >= 2i32 && c_equal((*request).argv[0usize], "--model") {
        var model: *u8 = (*request).argv[1usize];
        (*request).argc = (*request).argc - 2i32;
        (*request).argv = (*request).argv + 2isize;
        return resource_memory_program_with(request, options, loop_test_prepare, model);
    }
    if (*request).argc >= 1i32 && c_equal((*request).argv[0usize], "--reference") {
        (*request).argc = (*request).argc - 1i32;
        (*request).argv = (*request).argv + 1isize;
        return loop_test_reference(request);
    }
    crust_set_error((*request).context, null(*CrustSource), 0usize, "select --walk or --model");
    return 1i32;
}

fn main(argc: i32, argv: **u8) -> i32 {
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var request: CrustBuild = make CrustBuild {
        context: &context, source: null(*CrustSource), target_begin: 0usize,
        argc: argc - 1i32, argv: argv + 1isize
    };
    var contracts: [PmForeignSpec; 3] = make [PmForeignSpec; 3] {
        make PmForeignSpec { name: "allocate", alignment: 16usize, kind: PM_ALLOCATE },
        make PmForeignSpec { name: "release", alignment: 1usize, kind: PM_RELEASE },
        make PmForeignSpec { name: "emit", alignment: 1usize, kind: PM_SCALAR }
    };
    var options: PmOptions = make PmOptions {
        summaries: null(**u8), summary_count: 0usize,
        foreign: &contracts[0usize], foreign_count: 3usize,
        max_depth: 128usize, max_paths: 256usize, max_iterations: 4usize, milliseconds: 10000u32
    };
    var result: i32 = loop_test_program(&request, &options);
    if context.error_count != 0usize { c_driver_diagnostic(&context, argv[0usize]); }
    crust_context_destroy(&context);
    return result;
}
