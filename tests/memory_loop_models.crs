record LoopTestPolicy {
    resource: RmPolicy;
    target: *CrustStmt;
    counter: *CrustSymbol;
    model: *u8;
}

fn loop_test_describe(run: *PfRun, before: *PfState, head: *PfState, user: *u8, terms: *PmLoopTerms) -> unit {
    var policy: *LoopTestPolicy = user as *LoopTestPolicy;
    var value: *u8 = pf_define(run, "Int", pf_binding(head, (*policy).counter));
    var original: *u8 = pf_binding(before, (*policy).counter);
    var lower: *u8 = pf_define(run, "Bool", pf_binary(run, ">=", value, "0"));
    (*terms).invariant = pf_and(run, lower, pf_binary(run, "<=", value, original));
    (*terms).variant = value;
    if c_equal((*policy).model, "false") { (*terms).invariant = "false"; }
    if c_equal((*policy).model, "weak") { (*terms).invariant = "true"; }
    if c_equal((*policy).model, "constant") { (*terms).variant = "0"; }
    if c_equal((*policy).model, "negative") { (*terms).variant = "(- 1)"; }
    if c_equal((*policy).model, "missing") { (*terms).invariant = null(*u8); }
    if c_equal((*policy).model, "deep") {
        var index: usize = 0usize;
        while index <= (*(*run).stage).max_depth && !pf_failed(run) {
            (*terms).variant = pf_define(run, "Int", (*terms).variant);
            index = index + 1usize;
        }
    }
}

fn loop_test_statement(run: *PfRun, state: *PfState, node: *CrustStmt) -> *PfPath {
    var policy: *LoopTestPolicy = (*(*run).stage).user as *LoopTestPolicy;
    if node == (*policy).target {
        return pm_loop_execute(run, state, node, loop_test_describe, policy as *u8);
    }
    return rm_statement(run, state, node);
}

fn loop_test_prepare(stage: *PfStage, user: *u8) -> bool {
    var declaration: *CrustDecl = pm_lookup((*stage).status.context, "countdown");
    if declaration == null(*CrustDecl) { return false; }
    var policy: *LoopTestPolicy = c_alloc(&(*stage).status, sizeof(LoopTestPolicy), alignof(LoopTestPolicy)) as *LoopTestPolicy;
    if policy == null(*LoopTestPolicy) { return false; }
    *policy = make LoopTestPolicy {
        resource: *((*stage).user as *RmPolicy), target: null(*CrustStmt),
        counter: (*(*declaration).params).symbol, model: user
    };
    walk_find(stage, pf_body(stage, declaration), &(*policy).target, 0usize);
    if (*stage).status.failed || (*policy).target == null(*CrustStmt) { return false; }
    (*stage).user = policy as *u8;
    (*stage).statement = loop_test_statement;
    if c_equal(user, "budget") { (*stage).max_paths = 1usize; }
    return true;
}

// Produce an emission reference from the resource view. This test helper does
// not check memory and accepts only textual C output.
fn loop_test_reference(request: *CrustBuild) -> i32 {
    var cli: CCli = uninit;
    var ok: bool = c_driver_init(&cli, (*request).context, (*request).argc);
    var result: i32 = 1i32;
    if ok && c_driver_parse(&cli, (*request).argc, (*request).argv, 0i32) {
        var resources: RsStage = uninit;
        rs_init(&resources, (*request).context);
        if cli.mode == 2u32 && resource_driver_read(&cli, &resources) && rs_prepare_delegated(&resources) {
            var entry: *CrustDecl = resource_driver_entry(&cli, &resources);
            if entry != null(*CrustDecl) && c_driver_names(&cli.driver) {
                result = c_backend_build_with_body((*request).context, entry, &cli.options, rs_c_body, &resources as *u8);
            }
        }
    }
    c_stage_destroy(&cli.stage);
    return result;
}
