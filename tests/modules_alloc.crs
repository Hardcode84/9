// SPDX-License-Identifier: Apache-2.0

record ModuleAllocation {
    calls: usize;
    fail_at: usize;
    live: usize;
}

fn test_allocate(user: *u8, size: usize) -> *u8 {
    var counts: *ModuleAllocation = user as *ModuleAllocation;
    (*counts).calls = (*counts).calls + 1usize;
    if (*counts).calls == (*counts).fail_at { return null(*u8); }
    var bytes: *u8 = crust0_host_alloc(size, 16usize);
    if bytes == null(*u8) { trap; }
    (*counts).live = (*counts).live + 1usize;
    return bytes;
}

fn test_release(user: *u8, bytes: *u8) -> unit {
    var counts: *ModuleAllocation = user as *ModuleAllocation;
    if bytes == null(*u8) || (*counts).live == 0usize { trap; }
    (*counts).live = (*counts).live - 1usize;
    crust0_host_free(bytes);
}

fn test_prepare(provider: *CrustModule, consumer: *CrustModule, paths: **u8) -> bool {
    return module_read(provider, paths[0usize], 1u64) && module_check(provider) &&
           module_export(provider, "Value", "") &&
           module_export(provider, "increment", "test_increment") &&
           module_export(provider, "answer", "test_answer") &&
           module_import(consumer, provider, "Value", "Number") &&
           module_import(consumer, provider, "increment", "step") &&
           module_import(consumer, provider, "answer", "calculate") &&
           module_read(consumer, paths[1usize], 2u64) && module_check(consumer);
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 3i32 { return 1i32; }
    var fail_at: usize = 1usize;
    while true {
        var counts: ModuleAllocation = make ModuleAllocation { calls: 0usize, fail_at: fail_at, live: 0usize };
        var allocator: CrustAllocator = make CrustAllocator {
            user: &counts as *u8, allocate: test_allocate, release: test_release
        };
        var provider: CrustModule = uninit;
        var consumer: CrustModule = uninit;
        module_init(&provider, &allocator);
        module_init(&consumer, &allocator);
        var success: bool = test_prepare(&provider, &consumer, &argv[1usize]);
        var diagnosed: bool = provider.context.error_count != 0usize || consumer.context.error_count != 0usize;
        module_destroy(&consumer);
        module_destroy(&provider);
        if counts.live != 0usize || success == diagnosed { return 2i32; }
        if success {
            if counts.calls >= fail_at { return 3i32; }
            return 0i32;
        }
        if counts.calls != fail_at { return 4i32; }
        fail_at = fail_at + 1usize;
    }
    trap;
}
