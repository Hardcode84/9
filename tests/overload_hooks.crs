const OH_METER:u32 = 4096u32;

record OhType { syntax:*CrustTypeSyntax; next:*OhType; }
record OhState {
    failure:u32;
    failures:usize;
    error_offset:usize;
    types:*OhType;
    type_calls:usize;
    binding_calls:usize;
    name_calls:usize;
    group_calls:usize;
    call_calls:usize;
    statement_calls:usize;
    contract_calls:usize;
    nested_growth:bool;
}

fn oh_length(text:*u8)->usize {
    var count:usize = 0usize;
    while text[count] != 0u8 { count = count + 1usize; }
    return count;
}

fn oh_equal(a:*u8, b:*u8)->bool {
    var index:usize = 0usize;
    while a[index] == b[index] {
        if a[index] == 0u8 { return true; }
        index = index + 1usize;
    }
    return false;
}

fn oh_error(state:*OhState, stage:*OvStage, location:*CrustLoc, kind:u32)->bool {
    if (*state).failure != kind { return false; }
    (*state).failures = (*state).failures + 1usize;
    (*state).error_offset = (*location).offset;
    crust_set_error((*stage).context, (*location).source, (*location).offset,
        "external overload hook failed");
    return true;
}

fn oh_read_type(reader:*CrustReader, user:*u8)->*CrustTypeSyntax {
    var kind:u32 = OH_METER;
    if rr_is_name(reader, "second") { kind = OH_METER + 1u32; }
    else { if !rr_is_name(reader, "meter") { return null(*CrustTypeSyntax); } }
    var offset:usize = (*reader).token.offset;
    rr_next(reader);
    var syntax:*CrustTypeSyntax = rr_new_type(reader, kind, offset);
    var base:*CrustTypeSyntax = rr_type(reader);
    var link:*OhType = rr_alloc(reader, sizeof(OhType), alignof(OhType)) as *OhType;
    if (*reader).failed { return null(*CrustTypeSyntax); }
    (*syntax).base = base;
    var state:*OhState = user as *OhState;
    *link = make OhType { syntax:syntax, next:(*state).types };
    (*state).types = link;
    return syntax;
}

fn oh_type_key(stage:*OvStage, syntax:*CrustTypeSyntax, buffer:*OvText,
               depth:usize, user:*u8)->bool {
    if (*syntax).kind != OH_METER && (*syntax).kind != OH_METER + 1u32 { return false; }
    var state:*OhState = user as *OhState;
    (*state).type_calls = (*state).type_calls + 1usize;
    if oh_error(state, stage, &(*syntax).loc, 1u32) { return true; }
    var payload:*u8 = "units_of_measure_with_explicit_representation_contract_and_a_long_encoding_that_crosses_the_buffer_growth_boundary";
    ov_part(stage, buffer, payload, oh_length(payload));
    var probe:*CrustTypeSyntax = ov_type(stage, CRUST_T_U32, &(*syntax).loc);
    if (*stage).failed { return true; }
    if (*state).failure == 6u32 {
        (*probe).kind = OH_METER + 2u32;
        (*state).failures = (*state).failures + 1usize;
        (*state).error_offset = (*syntax).loc.offset;
    }
    var capacity:usize = (*buffer).capacity;
    if !ov_same(stage, (*syntax).base, probe) {
        if !(*stage).failed { ov_error(stage, &(*syntax).loc, "unit type requires u32"); }
        return true;
    }
    if (*buffer).capacity > capacity { (*state).nested_growth = true; }
    ov_encode_type(stage, (*syntax).base, buffer, depth + 1usize);
    return true;
}

fn oh_binding(stage:*OvStage, syntax:*CrustTypeSyntax, user:*u8)->*CrustTypeSyntax {
    var state:*OhState = user as *OhState;
    (*state).binding_calls = (*state).binding_calls + 1usize;
    oh_error(state, stage, &(*syntax).loc, 2u32);
    return syntax;
}

fn oh_expression(walk:*OvWalk, expression:*CrustExpr,
                  expected:*CrustTypeSyntax, user:*u8)->*CrustTypeSyntax {
    var state:*OhState = user as *OhState;
    if (*expression).kind == CRUST_E_NAME && (oh_equal((*(*expression).name).text, "choose") ||
       oh_equal((*(*expression).name).text, "zero")) {
        (*state).name_calls = (*state).name_calls + 1usize;
    }
    if (*expression).kind == CRUST_E_GROUP { (*state).group_calls = (*state).group_calls + 1usize; }
    if (*expression).kind == CRUST_E_CALL { (*state).call_calls = (*state).call_calls + 1usize; }
    oh_error(state, (*walk).stage, &(*expression).loc, 3u32);
    return null(*CrustTypeSyntax);
}

fn oh_statement(walk:*OvWalk, statement:*CrustStmt, user:*u8)->bool {
    var state:*OhState = user as *OhState;
    (*state).statement_calls = (*state).statement_calls + 1usize;
    oh_error(state, (*walk).stage, &(*statement).loc, 4u32);
    return false;
}

fn oh_contract(stage:*OvStage, declaration:*CrustDecl, user:*u8)->*CrustName {
    var state:*OhState = user as *OhState;
    (*state).contract_calls = (*state).contract_calls + 1usize;
    var name:*CrustName = ov_intern(stage, "meter_safe", 10usize);
    oh_error(state, stage, &(*declaration).loc, 5u32);
    return name;
}

fn oh_test(failure:u32, output:*u8)->bool {
    var context:CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var state:OhState = make OhState {
        failure:failure, failures:0usize, error_offset:0usize, types:null(*OhType),
        type_calls:0usize, binding_calls:0usize, name_calls:0usize, group_calls:0usize,
        call_calls:0usize, statement_calls:0usize, contract_calls:0usize, nested_growth:false
    };
    var source:CrustSource = make CrustSource {
        path:"overload-hook-input", identity:1u64, size:0usize,
        bytes:"fn choose(value:meter u32)->u32{return 41u32;}\nfn choose(value:u32)->u32{return 42u32;}\nfn metered(value:meter u32)->u32{return (choose)(value);}\nfn plain(value:u32)->u32{return choose(value);}\nfn zero()->unit{}\nfn invoke()->unit{zero();}\nfn choose(value:second u32)->u32{return 43u32;}\nfn seconded(value:second u32)->u32{return choose(value);}\nfn run_target(argc:i32,argv:**u8)->i32{var sum:u32=metered(0u32 as meter u32)+plain(0u32)+seconded(0u32 as second u32);return sum as i32-126i32;}"
    };
    source.size = oh_length(source.bytes);
    var reader_hooks:CrustReaderHooks = make CrustReaderHooks {
        user:&state as *u8, declaration:null(fn(*CrustReader,*u8)->*CrustDecl),
        statement:null(fn(*CrustReader,*u8)->*CrustStmt),
        prefix:null(fn(*CrustReader,*u8)->*CrustExpr), type_syntax:oh_read_type
    };
    var parsed:*CrustUnit = rr_read(&context, &source, 0usize, source.size, &reader_hooks);
    var hooks:OvHooks = make OvHooks {
        user:&state as *u8, type_key:oh_type_key, binding_type:oh_binding,
        expression:oh_expression, statement:oh_statement, contract:oh_contract
    };
    var stage:OvStage = uninit;
    ov_init(&stage, &context, "meter_fixture_v1", &hooks);
    var success:bool = parsed != null(*CrustUnit) && ov_prepare(&stage);
    var valid:bool = context.failure == null(*u8) && stage.scratch.size == 0usize;
    if failure != 0u32 {
        valid = oh_failed(&state, &context, &stage, &source, success) && valid;
    } else {
        valid = oh_succeeded(&state, &context, &stage, success) && valid;
        if valid { valid = oh_emit(&state, &context, parsed, output); }
    }
    if !valid {
        var message:*u8 = "overload hook contract failed in mode ";
        var digit:u8 = (failure as u8) + 48u8;
        crust0_host_write_stream(2u32, message, oh_length(message));
        crust0_host_write_stream(2u32, &digit, 1usize);
        crust0_host_write_stream(2u32, "\n", 1usize);
        if context.error_count != 0usize {
            crust0_host_write_stream(2u32, &context.error[0usize], oh_length(&context.error[0usize]));
            crust0_host_write_stream(2u32, "\n", 1usize);
        }
    }
    crust_context_destroy(&context);
    return valid;
}

fn main(argc:i32, argv:**u8)->i32 {
    if argc != 2i32 { return 2i32; }
    var kind:u32 = 0u32;
    while kind <= 6u32 {
        if !oh_test(kind, argv[1usize]) { return 1i32; }
        kind = kind + 1u32;
    }
    return 0i32;
}

fn oh_failed(state:*OhState, context:*CrustContext, stage:*OvStage, source:*CrustSource, success:bool)->bool {
    var expected:*u8 = "external overload hook failed";
    if (*state).failure == 6u32 { expected = "overload stage has no encoding for this type"; }
    return !success && (*stage).failed && (*state).failures == 1usize &&
        (*context).error_count == 1usize && (*context).error_loc.source == source &&
        (*context).error_loc.offset == (*state).error_offset &&
        oh_equal(&(*context).error[0usize], expected);
}

fn oh_succeeded(state:*OhState, context:*CrustContext, stage:*OvStage, success:bool)->bool {
    return success && !(*stage).failed && (*context).error_count == 0usize &&
        (*state).type_calls != 0usize && (*state).binding_calls != 0usize &&
        (*state).statement_calls != 0usize && (*state).contract_calls == 9usize &&
        (*state).name_calls == 4usize && (*state).group_calls == 1usize && (*state).call_calls == 7usize &&
        (*state).nested_growth && (*stage).scratch.size == 0usize;
}

fn oh_emit(state:*OhState, context:*CrustContext, parsed:*CrustUnit, output:*u8)->bool {
    var special:*CrustDecl = (*parsed).declarations;
    var ordinary:*CrustDecl = (*special).next;
    var metered:*CrustDecl = (*ordinary).next;
    var plain:*CrustDecl = (*metered).next;
    var metered_name:*CrustExpr = (*(*(*(*metered).body).body).expr).left;
    var plain_name:*CrustExpr = (*(*(*(*plain).body).body).expr).left;
    var valid:bool = (*(*metered_name).left).name == (*special).name &&
        (*plain_name).name == (*ordinary).name && (*special).name != (*ordinary).name;
    var type_link:*OhType = (*state).types;
    while type_link != null(*OhType) {
        *(*type_link).syntax = *(*(*type_link).syntax).base;
        type_link = (*type_link).next;
    }
    valid = valid && crust_collect(context) && crust_resolve(context) && crust_check(context);
    if valid {
        var entry:*CrustDecl = (*parsed).declarations;
        while (*entry).next != null(*CrustDecl) { entry = (*entry).next; }
        var options:CBackendOptions = make CBackendOptions {
            mode:0u32, output:output, symbols:null(*u8),
            cflags:null(**u8), cflag_count:0usize, ldflags:null(**u8), ldflag_count:0usize
        };
        valid = c_backend_build(context, entry, &options) == 0i32;
    }
    return valid;
}
