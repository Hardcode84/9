fn memory_alloc_verify(context: *CrustContext, source: *CrustSource, selection: *u8) -> bool {
    var resources: RsStage = uninit;
    rs_init(&resources, context);
    var ownership: OsStage = uninit;
    os_init(&ownership, &resources);
    var valid: bool = os_read(&ownership, source, 0usize, (*source).size);
    if valid { valid = os_lower(&ownership) && os_verify(&ownership); }
    pf_destroy(&ownership.proof);
    return valid;
}
