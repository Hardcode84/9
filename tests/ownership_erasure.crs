fn erasure_equal(left: *CBuffer, right: *CBuffer) -> bool {
    if (*left).size != (*right).size { return false; }
    var index: usize = 0usize;
    while index < (*left).size {
        if (*left).data[index] != (*right).data[index] { return false; }
        index = index + 1usize;
    }
    return true;
}

fn erasure_check(cli: *CCli) -> bool {
    var context: *CrustContext = (*cli).stage.status.context;
    var resources: RsStage = uninit;
    rs_init(&resources, context);
    var ownership: OsStage = uninit;
    os_init(&ownership, &resources);
    var relations: RlStage = uninit;
    rl_init(&relations, context);
    var before: CStage = uninit;
    var after: CStage = uninit;
    c_stage_init(&before, context);
    c_stage_init(&after, context);
    var valid: bool = os_driver_read(cli, &ownership) && os_lower(&ownership, &relations);
    var entry: *CrustDecl = null(*CrustDecl);
    if valid {
        entry = resource_driver_entry(cli, &resources);
        valid = entry != null(*CrustDecl) && c_driver_names(&(*cli).driver);
    }
    if valid { valid = c_emit_with_body(&before, entry, rs_c_body, &resources as *u8); }
    if valid { valid = os_verify(&ownership, &relations); }
    if valid { valid = c_emit_with_body(&after, entry, rs_c_body, &resources as *u8); }
    if valid {
        valid = erasure_equal(&before.header, &after.header) &&
                erasure_equal(&before.body, &after.body) && erasure_equal(&before.renames, &after.renames);
    }
    c_stage_destroy(&after);
    c_stage_destroy(&before);
    rl_destroy(&relations);
    return valid;
}

fn main(argc: i32, argv: **u8) -> i32 {
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var cli: CCli = uninit;
    var valid: bool = c_driver_init(&cli, &context, argc - 1i32);
    if valid { valid = c_driver_parse(&cli, argc, argv, 1i32); }
    if valid { valid = erasure_check(&cli); }
    if context.error_count != 0usize { c_driver_diagnostic(&context, argv[0usize]); }
    c_stage_destroy(&cli.stage);
    crust_context_destroy(&context);
    if valid { return 0i32; }
    return 1i32;
}
