// SPDX-License-Identifier: Apache-2.0

extern fn ogc_clock() -> u64 = "ownership_clock_ns";

record OgcStats {
    times: [u64; 8];
    input_io: u64;
    arena: usize;
    requests: usize;
    hits: usize;
    instances: usize;
    proof_checks: usize;
    proof_bytes: usize;
}

fn ogc_text(text: *u8) -> bool {
    return crust0_host_write_stream(1u32, text, gs_length(text)) == 0i32;
}

fn ogc_number(value: u64) -> bool {
    var buffer: [u8; 21] = uninit;
    var size: usize = gs_digits(&buffer[0usize], value);
    return crust0_host_write_stream(1u32, &buffer[0usize], size) == 0i32 && ogc_text(" ");
}

fn ogc_name(program: *OgProgram, name: *CrustName) -> bool {
    var instance: *GpInstance = null(*GpInstance);
    if program != null(*OgProgram) { instance = (*program).generics.instances; }
    while instance != null(*GpInstance) {
        if (*(*instance).declaration).name == name {
            if !ogc_text((*(*(*(*instance).definition).source).name).text) { return false; }
            var index: usize = 0usize;
            while index < (*instance).count {
                if !ogc_text("_") || !ogc_text((*(*(*instance).arguments[index]).name).text) { return false; }
                index = index + 1usize;
            }
            return true;
        }
        instance = (*instance).next;
    }
    return ogc_text((*name).text);
}

fn ogc_record(program: *OgProgram, declaration: *CrustDecl) -> bool {
    var kind: *CrustType = (*declaration).type;
    if !ogc_text("record ") || !ogc_name(program, (*declaration).name) ||
       !ogc_text(" ") || !ogc_number((*kind).size) || !ogc_number((*kind).align as u64) { return false; }
    var field: *CrustField = (*declaration).fields;
    while field != null(*CrustField) {
        if !ogc_number((*field).offset) { return false; }
        field = (*field).next;
    }
    return ogc_text("\n");
}

fn ogc_binding_name(resources: *RsStage, program: *OgProgram, declaration: *CrustDecl) -> bool {
    var global: *RsGlobal = (*resources).first_global;
    while global != null(*RsGlobal) {
        if (*global).drop_helper == declaration {
            return ogc_text("cleanup_") && ogc_name(program, (*(*global).source).name);
        }
        global = (*global).next;
    }
    return ogc_name(program, (*declaration).name);
}

fn ogc_bindings(stage: *CStage, resources: *RsStage, program: *OgProgram) -> bool {
    var binding: *CBinding = (*stage).first_binding;
    while binding != null(*CBinding) {
        if !ogc_text("function ") || !ogc_number((*binding).identity as u64) ||
           !ogc_binding_name(resources, program, (*binding).source) || !ogc_text("\n") { return false; }
        binding = (*binding).next;
    }
    var info: *CTypeInfo = (*stage).first_type;
    while info != null(*CTypeInfo) {
        var kind: *CrustType = (*info).source;
        if (*kind).kind == CRUST_T_RECORD {
            if !ogc_text("type ") || !ogc_number((*info).identity as u64) ||
               !ogc_name(program, (*(*kind).record_decl).name) || !ogc_text("\n") { return false; }
        }
        info = (*info).next;
    }
    return true;
}

fn ogc_layouts(stage: *CStage, resources: *RsStage, program: *OgProgram) -> bool {
    var unit_value: *CrustUnit = (*(*resources).context).units;
    while unit_value != null(*CrustUnit) {
        var declaration: *CrustDecl = (*unit_value).declarations;
        while declaration != null(*CrustDecl) {
            if (*declaration).kind == CRUST_D_RECORD && !ogc_record(program, declaration) { return false; }
            declaration = (*declaration).next;
        }
        unit_value = (*unit_value).next;
    }
    return ogc_bindings(stage, resources, program);
}

fn ogc_equal(left: *CBuffer, right: *CBuffer) -> bool {
    return (*left).size == (*right).size && cache_memcmp((*left).data, (*right).data, (*left).size) == 0i32;
}

fn ogc_outputs(context: *CrustContext, stage: *CStage, argv: **u8) -> bool {
    c_buffer_bytes(&(*stage).header, (*stage).body.data, (*stage).body.size);
    return !(*stage).status.failed &&
        cache_save(context, argv[3usize], (*stage).header.data, (*stage).header.size) &&
        cache_save(context, argv[4usize], (*stage).renames.data, (*stage).renames.size);
}

fn ogc_emit(ownership: *OsStage, program: *OgProgram, stats: *OgcStats, argv: **u8) -> bool {
    var resources: *RsStage = (*ownership).resources;
    var context: *CrustContext = (*resources).context;
    var cli: CCli = uninit;
    var before: CStage = uninit;
    c_stage_init(&before, context);
    var valid: bool = c_driver_init(&cli, context, 0i32) && c_driver_names(&cli.driver);
    var entry: *CrustDecl = null(*CrustDecl);
    if valid { entry = resource_driver_entry(&cli, resources); valid = entry != null(*CrustDecl); }
    var erase: bool = c_equal(argv[2usize], "erasure");
    if valid && erase { valid = c_emit_with_body(&before, entry, rs_c_body, resources as *u8); }
    var start: u64 = ogc_clock();
    if valid { valid = os_verify(ownership); }
    (*stats).times[5usize] = ogc_clock() - start;
    start = ogc_clock();
    if valid { valid = c_emit_with_body(&cli.stage, entry, rs_c_body, resources as *u8); }
    (*stats).times[6usize] = ogc_clock() - start;
    if valid && erase {
        valid = ogc_equal(&before.header, &cli.stage.header) && ogc_equal(&before.body, &cli.stage.body) &&
            ogc_equal(&before.renames, &cli.stage.renames);
        if !valid { native_error(context, "ownership verification changed emitted bytes"); }
    }
    if valid { valid = ogc_layouts(&cli.stage, resources, program) && ogc_outputs(context, &cli.stage, argv); }
    c_stage_destroy(&before);
    c_stage_destroy(&cli.stage);
    return valid;
}

fn ogc_read(program: *OgProgram, sources: *CrustSource) -> bool {
    var index: usize = 0usize;
    while index < 4usize {
        if !og_read(program, &sources[index], index == 0usize) { return false; }
        index = index + 1usize;
    }
    return true;
}

fn ogc_generic(sources: *CrustSource, stats: *OgcStats, argv: **u8) -> bool {
    var program: OgProgram = uninit;
    var start: u64 = ogc_clock();
    og_init(&program, null(*CrustAllocator), 100u64);
    var valid: bool = ogc_read(&program, sources);
    (*stats).times[0usize] = ogc_clock() - start;
    start = ogc_clock();
    if valid { valid = og_prove(&program); }
    (*stats).times[1usize] = ogc_clock() - start;
    start = ogc_clock();
    if valid { valid = og_lower_syntax(&program) && og_domains(&program); }
    (*stats).times[2usize] = ogc_clock() - start;
    start = ogc_clock();
    if valid { valid = os_lower(&program.ownership); }
    (*stats).times[3usize] = ogc_clock() - start;
    start = ogc_clock();
    if valid { valid = og_arguments(&program) && og_instance_receipts(&program); }
    (*stats).times[4usize] = ogc_clock() - start;
    if valid { valid = ogc_emit(&program.ownership, &program, stats, argv); }
    (*stats).arena = program.generics.syntax.arena.bytes_reserved + program.generics.context.arena.bytes_reserved;
    (*stats).requests = program.generics.requests;
    (*stats).hits = program.generics.hits;
    (*stats).instances = program.generics.specializations;
    (*stats).proof_checks = program.proof_checks;
    (*stats).proof_bytes = program.proof_bytes;
    if program.generics.syntax.error_count != 0usize { c_driver_diagnostic(&program.generics.syntax, argv[0usize]); }
    if program.generics.context.error_count != 0usize { c_driver_diagnostic(&program.generics.context, argv[0usize]); }
    start = ogc_clock();
    og_destroy(&program);
    (*stats).times[7usize] = ogc_clock() - start;
    return valid;
}

fn ogc_handwritten(sources: *CrustSource, stats: *OgcStats, argv: **u8) -> bool {
    var context: CrustContext = uninit;
    var resources: RsStage = uninit;
    var ownership: OsStage = uninit;
    var start: u64 = ogc_clock();
    crust_context_init(&context, null(*CrustAllocator));
    rs_init(&resources, &context);
    os_init(&ownership, &resources);
    var valid: bool = os_trust_sources(&ownership, sources, 1usize) &&
        os_read(&ownership, &sources[1usize], 0usize, sources[1usize].size);
    (*stats).times[0usize] = ogc_clock() - start;
    start = ogc_clock();
    if valid { valid = os_lower(&ownership); }
    (*stats).times[3usize] = ogc_clock() - start;
    if valid { valid = ogc_emit(&ownership, null(*OgProgram), stats, argv); }
    (*stats).arena = context.arena.bytes_reserved;
    if context.error_count != 0usize { c_driver_diagnostic(&context, argv[0usize]); }
    start = ogc_clock();
    crust_context_destroy(&context);
    (*stats).times[7usize] = ogc_clock() - start;
    return valid;
}

fn ogc_report(stats: *OgcStats) -> bool {
    if !ogc_text("times ") { return false; }
    var index: usize = 0usize;
    while index < 8usize {
        if !ogc_number((*stats).times[index]) { return false; }
        index = index + 1usize;
    }
    return ogc_number((*stats).input_io) && ogc_number((*stats).arena as u64) &&
        ogc_number((*stats).requests as u64) && ogc_number((*stats).hits as u64) &&
        ogc_number((*stats).instances as u64) && ogc_number((*stats).proof_checks as u64) &&
        ogc_number((*stats).proof_bytes as u64) && ogc_text("\n");
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 7i32 { return 2i32; }
    if !c_equal(argv[2usize], "measured") && !c_equal(argv[2usize], "erasure") { return 2i32; }
    var generic: bool = c_equal(argv[1usize], "generic");
    var count: usize = 2usize;
    if generic { count = 4usize; }
    if argc != 5i32 + count as i32 || (!generic && !c_equal(argv[1usize], "handwritten")) { return 2i32; }
    var captured: CrustContext = uninit;
    crust_context_init(&captured, null(*CrustAllocator));
    var sources: [CrustSource; 4] = uninit;
    var stats: OgcStats = make OgcStats {
        times: make [u64;8] {0u64,0u64,0u64,0u64,0u64,0u64,0u64,0u64},
        input_io: 0u64, arena: 0usize, requests: 0usize, hits: 0usize, instances: 0usize,
        proof_checks: 0usize, proof_bytes: 0usize
    };
    var start: u64 = ogc_clock();
    var index: usize = 0usize;
    while index < count {
        if !cache_read(&captured, argv[index + 5usize], &sources[index]) { break; }
        sources[index].identity = index as u64 + 1u64;
        index = index + 1usize;
    }
    stats.input_io = ogc_clock() - start;
    var valid: bool = index == count;
    if valid {
        if generic { valid = ogc_generic(&sources[0usize], &stats, argv); }
        else { valid = ogc_handwritten(&sources[0usize], &stats, argv); }
    }
    if valid { valid = ogc_report(&stats); }
    if captured.error_count != 0usize { c_driver_diagnostic(&captured, argv[0usize]); }
    crust_context_destroy(&captured);
    if valid { return 0i32; }
    return 1i32;
}
