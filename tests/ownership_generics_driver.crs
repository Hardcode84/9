// Check the probe program's 32-bit type layouts in the native test process.
fn layout_probe(context: *CrustContext, entry: *CrustDecl, options: *BackendOptions) -> i32 {
    if (*context).builtins[CRUST_T_USIZE as usize].size != 4u64 || (*context).builtins[
        CRUST_T_ISIZE as usize
    ].align != 4u32 {
        crust_set_error(
            context,
            null(*CrustSource),
            0usize,
            "scalar target layout was lost"
        );
        return 1i32;
    }
    var unit_value: *CrustUnit = (*context).units;
    while unit_value != null(*CrustUnit) {
        var declaration: *CrustDecl = (*unit_value).declarations;
        while declaration != null(*CrustDecl) {
            if (*declaration).kind == CRUST_D_RECORD {
                var result: *CrustType = (*declaration).type;
                var fields: *CrustField = (*(*result).record_decl).fields;
                var pointer: *CrustType = (*(*(*entry).params).next).type;
                if (*result).size != 8u64 || (*result).align != 4u32 || (*(*fields).next).offset != 4u64 || (
                    *pointer
                ).size != 4u64 || (*pointer).align != 4u32 {
                    crust_set_error(
                        context,
                        null(*CrustSource),
                        0usize,
                        "record or pointer target layout was lost"
                    );
                    return 1i32;
                }
                return 0i32;
            }
            declaration = (*declaration).next;
        }
        unit_value = (*unit_value).next;
    }
    crust_set_error(
        context,
        null(*CrustSource),
        0usize,
        "layout probe requires an instantiated record"
    );
    return 1i32;
}

fn main(argc: i32, argv: **u8) -> i32 {
    var context: CrustContext = uninit;
    crust_context_init(&context, null(*CrustAllocator));
    var request: CrustBuild = make CrustBuild {
        context: &context,
        source: null(*CrustSource),
        target_begin: 0usize,
        argc: argc - 1i32,
        argv: argv + 1isize
    };
    var emit: fn(*CrustContext, *CrustDecl, *BackendOptions) -> i32 = c_backend_build;
    if argc > 1i32 && c_equal(argv[1usize], "layout32") {
        context.builtins[CRUST_T_ISIZE as usize].size = 4u64;
        context.builtins[CRUST_T_ISIZE as usize].align = 4u32;
        context.builtins[CRUST_T_USIZE as usize].size = 4u64;
        context.builtins[CRUST_T_USIZE as usize].align = 4u32;
        emit = layout_probe;
        request.argc = request.argc - 1i32;
        request.argv = request.argv + 1isize;
    }
    var trusted: *CrustSource = ownership_test_trust(&request);
    var count: usize = 0usize;
    if trusted != null(*CrustSource) {
        count = 1usize;
    }
    var result: i32 = 1i32;
    if context.error_count == 0usize {
        result = ownership_generics_program(&request, trusted, count, emit);
    }
    if context.error_count != 0usize {
        c_driver_diagnostic(&context, argv[0usize]);
    }
    crust_context_destroy(&context);
    return result;
}
