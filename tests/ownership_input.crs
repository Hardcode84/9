fn ownership_test_input(context: *CrustContext, path: *u8) -> *CrustSource {
    var source: *CrustSource = crust_try_alloc(context, sizeof(CrustSource), alignof(CrustSource)) as *CrustSource;
    if source == null(*CrustSource) { return source; }
    *source = make CrustSource { path: path, bytes: null(*u8), size: 0usize, identity: 100u64 };
    var bytes: *u8 = null(*u8);
    var size: usize = 0usize;
    if crust0_host_read_file(path, &bytes, &size) != 0i32 {
        crust_set_error(context, source, 0usize, "cannot read trusted implementation"); return null(*CrustSource);
    }
    (*source).bytes = crust_try_copy_string(context, bytes, size);
    (*source).size = size;
    crust0_host_free(bytes);
    if (*source).bytes == null(*u8) { return null(*CrustSource); }
    return source;
}

fn ownership_test_trust(request: *CrustBuild) -> *CrustSource {
    if (*request).argc < 2i32 || !c_equal((*request).argv[0usize], "trusted") { return null(*CrustSource); }
    var source: *CrustSource = ownership_test_input((*request).context, (*request).argv[1usize]);
    (*request).argc = (*request).argc - 2i32;
    (*request).argv = (*request).argv + 2isize;
    return source;
}
