// SPDX-License-Identifier: Apache-2.0

record RaAllocator {
    calls: usize;
    fail_at: usize;
    live: usize;
    rejected: bool;
    host_failed: bool;
}

fn ra_text(stream:u32, text:*u8)->bool {
    var size:usize = 0usize;
    while text[size] != 0u8 { size = size + 1usize; }
    return crust0_host_write_stream(stream, text, size) == 0i32;
}

fn ra_number(stream:u32, value:usize)->bool {
    var digits:[u8;20] = uninit;
    var begin:usize = 20usize;
    while true {
        begin = begin - 1usize;
        digits[begin] = ((value % 10usize) as u8) + 48u8;
        value = value / 10usize;
        if value == 0usize { break; }
    }
    return crust0_host_write_stream(stream, &digits[begin], 20usize - begin) == 0i32;
}

fn ra_allocate(user:*u8, size:usize)->*u8 {
    var state:*RaAllocator = user as *RaAllocator;
    (*state).calls = (*state).calls + 1usize;
    if (*state).calls >= (*state).fail_at {
        (*state).rejected = true;
        return null(*u8);
    }
    var result:*u8 = crust0_host_alloc(size, 16usize);
    if result == null(*u8) { (*state).host_failed = true; }
    else { (*state).live = (*state).live + 1usize; }
    return result;
}

fn ra_release(user:*u8, allocation:*u8)->unit {
    var state:*RaAllocator = user as *RaAllocator;
    if allocation == null(*u8) || (*state).live == 0usize { trap; }
    (*state).live = (*state).live - 1usize;
    crust0_host_free(allocation);
}

fn ra_report(fail_at:usize, message:*u8, context:*CrustContext)->unit {
    ra_text(2u32, "allocation attempt ");
    ra_number(2u32, fail_at);
    ra_text(2u32, ": ");
    ra_text(2u32, message);
    if (*context).error_count != 0usize {
        ra_text(2u32, ": ");
        ra_text(2u32, &(*context).error[0usize]);
    }
    ra_text(2u32, "\n");
}

fn ra_check(sources:*CrustSource, count:usize)->i32 {
    var fail_at:usize = 1usize;
    while true {
        var state:RaAllocator = make RaAllocator {
            calls:0usize, fail_at:fail_at, live:0usize, rejected:false, host_failed:false
        };
        var allocator:CrustAllocator = make CrustAllocator {
            user:&state as *u8, allocate:ra_allocate, release:ra_release
        };
        var context:CrustContext = uninit;
        crust_context_init(&context, &allocator);
        var stage:RsStage = uninit;
        rs_init(&stage, &context);
        var success:bool = true;
        var index:usize = 0usize;
        while index < count && success {
            success = rs_read(&stage, &sources[index], 0usize, sources[index].size);
            index = index + 1usize;
        }
        if success { success = rs_prepare(&stage); }
        var valid:bool = ra_valid(&state, &context, &stage, success);
        if !valid { ra_report(fail_at, "invalid failure state or invalid test input", &context); }
        crust_context_destroy(&context);
        if state.live != 0usize || context.arena.blocks != null(*u8) || context.arena.bytes_reserved != 0usize {
            ra_report(fail_at, "context destruction retained allocations", &context);
            valid = false;
        }
        if !valid { return 1i32; }
        if success {
            if !ra_text(1u32, "resource allocation: ") || !ra_number(1u32, fail_at - 1usize) ||
               !ra_text(1u32, " failure points checked\n") { return 1i32; }
            return 0i32;
        }
        fail_at = fail_at + 1usize;
    }
    trap;
}

fn main(argc:i32, argv:**u8)->i32 {
    if argc < 2i32 {
        ra_text(2u32, "usage: resources-alloc SOURCE...\n");
        return 2i32;
    }
    var count:usize = (argc - 1i32) as usize;
    var sources:*CrustSource = crust0_host_alloc(count * sizeof(CrustSource), alignof(CrustSource)) as *CrustSource;
    if sources == null(*CrustSource) {
        ra_text(2u32, "cannot allocate test source descriptors\n");
        return 1i32;
    }
    var index:usize = 0usize;
    while index < count {
        sources[index] = make CrustSource {
            path:argv[index + 1usize], bytes:null(*u8), size:0usize, identity:index as u64 + 1u64
        };
        index = index + 1usize;
    }
    var result:i32 = 0i32;
    index = 0usize;
    while index < count {
        if crust0_host_read_file(sources[index].path, &sources[index].bytes, &sources[index].size) != 0i32 {
            ra_text(2u32, "cannot read test source: ");
            ra_text(2u32, sources[index].path);
            ra_text(2u32, "\n");
            result = 1i32;
            break;
        }
        index = index + 1usize;
    }
    if result == 0i32 { result = ra_check(sources, count); }
    index = 0usize;
    while index < count {
        crust0_host_free(sources[index].bytes);
        index = index + 1usize;
    }
    crust0_host_free(sources as *u8);
    return result;
}

fn ra_valid(state:*RaAllocator, context:*CrustContext, stage:*RsStage, success:bool)->bool {
    var valid:bool = !(*state).host_failed && (*context).failure == null(*u8);
    if success {
        valid = valid && !(*state).rejected && !(*stage).failed && (*context).error_count == 0usize;
    } else {
        valid = valid && (*state).rejected && (*stage).failed && (*context).error_count != 0usize && (*context).error[0usize] != 0u8;
    }
    return valid;
}
