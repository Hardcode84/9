extern fn st_puts(text: *u8) -> i32 = "puts";

record StAllocator {
    calls: usize;
    fail_at: usize;
    live: usize;
}

fn st_allocate(user: *u8, size: usize) -> *u8 {
    var state: *StAllocator = user as *StAllocator;
    state -> calls = state -> calls + 1usize;
    if state -> calls == state -> fail_at {
        return null(*u8);
    }
    var bytes: *u8 = crust0_host_alloc(size, 16usize);
    if bytes != null(*u8) {
        state -> live = state -> live + 1usize;
    }
    return bytes;
}

fn st_release(user: *u8, bytes: *u8) -> unit {
    var state: *StAllocator = user as *StAllocator;
    if state -> live == 0usize {
        trap;
    }
    state -> live = state -> live - 1usize;
    crust0_host_free(bytes);
}

fn st_attempt(
    source: *CrustSource,
    config: *ShaderConfig,
    output: *u8,
    fail_at: usize,
    calls: *usize
) -> bool {
    var state: StAllocator = make StAllocator {
        calls: 0usize,
        fail_at: fail_at,
        live: 0usize
    };
    var allocator: CrustAllocator = make CrustAllocator {
        user: &state as *u8,
        allocate: st_allocate,
        release: st_release
    };
    var context: CrustContext = uninit;
    crust_context_init(&context, &allocator);
    var success: bool = false;
    if c_equal(config -> llvm_directory, "wgsl") {
        success = shader_build_wgsl(&context, source, config, output);
    } else {
        success = shader_build(&context, source, config, output);
    }
    * calls = state.calls;
    var valid: bool = success && fail_at == 0usize;
    if fail_at != 0usize {
        valid = !success && context.error_count != 0usize;
    }
    if context.error_loc.source != null(*CrustSource) {
        var retained: CrustSource = *context.error_loc.source;
        if retained.size != 0usize && retained.bytes[0usize] == 0u8 {
            valid = false;
        }
    }
    crust_context_destroy(&context);
    return valid && state.live == 0usize;
}
fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 4i32 {
        return 2i32;
    }
    var resources: [ShaderResource; 3] = make [ShaderResource; 3] {
        make ShaderResource {
            name: "values",
            kind: SHADER_BUFFER_F32,
            layout: SHADER_FIXED,
            set: 0u32,
            binding: 0u32,
            length: 4u32,
            height: 0u32
        },
        make ShaderResource {
            name: "scratch",
            kind: SHADER_WORKGROUP_F32,
            layout: SHADER_FIXED,
            set: 0u32,
            binding: 0u32,
            length: 4u32,
            height: 0u32
        },
        make ShaderResource {
            name: "pixels",
            kind: SHADER_IMAGE_R32F,
            layout: SHADER_FIXED,
            set: 0u32,
            binding: 2u32,
            length: 4u32,
            height: 1u32
        }
    };
    var config: ShaderConfig = make ShaderConfig {
        resources: &resources[0usize],
        entry: "compute",
        llvm_directory: argv[1usize],
        validator: argv[2usize],
        resource_count: 3usize,
        execution: SHADER_CHECKED,
        invocations: 4u32,
        local_size: 4u32,
        status_set: 0u32,
        status_binding: 1u32,
        preserve_denorms: false
    };
    var bytes: *u8 = "fn sync()->unit{shader_barrier();}fn compute()->unit{var round:u32=0u32;while round<2u32{var i:u32=shader_local_x();scratch_store(i,values_load(i));shader_barrier();pixels_store(i,0u32,scratch_load(i));shader_barrier();values_store(i,pixels_load(i,0u32));sync();round=round+1u32;}}";
    var source: CrustSource = make CrustSource {
        path: "shader-allocation",
        bytes: bytes,
        size: c_length(bytes),
        identity: 1u64
    };
    var calls: usize = 0usize;
    if !st_attempt(&source, &config, argv[3usize], 0usize, &calls) {
        st_puts("shader baseline failed");
        return 1i32;
    }
    var index: usize = 1usize;
    while index <= calls {
        var used: usize = 0usize;
        if !st_attempt(&source, &config, argv[3usize], index, &used) {
            st_puts("shader allocation failure leaked or escaped");
            return 1i32;
        }
        index = index + 1usize;
    }
    st_puts("shader allocation sweep passed");
    return 0i32;
}
