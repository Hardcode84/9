extern fn union_open(path:*u8,mode:*u8)->*u8="fopen";
extern fn union_close(file:*u8)->i32="fclose";

fn union_assembly(request:*CrustBuild)->i32 {
    var cli:CCli=uninit;var stage:SuStage=uninit;var result:i32=1i32;
    var ready:bool=c_driver_init(&cli,request->context,request->argc);
    if ready && su_init(&stage,request->context) && c_driver_parse(&cli,request->argc,request->argv,0i32) {
        result=union_assembly_build(&cli,&stage);
    }
    c_stage_destroy(&cli.stage);return result;
}

fn union_assembly_build(cli:*CCli,stage:*SuStage)->i32 {
    if !su_inputs(cli,stage) || !su_check(stage) || !c_driver_exports(cli) || !c_driver_names(&cli->driver) { return 1i32; }
    var entry:*CrustDecl=null(*CrustDecl);
    if !cli->library { entry=c_driver_entry(cli);if entry==null(*CrustDecl) { return 1i32; } }
    if cli->options.output==null(*u8) { crust_set_error(stage->context,null(*CrustSource),0usize,"assembly output path required");return 1i32; }
    var file:*u8=union_open(cli->options.output,"wb");
    if file==null(*u8) { c_driver_io_error(&cli->driver,"cannot open output",cli->options.output,*c_driver_errno());return 1i32; }
    var success:bool=crust_x64_emit(stage->context,file,entry);
    if union_close(file)!=0i32 { c_driver_io_error(&cli->driver,"cannot close output",cli->options.output,*c_driver_errno());return 1i32; }
    if success { return 0i32; }return 1i32;
}

fn main(argc:i32,argv:**u8)->i32 {
    if argc==3i32 && c_equal(argv[1usize],"--verify") { return union_verify(argv[2usize]); }
    var context:CrustContext=uninit;crust_context_init(&context,null(*CrustAllocator));
    var request:CrustBuild=make CrustBuild{context:&context,source:null(*CrustSource),target_begin:0usize,argc:argc-1i32,argv:argv+1isize};
    var result:i32=1i32;
    if argc>1i32 && c_equal(argv[1usize],"--asm") {
        request.argc=request.argc-1i32;request.argv=request.argv+1isize;result=union_assembly(&request);
    } else { result=union_program(&request); }
    if context.error_count!=0usize { c_driver_diagnostic(&context,argv[0usize]); }
    crust_context_destroy(&context);return result;
}
