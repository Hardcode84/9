extern fn exit(status: i32) -> unit = "exit";
extern fn puts(text: *u8) -> i32 = "puts";
extern fn memset(bytes: *u8, value: i32, size: usize) -> *u8 = "memset";
extern fn memcmp(left: *u8, right: *u8, size: usize) -> i32 = "memcmp";
extern fn malloc(size: usize) -> *u8 = "malloc";
extern fn free(bytes: *u8) -> unit = "free";
extern fn fclose(file: *u8) -> i32 = "fclose";
extern fn fread(bytes: *u8, size: usize, count: usize, file: *u8) -> usize = "fread";

fn zero(bytes: *u8, size: usize) -> unit {
    memset(bytes, 0i32, size);
}

fn error(message: *u8) -> bool {
    puts(message);
    return false;
}

fn print_number(value: i64) -> unit {
    var buffer: [u8; 22] = uninit;
    var index: usize = 21usize;
    buffer[index] = 0u8;
    var number: u64 = value as u64;
    if value < 0i64 {
        number = 0u64 - number;
    }
    while true {
        index = index - 1usize;
        buffer[index] = (number % 10u64) as u8 + 48u8;
        number = number / 10u64;
        if number == 0u64 {
            break;
        }
    }
    if value < 0i64 {
        index = index - 1usize;
        buffer[index] = 45u8;
    }
    puts(&buffer[index]);
}

fn vk_ok(result: i32, operation: *u8) -> bool {
    if result == VK_SUCCESS {
        return true;
    }
    puts(operation);
    print_number(result as i64);
    return false;
}

record Input {
    bytes: *u8;
    size: usize;
}

fn read_input(path: *u8, output: *Input) -> bool {
    var file: *u8 = file_open(path, "rb");
    if file == null(*u8) {
        return error("cannot open input");
    }
    var size: i64 = -1i64;
    if file_seek(file, 0i64, 2i32) == 0i32 {
        size = file_tell(file);
    }
    var good: bool = size > 0i64 && size % 4i64 == 0i64;
    if good {
        good = file_seek(file, 0i64, 0i32) == 0i32;
    }
    if good {
        output -> size = size as usize;
        output -> bytes = malloc(output -> size);
        good = output -> bytes != null(*u8);
    }
    if good {
        good = fread(output -> bytes, 1usize, output -> size, file) == output -> size;
    }
    if fclose(file) != 0i32 {
        good = false;
    }
    if !good {
        return error("cannot read aligned input");
    }
    return true;
}
