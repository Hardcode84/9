extern fn strcmp(a: *u8, b: *u8) -> i32 = "strcmp";

fn check_buffer_guards(v: *Vulkan) -> bool {
    var offset: usize = 16usize;
    if v -> runtime {
        if (v -> mapped as *u32)[0usize] != v -> count {
            return error("runtime count header was modified");
        }
        offset = 20usize;
    }
    while offset < 256usize {
        if v -> mapped[offset] != 255u8 {
            return error("buffer guard was modified");
        }
        offset = offset + 1usize;
    }
    return true;
}

fn check_result(v: *Vulkan, expected: *u8) -> bool {
    var data: *u8 = v -> mapped;
    if v -> runtime {
        data = data + 4isize;
    }
    var good: bool = memcmp(data, expected, 16usize) == 0i32 && memcmp(
        v -> mapped + 256isize,
        expected + 16isize,
        16usize
    ) == 0i32;
    good = check_buffer_guards(v) && good;
    if !good {
        puts("Vulkan result mismatch (value bits / status per lane):");
        var values: *u32 = data as *u32;
        var status: *u32 = (v -> mapped + 256isize) as *u32;
        var index: usize = 0usize;
        while index < 4usize {
            print_number(values[index] as i64);
            print_number(status[index] as i64);
            index = index + 1usize;
        }
    }
    return good;
}

fn execute(code: *Input, expected: *u8, twice: bool, runtime: bool, count: u32) -> bool {
    var v: Vulkan = uninit;
    zero(&v as *u8, sizeof(Vulkan));
    v.runtime = runtime;
    v.count = count;
    var good: bool = device_open(&v) && buffer_create(&v) && image_create(&v) && layout_create(
        &v
    ) && pipeline_create(&v, code) && descriptors_create(&v) && dispatch(&v);
    if good && twice {
        good = submit_commands(&v);
    }
    if good {
        good = check_result(&v, expected);
    }
    device_close(&v);
    return good;
}

fn valid_arguments(argc: i32, argv: **u8) -> bool {
    if argc == 3i32 {
        return true;
    }
    if argc == 4i32 {
        return strcmp(argv[3usize], "--twice") == 0i32;
    }
    if argc != 5i32 || strcmp(argv[3usize], "--runtime") != 0i32 {
        return false;
    }
    var count: *u8 = argv[4usize];
    return count[0usize] >= 48u8 && count[0usize] <= 52u8 && count[1usize] == 0u8;
}
fn main(argc: i32, argv: **u8) -> i32 {
    if !valid_arguments(argc, argv) {
        puts("expected SPIRV_FILE EXPECTED_FILE [--twice|--runtime COUNT(0..4)]");
        return 2i32;
    }
    var count: u32 = 4u32;
    if argc == 5i32 {
        count = (argv[4usize][0usize] - 48u8) as u32;
    }
    var expected: Input = make Input {
        bytes: null(*u8),
        size: 0usize
    };
    var code: Input = make Input {
        bytes: null(*u8),
        size: 0usize
    };
    var good: bool = read_input(argv[2usize], &expected);
    if good && expected.size != 32usize {
        good = error("expected data must contain four f32 values and four u32 status codes");
    }
    if good {
        good = read_input(argv[1usize], &code);
    }
    if good {
        if code.size < 20usize || (code.bytes as *u32)[0usize] != 0x07230203u32 {
            good = error("invalid SPIR-V header");
        }
    }
    var status: i32 = 2i32;
    if good {
        status = 1i32;
        if execute(&code, expected.bytes, argc == 4i32, argc == 5i32, count) {
            status = 0i32;
            puts("Vulkan result and status match");
        }
    }
    free(code.bytes);
    free(expected.bytes);
    return status;
}
